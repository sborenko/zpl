procedure F6_PrtVedToBank(dDtProc : TDateTime; cdsShwAv : TDataSet;
                                                   myStringList : TStringList);
          // Ведомость аванса (возможно и зпл для банка
var iRow, nStartRow, nMyConst, nPp, nPage, nMaxCol : integer;
    cMsg, cPrtSpZ, cShObj, cNmObj : string; // каждый СБУ - отдельная ведомость
    nSmAvns, nSmObj, nSmSpZ, nSmTts : double;
    nCntObj, nCntSpZ, nPrtSpZ, nPrtObj, nSvTabN, nKopeek : integer;
    nY, nM, nD : word;
    nNrVed : integer;
    nLstCntRow, nLstMaxRow : integer;
    PgSetup : F1PageSetup;
    F : TextFile;
    cSmMsg, cBnkMsg : string;
begin
  AssignFile(F, cDirTemp + 'Opu.txt');
  Rewrite(F);
  myStringList.Clear;
  Screen.Cursor := crHourGlass;
  FormZpCmnPrt := TFormZpCmnPrt.Create(Application);
  with FormZpCmnPrt, F6B do begin
    PgSetup := CreateNewPageSetup;
    SetPageParams(PgSetup);
    SetPageSetup(PgSetup);
    nPage := 0;
    nPp := 0;
    nLstMaxRow := nAppLstMaxRow;
    DecodeDate(dDtProc, nY, nM, nd);
    nMyConst := RowHeight[1];
    ShowGridLines    := false;
    ShowColHeading   := true;
    ShowRowHeading   := true;
    ShowZeroValues   := false;
    ShowTabs         := 0;
    PrintNoColor     := true;
    PrintGridLines   := false;
    PrintFooter      := '';
    PrintHeader      := '';
    PrintLandscape   := false;
    DefaultFontCharSet := F1RussianCharSet;
    DefaultFontSize := 10;
    ColWidth[1] := Round(6 * nMyConst);   // № п/п
    ColWidth[2] := Round(15 * nMyConst);  // № карткового рахунку
    ColWidth[3] := Round(13 * nMyConst);  // Сума зарахування
    ColWidth[4] := Round(45 * nMyConst);  // Прiзвище, iм`я та по батьковi
    nMaxCol := 4;
    nLstCntRow := 0;
    iRow := 1;
    nNrVed := 0;
    with cdsShwAv do begin
      nSvTabN := FieldByName('TabN').AsInteger;
      First;
      nCntSpZ := 0;
      nSmTts  := 0;
      while not Eof do begin
        if nCntSpZ > 0 then begin
          Inc(iRow);
          AddRowPageBreak(iRow);
          Inc(iRow);
          Inc(nLstCntRow);
        end;
        Inc(nNrVed);
        Head1(iRow, nNrVed, nPage, nMaxCol);
        Head2(iRow, nNrVed, nMaxCol);
        Head3(iRow, nNrVed, nMaxCol, nStartRow);
        Inc(nCntSpZ);
        nPrtSpZ := FieldByName('KdSpZ').AsInteger;
        if FieldByName('SpZ').IsNull then
          cPrtSpZ := 'xxx'
        else
          cPrtSpZ := FieldByName('SpZ').AsString;
        nSmSpZ := 0;
        nCntObj := 0;
        Inc(iRow);
        Inc(nLstCntRow);
        TextRC[iRow, nMaxCol] := 'Рахунок ' + cPrtSpZ;
        SetSelection(iRow, nMaxCol, iRow, nMaxCol);
        FontUnderLine := true;
        SetAlignment(F1HAlignRight, false, F1VAlignCenter, 0);
        while (FieldByName('KdSpZ').AsInteger = nPrtSpZ) and not Eof do begin
          nPrtObj := FieldByName('KdObj').AsInteger;
          cShObj := DmMain.KdObj2ShObj(nPrtObj, cNmObj);
          Inc(iRow);
          Inc(nLstCntRow);
          TextRC[iRow, 1] := cNmObj;
          SetSelection(iRow, 1, iRow, nMaxCol);
          FontUnderLine := true;
          SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
          Inc(nCntObj);
          nSmObj := 0;
          while (FieldByName('KdSpZ').AsInteger = nPrtSpZ) and
                 (FieldByName('KdObj').AsInteger = nPrtObj) and not Eof do begin
            // тут можно сначала пройтись до след. подразд, посчитать записи,
            // либо организовать буффер, сбрасывать в него, а при достижении
            // нового подразд. решить, что делать.
            Inc(iRow);
            Inc(nLstCntRow);
            Inc(nPp);
            TextRC[iRow, 1] := IntToStr(nPp) + '.';
            SetSelection(iRow, 1, iRow, 1);
            SetAlignment(F1HAlignRight, true, F1VAlignBottom, 0);
            TextRC[iRow, 2] := FieldByName('LicSch').AsString;
            nSmAvns := FieldByName('Summa').AsFloat;
            NumberRC[iRow, 3] := nSmAvns;
            nSmObj := nSmObj + nSmAvns;
            nSmSpZ := nSmSpZ + nSmAvns;
            nSmTts := nSmTts + nSmAvns;
            SetSelection(iRow, 3, iRow, 3);
            FormatFixed2;
            TextRC[iRow, nMaxCol] := '      ' + FieldByName('FamIO').AsString;
            //  26208015043001 ,  0,   4,          85.00,КРИВДА ВIКТОРIЯ IГОРIВНА
            cSmMsg := MyPadL(FloatToStrF(nSmAvns, ffFixed, 12, 2), 15);

            cBnkMsg := FieldByName('LicSch').AsString + ' ,  0,   4,' +
                       cSmMsg + ', ' + FieldByName('Fam').AsString +
                       ' ' + FieldByName('Ima').AsString + ' ' +
                       FieldByName('Otch').AsString;
            WriteLn(F, cBnkMsg);
            myStringList.Add(cBnkMsg);
            if (nLstCntRow >= nLstMaxRow) then begin
              SetSelection(nStartRow, 1, iRow, nMaxCol);
              SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
              nLstCntRow := 0;
              AddRowPageBreak(iRow+1);
              Head1(iRow, nNrVed, nPage, nMaxCol);
              Head3(iRow, nNrVed, nMaxCol, nStartRow); end
            else
              Inc(nLstCntRow);
            Next;
          end;
          Inc(iRow);
          TextRC[iRow, 1] := 'Ітого по підрозділу:';
          SetSelection(iRow, 1, iRow, 2);
          SetAlignment(F1HAlignCenterAcrossCells, true, F1VAlignBottom, 0);
          NumberRC[iRow, 3] := nSmObj;
          SetSelection(iRow, 3, iRow, 3);
          FormatFixed2;
          SetSelection(iRow, 1, iRow, nMaxCol);
          FontItalic := true;
        end;
        if nCntObj > 0 then begin
          SetSelection(nStartRow, 1, iRow, nMaxCol);
          SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
          nStartRow := 0;
          iRow := iRow + 2;
          TextRC[iRow, 1] := 'Ітого по рахунку: ' + cPrtSpZ;
          Inc(iRow);
          cMsg := UkrSumPropis(nSmSpZ, 'w', nKopeek);
          cMsg := AnsiUpperCase(Copy(cMsg, 1, 1)) +
                              Copy(cMsg, 2, Length(cMsg)) + ' грн., ';
          if nKopeek <> 0 then
            cMsg := cMsg + IntToStr(nKopeek) + ' коп.'
          else
            cMsg := cMsg + '00 коп.';
          SetSelection(iRow, 2, iRow, nMaxCol);
          mCellFormat := CreateNewCellFormat;
          mCellFormat.AlignHorizontal := F1HAlignGeneral;
          mCellFormat.AlignVertical := F1VAlignCenter;
          mCellFormat.MergeCells := true;
          mCellFormat.WordWrap   := true;
          mCellFormat.FontBold   := true;
          SetCellFormat(mCellFormat);
          TextRC[iRow, 2] := cMsg;
          iRow := iRow + 2;
          if cDirDolgn <> '' then
            cMsg := cDirDolgn + ' ____________  ' + cDirFIO
          else
            cMsg := 'Руководитель ____________  ____________';
          TextRC[iRow, nMaxCol] := cMsg;
          iRow := iRow + 2;
          if cGlBuhDolgn <> '' then
            cMsg := cGlBuhDolgn + ' ____________  ' + cGlBuhFIO
          else
            cMsg := 'Бухгалтер ____________ ' + Form_Dm.KdUsr2FioUsr(nAppKdUsr);
          TextRC[iRow, nMaxCol] := cMsg;
          SetSelection(iRow-2, nMaxCol, iRow, nMaxCol);
          SetAlignment(F1HAlignRight, false, F1VAlignCenter, 0);
          Inc(iRow);
          Inc(iRow);
        end;
      end;
      CloseFile(F);
      if nCntSpZ > 1 then begin
        Inc(iRow);
        AddRowPageBreak(iRow);
        iRow := iRow + 2;
        TextRC[iRow, 1] := 'Усього рахунків: ' +
                                         IntToStr(nCntSpZ) + ' на сумму: ';
        Inc(iRow);
        cMsg := UkrSumPropis(nSmTts, 'w', nKopeek);
        cMsg := AnsiUpperCase(Copy(cMsg, 1, 1)) +
                                   Copy(cMsg, 2, Length(cMsg)) + ' грн., ';
        if nKopeek <> 0 then
          cMsg := cMsg + IntToStr(nKopeek) + ' коп.'
        else
          cMsg := cMsg + '00 коп.';
        SetSelection(iRow, 2, iRow, nMaxCol);
        mCellFormat := CreateNewCellFormat;
        mCellFormat.AlignHorizontal := F1HAlignGeneral;
        mCellFormat.AlignVertical := F1VAlignCenter;
        mCellFormat.MergeCells := true;
        mCellFormat.WordWrap   := true;
        mCellFormat.FontBold   := true;
        SetCellFormat(mCellFormat);
        TextRC[iRow, 2] := cMsg;
        iRow := iRow + 2;
        if cDirDolgn <> '' then
          cMsg := cDirDolgn + ' ____________  ' + cDirFIO
        else
          cMsg := 'Руководитель ____________  ____________';
        TextRC[iRow, nMaxCol] := cMsg;
        iRow := iRow + 2;
        if cGlBuhDolgn <> '' then
          cMsg := cGlBuhDolgn + ' ____________  ' + cGlBuhFIO
        else
          cMsg := 'Бухгалтер ____________ ' + Form_Dm.KdUsr2FioUsr(nAppKdUsr);
        TextRC[iRow, nMaxCol] := cMsg;
        SetSelection(iRow-2, nMaxCol, iRow, nMaxCol);
        SetAlignment(F1HAlignRight, false, F1VAlignCenter, 0);
        Inc(iRow);
        Inc(iRow);
      end;
      Locate('TabN', nSvTabN, []);
    end;
    cRandomFileName := RandomFileName;
    if bAppDocsToExcel then begin
      cRandomFileName := cRandomFileName + '.xls';
      WriteEx(cDirTemp + cRandomFileName, F1FileExcel97); end
    else begin
      cRandomFileName := cRandomFileName + '.vts';
      WriteEx(cDirTemp + cRandomFileName, F1FileFormulaOne6);
    end;
    Screen.Cursor := crDefault;
    Free;
  end;
  Screen.Cursor := crDefault;
  MyPreView(cDirTemp, cRandomFileName);
end;
