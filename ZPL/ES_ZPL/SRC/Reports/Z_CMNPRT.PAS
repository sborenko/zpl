        SetAlignment(F1HAlignRight, true, F1VAlignCenter, 0);
        Inc(iRow);
        Inc(nCntPgLn, 2);
        TextRC[iRow, 1] := '№№ п/п';
        TextRC[iRow, 2] := 'Таб. номер';
        TextRC[iRow, 3] := 'Счёт (PSch)';
        TextRC[iRow, 4] := 'Начисления';
        TextRC[iRow, 5] := 'Удержания';
        TextRC[iRow, 6] := 'Выплаты';
        TextRC[iRow, 7] := 'Остатки';
        TextRC[iRow, 8] := 'В долг ТМ';
        TextRC[iRow, 9] := 'Возвр. долга ПМ';
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
        SetBorder(1, 1, 1, 1, 1, 0, clBlack,clBlack,clBlack,clBlack,clBlack);
      end;
    end;
begin
  Screen.Cursor := crHourGlass;
  FormZpCmnPrt := TFormZpCmnPrt.Create(Application);
  with FormZpCmnPrt, F6B do begin
    PgSetup := CreateNewPageSetup;
    SetPageParams(PgSetup);
    SetPageSetup(PgSetup);
    ShowGridLines    := false;
    ShowColHeading   := true;
    ShowRowHeading   := true;
    ShowZeroValues   := false;
    ShowTabs         := 0;
    PrintNoColor     := true;
    PrintGridLines   := false;
    PrintFooter      := '';
    PrintHeader      := '';
    PrintLandscape   := false;
    DefaultFontCharSet := F1RussianCharSet;
    DefaultFontSize := 9;
    nMyConst := RowHeight[1];
    nMaxCol := 9;
    nMaxCntPgLn := 59;
    nCntPgLn := 0;
    nPg := 0;
    iRow := 1;
    ColWidth[1]  := Round( 6 * nMyConst);  // № п/п
    ColWidth[2]  := Round( 9 * nMyConst);  // ТабН
    ColWidth[3]  := Round(10 * nMyConst);  // ПСч
    ColWidth[4]  := Round(15 * nMyConst);  // Начисл
    ColWidth[5]  := Round(15 * nMyConst);  // Удерж
    ColWidth[6]  := Round(15 * nMyConst);  // Выплаты
    ColWidth[7]  := Round(15 * nMyConst);  // Остаток
    ColWidth[8]  := Round( 9 * nMyConst);  // В долг ТМ
    ColWidth[9]  := Round( 9 * nMyConst);  // Возвр. долга ПМ
    DecodeDate(dDtPrc, nY, nM, nD);
    Inc(iRow);
    cMsg := 'Результаты проверка данных для м/ордера за ' +
                                     MesRus(nM) + ' ' + IntToStr(nY) + ' г.';
    TextRC[iRow, 1] := cMsg;
    SetSelection(iRow, 1, iRow, nMaxCol);
    FontBold := true;
    FontUnderLine := true;
    SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignBottom, 0);
    bIsItogi := false;
    nPp := 0;
    with cdsMo do begin
      nSvNR := FieldByName('NR').AsInteger;
      DisableControls;
      Last;
      nCntLnPodvala := 0;
      while not Bof do begin
        if FieldByName('TabN').AsInteger > 9900000 then
          Inc(nCntLnPodvala)
        else
          Break;
        Prior;
      end;
      First;
      Shapka(F6B, iRow);
      while not Eof do begin
        Inc(nCntPgLn);
        if (nCntPgLn > nMaxCntPgLn) then begin
          Inc(iRow);
          AddRowPageBreak(iRow);
          nCntPgLn := 0;
          Shapka(F6B, iRow);
        end;
        Inc(iRow);
        Inc(nPp);
        if FieldByName('TabN').AsInteger < 9900000 then begin
          NumberRC[iRow, 1] := nPp;
          NumberRC[iRow, 2] := FieldByName('TabN').AsInteger;
        end;
        TextRC[iRow, 3]   := FieldByName('PSch').AsString;
        NumberRC[iRow, 4] := FieldByName('Sm_Nach').AsFloat;
        NumberRC[iRow, 5] := FieldByName('Sm_Udrg').AsFloat;
        NumberRC[iRow, 6] := FieldByName('Sm_Vupl').AsFloat;
        NumberRC[iRow, 7] := FieldByName('Sm_Ost').AsFloat;
        NumberRC[iRow, 8] := FieldByName('Sm_VDlg').AsFloat;
        NumberRC[iRow, 9] := FieldByName('Sm_Vzvr').AsFloat;
        SetSelection(iRow, 4, iRow, nMaxCol);
        SetColWidthAuto(iRow, 4, iRow, 7, false);
        FormatFixed2;
        SetSelection(iRow, 1, iRow, nMaxCol);
        if FieldByName('TabN').AsInteger > 9900000 then
          FontBold := true;
        SetBorder(1, 1, 1, 1, 1, 0, clBlack,clBlack,clBlack,clBlack,clBlack);
        Next;

        if not bIsItogi and
                     (FieldByName('TabN').AsInteger > 9900000) then begin
          if (nCntPgLn >= (nMaxCntPgLn - nCntLnPodvala - 3)) then begin
            Inc(iRow);
            AddRowPageBreak(iRow);
            nCntPgLn := 0;
            Shapka(F6B, iRow);
          end;
          Inc(iRow);
          TextRC[iRow, 1] := 'Итоги по счетам:';
          SetSelection(iRow, 1, iRow, 1);
          FontBold := true;
          SetSelection(iRow, 1, iRow, nMaxCol);
          SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignBottom, 0);
          SetBorder(1, 1, 1, 1, 1, 0, clBlack,clBlack,clBlack,clBlack,clBlack);
          bIsItogi := true;
{
          end
          else begin
            Inc(iRow);
            TextRC[iRow, 1] := 'Итоги по счетам:';
            SetSelection(iRow, 1, iRow, 1);
            FontBold := true;
            SetSelection(iRow, 1, iRow, nMaxCol);
            SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignBottom, 0);
            SetBorder(1, 1, 1, 1, 1, 0, clBlack,clBlack,clBlack,clBlack,clBlack);
            bIsItogi := true;
          end;
}
        end;
      end;
      Locate('NR', nSvNR, []);
      EnableControls;
      Inc(iRow,2);
      TextRC[iRow, nMaxCol] := 'Исполнитель ____________ ' +
                                              Form_Dm.KdUsr2FioUsr(nAppKdUsr);
      SetSelection(iRow, nMaxCol, iRow, nMaxCol);
      SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
    end;
    cRandomFileName := RandomFileName;
    if bAppDocsToExcel then begin
      cRandomFileName := cRandomFileName + '.xls';
      WriteEx(cDirTemp + cRandomFileName, F1FileExcel97); end
    else begin
      cRandomFileName := cRandomFileName + '.vts';
      WriteEx(cDirTemp + cRandomFileName, F1FileFormulaOne6);
    end;
    Screen.Cursor := crDefault;
    Free;
  end;
  MyPreView(cDirTemp, cRandomFileName);
end;

