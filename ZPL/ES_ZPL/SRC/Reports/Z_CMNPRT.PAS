  procedure Shapka(F6B : TF6Book; var iRow, iCol : integer);
  var
    Mnth: Word;
  begin
    with F6B do begin
      Inc(nPage);
      Inc(iRow);
      Inc(nCntPgLines);
      TextRC[iRow, 1] := 'Податковий №: ' + cID;
      //TextRC[iRow, 15] := '1-е полугодие';
