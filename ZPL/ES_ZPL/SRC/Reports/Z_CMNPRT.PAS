    Inc(nCntPgLn);
    Shapka(F6B, iRow);
    with cdsNdb do begin
      nSvNR := FieldByName('NR').AsInteger;
      DisableControls;
      First;
      nPp := 0;
      while not Eof do begin
        i := LbxF8.Items.IndexOf(FieldByName('NR').AsString);
        if (nSelCase = 3) or ((nSelCase = 1) and (i >= 0)) or
