procedure F6_PrtSpisok(qryUpi : TDataSet; bAll : boolean);
var nMyConst, iRow, iCol, nMaxCol,
    nStartRow, nPp, nSvTabN : integer;
    cMsg : string;
begin
  Screen.Cursor := crHourGlass;
  FormZpCmnPrt := TFormZpCmnPrt.Create(Application);
  with FormZpCmnPrt, F6B do begin
    ShowGridLines  := false;
    ShowColHeading := true;
    ShowRowHeading := true;
    ShowZeroValues := false;
    ShowTabs       := 0;
    PrintNoColor   := true;
    PrintGridLines := false;
    PrintFooter    := '';
    PrintHeader    := '';
    PrintLandscape := false;
    DefaultFontCharSet := F1RussianCharSet;
    DefaultFontSize := 8;
    nMyConst := RowHeight[1];
    nMaxCol := 8;
    iRow := 1;
    iCol := 1;
    if bAll then begin
      cMsg := 'Список сотрудников';
      TextRC[iRow, iCol] := cMsg;
      RowHeight[iRow] := Round(1.5 * nMyConst);
      SetSelection(iRow, 1, iRow, nMaxCol);
      SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
      FontSize := 10;
      FontBold := true; end
    else begin
      cMsg := 'Список сотрудников,';
      TextRC[iRow, iCol] := cMsg;
      SetSelection(iRow, 1, iRow, nMaxCol);
      SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
      FontSize := 10;
      FontBold := true;
      Inc(iRow);
      cMsg := 'имеющих лицевые счета';
      TextRC[iRow, iCol] := cMsg;
      SetSelection(iRow, 1, iRow, nMaxCol);
      SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
      FontSize := 10;
    end;
    Inc(iRow);
    iCol := 1;
    TextRC[iRow, iCol] := '№ п/п';
    ColWidth[iCol] := Round(4 * nMyConst);
    Inc(iCol);
    TextRC[iRow, iCol] := 'Таб. номер';
    ColWidth[iCol] := Round(7 * nMyConst);
    Inc(iCol);
    TextRC[iRow, iCol] := 'Фамилия И.О.';
    ColWidth[iCol] := Round(15 * nMyConst);
    Inc(iCol);
    TextRC[iRow, iCol] := 'Фамилия';
    ColWidth[iCol] := Round(15 * nMyConst);
    Inc(iCol);
    TextRC[iRow, iCol] := 'Имя';
    ColWidth[iCol] := Round(12 * nMyConst);
    Inc(iCol);
    TextRC[iRow, iCol] := 'Отчество';
    ColWidth[iCol] := Round(15 * nMyConst);
    Inc(iCol);
    TextRC[iRow, iCol] := 'Идентификатор';
    ColWidth[iCol] := Round(15 * nMyConst);
    Inc(iCol);
    TextRC[iRow, iCol] := 'Лицевой счёт';
    ColWidth[iCol] := Round(15 * nMyConst);
    SetSelection(iRow, 1, iRow, nMaxCol);
    SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
    RowHeight[iRow] := Round(2 * nMyConst);
    with qryUpi do begin
      DisableControls;
      nSvTabN := FieldByName('TabN').AsInteger;
      First;
      nStartRow := iRow + 1;
      nPp := 0;
      while not Eof do begin
        if not bAll and (FieldByName('LicSch').IsNull or
                              (FieldByName('LicSch').AsString = '')) then begin
          Next;
          Continue;
        end;
        Inc(iRow);
        Inc(nPp);
        iCol := 1;
        NumberRC[iRow, iCol] := nPp;
        Inc(iCol);
        NumberRC[iRow, iCol] := FieldByName('TabN').AsInteger;
        Inc(iCol);
        TextRC[iRow, iCol] := myFamIO(FieldByName('Fam').AsString,
                                      FieldByName('Ima').AsString,
                                      FieldByName('Otch').AsString);
        Inc(iCol);
        TextRC[iRow, iCol] := FieldByName('Fam').AsString;
        Inc(iCol);
        TextRC[iRow, iCol] := FieldByName('Ima').AsString;
        Inc(iCol);
        TextRC[iRow, iCol] := FieldByName('Otch').AsString;
        Inc(iCol);
        TextRC[iRow, iCol] := FieldByName('ID').AsString;
        Inc(iCol);
        TextRC[iRow, iCol] := FieldByName('LicSch').AsString;
        Next;
      end;
      EnableControls;
      Locate('TabN', nSvTabN, []);
    end;
    SetSelection(nStartRow-1, 1, iRow, nMaxCol);;
    SetBorder(6, 1, 1, 1, 1, 0, clBlack,
                                  clBlack, clBlack, clBlack, clBlack);
    SetSelection(nStartRow-1, 1, nStartRow-1, nMaxCol);
    SetBorder(-1, -1, -1, -1, 2, 0, clBlack,
                                  clBlack, clBlack, clBlack, clBlack);
    IRow := iRow + 3;
    if cBuhDolgn <> '' then
      cMsg := cBuhDolgn + '  ___________  ' + cBuhFIO
    else
      cMsg := 'Бухгалтер ____________ ' + Form_Dm.KdUsr2FioUsr(nAppKdUsr);
    TextRC[iRow, nMaxCol] := cMsg;
    SetSelection(iRow, nMaxCol, iRow, nMaxCol);
    SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
    cRandomFileName := RandomFileName;
    if bAppDocsToExcel then begin
      cRandomFileName := cRandomFileName + '.xls';
      WriteEx(cDirTemp + cRandomFileName, F1FileExcel97); end
    else begin
      cRandomFileName := cRandomFileName + '.vts';
      WriteEx(cDirTemp + cRandomFileName, F1FileFormulaOne6);
    end;
    Screen.Cursor   := crDefault;
    Free;
  end;
  Screen.Cursor := crDefault;
  MyPreView(cDirTemp, cRandomFileName);
end; {F6_PrtSpisok}

