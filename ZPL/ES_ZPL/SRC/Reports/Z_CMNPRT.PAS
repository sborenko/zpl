    PrintLandscape := false;
    DefaultFontCharSet := F1RussianCharSet;
    DefaultFontSize := 10;
    nMyConst := RowHeight[1];
    iRow := 1;
    iCol := 1;
    if bForm2 then begin
      cMsg := 'Свод по счетам БухУчёта за ' + MesRus(nM) + ' ' +
                                         IntToStr(nY) + ' года';
      TextRC[iRow, iCol] := cMsg;
      RowHeight[iRow] := Round(1.8 * nMyConst);
      Inc(iRow);
      RowHeight[iRow] := Round(2 * nMyConst);
      iCol := 1;
      TextRC[iRow, iCol] := '№ п/п';
      ColWidth[iCol] := Round(4 * nMyConst);
      Inc(iCol);
      TextRC[iRow, iCol] := 'Вид';
      ColWidth[iCol] := Round(5 * nMyConst);
      Inc(iCol);
      TextRC[iRow, iCol] := 'Наименование';
      ColWidth[iCol] := Round(35 * nMyConst);
      Inc(iCol);
      TextRC[iRow, iCol] := 'Дебет счёта';
      ColWidth[iCol] := Round(9 * nMyConst);
      Inc(iCol);
      TextRC[iRow, iCol] := 'КЕКВ';
      ColWidth[iCol] := Round(9 * nMyConst);
      Inc(iCol);
      TextRC[iRow, iCol] := 'Кредит счёта';
      ColWidth[iCol] := Round(9 * nMyConst);
      Inc(iCol);
      TextRC[iRow, iCol] := 'Сумма';
      ColWidth[iCol] := Round(10 * nMyConst);
      Inc(iCol);
      TextRC[iRow, iCol] := 'Примеч.';
      ColWidth[iCol] := Round(6 * nMyConst);
      nMaxCol := iCol; end
    else begin
      cMsg := 'Свод по счетам БухУчета за ' + MesRus(nM) + ' ' +
                                         IntToStr(nY) + ' года';
      TextRC[iRow, iCol] := cMsg;
      RowHeight[iRow] := Round(1.8 * nMyConst);
      Inc(iRow);
      RowHeight[iRow] := Round(2 * nMyConst);
      iCol := 1;
      TextRC[iRow, iCol] := '№ п/п';
      ColWidth[iCol] := Round(4 * nMyConst);
      Inc(iCol);
      TextRC[iRow, iCol] := 'Счёт виды';
      ColWidth[iCol] := Round(6 * nMyConst);
      Inc(iCol);
      TextRC[iRow, iCol] := 'Наименование';
      ColWidth[iCol] := Round(35 * nMyConst);
      Inc(iCol);
      TextRC[iRow, iCol] := 'Часы';
      ColWidth[iCol] := Round(9 * nMyConst);
      Inc(iCol);
      TextRC[iRow, iCol] := 'Начисл.';
      ColWidth[iCol] := Round(9 * nMyConst);
      Inc(iCol);
      TextRC[iRow, iCol] := 'Удерж.';
      ColWidth[iCol] := Round(9 * nMyConst);
      Inc(iCol);
      TextRC[iRow, iCol] := 'Итого';
      ColWidth[iCol] := Round(10 * nMyConst);
      Inc(iCol);
      TextRC[iRow, iCol] := 'Примеч.';
      ColWidth[iCol] := Round(6 * nMyConst);
      nMaxCol := iCol;
    end;
    SetSelection(1, 1, 1, nMaxCol);
    SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
    FontSize := 10;
    FontBold := true;
    TextRC[1, nMaxCol] := 'Вар-т 1';
    SetSelection(1, nMaxCol, 1, nMaxCol);
    SetAlignment(F1HAlignRight, false, F1VAlignCenter, 0);
    FontSize := 8;
    FontBold := false;
    FontUnderLine := true;
    SetSelection(iRow, 1, iRow, nMaxCol);
    SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
    RowHeight[iRow] := Round(2 * nMyConst);
    with cdsSPZ do begin
      nSvNr := FieldByName('NR').AsInteger;
      First;
      nStartRow := iRow + 1;
      FixedRow := nStartRow;
      while not Eof do begin
        nPrtObj := FieldByName('KdObj').AsInteger;
        if nPrtObj = NMAXKDOBJ then
          cMsg := 'По выбранным подразделениям'
        else begin
          cMsg := DmMain.KdObj2ShObj(nPrtObj, cNmObj);
          cMsg := cNmObj;
        end;
        Inc(iRow);
        TextRC[iRow, 1] := cMsg;
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetAlignment(F1HAlignCenterAcrossCells, false,
                                                F1VAlignCenter, 0);
        FontUnderline := true;
        RowHeight[iRow] := Round(1.2 * nMyConst);
        nPp := 0;
        nSmNachVN := 0;
        nSmUdrgVN := 0;
        nSmNachVU := 0;
        nSmUdrgVU := 0;
        bIsTotalsVN  := false;
        bIsTotalsVU  := false;
        Inc(iRow);
        cMsg := 'Кредит счёта 661 в дебет счетов:';
        TextRC[iRow, 1] := cMsg;
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetAlignment(F1HAlignCenterAcrossCells, false,
                                                F1VAlignBottom, 0);
        FontBold := true;
        FontUnderline := true;
        while not Eof and
                    (FieldByName('KdObj').AsInteger = nPrtObj) do begin
          if FieldByName('VUN').AsInteger = 0 then begin
            nSmNachVN := nSmNachVN + FieldByName('SmNach').AsFloat;
            nSmUdrgVN := nSmUdrgVN + FieldByName('SmUdrg').AsFloat; end
          else begin
            nSmNachVU := nSmNachVU + FieldByName('SmNach').AsFloat;
            nSmUdrgVU := nSmUdrgVU + FieldByName('SmUdrg').AsFloat;
          end;
          if (FieldByName('VUN').AsInteger = 1) and
                                        not bIsTotalsVN then begin
            bIsTotalsVN := true;
            Inc(iRow);
            TextRC[iRow, 1] := 'Итого по видам начисления:';
            SetSelection(iRow, 1, iRow, 4);
            SetAlignment(F1HAlignCenterAcrossCells, false,
                                                F1VAlignBottom, 0);
            NumberRC[iRow, 5] := nSmNachVN;
            NumberRC[iRow, 6] := -nSmUdrgVN;
            NumberRC[iRow, 7] := nSmNachVN + nSmUdrgVN;
            SetSelection(iRow, 5, iRow, 7);
            FormatFixed2;
            SetSelection(iRow, 1, iRow, nMaxCol);
            FontBold := true;
            Inc(iRow);
            cMsg := 'Дебет счёта 661 в кредит счетов:';
            TextRC[iRow, 1] := cMsg;
            SetSelection(iRow, 1, iRow, nMaxCol);
            SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignBottom, 0);
            FontBold := true;
            FontUnderline := true;
          end;
          if bForm2 then begin
            cdsDet.First;
            while not cdsDet.Eof do begin
              cRoot := Copy(cdsDet.FieldByName('SchBU').AsString, 1, 3);
              cTmp := 'vcx'; // что-нибудь
              nCntInRoot := 0;
              nSmRoot := 0;
              while (Copy(cdsDet.FieldByName('SchBU').AsString, 1, 3) = cRoot)
                                              and not cdsDet.Eof do begin
                Inc(nCntInRoot);
                Inc(iRow);
                iCol := 1;
                Inc(iCol);
                TextRC[iRow, iCol] := cdsDet.FieldByName('VidN').AsString;
                SetSelection(iRow, iCol, iRow, iCol);
                SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
                Inc(iCol);
                TextRC[iRow, iCol] := cdsDet.FieldByName('ShVidN').AsString;
                SetSelection(iRow, iCol, iRow, iCol);
                SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);
                Inc(iCol);
                if cdsDet.FieldByName('VidN').AsString < '60' then
                  TextRC[iRow, iCol] := FieldByName('SchBU').AsString
                else
                  TextRC[iRow, iCol] := '661';
                Inc(iCol);
                TextRC[iRow, iCol] := cKekv1111;
                Inc(iCol);
                if cdsDet.FieldByName('VidN').AsString < '60' then
                  TextRC[iRow, iCol] := '661'
                else
                  TextRC[iRow, iCol] := FieldByName('SchBU').AsString;
                SetSelection(iRow, iCol-2, iRow, iCol);
                SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);
                Inc(iCol);
                NumberRC[iRow, iCol] := cdsDet.FieldByName('SmTot').AsFloat;
                SetSelection(iRow, iCol, iRow, iCol);
                FormatFixed2;
                nSmRoot := nSmRoot + cdsDet.FieldByName('SmTot').AsFloat;
                cdsDet.Next;
              end;
              if nCntInRoot > 1 then begin
                Inc(iRow);
                iCol := 4;
                TextRC[iRow, iCol] := 'Итого по счёту ' + cRoot + ':';
                SetSelection(iRow, iCol, iRow, iCol);
                SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
                iCol := 7;
                NumberRC[iRow, iCol] := nSmRoot;
                SetSelection(iRow, iCol, iRow, iCol);
                FormatFixed2;
              end;
            end;
            Next; end
          else begin
            Inc(iRow);
            Inc(nPp);
            iCol := 1;
            NumberRC[iRow, iCol] := nPp;
            Inc(iCol);
            TextRC[iRow, iCol] := FieldByName('SchBU').AsString;
            Inc(iCol);
            TextRC[iRow, iCol] := FieldByName('NmSch').AsString;
            Inc(iCol);
            NumberRC[iRow, iCol] := FieldByName('Chasu').AsFloat;
            SetSelection(iRow, iCol, iRow, iCol);
            FormatFixed2;
            Inc(iCol);
            NumberRC[iRow, iCol] := FieldByName('SmNach').AsFloat;
            SetSelection(iRow, iCol, iRow, iCol);
            FormatFixed2;
            Inc(iCol);
            NumberRC[iRow, iCol] := -FieldByName('SmUdrg').AsFloat;
            SetSelection(iRow, iCol, iRow, iCol);
            FormatFixed2;
            Inc(iCol);
            NumberRC[iRow, iCol] := FieldByName('SmTot').AsFloat;
            SetSelection(iRow, iCol, iRow, iCol);
            FormatFixed2;
            SetSelection(iRow, 1, iRow, nMaxCol);
            FontBold := true;
            cdsDet.First;
            while not cdsDet.Eof do begin
              Inc(iRow);
              iCol := 1;
              Inc(iCol);
              TextRC[iRow, iCol] := cdsDet.FieldByName('VidN').AsString;
              SetSelection(iRow, iCol, iRow, iCol);
              SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
              Inc(iCol);
              TextRC[iRow, iCol] := cdsDet.FieldByName('ShVidN').AsString;
              SetSelection(iRow, iCol, iRow, iCol);
              SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);
              Inc(iCol);
              NumberRC[iRow, iCol] := cdsDet.FieldByName('Chasu').AsFloat;
              SetSelection(iRow, iCol, iRow, iCol);
              FormatFixed2;
              Inc(iCol);
              NumberRC[iRow, iCol] := cdsDet.FieldByName('SmNach').AsFloat;
              SetSelection(iRow, iCol, iRow, iCol);
              FormatFixed2;
              Inc(iCol);
              NumberRC[iRow, iCol] := -cdsDet.FieldByName('SmUdrg').AsFloat;
              SetSelection(iRow, iCol, iRow, iCol);
              FormatFixed2;
              Inc(iCol);
              NumberRC[iRow, iCol] := cdsDet.FieldByName('SmTot').AsFloat;
              SetSelection(iRow, iCol, iRow, iCol);
              FormatFixed2;
              SetSelection(iRow, 1, iRow, nMaxCol);
              FontSize := 8;
              cdsDet.Next;
            end;
            Next;
          end;
          if ((FieldByName('KdObj').AsInteger <> nPrtObj) or Eof) and
                                            not bIsTotalsVU then begin
            bIsTotalsVU := true;
            Inc(iRow);
            TextRC[iRow, 1] := 'Итого по видам удержания:';
            SetSelection(iRow, 1, iRow, 4);
            SetAlignment(F1HAlignCenterAcrossCells, false,
                                                F1VAlignBottom, 0);
            NumberRC[iRow, 5] := nSmNachVU;
            NumberRC[iRow, 6] := -nSmUdrgVU;
            NumberRC[iRow, 7] := nSmNachVU + nSmUdrgVU;
            SetSelection(iRow, 5, iRow, 7);
            FormatFixed2;
            SetSelection(iRow, 1, iRow, nMaxCol);
            FontBold := true;
            Inc(iRow, 2);
            TextRC[iRow, 1] := 'К выдаче:';
            SetSelection(iRow, 1, iRow, 4);
            SetAlignment(F1HAlignCenterAcrossCells, false,
                                                F1VAlignBottom, 0);
            NumberRC[iRow, 7] :=
                        (nSmNachVN + nSmUdrgVN) + (nSmNachVU + nSmUdrgVU);
            SetSelection(iRow, 7, iRow, 7);
            FormatFixed2;
            SetSelection(iRow, 1, iRow, nMaxCol);
            FontBold := true;
          end;
        end;
      end;
      Locate('NR', nSvNR, []);
    end;
    SetSelection(nStartRow-1, 1, iRow, nMaxCol);;
    SetBorder(6, 1, 1, 1, 1, 0, clBlack,
                                  clBlack, clBlack, clBlack, clBlack);
    SetSelection(nStartRow-1, 1, nStartRow-1, nMaxCol);
    SetBorder(-1, -1, -1, -1, 2, 0, clBlack,
                                  clBlack, clBlack, clBlack, clBlack);
    IRow := iRow + 3;
    if cBuhDolgn <> '' then
      cMsg := cBuhDolgn + '  ___________  ' + cBuhFIO
    else
      cMsg := 'Бухгалтер ____________ ' + Form_Dm.KdUsr2FioUsr(nAppKdUsr);
    TextRC[iRow, nMaxCol] := cMsg;
    SetSelection(iRow, nMaxCol, iRow, nMaxCol);
    SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
    cRandomFileName := RandomFileName;
    if bAppDocsToExcel then begin
      cRandomFileName := cRandomFileName + '.xls';
      WriteEx(cDirTemp + cRandomFileName, F1FileExcel97); end
    else begin
      cRandomFileName := cRandomFileName + '.vts';
      WriteEx(cDirTemp + cRandomFileName, F1FileFormulaOne6);
    end;
    Screen.Cursor   := crDefault;
    Free;
  end;
  Screen.Cursor := crDefault;
  MyPreView(cDirTemp, cRandomFileName);
end; {F6PrtSvdBySPZ}
