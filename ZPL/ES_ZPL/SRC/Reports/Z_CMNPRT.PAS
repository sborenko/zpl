        mCellFormat.WordWrap   := true;
        mCellFormat.FontBold   := false;
        SetCellFormat(mCellFormat);
        TextRC[iRow, iCol] := 'Назва платежу';
        iCol := 3;
        SetSelection(iRow, iCol, iRow, nMaxCol);
        SetAlignment(F1HAlignCenterAcrossCells, true, F1VAlignCenter, 0);
        TextRC[iRow, iCol] := cNmPrdDoc;
        FontBold := true;
        Inc(iRow);
        iCol := 1;
        SetSelection(iRow, 1, iRow, 2);
        mCellFormat := CreateNewCellFormat;
        mCellFormat.AlignHorizontal := F1HAlignGeneral;
        mCellFormat.AlignVertical := F1VAlignCenter;
        mCellFormat.MergeCells := true;
        mCellFormat.WordWrap   := true;
        mCellFormat.FontBold   := false;
        SetCellFormat(mCellFormat);
        TextRC[iRow, iCol] := 'Номер пачки';
        iCol := 3;
        SetSelection(iRow, iCol, iRow, nMaxCol);
        SetAlignment(F1HAlignCenterAcrossCells, true, F1VAlignCenter, 0);
        TextRC[iRow, iCol] := IntToStr(nNrPrdFile);
        FontBold := true;
        SetSelection(iRow-3, 1, iRow, nMaxCol);
        SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
      end;
    end;
    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    procedure Shap1VedBnk(F6B : TF6Book; nY, nM : word;
                                                   var iRow, iCol : integer);
    begin
      with F6B do begin
        Inc(iRow);
        iCol := 1;
        TextRC[iRow, iCol] := 'Зведена вiдомicть №' + IntToStr(nNrPrdFile);
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
        Inc(iRow);
        iCol := 1;
        TextRC[iRow, iCol] := 'сум для зарахування на спецiальнi картковi рахунки';
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
        Inc(iRow);
        Inc(nPage);
        if nPage > 1 then
          nMaxPgLines := 52;
        TextRC[iRow, nMaxCol] := 'Лист ' + IntToStr(nPage);
        SetSelection(iRow, nMaxCol, iRow, nMaxCol);
        SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
      end;
    end;
    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    procedure Shap2VedBnk(F6B : TF6Book; nY, nM : word;
                                                   var iRow, iCol : integer);
    begin
      with F6B do begin
        Inc(iRow);
        iCol := 1;
        TextRC[iRow, iCol] := '№ п/п';
        Inc(iCol);
        if nKdBnk = 113 then
          TextRC[iRow, iCol] := '№ карткового рахунку'
        else
          TextRC[iRow, iCol] := '№ карткового рахунку';
        if nKdBnk = 117 then begin
          Inc(iCol);
          TextRC[iRow, iCol] := 'Ідентифікаційний код';
        end;
        Inc(iCol);
        TextRC[iRow, iCol] := 'Сума зарахування';
        Inc(iCol);
        TextRC[iRow, iCol] := 'Прiзвище, iм''я та по батьковi';
        RowHeight[iRow] := Round(2 * nMyConst);
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
        SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
      end;
    end;
    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
begin
  Screen.Cursor := crHourGlass;
  FormZpCmnPrt := TFormZpCmnPrt.Create(Application);
  with FormZpCmnPrt, F6B do begin
    PgSetup := CreateNewPageSetup;
    SetPageParams(PgSetup);
    SetPageSetup(PgSetup);
    nMyConst := RowHeight[1];
    if nKdBnk = 117 then
      nMaxCol := 5
    else
      nMaxCol := 4;
    ShowGridLines    := false;
    ShowColHeading   := true;
    ShowRowHeading   := true;
    ShowZeroValues   := false;
    ShowTabs         := 0;
    PrintNoColor     := true;
    PrintGridLines   := false;
    PrintFooter      := '';
    PrintHeader      := '';
    PrintLandscape   := false;
    DefaultFontCharSet := F1RussianCharSet;
    // DefaultFontSize := 10;
    DefaultFontSize := 8;

    iCol := 1;
    ColWidth[iCol] := Round(6 * nMyConst);   // № п/п

    Inc(iCol);
    if (nKdBnk = 112) or (nKdBnk = 117) then begin
      // ColWidth[iCol] := Round(25 * nMyConst);  // ЛицСчёт
      ColWidth[iCol] := Round(31 * nMyConst);  // ЛицСчёт
    end else
      ColWidth[iCol] := Round(16 * nMyConst);

    if nKdBnk = 117 then begin // Идент.налог.код
      Inc(iCol);
      ColWidth[iCol] := Round(16 * nMyConst);
    end;

    Inc(iCol);
    ColWidth[iCol] := Round(18 * nMyConst);  // Сумма
    Inc(iCol);
    ColWidth[iCol] := Round(50 * nMyConst);  // ФИО

    nMaxPgLines := 47;
    iRow := 1;
    iCol := 1;
    nPage := 0;
    DecodeDate(dVedDtProc, nY, nM, nD);
    cDirBnk := 'c:\T_E_M_P\BZpl' + IntToStr(nKdBnk) + '\' + IntToStr(nY) + '_';
    if nM < 10 then
      cDirBnk := cDirBnk + '0';
    cDirBnk := cDirBnk + IntToStr(nM) + '\';
    if not DirectoryExists(cDirBnk) then
      ForceDirectories(cDirBnk);
    if nKdBnk = 101 {ИмексБанк} then begin
      cNmFileOpu := GetNameFileOpu(dDtPrdFile, nNrPrdFile);
      cNmFileOpu := cDirBnk + cNmFileOpu + '.z';
      if nNrPrdFile < 10 then
        cNmFileOpu := cNmFileOpu + '0';
      cNmFileOpu := cNmFileOpu + IntToStr(nNrPrdFile);
      AssignFile(F1, cNmFileOpu);
      Rewrite(F1);
    end;
    cNmBnk := DmMain.KdBnk2NmBnk(nKdBnk, cShBnk);
    TextRC[iRow, nMaxCol] := cNmBnk;
    SetSelection(iRow, nMaxCol, iRow, nMaxCol);
    SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
    FontUnderLine := true;
    DecodeDate(dVedDtProc, nY, nM, nD);
    Shap1VedBnk(F6B, nY, nM, iRow, iCol);
    Shap0VedBnk(F6B, nY, nM, iRow, iCol);
    Inc(iRow);
    Shap2VedBnk(F6B, nY, nM, iRow, iCol);

    with cdsPrt do begin
      Filtered := false;
      Filter := 'KdBnk = ' + IntToStr(nKdBnk);
      Filtered := true;
      First;
      //nSvNr := FieldByName('NR').AsInteger;
      DisableControls;
      nPp := 0;
      nSmTt := 0;
      nCntPgLines := 0;
      // Запоминаю положение 1 строки банка и делаю два прохода
      // 1-й печать xls-файла и подсчёт итогов для 1-й строки ДОС-файла
      // 2-й формирование ДОС-файла для банка
      nSvNR2 := FieldByName('NR').AsInteger;
      while (FieldByName('KdBnk').AsInteger = nKdBnk) and not Eof do begin
        if nCntPgLines >= nMaxPgLines then begin
          Inc(iRow);
          AddRowPageBreak(iRow);
          nCntPgLines := 0;
          Shap1VedBnk(F6B, nY, nM, iRow, iCol);
          Shap2VedBnk(F6B, nY, nM, iRow, iCol);
        end;
        Inc(iRow);
        Inc(nPp);
        Inc(nCntPgLines);

        iCol := 1;
        NumberRC[iRow, iCol{1}] := nPp;

        Inc(iCol);
        if nKdBnk = 113 then begin
          TextRC[iRow, iCol{2}] := FieldByName('LicSch').AsString; // ('ID').AsString;
          SetSelection(iRow, iCol{2}, iRow, iCol{2});
          SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0); end
        else
          TextRC[iRow, iCol{2}] := FieldByName('LicSch').AsString;

        if nKdBnk = 117 then begin
          Inc(iCol);
          TextRC[iRow, iCol{3}] := FieldByName('ID').AsString;
          SetSelection(iRow, iCol{3}, iRow, iCol{3});
          SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);
        end;

        Inc(iCol);
        NumberRC[iRow, iCol{4}] := -FieldByName('Summa').AsFloat;
        nSmTt := nSmTt - FieldByName('Summa').AsFloat;
        SetSelection(iRow, iCol{4}, iRow, iCol{4});
        FormatFixed2;

        Inc(iCol);
        cMsg := FieldByName('Fam').AsString + ' ' +
          FieldByName('Ima').AsString + ' ' +
          FieldByName('Otch').AsString;
        SetSelection(iRow, iCol{4}, iRow, iCol{4});
        TextRC[iRow, iCol{5}] := cMsg;

        SetSelection(iRow, 1, iRow, nMaxCol);
        SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
        Next;
      end;

      Locate('NR', nSvNr2, []);
      if (nKdBnk = 101) {ИмексБанк} then begin
        cMsg := DateToStr(dDtPrdFile) + ';' + IntToStr(nPp) + ';' +
                 FloatToStrF(nSmTt, ffFixed, 18, 2);
        WriteLn(F1, cMsg);
        while (FieldByName('KdBnk').AsInteger = nKdBnk) and not Eof do begin
          cMsg := FieldByName('LicSch').AsString + ';' +
                  FieldByName('ID').AsString + ';' +
                  Trim(FieldByName('Fam').AsString + ' ' +
                              FieldByName('Ima').AsString + ' ' +
                                      FieldByName('Otch').AsString) + ';' +
                  FloatToStrF(-FieldByName('Summa').AsFloat, ffFixed, 18, 2) +
                  ';' + cNmPrdDoc;

          cMsg := MyAnsiToOEM(cMsg);
          WriteLn(F1, cMsg);
          Next;
        end;
        CloseFile(F1); end
      else if (nKdBnk = 117) {т.е. Пивденний } then begin
//=============================================================================
        DecodeDate(dDtPrdFile, nY, nM, nD);
        cNmSibBnkDbf := {'onpu' +} Copy(IntToStr(nY), 3, 2);
        if nM < 10 then
          cNmSibBnkDbf := cNmSibBnkDbf + '0';
        cNmSibBnkDbf := cNmSibBnkDbf + IntToStr(nM);
        if nD < 10 then
          cNmSibBnkDbf := cNmSibBnkDbf + '0';
        cNmSibBnkDbf := cNmSibBnkDbf + IntToStr(nD);
        if nNrPrdFile < 10 then
          cNmSibBnkDbf := cNmSibBnkDbf + '0';
        cNmSibBnkDbf := cNmSibBnkDbf + IntToStr(nNrPrdFile);
        cNmSibBnkDbf := cNmSibBnkDbf + '.txt';

        if FileExists(cDirBnk + cNmSibBnkDbf) then
          DeleteFile(cDirBnk + cNmSibBnkDbf);
        AssignFile(OutFTxt, cDirBnk + cNmSibBnkDbf);
        Rewrite(OutFTxt);

        nNstr        := 0;
        nSmtt        := 0;
        while (FieldByName('KdBnk').AsInteger = nKdBnk) and not Eof do begin
          Str(Abs(FieldByName('Summa').Value):12:2,cwstr);
          If length(cwstr) < 12 then begin
            cTempl := '            ';
            setLength(cTempl, 12-length(cwstr));
            cwstr  :=  cTempl + cwstr;
          end;
          cWStr    :=  FieldByName('LicSch').AsString + cwstr;
          WriteLn(OutFTxt, cWstr);
          nSmtt := nSmtt + Abs(FieldByName('Summa').Value);
          inc(nNstr);
          Next;
        end;
        CloseFile(OutFTxt);

        Str(nSMtt:12:2,cSumtt);

        obTSl := TstringList.Create;
        obTSl.Clear;
        obTSl.LoadFromFile(cDirBnk + cNmSibBnkDbf);
        obTSl.Insert(0,'43861328' + cSumtt);

        obTSl.SaveToFile(cDirBnk + cNmSibBnkDbf);
        obTSl.Free;
      end
      else if (nKdBnk <> 113) {т.е. УкрСибБанк и другие} then begin
        // Создать файл .dbf из шаблона Sib_Bank.dbf и заполнить его данными
        //cNmSibBnkDbf := 'onpu0904_3.dbf';
        DecodeDate(dDtPrdFile, nY, nM, nD);
        cNmSibBnkDbf := {'onpu' +} Copy(IntToStr(nY), 3, 2);
        if nM < 10 then
          cNmSibBnkDbf := cNmSibBnkDbf + '0';
        cNmSibBnkDbf := cNmSibBnkDbf + IntToStr(nM);
        if nD < 10 then
          cNmSibBnkDbf := cNmSibBnkDbf + '0';
        cNmSibBnkDbf := cNmSibBnkDbf + IntToStr(nD);
        if nNrPrdFile < 10 then
          cNmSibBnkDbf := cNmSibBnkDbf + '0';
        cNmSibBnkDbf := cNmSibBnkDbf + IntToStr(nNrPrdFile);
        cNmSibBnkDbf := cNmSibBnkDbf + '.dbf';
        CreSibBankDbf(cDirBnk + cNmSibBnkDbf);
        if FileExists(cDirBnk + cNmSibBnkDbf) then begin
          if tblSibBnk.Active then
            tblSibBnk.Close;
          tblSibBnk.DatabaseName := cDirBnk;
          tblSibBnk.TableName := cNmSibBnkDbf;
          tblSibBnk.EmptyTable;
          tblSibBnk.Open;
          while not tblSibBnk.Eof do begin
            tblSibBnk.Delete;
          end;
          nPpSib := 0;
          while (FieldByName('KdBnk').AsInteger = nKdBnk) and not Eof do begin
            Inc(nPpSib);
            tblSibBnk.Append;
            tblSibBnk.FieldByName('Tran_Date').AsDateTime := Date;
            tblSibBnk.FieldByName('Slip_Nr').AsString := IntToStr(nPpSib);
            tblSibBnk.FieldByName('Tran_Type').AsString := '20';
            tblSibBnk.FieldByName('Card_Acct').AsString :=
                                           FieldByName('LicSch').AsString;
            tblSibBnk.FieldByName('Amount').AsFloat :=
                                             -FieldByName('Summa').AsFloat;
            tblSibBnk.FieldByName('Currency').AsString := 'UAH';
            tblSibBnk.Post;
            Next;
          end;
          tblSibBnk.Close;
        end;
      end
      else if (nKdBnk = 113) {ПриватБанк} then begin
        DecodeDate(dDtPrdFile, nY, nM, nD);
        cNmPrvBnkDbf := Copy(IntToStr(nY), 3, 2);
        //cNmPrvBnkDbf := 'pb';
        if nM < 10 then
          cNmPrvBnkDbf := cNmPrvBnkDbf + '0';
        cNmPrvBnkDbf := cNmPrvBnkDbf + IntToStr(nM);
        if nD < 10 then
          cNmPrvBnkDbf := cNmPrvBnkDbf + '0';
        cNmPrvBnkDbf := cNmPrvBnkDbf + IntToStr(nD);
        if nNrPrdFile < 10 then
          cNmPrvBnkDbf := cNmPrvBnkDbf + '0';
        cNmPrvBnkDbf := cNmPrvBnkDbf + IntToStr(nNrPrdFile);
        cNmPrvBnkDbf := cNmPrvBnkDbf + '.dbf';

        // Создать файл .dbf из шаблона Prv_Bank.dbf и заполнить его данными
        CrePrvBankDbf(cDirBnk + cNmPrvBnkDbf);

        if FileExists(cDirBnk + cNmPrvBnkDbf) then begin
          with TblPrvBnk do begin
            if Active then
              Close;
            DatabaseName := cDirBnk;
            TableName := cNmPrvBnkDbf;
            EmptyTable;
            Open;

            while (CdsPrt.FieldByName('KdBnk').AsInteger = nKdBnk)
              and not CdsPrt.Eof do
            begin
              Append;
              // 29-05-2025, Оксана + приватбанковец, шаблон Prv_Bank.dbf:
              // удаляем поля Branch и ZpKod
              // FieldByName('Branch').AsString := '86W';
              // FieldByName('ZpKod').AsString := '00L';
              // добавляем INN Char(10), оно будет дублировать поле LsTbl
              FieldByName('INN').AsString :=
                CdsPrt.FieldByName('LicSch').AsString;
              FieldByName('LsTbl').AsString :=
                CdsPrt.FieldByName('LicSch').AsString;
              FieldByName('RlSum').AsFloat :=
                -CdsPrt.FieldByName('Summa').AsFloat;
              Post;

              CdsPrt.Next;
            end;

            Close;
          end;
        end;
      end;

      Filtered := false;
      Filter := '';
      EnableControls;
    end;
    if nSmTt <> 0 then begin
      Inc(iRow);
      TextRC[iRow, 1] := 'Всього по вiдомостi:';
      SetSelection(iRow, 1, iRow, 2);
      SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignBottom, 0);
      NumberRC[iRow, nMaxCol - 1] := nSmTt;
      SetSelection(iRow, nMaxCol - 1, iRow, nMaxCol - 1);
      FormatFixed2;
      SetSelection(iRow, 1, iRow, nMaxCol);
      FontBold := true;
      SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
    end;

    Inc(iRow, nMaxCol);
    TextRC[iRow, nMaxCol] :=
      'Керiвник органiзацiї ____________________________';
    SetSelection(iRow, nMaxCol, iRow, nMaxCol);
    SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);

    Inc(iRow);
    TextRC[iRow, 2] := 'М. П.';
    SetSelection(iRow, 2, iRow, 2);
    SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);

    Inc(iRow);
    TextRC[iRow, nMaxCol] := 'Головний бухгалтер ____________ ' +
      Form_Dm.KdUsr2FioUsr(109);
    SetSelection(iRow, nMaxCol, iRow, nMaxCol);
    SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);

    Inc(iRow, 2);
    if cBuhDolgn <> '' then
      cMsg := cBuhDolgn + '  ___________  ' + cBuhFIO
    else
      cMsg := 'Бухгалтер ______________________ ' + Form_Dm.KdUsr2FioUsr(nAppKdUsr);
    TextRC[iRow, nMaxCol] := cMsg;
    SetSelection(iRow, nMaxCol, iRow, nMaxCol);
    SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);

    Inc(iRow, 3);
    TextRC[iRow, 2] := 'Вiдмiтки Банку:';
    SetSelection(iRow, 2, iRow, 2);
    FontUnderLine := true;

    if nKdBnk = 117 then begin
      Inc(iRow);
      TextRC[iRow, nMaxCol - 1] := 'Дата приймання Зведеної вiдомостi на паперовому';
      Inc(iRow);
      TextRC[iRow, nMaxCol - 1] := 'та магнiтному носiї';
      SetSelection(iRow-1, nMaxCol - 1, iRow, nMaxCol - 1);
      SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
    end else begin
      TextRC[iRow, nMaxCol - 1] := 'Дата приймання Зведеної вiдомостi на паперовому';
      Inc(iRow);
      TextRC[iRow, nMaxCol - 1] := 'та магнiтному носiї';
      SetSelection(iRow-1, nMaxCol - 1, iRow, nMaxCol - 1);
      SetAlignment(F1HAlignLeft, false, F1VAlignBottom, 0);
      Inc(iRow);
    end;

    TextRC[iRow, nMaxCol] := ' "___"__________ 200__р.';
    SetSelection(iRow, nMaxCol, iRow, nMaxCol);
    SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);
    Inc(iRow, 2);
    TextRC[iRow, 2] := 'Пiдпис __________________________';
    Inc(iRow);
    AddRowPageBreak(iRow);
    Screen.Cursor := crHourGlass;
    cRandomFileName := RandomFileName;
    if bAppDocsToExcel then begin
      cRandomFileName := cRandomFileName + '.xls';
      WriteEx(cDirTemp + cRandomFileName, F1FileExcel97); end
    else begin
      cRandomFileName := cRandomFileName + '.vts';
      WriteEx(cDirTemp + cRandomFileName, F1FileFormulaOne6);
    end;
    Screen.Cursor := crDefault;
    Free;
  end;
  MyPreView(cDirTemp, cRandomFileName);
end;
