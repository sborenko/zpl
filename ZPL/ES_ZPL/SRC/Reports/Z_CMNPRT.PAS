            TextRC[iRow, 1] := 'Всього обов`язкових платежів до рівня ' +
                                                'мінімальної з/пл:';
            SetSelection(iRow, 1, iRow, 7);
            SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignBottom, 0);
            FontItalic := true;
            SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
            NumberRC[iRow, 8] := nEsvPrpDoMinZp;
            SetSelection(iRow, 8, iRow, 8);
            FormatFixed2;
            SetSelection(iRow, 1, iRow, nMaxCol);
            FontItalic := true;
            SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
          end;
          Inc(iRow);
          RowHeight[iRow] := Round(0.3 * nMyConst);
          SetSelection(iRow, 1, iRow, nMaxCol);
          SetBorder(1,0,0,0,0,0,clBlack,clBlack,clBlack,clBlack,clBlack);
          Inc(iRow);
          SetSelection(iRow, 1, iRow, nMaxCol-1);
          SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignBottom, 0);
          TextRC[iRow, 1] := 'Всього обов`язкових платежів:';
          FontBold := true;
          nSmPrpItg := nSmPrpItg + nEsvPrpDoMinZp;
          NumberRC[iRow, 8] := nSmPrpItg;
          SetSelection(iRow, 8, iRow, 8);
          FormatFixed2;
          SetSelection(iRow, 1, iRow, nMaxCol);
          FontBold := true;
          SetSelection(iRow, 1, iRow, nMaxCol);
          SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
          Inc(iRow);
          RowHeight[iRow] := Round(0.3 * nMyConst);
          SetSelection(iRow, 1, iRow, nMaxCol);
          SetBorder(1,0,0,0,0,0,clBlack,clBlack,clBlack,clBlack,clBlack);
          Inc(iRow);
          RowHeight[iRow] := Round(1.5 * nMyConst);
          cMsg := 'Всього обертів за М/О';
