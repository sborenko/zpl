procedure F6_PrtBankVedZp(cNmBank : string; dDtProc : TDateTime;
                                        dtsTmp : TDataSet; bPrtZero : boolean);
var iRow, nStartRow, nMyConst, nPp,
    nCntRec, nMaxCol, nSvTabN, nKopeek : integer;
    nY, nM, nD : word;
    cMsg : string;
    nSmNaRuki, nSmVed : double;
begin
  Screen.Cursor := crHourGlass;
  FormZpCmnPrt := TFormZpCmnPrt.Create(Application);
  with FormZpCmnPrt, F6B do begin
    DecodeDate(dDtProc, nY, nM, nD);
    nMyConst := RowHeight[1];
    ShowGridLines    := false;
    ShowColHeading   := true;
    ShowRowHeading   := true;
    ShowZeroValues   := false;
    ShowTabs         := 0;
    PrintNoColor     := true;
    PrintGridLines   := false;
    PrintFooter      := '';
    PrintHeader      := '';
    PrintLandscape   := false;
    DefaultFontCharSet := F1RussianCharSet;
    DefaultFontSize := 10;
    nMaxCol := 5;
    ColWidth[1] := Round(4 * nMyConst);      // № п/п
    ColWidth[2] := Round(5 * nMyConst);      // ТабН
    ColWidth[3] := Round(15 * nMyConst);     // Лиц.счёт
    ColWidth[4] := Round(35 * nMyConst);     // ФамИО
    ColWidth[5] := Round(11 * nMyConst);     // Сумма
    iRow := 1;
    with dtsTmp do begin
      nSvTabN := FieldByName('TabN').AsInteger;
      DisableControls;
      First;
      nCntRec := 0;
      if cFirma <> '' then
        cMsg := cFirma
      else
        cMsg := 'Фирма ____________';
      TextRC[iRow, nMaxCol] := cMsg;
      SetSelection(iRow, nMaxCol, iRow, nMaxCol);
      FontUnderLine := true;
      SetAlignment(F1HAlignRight, false, F1VAlignCenter, 0);
      Inc(iRow);
      TextRC[iRow, nMaxCol] := cNmBank;
      SetSelection(iRow, nMaxCol, iRow, nMaxCol);
      FontUnderLine := true;
      SetAlignment(F1HAlignRight, false, F1VAlignCenter, 0);
      Inc(iRow);
      TextRC[iRow, 1] := 'Ведомость зарплаты для банка';
      Inc(iRow);
      cMsg := 'за ' + MesRus(nM) + ' ' + IntToStr(nY) + ' г.';
      TextRC[iRow, 1] := cMsg;
      SetSelection(iRow-1, 1, iRow, nMaxCol);
      SetAlignment(F1HAlignCenterAcrossCells, false,
                                               F1VAlignCenter, 0);
      FontBold := true;
      Inc(iRow);
      TextRC[iRow, 1] := '№ п/п';
      TextRC[iRow, 2] := 'Таб. н-р';
      TextRC[iRow, 3] := 'Лицевой счёт';
      TextRC[iRow, 4] := 'Фамилия Имя Отчество';
      TextRC[iRow, 5] := 'Сумма';
      RowHeight[iRow] := Round(2.2 * nMyConst);
      SetSelection(iRow, 1, iRow, nMaxCol);
      SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
      nStartRow := iRow;
      nPp := 0;
      nSmVed := 0;
      while not Eof do begin
        nSmNaRuki := RoundTo(FieldByName('SumNU').AsFloat, -2);
        if not bPrtZero and (nSmNaRuki = 0) then begin
          Next;
          Continue;
        end;
        Inc(iRow);
        Inc(nPp);
        NumberRC[iRow, 1] := nPp;
        NumberRC[iRow, 2] := FieldByName('TabN').AsInteger;
        TextRC[iRow, 3] := FieldByName('LicSch').AsString;
        TextRC[iRow, 4] := FieldByName('FamIO').AsString;
        NumberRC[iRow, 5] := nSmNaRuki;
        nSmVed := nSmVed + nSmNaRuki;
        SetSelection(iRow, 5, iRow, 5);
        FormatFixed2;
        nCntRec := nCntRec + 1;
        Next;
      end;
      Inc(iRow);
      TextRC[iRow, 3] := 'Итого:';
      SetSelection(iRow, 3, iRow, 3);
      SetAlignment(F1HAlignCenter, false, F1VAlignCenter, 0);
      NumberRC[iRow, 5] := nSmVed;
      SetSelection(iRow, 5, iRow, 5);
      FormatFixed2;
      SetSelection(nStartRow, 1, iRow, nMaxCol);
      SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
      SetColWidthAuto(nStartRow+1, 5, iRow, 5, false);
      if nCntRec <> 0 then begin
        iRow := iRow + 2;
        TextRC[iRow, 1] := 'Всего по ведомости:';
        Inc(iRow);
        cMsg := SumPropis(nSmVed, 'w', nKopeek);
        if cMsg <> '' then
          cMsg := AnsiUpperCase(Copy(cMsg, 1, 1)) +
                              Copy(cMsg, 2, Length(cMsg)) + ' грн., '
        else
          cMsg := 'Ноль грн., ';
        if nKopeek <> 0 then begin
          if nKopeek < 10 then
            cMsg := cMsg + '0';
          cMsg := cMsg + IntToStr(nKopeek) + ' коп.'; end
        else
          cMsg := cMsg + '00 коп.';
        SetSelection(iRow, 2, iRow, nMaxCol);
        mCellFormat := CreateNewCellFormat;
        mCellFormat.AlignHorizontal := F1HAlignGeneral;
        mCellFormat.AlignVertical := F1VAlignCenter;
        mCellFormat.MergeCells := true;
        mCellFormat.WordWrap   := true;
        mCellFormat.FontBold   := true;
        SetCellFormat(mCellFormat);
        TextRC[iRow, 2] := cMsg;
        iRow := iRow + 2;
        if cDirDolgn <> '' then
          cMsg := cDirDolgn + ' ____________  ' + cDirFIO
        else
          cMsg := 'Руководитель ____________  ____________';
        TextRC[iRow, nMaxCol] := cMsg;
        iRow := iRow + 2;
        if cGlBuhDolgn <> '' then
          cMsg := cGlBuhDolgn + ' ____________  ' + cGlBuhFIO
        else
          cMsg := 'Бухгалтер ____________ ' + Form_Dm.KdUsr2FioUsr(nAppKdUsr);
        TextRC[iRow, nMaxCol] := cMsg;
        SetSelection(iRow-2, nMaxCol, iRow, nMaxCol);
        SetAlignment(F1HAlignRight, false, F1VAlignCenter, 0);
      end;
      Locate('TabN', nSvTabN, []);
      EnableControls;
    end;
    cRandomFileName := RandomFileName;
    if bAppDocsToExcel then begin
      cRandomFileName := cRandomFileName + '.xls';
      WriteEx(cDirTemp + cRandomFileName, F1FileExcel97); end
    else begin
      cRandomFileName := cRandomFileName + '.vts';
      WriteEx(cDirTemp + cRandomFileName, F1FileFormulaOne6);
    end;
    Screen.Cursor := crDefault;
    Free;
  end;
  Screen.Cursor := crDefault;
  MyPreView(cDirTemp, cRandomFileName);
end;
