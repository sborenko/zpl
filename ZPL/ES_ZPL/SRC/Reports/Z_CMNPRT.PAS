var nSvTabN, iRow, nMaxCol, nMyConst, nPp : integer;
    nCntPgLn, nMaxCntPgLn, nPg : SmallInt;
    cMsg : ShortString;
    PgSetup : F1PageSetup; nY, nM, nD : word;
    nSmDoplat, nSmUderg : double;
    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    procedure Shapka(F6B : TF6Book; var iRow : integer);
    begin
      with F6B do begin
        Inc(iRow);
        Inc(nPg);
        if nPg = 1 then
          TextRC[iRow, 1] := DateToStr(Date);
        TextRC[iRow, nMaxCol] := 'Стр. ' + IntToStr(nPg);
        SetSelection(iRow, nMaxCol, iRow, nMaxCol);
        SetAlignment(F1HAlignRight, true, F1VAlignCenter, 0);
        Inc(iRow);
        Inc(nCntPgLn, 2);
        TextRC[iRow, 1] := '№№ п/п';
        TextRC[iRow, 2] := 'Таб. номер';
        TextRC[iRow, 3] := 'Фамилия И.О.';
        TextRC[iRow, 4] := 'Базовый месяц';
        TextRC[iRow, 5] := 'Старая сумма индекс.';
        TextRC[iRow, 6] := 'Новая сумма индекс.';
        TextRC[iRow, 7] := 'Доплата';
        TextRC[iRow, 8] := 'Удержание';
        TextRC[iRow, 9] := 'Примечание';
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
        SetBorder(1, 1, 1, 1, 1, 0, clBlack,clBlack,clBlack,clBlack,clBlack);
      end;
    end;
begin
  Screen.Cursor := crHourGlass;
  FormZpCmnPrt := TFormZpCmnPrt.Create(Application);
  with FormZpCmnPrt, F6B do begin
    PgSetup := CreateNewPageSetup;
    SetPageParams(PgSetup);
    SetPageSetup(PgSetup);
    nMyConst := RowHeight[1];
    ShowGridLines    := false;
    ShowColHeading   := true;
    ShowRowHeading   := true;
    ShowZeroValues   := false;
    ShowTabs         := 0;
    PrintNoColor     := true;
    PrintGridLines   := false;
    PrintFooter      := '';
    PrintHeader      := '';
    PrintLandscape   := false;
    DefaultFontCharSet := F1RussianCharSet;
    DefaultFontSize := 9;
    nMaxCol := 9;
    nMaxCntPgLn := 59;
    nCntPgLn := 0;
    nPg := 0;
    iRow := 1;
    ColWidth[1]  := Round( 6 * nMyConst);  // №№ п/п
    ColWidth[2]  := Round( 6 * nMyConst);  // ТабНр
    ColWidth[3]  := Round(25 * nMyConst);  // ФИО
    ColWidth[4]  := Round(10 * nMyConst);  // Базовый месяц
    ColWidth[5]  := Round(12 * nMyConst);  // Старая сумма
    ColWidth[6]  := Round(12 * nMyConst);  // Новая сумма
    ColWidth[7]  := Round(12 * nMyConst);  // Доначислть
    ColWidth[8]  := Round(12 * nMyConst);  // Удержать
    ColWidth[9]  := Round(15 * nMyConst);  // Примечание
    Inc(iRow);
    Inc(nCntPgLn);
    DecodeDate(dDtZaMG, nY, nM, nD);
    cMsg := 'Протокол перерасчёта индексации за ' + MesRus(nM) + ' ' +
                                     IntToStr(nY) + ' г.';
    TextRC[iRow, 1] := cMsg;
    SetSelection(iRow, 1, iRow, nMaxCol);
    FontBold := true;
    FontUnderLine := true;
    SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignBottom, 0);
    nSmDoplat := 0;
    nSmUderg  := 0;
    nPp := 0;
    with cdsPRs do begin
      nSvTabN := FieldByName('TabN').AsInteger;
      DisableControls;
      First;
      Shapka(F6B, iRow);
      while not Eof do begin
        if FieldByName('SmRazn').AsFloat <> 0 then begin
          Inc(nCntPgLn);
          if nCntPgLn > nMaxCntPgLn then begin
            Inc(iRow);
            AddRowPageBreak(iRow);
            nCntPgLn := 0;
            Shapka(F6B, iRow);
            //Inc(iRow);
          end;
          Inc(iRow);
          Inc(nPp);
          NumberRC[iRow, 1] := nPp;
          NumberRC[iRow, 2] := FieldByName('TabN').AsInteger;
          cMsg := FieldByName('FamIO').AsString;
          TextRC[iRow, 3] := cMsg;
          if Length(cMsg) > 20 then begin
            SetSelection(iRow, 3, iRow, 3);
            FontSize := 8;
          end;
          if not FieldByName('BazMes').IsNull then
            TextRC[iRow, 4] := Copy(FieldByName('BazMes').AsString, 4, 7);
          NumberRC[iRow, 5] := FieldByName('OldSmIndx').AsFloat;
          NumberRC[iRow, 6] := FieldByName('SmIndx').AsFloat;
          if FieldByName('SmRazn').AsFloat > 0 then begin
            NumberRC[iRow, 7] := FieldByName('SmRazn').AsFloat;
            nSmDoplat := nSmDoplat + FieldByName('SmRazn').AsFloat; end
          else if FieldByName('SmRazn').AsFloat < 0 then begin
            NumberRC[iRow, 8] := -FieldByName('SmRazn').AsFloat;
            nSmUderg := nSmUderg - FieldByName('SmRazn').AsFloat;
          end;
          SetSelection(iRow, 5, iRow, 8);
          FormatFixed2;
          SetSelection(iRow, 1, iRow, nMaxCol);
          SetBorder(1, 1, 1, 1, 1, 0, clBlack,clBlack,clBlack,clBlack,clBlack);
        end;
        Next;
      end;
      Locate('TabN', nSvTabN, []);
      EnableControls;
      Inc(iRow);
      SetSelection(iRow, 1, iRow, 6);
      SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignBottom, 0);
      TextRC[iRow, 1] := 'Итого';
      NumberRC[iRow, 7] := nSmDoplat;
      NumberRC[iRow, 8] := nSmUderg;
      SetSelection(iRow, 7, iRow, 8);
      FormatFixed2;
      SetSelection(iRow, 1, iRow, nMaxCol);
      SetBorder(1, 1, 1, 1, 1, 0, clBlack,clBlack,clBlack,clBlack,clBlack);
      Inc(iRow,3);
      TextRC[iRow, nMaxCol] := 'Исполнитель ____________ ' +
                                              Form_Dm.KdUsr2FioUsr(nAppKdUsr);
      SetSelection(iRow, nMaxCol, iRow, nMaxCol);
      SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
    end;
    cRandomFileName := RandomFileName;
    if bAppDocsToExcel then begin
      cRandomFileName := cRandomFileName + '.xls';
      WriteEx(cDirTemp + cRandomFileName, F1FileExcel97); end
    else begin
      cRandomFileName := cRandomFileName + '.vts';
      WriteEx(cDirTemp + cRandomFileName, F1FileFormulaOne6);
    end;
    Screen.Cursor := crDefault;
    Free;
  end;
  MyPreView(cDirTemp, cRandomFileName);
end;
