      //SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
      //TextRC[iRow, 16] := 'Налоговый ИД: ' + cID;
      //TextRC[iRow, 29] := '2-е полугодие';
      //SetSelection(iRow, 29, iRow, 29);
      //SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
      if nPage > 1 then begin
        TextRC[iRow, 4] := 'Таб.№ ' + IntToStr(TabN) + '. ' + cFamIO;
        SetSelection(iRow, 4, iRow, 4);
        SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);
        FontBold := true;
      end;
      Inc(iRow);
      Inc(nCntPgLines);
      iCol := 1;
      TextRC[iRow, iCol] := '№ з/п';
      Inc(iCol);
      TextRC[iRow, iCol] := 'Вид';
      Inc(iCol);
