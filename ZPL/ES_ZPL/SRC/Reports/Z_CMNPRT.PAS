//------------------------------------------------------------------------------
procedure F6PrintMoTable(
  qryVidN, qryNU: TDataSet;
  cSchNo: string;
  dDtProc: TDateTime;
  cdsEmployeeDeductions, cdsDeductionTotals: TClientDataSet);
const
  NPP_COL = 1;
  TABN_COL = 2;
  FIO_COL = 3;
  ADDITIONS_COL = 4;
  FIRST_DEDUCT_COL = 5;
  DEDUCTIONS_COL_OFFSET = 2;
  TRANSFER_COL_OFFSET = 1;
  BANKS_COL_OFFSET = 0;
var
  nYear, nMonth, nDummyWord: word;
  nDeductCount: integer;
  iRow, iCol, nMaxCol, i: integer;
  nWidthUnit: integer;
  cFileName: string;
  nTabN: integer;
  cFam, cIma, cOtch: string;
  nEmployeeAdditions, nEmployeeDeductions, nEmployeeBank,
  nAdditionsTotal, nDeductionsTotal, nBankTotal: double;
  nOrder: integer;
  cVidN: string;
  nVidNIndex: integer;
  nSum: double;
  PgSetup : F1PageSetup;
  cBanks: string;

  function IsAddition(cVidN: string): boolean;
  begin
    Result := cVidN < '5000';
  end;

  function IsDeduction(cVidN: string): boolean;
  begin
    Result := (cVidN >= '6000') and (cVidN < '7500');
  end;

  function IsTransfer(cVidN: string): boolean;
  begin
    Result := (cVidN >= '7500') and (cVidN < '8600');
  end;

  function CountDeductions: integer;
  begin
    Result := 0;
    with qryVidN do begin
      First;
      while not EoF do begin
        if IsDeduction(FieldByName('VidN').AsString) then
          Inc(Result);
        Next;
      end;
    end;
  end;

  function DeductVidNIndex(cDeductVidN: string): integer;
  var
    cVidN: string;
  begin
    Result := 1;
    with qryVidN do begin
      First;
      while not EoF do begin
        cVidN := FieldByName('VidN').AsString;
        if IsDeduction(cVidN) then begin
          if cVidN = cDeductVidN then
            break;
          Inc(Result);
        end;
        Next;
      end;
    end;
  end;

  procedure IncrementSum(cds: TClientDataSet; iIndex: integer; nSum: double);
  var
    i: integer;
  begin
    with cds do begin
      if iIndex < RecordCount then begin
        First;
        i := 1;
        while i < iIndex do begin
          Next;
          Inc(i);
        end;
      end else begin
        Last;
        i := RecordCount;
        while i < iIndex do begin
          Append;
          FieldByName('Sum').AsFloat := 0;
          Post;
          Inc(i);
        end;
      end;
      Edit;
      FieldByName('Sum').AsFloat := FieldByName('Sum').AsFloat + nSum;
      Post;
    end;
  end;

begin
  Screen.Cursor := crHourGlass;
  FormZpCmnPrt := TFormZpCmnPrt.Create(Application);
  with FormZpCmnPrt, F6B do begin
    PgSetup := CreateNewPageSetup;
    SetPageParams(PgSetup);
    SetPageSetup(PgSetup);
    ShowGridLines    := false;
    ShowColHeading   := true;
    ShowRowHeading   := true;
    ShowZeroValues   := false;
    ShowTabs         := 0;
    PrintNoColor     := true;
    PrintGridLines   := false;
    PrintFooter      := '';
    PrintHeader      := '';
    PrintLandscape   := true;
    DefaultFontSize  := 9;
    DefaultFontCharSet := F1RussianCharSet;
    
    nDeductCount := Max(CountDeductions, 1);
    nMaxCol := 7 + nDeductCount;

    nWidthUnit     := RowHeight[1];
    ColWidth[1]  := Round(5 * nWidthUnit);  // № п/п
    ColWidth[2]  := Round(10 * nWidthUnit);  // Таб.№
    ColWidth[3]  := Round(35 * nWidthUnit);  // ФИО
    ColWidth[4]  := Round(13 * nWidthUnit);  // Начислено
    iCol := FIRST_DEDUCT_COL;
    for i := 1 to nDeductCount do begin
      ColWidth[iCol] := Round(12 * nWidthUnit);  // Удержано по виду
      Inc(iCol);
    end;
    ColWidth[nMaxCol - DEDUCTIONS_COL_OFFSET] := Round(13 * nWidthUnit); // Удержано всего
    ColWidth[nMaxCol - TRANSFER_COL_OFFSET] := Round(13 * nWidthUnit);  // Перечислено в банк
    ColWidth[nMaxCol - BANKS_COL_OFFSET] := Round(15 * nWidthUnit);  // Название банка

    iRow := 1;

    DecodeDate(dDtProc, nYear, nMonth, nDummyWord);

    SetSelection(iRow, NPP_COL, iRow, nMaxCol);
    SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
    FontBold := true;
    FontUnderLine := true;
    TextRC[iRow, NPP_COL] := 'Набор по сч. ' + cSchNo +
      ' за ' + UkrMes(nMonth) + ' ' + IntToStr(nYear) + 'г.';

    Inc(iRow, 2);
    iCol := NPP_COL;
    SetSelection(iRow, iCol, iRow + 1, iCol);
    SetBorder(1,0,0,0,0,0,clBlack,clBlack,clBlack,clBlack,clBlack);
    SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
    TextRC[iRow, iCol] := '№ п/п';
    iCol := TABN_COL;
    SetSelection(iRow, iCol, iRow + 1, iCol);
    SetBorder(1,0,0,0,0,0,clBlack,clBlack,clBlack,clBlack,clBlack);
    SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
    TextRC[iRow, iCol] := 'Таб.№';
    iCol := FIO_COL;
    SetSelection(iRow, iCol, iRow + 1, iCol);
    SetBorder(1,0,0,0,0,0,clBlack,clBlack,clBlack,clBlack,clBlack);
    SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
    TextRC[iRow, iCol] := 'ПІБ';
    iCol := ADDITIONS_COL;
    SetSelection(iRow, iCol, iRow + 1, iCol);
    SetBorder(1,0,0,0,0,0,clBlack,clBlack,clBlack,clBlack,clBlack);
    SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
    TextRC[iRow, iCol] := 'Нарах. оплата праці';
    iCol := FIRST_DEDUCT_COL;
    SetSelection(iRow, iCol, iRow, iCol + nDeductCount - 1);
    SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
    SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
    TextRC[iRow, iCol] := 'Утримання із ЗП';
    iCol := nMaxCol - DEDUCTIONS_COL_OFFSET;
    SetSelection(iRow, iCol, iRow + 1, iCol);
    SetBorder(1,0,0,0,0,0,clBlack,clBlack,clBlack,clBlack,clBlack);
    SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
    TextRC[iRow, iCol] := 'Всього утримано із ЗП';
    iCol := nMaxCol - TRANSFER_COL_OFFSET;
    SetSelection(iRow, iCol, iRow + 1, iCol);
    SetBorder(1,0,0,0,0,0,clBlack,clBlack,clBlack,clBlack,clBlack);
    SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
    TextRC[iRow, iCol] := 'Перерах. на картки в банк';
    iCol := nMaxCol - BANKS_COL_OFFSET;
    SetSelection(iRow, iCol, iRow + 1, iCol);
    SetBorder(1,0,0,0,0,0,clBlack,clBlack,clBlack,clBlack,clBlack);
    SetAlignment(F1HAlignLeft, true, F1VAlignCenter, 0);
    TextRC[iRow, iCol] := 'Банк';

    Inc(iRow);
    iCol := FIRST_DEDUCT_COL;
    SetSelection(iRow, iCol, iRow, iCol + nDeductCount - 1);
    SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
    with qryVidN do begin
      First;
      while not EoF do begin
        if IsDeduction(FieldByName('VidN').AsString) then begin
          SetSelection(iRow, iCol, iRow, iCol);
          SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
          TextRC[iRow, iCol] := FieldByName('ShVidN').AsString;
          Inc(iCol);
        end;
        Next;
      end;
    end;

    with qryNU do begin
      First;
      nOrder := 0;
      nAdditionsTotal := 0;
      nDeductionsTotal := 0;
      nBankTotal := 0;

      while not EoF do begin
        nTabN := FieldByName('TabN').AsInteger;
        cFam := FieldByName('Fam').AsString;
        cIma := FieldByName('Ima').AsString;
        cOtch := FieldByName('Otch').AsString;

        nEmployeeAdditions := 0;
        nEmployeeDeductions := 0;
        nEmployeeBank := 0;
        cdsEmployeeDeductions.EmptyDataSet;
        cBanks := '';

        // Накопление сумм
        while (FieldByName('TabN').AsInteger = nTabN) and not EoF do begin
          cVidN := FieldByName('VidN').AsString;
          nSum := FieldByName('Summa').AsFloat;

          if IsAddition(cVidN) then
            nEmployeeAdditions := nEmployeeAdditions + nSum
          else if IsDeduction(cVidN) then begin
            nVidNIndex := DeductVidNIndex(cVidN);
            IncrementSum(cdsEmployeeDeductions, nVidNIndex, -nSum);
            IncrementSum(cdsDeductionTotals, nVidNIndex, -nSum);
            nEmployeeDeductions := nEmployeeDeductions - nSum;
          end else if IsTransfer(cVidN) then
            nEmployeeBank := nEmployeeBank - FieldByName('Summa').AsFloat;
            if (FieldByName('ShBnk').AsString <> '') and
                (Pos(FieldByName('ShBnk').AsString, cBanks) = 0) then
              cBanks := cBanks + FieldByName('ShBnk').AsString + ' ';
          Next;
        end;

        if (Abs(nEmployeeAdditions) > 0.001) or (Abs(nEmployeeDeductions) > 0.001) or
            (Abs(nEmployeeBank) > 0.001) then begin
          // Печатаем запись по сотруднику
          Inc(iRow);
          Inc(nOrder);
          TextRC[iRow, NPP_COL] := IntToStr(nOrder);
          TextRC[iRow, TABN_COL] := IntToStr(nTabN);
          TextRC[iRow, FIO_COL] := cFam + ' ' + Copy(cIma, 1, 1) + ' ' + Copy(cOtch, 1, 1);

          if nEmployeeAdditions <> 0 then begin
            SetSelection(iRow, ADDITIONS_COL, iRow, ADDITIONS_COL);
            SetAlignment(F1HAlignRight, true, F1VAlignCenter, 0);
            NumberRC[iRow, ADDITIONS_COL] := nEmployeeAdditions;
            FormatFixed2;
          end;
          iCol := FIRST_DEDUCT_COL;
          with cdsEmployeeDeductions do begin
            First;
            while not EoF do begin
              SetSelection(iRow, iCol, iRow, iCol);
              SetAlignment(F1HAlignRight, true, F1VAlignCenter, 0);
              NumberRC[iRow, iCol] := FieldByName('Sum').AsFloat;
              FormatFixed2;
              Inc(iCol);
              Next;
            end;
          end;
          iCol := nMaxCol - DEDUCTIONS_COL_OFFSET;
          if nEmployeeDeductions <> 0 then begin
            SetSelection(iRow, iCol, iRow, iCol);
            SetAlignment(F1HAlignRight, true, F1VAlignCenter, 0);
            NumberRC[iRow, iCol] := nEmployeeDeductions;
            FormatFixed2;
          end;
          iCol := nMaxCol - TRANSFER_COL_OFFSET;
          if nEmployeeBank <> 0 then begin
            SetSelection(iRow, iCol, iRow, iCol);
            SetAlignment(F1HAlignRight, true, F1VAlignCenter, 0);
            NumberRC[iRow, iCol] := nEmployeeBank;
            FormatFixed2;
          end;
          iCol := nMaxCol - BANKS_COL_OFFSET;
          SetSelection(iRow, iCol, iRow, iCol);
          SetAlignment(F1HAlignLeft, true, F1VAlignCenter, 0);
          TextRC[iRow, iCol] := cBanks;

          nAdditionsTotal := nAdditionsTotal + nEmployeeAdditions;
          nDeductionsTotal := nDeductionsTotal + nEmployeeDeductions;
          nBankTotal := nBankTotal + nEmployeeBank;
        end; {if}
      end;

      Inc(iRow);
      SetSelection(iRow, NPP_COL, iRow, FIO_COL);
      SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
      FontBold := true;
      TextRC[iRow, NPP_COL] := 'Всього:';
      SetBorder(1,0,0,0,0,0,clBlack,clBlack,clBlack,clBlack,clBlack);
      SetSelection(iRow, ADDITIONS_COL, iRow, ADDITIONS_COL);
      SetBorder(1,0,0,0,0,0,clBlack,clBlack,clBlack,clBlack,clBlack);
      if nAdditionsTotal <> 0 then begin
        SetAlignment(F1HAlignRight, true, F1VAlignCenter, 0);
        NumberRC[iRow, ADDITIONS_COL] := nAdditionsTotal;
        FormatFixed2;
      end;
      iCol := FIRST_DEDUCT_COL;
      with cdsDeductionTotals do begin
        First;
        while not EoF do begin
          SetSelection(iRow, iCol, iRow, iCol);
          SetBorder(1,0,0,0,0,0,clBlack,clBlack,clBlack,clBlack,clBlack);
          nSum := FieldByName('Sum').AsFloat;
          if nSum <> 0 then begin
            SetAlignment(F1HAlignRight, true, F1VAlignCenter, 0);
            NumberRC[iRow, iCol] := nSum;
            FormatFixed2;
          end;
          Inc(iCol);
          Next;
        end;
      end;
      iCol := nMaxCol - DEDUCTIONS_COL_OFFSET;
      SetSelection(iRow, iCol, iRow, iCol);
      SetBorder(1,0,0,0,0,0,clBlack,clBlack,clBlack,clBlack,clBlack);
      if nDeductionsTotal <> 0 then begin
        SetAlignment(F1HAlignRight, true, F1VAlignCenter, 0);
        NumberRC[iRow, iCol] := nDeductionsTotal;
        FormatFixed2;
      end;
      iCol := nMaxCol - TRANSFER_COL_OFFSET;
      SetSelection(iRow, iCol, iRow, iCol);
      SetBorder(1,0,0,0,0,0,clBlack,clBlack,clBlack,clBlack,clBlack);
      if nBankTotal <> 0 then begin
        SetAlignment(F1HAlignRight, true, F1VAlignCenter, 0);
        NumberRC[iRow, iCol] := nBankTotal;
        FormatFixed2;
      end;
      iCol := nMaxCol - BANKS_COL_OFFSET;
      SetSelection(iRow, iCol, iRow, iCol);
      SetBorder(1,0,0,0,0,0,clBlack,clBlack,clBlack,clBlack,clBlack);
    end; {while}

    cFileName := RandomFileName;

    if bAppDocsToExcel then begin
      cFileName := cFileName + '.xls';
      WriteEx(cDirTemp + cFileName, F1FileExcel97);
    end else begin
      cFileName := cFileName + '.vts';
      WriteEx(cDirTemp + cFileName, F1FileFormulaOne6);
    end;

    Free;
  end;
  Screen.Cursor := crDefault;
  MyPreView(cDirTemp, cFileName);
end;

//------------------------------------------------------------------------------
procedure TFormZpCmnPrt.GetSmByBnk(cPSCH :ShortString;
                                     dDtPrc, dDt_2009_04 : TDateTime;
                                         var nSmBnk101, nSmBnkOther : double);
var cNmViNu : ShortString;
begin
  // Тут надо при обращении к месяцам до 01-04-2009 оставить как есть
  // а начиная с 04-2009 выбирать по полю KdBnk в таблице Z_NU !!!!!!!!!!!!!!
  if dDtPrc < dDt_2009_04 then with qryMy do begin
    if Active then Close;
    SQL.Clear;
    DataBaseName := CESMAIN;
    SQL.Add('Select bl.KdBnk, sum(n.Summa) as SMM ' +
            ' from vinuMain n Left outer join ' +
            ' GETWRKBNKLS (n.TabN, n.DtProc) bl on 1 = 1 ' +
            ' where n.DtProc = :dDtPrc and n.PSCH = :cPSCH and ' +
            ' n.KdSps = 1 and n.VidN = "7511" group by bl.KdBnk');
    ParamByName('dDtPrc').AsDateTime := dDtProc;
    ParamByName('cPSCH').AsString := cPSCH;
    Open;
    nSmBnk101 := 0;
    nSmBnkOther := 0;
    while not Eof do begin
      if FieldByName('KdBnk').AsInteger = 101 then
        nSmBnk101 := nSmBnk101 + RoundTo(FieldByName('SMM').AsFloat, -2)
      else
        nSmBnkOther := nSmBnkOther + RoundTo(FieldByName('SMM').AsFloat, -2);
      Next;
    end;
    Close;
    SQL.Clear;
    DataBaseName := ''; end
  else with qryMy do begin
    if dDtProc >= d_0117 then
      cNmViNu := 'ViNuM_17'
    else
      cNmViNu := 'ViNuMain';
    if Active then Close;
    SQL.Clear;
    DataBaseName := CESMAIN;
    SQL.Add('Select n.KdBnk, b.ShBnk, sum(n.Summa) as SMM ' +
            ' from ' + cNmViNu + ' n Left outer join z_Banki b on b.KdBnk = n.KdBnk ' +
            ' where n.DtProc = :dDtPrc and n.PSCH = :cPSCH and ' +
            ' n.KdSps = 1 and n.VidN = "7511" group by n.KdBnk, b.ShBnk');
    ParamByName('dDtPrc').AsDateTime := dDtProc;
    ParamByName('cPSCH').AsString := cPSCH;
    Open;
  end;
end;
//------------------------------------------------------------------------------
procedure TFormZpCmnPrt.GetSmForSmPrgByPSch(dDtProc : TDateTime;
                                            cVidN : string4; cPoleVh : string15;
                                            cVidPrg : string4; cPSch : string10;
                                                 var nSmmFor, nSmmPrg : double);
begin
  nSmmFor := 0;
  nSmmPrg := 0;
  with qryTmp do begin
    if Active then Close;
    SQL.Clear;
    DataBaseName := CESMAIN;
