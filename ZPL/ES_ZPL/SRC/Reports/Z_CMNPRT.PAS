      TextRC[iRow, 1] := '№ п/п';
      TextRC[iRow, 2] := 'Вид';
      SetSelection(iRow, 1, iRow, 2);
      SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
      TextRC[iRow, 3] := 'Наименование';
      SetSelection(iRow, 3, iRow, 4);
      SetAlignment(F1HAlignCenterAcrossCells, true, F1VAlignCenter, 0);
      TextRC[iRow, 5] := '%';
      SetSelection(iRow, 5, iRow, 5);
      SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
      TextRC[iRow, 6] := 'Сумма(%)';
      SetSelection(iRow, 6, iRow, 7);
      SetAlignment(F1HAlignCenterAcrossCells, true, F1VAlignCenter, 0);
      TextRC[iRow, 8] := 'Сумма в зачет';
      SetSelection(iRow, 8, iRow, 8);
      SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
      SetSelection(iRow, 1, iRow, nMaxCol);
      SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack); end
    else begin // по 6-ти месяцам
      cMsg := 'Заработки прошлых месяцев для расчёта среднего';
      Inc(iRow);
      TextRC[iRow, iCol] := cMsg;
      SetSelection(iRow, 1, iRow, nMaxCol);
      FontBold := true;
      SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
      Inc(iRow);
      TextRC[iRow, 1] := '№ п/п';
      TextRC[iRow, 2] := 'Месяц Год';
      TextRC[iRow, 5] := 'Сумма заработка';
      TextRC[iRow, 6] := 'Коэф-т. з/пл.';
      if (cVidBln = '2602') then
        TextRC[iRow, 7] := 'Календ. дней'
