      TextRC[iRow, 1] := 'за ' + cMsg;
      SetSelection(iRow-1, 1, iRow, 5);
      SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
      FontBold := true;
      Inc(iRow);
      TextRC[iRow, 1] := '№ п/п';
      TextRC[iRow, 2] := 'Таб. н-р';
      TextRC[iRow, 3] := 'Фамилия И.О.';
      TextRC[iRow, 4] := 'Сумма';
      TextRC[iRow, 5] := 'Роспись о получении';
      RowHeight[iRow] := Round(2.2 * nMyConst);
      SetSelection(iRow, 1, iRow, 5);
      SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
      nStartRow := iRow;
