procedure F6_PrtVedProf(dDtProc : TDateTime; cdsProf : TDataSet; nCase : byte);
// при nCase = 1 печать общей ведомостью, иначе раздельно по KdObj
var iRow, iCol, nStartRow, nMyConst, nMaxCol, nPp : integer;
    nKdObj, nVedNo : integer;
    cMsg, cNmObj  : string;
    nSmNO, nSmPO, nSmNV, nSmPV : double;
    nY, nM, nD : word;
    PgSetup : F1PageSetup;
begin
  Screen.Cursor := crHourGlass;
  FormZpCmnPrt := TFormZpCmnPrt.Create(Application);
  with FormZpCmnPrt, F6B do begin
    PgSetup := CreateNewPageSetup;
    SetPageParams(PgSetup);
    SetPageSetup(PgSetup);
    DecodeDate(dDtProc, nY, nM, nd);
    nMyConst := RowHeight[1];
    nMaxCol := 6;
    nStartRow := 1;
    ShowGridLines    := false;
    ShowColHeading   := true;
    ShowRowHeading   := true;
    ShowZeroValues   := false;
    ShowTabs         := 0;
    PrintNoColor     := true;
    PrintGridLines   := false;
    PrintFooter      := '';
    PrintHeader      := '';
    PrintLandscape   := false;
    DefaultFontCharSet := F1RussianCharSet;
    DefaultFontSize := 10;
    iRow := 0;
    iCol := 1;
    nSmNV := 0;
    nSmPV := 0;
    nVedNo := 0;
    nPp := 0;
    with cdsProf do begin
      DisableControls;
      First;
      if nCase = 1 then begin
        Inc(iRow);
        Inc(nVedNo);
        if nM < 10 then
          cMsg := cMsg + '0'
        else
          cMsg := '';
        cMsg := IntToStr(nM) + '-' + IntToStr(nVedNo);
        TextRC[iRow, iCol] := 'В Е Д О М О С Т Ь  N ' + cMsg;
        SetSelection(iRow, iCol, iRow, nMaxCol);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
        Inc(iRow);
        TextRC[iRow, iCol] := 'профсоюзных взносов за ' + MesRus(nM) + ' ' +
                                                       IntToStr(nY) + ' г.';
        SetSelection(iRow, iCol, iRow, nMaxCol);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
        Inc(iRow);
        iCol := 1;
        TextRC[iRow, iCol] := '№ п/п';
        ColWidth[iCol] := Round(5 * nMyConst);
        Inc(iCol);
        TextRC[iRow, iCol] := 'Таб. номер';
        ColWidth[iCol] := Round(9 * nMyConst);
        Inc(iCol);
        TextRC[iRow, iCol] := 'Ф а м и л и я  И. О.';
        ColWidth[iCol] := Round(35 * nMyConst);
        Inc(iCol);
        TextRC[iRow, iCol] := 'Начислено (грн.)';
        ColWidth[iCol] := Round(12 * nMyConst);
        Inc(iCol);
        TextRC[iRow, iCol] := 'ПрофВзнос (грн.)';
        ColWidth[iCol] := Round(12 * nMyConst);
        Inc(iCol);
        TextRC[iRow, iCol] := 'Роспись об уплате';
        ColWidth[iCol] := Round(20 * nMyConst);
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
        SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
        nStartRow := iRow+1;
        nPp := 0;
      end;
      while not Eof do begin
        nKdObj := FieldByName('KdObj').AsInteger;
        cNmObj := FieldByName('NmObj').AsString;
        nSmNO := 0;
        nSmPO := 0;
        Inc(nVedNo);
        iCol := 1;
        if nCase = 2 then begin
          Inc(iRow, 3);
          if nM < 10 then
            cMsg := cMsg + '0'
          else
            cMsg := '';
          cMsg := IntToStr(nM) + '-' + IntToStr(nVedNo);
          TextRC[iRow, iCol] := 'В Е Д О М О С Т Ь  N ' + cMsg;
          SetSelection(iRow, iCol, iRow, nMaxCol);
          SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
          Inc(iRow);
          TextRC[iRow, iCol] := 'профсоюзных взносов за ' + MesRus(nM) + ' ' +
                                                         IntToStr(nY) + ' г.';
          SetSelection(iRow, iCol, iRow, nMaxCol);
          SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
          Inc(iRow);
          TextRC[iRow, iCol] := IntToStr(nKdObj) + ' ' + cNmObj;
          Inc(iRow);
          iCol := 1;
          TextRC[iRow, iCol] := '№ п/п';
          ColWidth[iCol] := Round(5 * nMyConst);
          Inc(iCol);
          TextRC[iRow, iCol] := 'Таб. н-р';
          ColWidth[iCol] := Round(10 * nMyConst);
          Inc(iCol);
          TextRC[iRow, iCol] := 'Ф а м и л и я  И. О.';
          ColWidth[iCol] := Round(35 * nMyConst);
          Inc(iCol);
          TextRC[iRow, iCol] := 'Начислено (грн.)';
          ColWidth[iCol] := Round(12 * nMyConst);
          Inc(iCol);
          TextRC[iRow, iCol] := 'ПрофВзнос (грн.)';
          ColWidth[iCol] := Round(12 * nMyConst);
          Inc(iCol);
          TextRC[iRow, iCol] := 'Роспись об уплате';
          ColWidth[iCol] := Round(20 * nMyConst);
          SetSelection(iRow, 1, iRow, nMaxCol);
          SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
          SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
          nStartRow := iRow+1;
          nPp := 0; end
        else begin
          Inc(iRow);
          iCol := 1;
          TextRC[iRow, iCol] := IntToStr(nKdObj) + ' ' + cNmObj;
          SetSelection(iRow, iCol, iRow, nMaxCol);
          FontUnderLine := true;
          SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
        end;
        while (FieldByName('KdObj').AsInteger = nKdObj) and not Eof do begin
          Inc(iRow);
          Inc(nPp);
          TextRC[iRow, 1] := IntToStr(nPp) + '.';
          SetSelection(iRow, 1, iRow, 1);
          SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
          TextRC[iRow, 2] := FieldByName('TabN').AsString;
          TextRC[iRow, 3] := FieldByName('FamIO').AsString;
          NumberRC[iRow, 4] := FieldByName('SmNach').AsFloat;
          NumberRC[iRow, 5] := FieldByName('SmProf').AsFloat;
          SetSelection(iRow, 4, iRow, 5);
          FormatFixed2;
          nSmNO := nSmNO + FieldByName('SmNach').AsFloat;
          nSmPO := nSmPO + FieldByName('SmProf').AsFloat;
          nSmNV := nSmNV + FieldByName('SmNach').AsFloat;
          nSmPV := nSmPV + FieldByName('SmProf').AsFloat;
          Next;
        end;
        if nCase = 2 then begin
          SetSelection(nStartRow, 1, iRow, nMaxCol);
          SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
          Inc(iRow);
          TextRC[iRow, 3] := '    И т о г о:';
          NumberRC[iRow, 4] := nSmNO;
          NumberRC[iRow, 5] := nSmPO;
          SetSelection(iRow, 4, iRow, 5);
          FormatFixed2;
          Inc(iRow);
          AddRowPageBreak(iRow); end
        else begin
          Inc(iRow);
          TextRC[iRow, 3] := '    И т о г о:';
          NumberRC[iRow, 4] := nSmNO;
          NumberRC[iRow, 5] := nSmPO;
          SetSelection(iRow, 4, iRow, 5);
          FormatFixed2;
          Inc(iRow);
        end;
      end;
      Inc(iRow, 2);
      TextRC[iRow, 3] := '    В С Е Г О:';
      NumberRC[iRow, 4] := nSmNV;
      NumberRC[iRow, 5] := nSmPV;
      SetSelection(iRow, 4, iRow, 5);
      FormatFixed2;
      Inc(iRow);
      if nCase = 1 then begin
        SetSelection(nStartRow, 1, iRow, nMaxCol);
        SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
        Inc(iRow);
        AddRowPageBreak(iRow);
      end;
      First;
      EnableControls;
    end;
    cRandomFileName := RandomFileName;
    if bAppDocsToExcel then begin
      cRandomFileName := cRandomFileName + '.xls';
      WriteEx(cDirTemp + cRandomFileName, F1FileExcel97); end
    else begin
      cRandomFileName := cRandomFileName + '.vts';
      WriteEx(cDirTemp + cRandomFileName, F1FileFormulaOne6);
    end;
    Screen.Cursor := crDefault;
    Free;
  end;
  Screen.Cursor := crDefault;
  MyPreView(cDirTemp, cRandomFileName);
end;
