          FormatFixed2;
        end;
        // Подставляем одинаковые nSmmFor и nSmmPrg во все три фонда (Ольга)
        if nSmmFor <> 0 then begin
          Inc(iRow);
          Inc(nPp);
          NumberRC[iRow, 1] := nPp;
          SetSelection(iRow, 3, iRow, 4);
          mCellFormat := CreateNewCellFormat;
          mCellFormat.MergeCells := true;
          mCellFormat.WordWrap   := false;
          SetCellFormat(mCellFormat);
          cMsg := 'В ФЗ ' +  FloatToStr(nPrcFz) + '%:';
          if nSmmFor <> 0 then begin
            cMsg := cMsg + ' (' + FloatToStrF(nSmmFor, ffFixed, 18, 2);
            if nSmmPrg <> 0 then begin
              cMsg := cMsg + ' - ' + FloatToStrF(nSmmPrg, ffFixed, 18, 2);
              cMsg := cMsg + ' = ' + FloatToStrF(nSmmFor-nSmmPrg, ffFixed, 18, 2);
            end;
            cMsg := cMsg + ')';
          end;
          TextRC[iRow, 2] := '8641';
          TextRC[iRow, 3] := cMsg;
          TextRC[iRow, 5] := cSchBU;
          SetColWidthAuto(iRow, 5, iRow, 5, false);
          if DmMain.qryVidN_LU.Locate('VidN', '8641', []) then begin
            TextRC[iRow, 6] := DmMain.qryVidN_LU.FieldByName('KEKV').AsString;
            TextRC[iRow, 7] := DmMain.KdSbu2SchBU(
                             DmMain.qryVidN_LU.FieldByName('KdSpZ').AsInteger);
            SetSelection(iRow, 5, iRow, 7);
            SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);
          end;
          nSmPrpFz := RoundTo((nSmmFor-nSmmPrg) * nPrcFz / 100, -2);
          NumberRC[iRow, 8] := nSmPrpFz;
          nSmPrpItg := nSmPrpItg + nSmPrpFz;
          SetSelection(iRow, 8, iRow, 8);
          FormatFixed2;
        end;
        Inc(iRow);
        SetSelection(iRow, 1, iRow, nMaxCol-1);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignBottom, 0);
        TextRC[iRow, 1] := 'Итого обязательных платежей:';
        FontBold := true;
        NumberRC[iRow, 8] := nSmPrpItg;
        SetSelection(iRow, 8, iRow, 8);
        FormatFixed2;
        SetSelection(iRow, 1, iRow, nMaxCol);
        FontBold := true;
        SetSelection(nFirstRowOP, 1, iRow, nMaxCol);
        SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
        Inc(iRow);
        RowHeight[iRow] := Round(0.5 * nMyConst);
        Inc(iRow);
        RowHeight[iRow] := Round(1.8 * nMyConst);
        cMsg := 'Итого обороты по М/О №5';
        TextRC[iRow, 1] := cMsg;
        SetSelection(iRow, 1, iRow, nMaxCol-1);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
        NumberRC[iRow, 8] := RoundTo(nSmVnu00 + nSmVnu01, -2) +
                                RoundTo(nSmVnu02 + nSmVnu03 + nSmVnu04, -2) +
                                                         RoundTo(nSmPrpItg, -2);
        SetSelection(iRow, nMaxCol, iRow, nMaxCol);
        SetAlignment(F1HAlignRight, false, F1VAlignCenter, 0);
        FormatFixed2;
        SetSelection(iRow, 1, iRow, nMaxCol);
        FontBold := true;
        FontSize := 11;
        SetColWidthAuto(iRow, 8, iRow, 8, false);
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
        Inc(iRow);
      end;
      GoToBookMark(mBookMark);
      FreeBookMark(mBookMark);
      EnableControls;
    end;

    Inc(iRow, 3);
    cMsg := 'Заступник головнго бухгалтера ____________ ' +
      Form_Dm.KdUsr2FioUsr(102);
    TextRC[iRow, nMaxCol] := cMsg;
    SetSelection(iRow, nMaxCol, iRow, nMaxCol);
    SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);

    IRow := iRow + 2;
    if cBuhDolgn <> '' then
      cMsg := cBuhDolgn + '  ___________  ' + cBuhFIO
    else
      cMsg := 'Бухгалтер ____________ ' + Form_Dm.KdUsr2FioUsr(nAppKdUsr);
    TextRC[iRow, nMaxCol] := cMsg;
    SetSelection(iRow, nMaxCol, iRow, nMaxCol);
    SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
    cRandomFileName := RandomFileName;
    if bAppDocsToExcel then begin
      cRandomFileName := cRandomFileName + '.xls';
      WriteEx(cDirTemp + cRandomFileName, F1FileExcel97); end
    else begin
      cRandomFileName := cRandomFileName + '.vts';
      WriteEx(cDirTemp + cRandomFileName, F1FileFormulaOne6);
    end;
    Screen.Cursor   := crDefault;
    Free;
  end;
  Screen.Cursor := crDefault;
  MyPreView(cDirTemp, cRandomFileName);
end;
//------------------------------------------------------------------------------
procedure F6PrtMoBySintSPZ(cdsSpZ : TDataSet; dDtProc : TDateTime;
         {старая до 01-01-07}                             cPrtCaption : string);
var nMyConst, iRow, iCol, nMaxCol, nStartRow, nFirstRowOP,
                                              nPp, nCntLineInSch : integer;
    cMsg : string;
    cKrSch, cSchZp, cPSch, cNmVidN, cKEKV : ShortString;
    cVidN : string4;
    nSvNR, nCntStrok : integer;
    nSmVidN, nSmKrSch : double;
    nSmDolgTM, nSmDolgPM : double;
    nSmVnu00, nSmVnu01, nSmVnu02, nSmVnu03, nSmVnu04 : double;
    nSmSch, nSmNach, nSmUdrg, nSmTots : double;
    nNumberPSCH, nY, nM, nD : word;
    bIsKrtTitle, bIsDbtTitle : boolean;
    nSmPrpPf, nSmPrpPfInv, nSmPrpPfBlnInc,
    nSmPrpTvp, nSmPrpNv, nSmPrpFz,
    nSmPrpItg,
    nSmPrpPfTt, nSmPrpPfInvTt, nSmPrpPfBlnIncTt,
    nSmPrpTvpTt, nSmPrpNvTt, nSmPrpFzTt,
    nSmPrpTt : double;
    nPrtObj, nVNU : integer; // nVNU - для видов: больничн. -  0
                             //                   начисления - 1,
                             //                   удержания -  1 (для сортировки)
    // сортировка таблицы KdObj;VUN;SchBU;VidN
    nCntPSCH : integer;
    cTmp : string; cRoot : string3; nCntInRoot : integer; nSmRoot : double;
    PgSetup : F1PageSetup;
    mBookMark : TBookMark;
    nSmmFor, nSmmPrg : double;
    nPrcPfCmn, nPrcPfInv, nPrcSsBln, nPrcSsNsl, nPrcFz, nPrcFz1006 : double;
    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    procedure ShapochkaSMo(F6B : TF6Book; nY, nM : word;
                                                   var iRow, iCol : integer);
    var cMsg : string;
    begin
      with F6B do begin
        Inc(iRow);
        iCol := 1;
        cMsg := 'Мемориальный ордер №5';
        TextRC[iRow, iCol] := cMsg;
        RowHeight[iRow] := Round(1.2 * nMyConst);
        Inc(iRow);
        cMsg := 'за ' + MesRus(nM) + ' ' + IntToStr(nY) + ' года';
        TextRC[iRow, iCol] := cMsg;
        RowHeight[iRow] := Round(1.2 * nMyConst);
        SetSelection(iRow-1, 1, iRow, nMaxCol);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
        FontSize := 10;
        FontBold := true;
        Inc(iRow);
        iCol := 1;
        TextRC[iRow, iCol] := '№ п/п';
        ColWidth[iCol] := Round(4 * nMyConst);
        Inc(iCol);
        TextRC[iRow, iCol] := 'Вид';
        ColWidth[iCol] := Round(5 * nMyConst);
        Inc(iCol);
        ColWidth[iCol] := Round(35 * nMyConst);
        ColWidth[iCol+1] := Round(10 * nMyConst);
        SetSelection(iRow, iCol, iRow, iCol+1);
        mCellFormat := CreateNewCellFormat;
        mCellFormat.MergeCells := true;
        mCellFormat.WordWrap   := false;
        SetCellFormat(mCellFormat);
        TextRC[iRow, iCol] := 'Наименование';
        Inc(iCol, 2);
        TextRC[iRow, iCol] := 'Дебет счёта';
        ColWidth[iCol] := Round(8 * nMyConst);
        Inc(iCol);
        TextRC[iRow, iCol] := 'КЕКВ';
        ColWidth[iCol] := Round(7 * nMyConst);
        Inc(iCol);
        TextRC[iRow, iCol] := 'Кредит счёта';
        ColWidth[iCol] := Round(8 * nMyConst);
        Inc(iCol);
        TextRC[iRow, iCol] := 'Сумма';
        ColWidth[iCol] := Round(15 * nMyConst);
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
        RowHeight[iRow] := Round(2 * nMyConst);
        SetSelection(iRow, 1, iRow, nMaxCol);;
        SetBorder(1, 1, 1, 1, 1, 0, clBlack,
                                  clBlack, clBlack, clBlack, clBlack);
      end;
    end;
    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
begin
  Screen.Cursor := crHourGlass;
  FormZpCmnPrt := TFormZpCmnPrt.Create(Application);
  with FormZpCmnPrt, F6B do begin
    PgSetup := CreateNewPageSetup;
    SetPageParams(PgSetup);
    SetPageSetup(PgSetup);
    DecodeDate(dDtProc, nY, nM, nD);
    ShowGridLines  := false;
    ShowColHeading := true;
    ShowRowHeading := true;
    ShowZeroValues := false;
    ShowTabs       := 0;
    PrintNoColor   := true;
    PrintGridLines := false;
    PrintFooter    := '';
    PrintHeader    := '';
    PrintLandscape := false;
    DefaultFontCharSet := F1RussianCharSet;
    DefaultFontSize := 10;
    nMaxCol := 8;
    nMyConst := RowHeight[1];
    iRow := 1;
    iCol := 1;
    TextRC[iRow, nMaxCol] := cPrtCaption;
    RowHeight[iRow] := Round(1.2 * nMyConst);
    SetSelection(iRow, nMaxCol, iRow, nMaxCol);
    FontUnderLine := true;
    SetAlignment(F1HAlignRight, false, F1VAlignCenter, 0);
    ShapochkaSMo(F6B, nY, nM, iRow, iCol);
    with cdsSpZ do begin
      mBookMark := GetBookMark;
      DisableControls;
      First;
      nStartRow := iRow + 1;
      nPp := 0;
      cSchZp := '6511';   // '661';
      nNumberPSCH := 0;
      nSmPrpPfTt       := 0;
      nSmPrpPfInvTt    := 0;
      nSmPrpPfBlnIncTt := 0;
      nSmPrpTvpTt      := 0;
      nSmPrpNvTt       := 0;
      nSmPrpFzTt       := 0;
      while not Eof do begin
        if FieldByName('Smm').AsFloat = 0 then begin
          Next;
          Continue;
        end;
        cPSCH := FieldByName('PSch').AsString;
        Inc(nNumberPSCH);
        if nNumberPSCH > 1 then begin
          AddRowPageBreak(iRow);
          ShapochkaSMo(F6B, nY, nM, iRow, iCol);
        end;
        bIsKrtTitle := false;
        bIsDbtTitle := false;
        nSmDolgTM := 0;
        nSmDolgPM := 0;
        nSmVnu00 := 0;   // для группы больничных видов
        nSmVnu01 := 0;   //            виды начилений
        nSmVnu02 := 0;   //            виды удержаний
        nSmVnu03 := 0;   //            прочие (удалил все)
        nSmVnu04 := 0;   //            выплаты и долги (коп., ПМ, ТМ)
        nSmPrpPf       := 0;
        nSmPrpPfInv    := 0;
        nSmPrpPfBlnInc := 0;
        nSmPrpTvp      := 0;
        nSmPrpNv       := 0;
        nSmPrpFz       := 0;
        while (FieldByName('PSch').AsString = cPSCH) and not Eof do begin
          if FieldByName('Smm').AsFloat = 0 then begin
            Next;
            Continue;
          end;
          nVNU := FieldByName('VNU').AsInteger;
          if (nVNU = 0) or (nVNU = 1) and not bIsKrtTitle then begin
            cMsg := 'Кредит счёта ' + cSchZp +
                                  ' в дебет счетов:';
            Inc(iRow);
            TextRC[iRow, 1] := cMsg;
            SetSelection(iRow, 1, iRow, nMaxCol);
            SetBorder(1,0,0,0,0,0,clBlack,clBlack,clBlack,clBlack,clBlack);
            SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
            FontBold := true;
            FontUnderLine := true;
            bIsKrtTitle := true; end
          else if (nVNU = 2) and not bIsDbtTitle then begin
            if (nSmVnu00 <> 0) or (nSmVnu01 <> 0) then begin
              Inc(IRow);
              SetSelection(iRow, 1, iRow, nMaxCol-1);
              mCellFormat := CreateNewCellFormat;
              mCellFormat.AlignHorizontal := F1HAlignCenter;
              mCellFormat.AlignVertical := F1VAlignBottom;
              mCellFormat.MergeCells := true;
              mCellFormat.WordWrap   := false;
              mCellFormat.FontBold   := true;
              SetCellFormat(mCellFormat);
              TextRC[iRow, 1] := 'Итого по видам начисления:';
              NumberRC[iRow, 8] := nSmVnu00 + nSmVnu01;
              SetSelection(iRow, 8, iRow, 8);
              FontBold := true;
              FormatFixed2;
              SetSelection(iRow, 1, iRow, nMaxCol);
              SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
              Inc(iRow);
              SetSelection(iRow, 1, iRow, nMaxCol);
              SetBorder(1,0,0,0,0,0,clBlack,clBlack,clBlack,clBlack,clBlack);
            end;
            cMsg := 'Дебет счёта ' + cSchZp +
                                 ' в кредит счетов:';
            Inc(iRow);
            TextRC[iRow, 1] := cMsg;
            SetSelection(iRow, 1, iRow, nMaxCol);
            SetBorder(1,0,0,0,0,0,clBlack,clBlack,clBlack,clBlack,clBlack);
            SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
            FontBold := true;
            FontUnderLine := true;
            bIsDbtTitle := true;
          end;
          while (FieldByName('VNU').AsInteger = nVNU) and not Eof do begin
            if FieldByName('Smm').AsFloat = 0 then begin
              Next;
              Continue;
            end;
            cKrSch := FieldByName('KrSch').AsString;
            nSmKrSch := 0;
            nCntLineInSch := 0;
            while (FieldByName('KrSch').AsString = cKrSch) and not Eof do begin
              if FieldByName('Smm').AsFloat = 0 then begin
                Next;
                Continue;
              end;
              Inc(nCntLineInSch);
              cVidN := FieldByName('VidN').AsString;
              cNmVidN := FieldByName('NmVidN').AsString;
              cKEKV := FieldByName('Vid_KEKV').AsString;
              nSmVidN := 0;
              while (FieldByName('VidN').AsString = cVidN) and not Eof do begin
                if FieldByName('Smm').AsFloat = 0 then begin
                  Next;
                  Continue;
                end;
                nSmVidN := nSmVidN + FieldByName('Smm').AsFloat;
                if (cVidN = '2723') or (cVidN = '6623') then
                  // возврат и удержание копеек - просто пропускаем
                else if cVidN = '2724' then
                  nSmDolgTM := nSmDolgTM + FieldByName('Smm').AsFloat
                else if cVidN = '6624' then
                  nSmDolgPM := nSmDolgPM - FieldByName('Smm').AsFloat
                                         // будет плюсовым, хотя удерж.
                else if cVidN < '6000' then
                  nSmKrSch := nSmKrSch + FieldByName('Smm').AsFloat
                else if cVidN < '8600' then
                  nSmKrSch := nSmKrSch - FieldByName('Smm').AsFloat
                else if cVidN = '8611' then begin
                  nSmPrpPf := nSmPrpPf - FieldByName('Smm').AsFloat;
                  nSmPrpPfTt := nSmPrpPfTt - FieldByName('Smm').AsFloat; end
                else if cVidN = '8612' then begin  // В ПФпрп с инвалидов
                  nSmPrpPfInv := nSmPrpPfInv - FieldByName('Smm').AsFloat;
                  nSmPrpPfInvTt := nSmPrpPfInvTt - FieldByName('Smm').AsFloat; end
                else if cVidN = '8621' then begin
                  nSmPrpTvpTt := nSmPrpTvpTt - FieldByName('Smm').AsFloat;
                  nSmPrpTvp := nSmPrpTvp - FieldByName('Smm').AsFloat; end
                else if cVidN = '8631' then begin
                  nSmPrpNvTt := nSmPrpNvTt - FieldByName('Smm').AsFloat;
                  nSmPrpNv := nSmPrpNv - FieldByName('Smm').AsFloat; end
                else if cVidN = '8641' then begin
                  nSmPrpFzTt := nSmPrpFzTt - FieldByName('Smm').AsFloat;
                  nSmPrpFz := nSmPrpFz - FieldByName('Smm').AsFloat;
                end;
                Next;
              end;
              if (cVidN <> '2723') and (cVidN <> '2724') and
                    (cVidN <> '6623') and (cVidN <> '6624') and
                        ((cVidN < '5000') or (cVidN >= '6000')) and
                                               (cVidN < '8600') then begin
                Inc(nPp);
                Inc(iRow);
                NumberRC[iRow, 1] := nPp;
                TextRC[iRow, 2] := cVidN;
                SetSelection(iRow, 2, iRow, 2);
                SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);
                SetSelection(iRow, 3, iRow, 4);
                mCellFormat := CreateNewCellFormat;
                mCellFormat.MergeCells := true;
                mCellFormat.WordWrap   := false;
                mCellFormat.FontSize := 8;
                SetCellFormat(mCellFormat);
                cMsg := cNmVidN;
                TextRC[iRow, 3] := cMsg;
                if nVNU < 2 then
                  TextRC[iRow, 5] := cKrSch
                else
                  TextRC[iRow, 5] := cSchZp;
                SetColWidthAuto(iRow, 5, iRow, 5, false);
                TextRC[iRow, 6] := cKEKV;
                if nVNU < 2 then //начисления (больн, детск. = 0; остальн. = 1)
                  TextRC[iRow, 7] := cSchZp
                else             // виды удержаний и выплаты
                  TextRC[iRow, 7] := cKrSch;
                SetSelection(iRow, 5, iRow, 7);
                SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);
                if cVidN < '6000' then
                  NumberRC[iRow, 8] := nSmVidN
                else
                  NumberRC[iRow, 8] := -nSmVidN;
                SetSelection(iRow, 8, iRow, 8);
                FormatFixed2;
                SetSelection(iRow, 1, iRow, nMaxCol);
                SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
                SetRowHeightAuto(iRow, 1, iRow, nMaxCol, true);
                if nVNU = 0 then        // больничные (и детские)
                  nSmVnu00 := nSmVnu00 + nSmVidN
                else if nVNU = 1 then   // начисления
                  nSmVnu01 := nSmVnu01 + nSmVidN
                else if nVNU = 2 then   // удержания
                  nSmVnu02 := nSmVnu02 - nSmVidN
                else if nVNU = 3 then   // бывш. прочие
                  nSmVnu03 := nSmVnu03 - nSmVidN
                else if nVNU = 4 then   // выплаты
                  nSmVnu04 := nSmVnu04 - nSmVidN;
              end;
            end;
            if (cKrSch <> '') or (nSmKrSch <> 0) then begin
              Inc(iRow);
              if nCntLineInSch > 1 then begin
                SetSelection(iRow, 1, iRow, nMaxCol-1);
                FontItalic := true;
                FontSize := 8;
                mCellFormat := CreateNewCellFormat;
                mCellFormat.AlignHorizontal := F1HAlignRight;
                mCellFormat.AlignVertical := F1VAlignBottom;
                mCellFormat.MergeCells := true;
                mCellFormat.WordWrap   := false;
                mCellFormat.FontBold   := false;
                SetCellFormat(mCellFormat);
                TextRC[iRow, 1] := 'Итого по счёту ' + cKrSch + ':';
                NumberRC[iRow, 8] := nSmKrSch;
                SetSelection(iRow, 8, iRow, 8);
                FontItalic := true;
                FormatFixed2;
                SetSelection(iRow, 1, iRow, nMaxCol);
                SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
                Inc(iRow);
                RowHeight[iRow] := Round(0.4 * nMyConst);
                SetSelection(iRow, 1, iRow, nMaxCol);
                SetBorder(1,0,0,0,0,0,
                                 clBlack,clBlack,clBlack,clBlack,clBlack); end
              else begin
                RowHeight[iRow] := Round(0.4 * nMyConst);
                SetSelection(iRow, 1, iRow, nMaxCol);
                SetBorder(1,0,0,0,0,0,clBlack,clBlack,clBlack,clBlack,clBlack);
              end;
            end;
          end;
        end;
        if Eof or (FieldByName('KrSch').AsString <> cPSCH) then begin
          Inc(IRow);
          SetSelection(iRow, 1, iRow, nMaxCol-1);
          mCellFormat := CreateNewCellFormat;
          mCellFormat.AlignHorizontal := F1HAlignCenter;
          mCellFormat.AlignVertical := F1VAlignBottom;
          mCellFormat.MergeCells := true;
          mCellFormat.WordWrap   := false;
          mCellFormat.FontBold   := true;
          SetCellFormat(mCellFormat);
          TextRC[iRow, 1] := 'Итого по видам удержания:';
          NumberRC[iRow, 8] := nSmVnu02 + nSmVnu03 + nSmVnu04;
          SetSelection(iRow, 8, iRow, 8);
          FontBold := true;
          FormatFixed2;
          SetSelection(iRow, 1, iRow, nMaxCol);
          SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
          Inc(iRow);
          SetSelection(iRow, 1, iRow, nMaxCol);
          SetBorder(1,0,0,0,0,0,clBlack,clBlack,clBlack,clBlack,clBlack);
          if ((nSmDolgTM <> 0) or (nSmDolgPM <> 0)) then begin
            Inc(iRow);
            SetSelection(iRow, 3, iRow, 4);
            mCellFormat := CreateNewCellFormat;
            mCellFormat.MergeCells := true;
            mCellFormat.WordWrap   := false;
            SetCellFormat(mCellFormat);
            TextRC[iRow, 3] := 'Справка:';
            SetSelection(iRow, 3, iRow, 3);
            SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);
            FontSize := 8;
            FontItalic := true;
            SetSelection(iRow, 1, iRow, nMaxCol);
            SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
            if (nSmDolgPM <> 0) then begin
              Inc(iRow);
              TextRC[iRow, 4] := 'Погашение долга за прошлый месяц:';
              SetSelection(iRow, 4, iRow, 4);
              SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
              NumberRC[iRow, 7] := -nSmDolgPM;
              SetSelection(iRow, 7, iRow, 7);
              FormatFixed2;
              SetSelection(iRow, 4, iRow, 7);
              FontSize := 8;
              FontItalic := true;
              SetSelection(iRow, 1, iRow, nMaxCol);
              SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
            end;
            if (nSmDolgTM <> 0) then begin
              Inc(iRow);
              TextRC[iRow, 4] := 'В долг в текущем месяце:';
              SetSelection(iRow, 4, iRow, 4);
