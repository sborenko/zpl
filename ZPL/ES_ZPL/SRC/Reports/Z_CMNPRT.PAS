        nPp := 0;
        nKopeek := 0;
        nCntPgLines := 0;
        nSmTt := 0;
        nSmBudg := 0;
        nSmBlnBudg := 0;
        nSmSpec := 0;
        nSmBlnSpec := 0;
        while (FieldByName('KdObj_Sps').AsInteger = nKdObj) and not Eof do begin
          nSmZp := 0;
          nSmPg := 0;
          nTabN := FieldByName('TabN').AsInteger;
          cFIO := MyFamIO(FieldByName('Fam').AsString,
                               FieldByName('Ima').AsString,
                                    FieldByName('Otch').AsString);
          while (FieldByName('TabN').AsInteger = nTabN) and
              (FieldByName('KdObj_Sps').AsInteger = nKdObj) and not Eof do begin
            nSmZp := nSmZp - FieldByName('Summa').AsFloat;
            if FieldByName('PSCH').AsString = '801' then begin
              if FieldByName('PRR').IsNull or
                              (FieldByName('PRR').AsInteger = 0) then
                nSmBudg := nSmBudg - FieldByName('Summa').AsFloat
              else
                nSmBlnBudg := nSmBlnBudg - FieldByName('Summa').AsFloat; end
            else begin
              if FieldByName('PRR').IsNull or
                              (FieldByName('PRR').AsInteger = 0) then
                nSmSpec := nSmSpec - FieldByName('Summa').AsFloat
              else
                nSmBlnSpec := nSmBlnSpec - FieldByName('Summa').AsFloat;
            end;
            //nSmPg := nSmPg - FieldByName('Summa').AsFloat;
            nSmTt := nSmTt - FieldByName('Summa').AsFloat;
            Next;
          end;
          if (nCntPgLines >= nMaxPgLines-1) or ((nCntRestTabN <= 1) and
                                   (nCntPgLines >= (nMaxPgLines-10))) then begin
            if (nCntRestTabN <= 1) then
              nCntRestTabN := 100;
            Inc(iRow);
            RowHeight[iRow] := Round(nMyConst * 1.4);
            TextRC[iRow, 1] := 'Усього по листу:';
