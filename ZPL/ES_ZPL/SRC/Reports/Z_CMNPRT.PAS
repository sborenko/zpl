procedure F6_PrtPlnDoc(tblPln : TDataSet; nYY, nMes : word);
var iRow, nPp, nMaxCol, nMyConst, nFirstRow : integer;
    cMsg : string;
    myPgSetup : F1PageSetup;
    nCntSotrTt : integer;
    nSumZplTt : double;
begin
  Screen.Cursor := crHourGlass;
  FormZpCmnPrt := TFormZpCmnPrt.Create(Application);
  with FormZpCmnPrt, F6B do begin
    nMyConst := RowHeight[1];
    ShowGridLines    := false;
    ShowColHeading   := true;
    ShowRowHeading   := true;
    ShowZeroValues   := false;
    ShowTabs         := 0;
    PrintNoColor     := true;
    PrintGridLines   := false;
    PrintFooter      := '';
    PrintHeader      := '';
    PrintLandscape   := false;
    DefaultFontCharSet := F1RussianCharSet;
    DefaultFontSize := 14;
    myPgSetup := CreateNewPageSetup;
    myPgSetup.LeftMargin := 0.5;
    myPgSetup.RightMargin := 0.25;
    SetPageSetup(myPgSetup);
    nMaxCol := 6;
    iRow := 1;
    cMsg := 'Справка для планового отдела по зарплате';
    TextRC[iRow,  1] := cMsg;
    Inc(iRow);
    cMsg := 'за ' + MesRus(nMes) + ' ' + IntToStr(nYY) + ' г.';
    TextRC[iRow,  1] := cMsg;
    SetSelection(iRow-1, 1, iRow, nMaxCol);
    SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
    SetSelection(iRow-1, 1, iRow, 1);
    FontBold := true;
    Inc(iRow, 2);
    SetSelection(iRow, 1, iRow+1, 1);
    mCellFormat := CreateNewCellFormat;
    mCellFormat.AlignHorizontal := F1HAlignCenter;
    mCellFormat.AlignVertical := F1VAlignCenter;
    mCellFormat.MergeCells := true;
    mCellFormat.WordWrap   := true;
    SetCellFormat(mCellFormat);
    nFirstRow := iRow;
    TextRC[iRow, 1] := 'Н-р п/п';
    ColWidth[1] := Round(4 * nMyConst);
    ColWidth[2] := Round(10 * nMyConst);
    ColWidth[3] := Round(10 * nMyConst);
    ColWidth[4] := Round(8 * nMyConst);
    ColWidth[5] := Round(15 * nMyConst);
    ColWidth[6] := Round(12 * nMyConst);
    TextRC[iRow, 2] := 'Градации заработков';
    SetSelection(iRow, 2, iRow, 3);
    SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
    TextRC[iRow+1, 2] := 'от';
    TextRC[iRow+1, 3] := 'до (вкл.)';
    SetSelection(iRow+1, 2, iRow+1, 3);
    SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
    SetSelection(iRow, 4, iRow+1, 4);
    mCellFormat := CreateNewCellFormat;
    mCellFormat.AlignHorizontal := F1HAlignCenter;
    mCellFormat.AlignVertical := F1VAlignCenter;
    mCellFormat.MergeCells := true;
    mCellFormat.WordWrap   := true;
    SetCellFormat(mCellFormat);
    TextRC[iRow, 4] := 'К-во сотр.';
    SetSelection(iRow, 5, iRow+1, 5);
    mCellFormat := CreateNewCellFormat;
    mCellFormat.AlignHorizontal := F1HAlignCenter;
    mCellFormat.AlignVertical := F1VAlignCenter;
    mCellFormat.MergeCells := true;
    mCellFormat.WordWrap   := true;
    SetCellFormat(mCellFormat);
    TextRC[iRow, 5] := 'Сумма заработков';
    SetSelection(iRow, 6, iRow+1, 6);
    mCellFormat := CreateNewCellFormat;
    mCellFormat.AlignHorizontal := F1HAlignCenter;
    mCellFormat.AlignVertical := F1VAlignCenter;
    mCellFormat.MergeCells := true;
    mCellFormat.WordWrap   := true;
    SetCellFormat(mCellFormat);
    TextRC[iRow, 6] := 'Примечание';
    Inc(iRow);
    with tblPln do begin
      First;
      nPp := 0;
      nCntSotrTt := 0;
      nSumZplTt := 0;
      while not Eof do begin
        Inc(nPp);
        Inc(iRow);
        NumberRC[iRow, 1] := nPp;
        NumberRC[iRow, 2] := FieldByName('P_From').AsFloat;
        NumberRC[iRow, 3] := FieldByName('P_To').AsFloat;
        NumberRC[iRow, 4] := FieldByName('Cnt').AsInteger;
        NumberRC[iRow, 5] := FieldByName('Smm').AsFloat;
        nCntSotrTt := nCntSotrTt + FieldByName('Cnt').AsInteger;
        nSumZplTt := nSumZplTt + FieldByName('Smm').AsFloat;
        SetSelection(iRow, 2, iRow, 3);
        FormatFixed2;
        SetSelection(iRow, 5, iRow, 5);
        FormatFixed2;
        Next;
      end;
    end;
    Inc(iRow, 2);
    TextRC[iRow, 2] := 'Итого:';
    SetSelection(iRow, 2, iRow, 3);
    SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
    NumberRC[iRow, 4] := nCntSotrTt;
    NumberRC[iRow, 5] := nSumZplTt;
    SetSelection(iRow, 5, iRow, 5);
    FormatFixed2;
    SetSelection(iRow, 2, iRow, 5);
    FontBold := true;
    SetSelection(nFirstRow, 1, iRow, nMaxCol);
    SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
    cRandomFileName := RandomFileName;
    if bAppDocsToExcel then begin
      cRandomFileName := cRandomFileName + '.xls';
      WriteEx(cDirTemp + cRandomFileName, F1FileExcel97); end
    else begin
      cRandomFileName := cRandomFileName + '.vts';
      WriteEx(cDirTemp + cRandomFileName, F1FileFormulaOne6);
    end;
    Screen.Cursor := crDefault;
    Free;
  end;
  MyPreView(cDirTemp, cRandomFileName);
end;
