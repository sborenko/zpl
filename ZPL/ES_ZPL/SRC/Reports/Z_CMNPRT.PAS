procedure F6PrtAnalitMo(cdsSPZ, cdsPrp : TDataSet; dDtProc : TDateTime;
                                                          cPrtCaption : string);
var nMyConst, iRow, iCol, nMaxCol, nStartRow, nFirstRowOP,
                                                   nPp, nCntLineInSch : integer;
    cMsg, cVidNotes, cKrSch, cSchZp,
             cSchBU, cNmSchBU, cNmVidN, cKEKV, cKekv1111, cTmpSch : ShortString;
    cVidN : string4;
    nNumberSchBU, nSvNR, nCntStrok : integer;
    nSmVidN, nSmKrSch : double;
    nSmDolgTM, nSmDolgPM : double;
    nSmVnu_1, nSmVnu00, nSmVnu01, nSmVnu02, nSmVnu03, nSmVnu04 : double;
    nSmSch, nSmNach, nSmUdrg, nSmTots, nSmPrpItg, nSmSvPrgAll : double;
    nNumberPSCH, nY, nM, nD : word;
    bIsKrtTitle, bIsDbtTitle : boolean;
    nSmForPrpPfCmn, nSmForPrpPfCmnBln5dn, nSmForPrpPfCmnBlnSs,
             nSmSvPrgPfCmn, nSmSvPrgPfCmnBln5dn, nSmSvPrgPfCmnBlnSs,
                      nSmToPfCmn, nSmToPfCmnBln5dn, nSmToPfCmnBlnSs,
    nSmForPrpPfInv, nSmForPrpPfInvBln5dn, nSmForPrpPfInvBlnSs,
             nSmSvPrgPfInv, nSmSvPrgPfInvBln5dn, nSmSvPrgPfInvBlnSs,
                      nSmToPfInv, nSmToPfInvBln5dn, nSmToPfInvBlnSs : double;
    nSmForPrpTvp, nSmSvPrgTvp, nSmToTvp,
       nSmForPrpNv, nSmSvPrgNv, nSmToNv,
          nSmForPrpFz, nSmSvPrgFz, nSmToFz,
           nSmForPrpFz1dgv, nSmSvPrgFz1dgv, nSmToFz1dgv,
            nSmForPrpFz2dgv, nSmSvPrgFz2dgv, nSmToFz2dgv, nSmToFzTt  : double;
    cSchToFz, cSchToFz1dgv, cSchToFz2dgv : ShortString;
    nPrtObj, nVNU : integer; // nVNU - для видов: больничн. - -1
                             //                   начисления - 1,
                             //                   удержания -  1 (для сортировки)
    // сортировка таблицы KdObj;VNU;SchBU;VidN
    nCntPSCH : integer;
    cTmp : string; cRoot : string3; nCntInRoot : integer; nSmRoot : double;
    PgSetup : F1PageSetup;
    nSmmFor, nSmmPrg : double;
    nPrcPfCmn, nPrcPfInv, nPrcSsBln, nPrcSsNsl, nPrcFz, nPrcFz1006 : double;
    iKekv : SmallInt; cSp_PF : ShortString;
    bIsNICH, bIsUdVes : boolean;
    nPrcPdN, nPrcPdn2, nDummy, nSmPdN, nSmKekvTt, nSmOst, nSmKekv : double;
    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    procedure ShapkaMo(F6B : TF6Book; nY, nM : word; var iRow, iCol : integer);
    var cMsg : ShortString;
    begin
      with F6B do begin
        Inc(iRow);
        iCol := 1;
        cMsg := 'Мемориальный ордер';  // тут пристраивать название из спр-ка
        TextRC[iRow, iCol] := cMsg;    // названий МО (сделать его)
        RowHeight[iRow] := Round(1.2 * nMyConst);
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
        FontSize := 10;
        FontBold := true;
        Inc(iRow);
        if (Pos('801/1-1', cSchBU) > 0) or (Pos('801/1-2', cSchBU) > 0) or
                                               (Pos('823/1', cSchBU) > 0) then
          bIsNICH := true;
        cMsg := 'СубСч. ' + cSchBU + ' ' + cNmSchBU;
        TextRC[iRow, iCol] := cMsg;
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
        Inc(iRow);
        cMsg := 'за ' + MesRus(nM) + ' ' + IntToStr(nY) + ' года';
        TextRC[iRow, iCol] := cMsg;
        RowHeight[iRow] := Round(1.2 * nMyConst);
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
        FontSize := 10;
        FontBold := true;
        Inc(iRow);
        iCol := 1;
        TextRC[iRow, iCol] := '№ п/п';
        ColWidth[iCol] := Round(4 * nMyConst);
        Inc(iCol);
        TextRC[iRow, iCol] := 'Вид';
        ColWidth[iCol] := Round(5 * nMyConst);
        Inc(iCol);
        ColWidth[iCol] := Round(35 * nMyConst);
        ColWidth[iCol+1] := Round(10 * nMyConst);
        SetSelection(iRow, iCol, iRow, iCol+1);
        mCellFormat := CreateNewCellFormat;
        mCellFormat.MergeCells := true;
        mCellFormat.WordWrap   := false;
        SetCellFormat(mCellFormat);
        TextRC[iRow, iCol] := 'Наименование';
        Inc(iCol, 2);
        TextRC[iRow, iCol] := 'Дебет счёта';
        ColWidth[iCol] := Round(8 * nMyConst);
        Inc(iCol);
        TextRC[iRow, iCol] := 'КЕКВ';
        ColWidth[iCol] := Round(7 * nMyConst);
        Inc(iCol);
        TextRC[iRow, iCol] := 'Кредит счёта';
        ColWidth[iCol] := Round(8 * nMyConst);
        Inc(iCol);
        TextRC[iRow, iCol] := 'Сумма';
        ColWidth[iCol] := Round(15 * nMyConst);
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
        RowHeight[iRow] := Round(2 * nMyConst);
        SetSelection(iRow, 1, iRow, nMaxCol);;
        SetBorder(1, 1, 1, 1, 1, 0, clBlack,
                                  clBlack, clBlack, clBlack, clBlack);
      end;
    end;
    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
begin
  Screen.Cursor := crHourGlass;
  FormZpCmnPrt := TFormZpCmnPrt.Create(Application);
  with FormZpCmnPrt, F6B do begin
    if dDtProc < EncodeDate(2013, 1, 1) then
      cKekv1111 := '1111'
    else
      cKekv1111 := '2111';
    PgSetup := CreateNewPageSetup;
    SetPageParams(PgSetup);
    SetPageSetup(PgSetup);
    DecodeDate(dDtProc, nY, nM, nD);
    ShowGridLines  := false;
    ShowColHeading := true;
    ShowRowHeading := true;
    ShowZeroValues := false;
    ShowTabs       := 0;
    PrintNoColor   := true;
    PrintGridLines := false;
    PrintFooter    := '';
    PrintHeader    := '';
    PrintLandscape := false;
    DefaultFontCharSet := F1RussianCharSet;
    DefaultFontSize := 10;
    bIsNICH := false;
    DmMain.GetPdnInfo(dDtProc, nPrcPdn, nPrcPdn2, nDummy, nDummy, nDummy,
                                     nDummy, nDummy, nDummy, nDummy, nDummy,
                                                             nDummy, nDummy);
    bIsUdVes := false; // Не расчитывались удельные веса в cdsKekv
    nMaxCol := 8;
    nMyConst := RowHeight[1];
    iRow := 1;
    iCol := 1;
    TextRC[iRow, nMaxCol] := cPrtCaption;
    RowHeight[iRow] := Round(1.2 * nMyConst);
    SetSelection(iRow, nMaxCol, iRow, nMaxCol);
    FontUnderLine := true;
    SetAlignment(F1HAlignRight, false, F1VAlignCenter, 0);
    with cdsSpZ do begin
      DisableControls;
      First;
      nStartRow := iRow + 1;
      nPp := 0;
      cSchZp := '6511';     // '661';
      nNumberSchBU := 0;
      while not Eof do begin
        if (FieldByName('VNU').AsInteger > 4) or
                      (FieldByName('Smm').AsFloat = 0) then begin
          Next;
          Continue;
        end;
        cSchBU := FieldByName('SchBU').AsString;
        cNmSchBU := Form_Dm.SchBU2NmSbu(cSchBU);
        if cdsKekv.Active then cdsKekv.Close;
        cdsKekv.FieldDefs.Clear;
        cdsKekv.IndexDefs.Clear;
        cdsKekv.FieldDefs.Add('KEKV', ftString, 4);
        cdsKekv.FieldDefs.Add('SmN', ftFloat);
        cdsKekv.FieldDefs.Add('SmPdN', ftFloat);
        cdsKekv.FieldDefs.Add('SmPfSotr', ftFloat);
        cdsKekv.FieldDefs.Add('UdVes', ftFloat);
        cdsKekv.FieldDefs.Add('SmForPF', ftFloat);
        cdsKekv.FieldDefs.Add('SmToPfPrp', ftFloat);
        cdsKekv.CreateDataSet;
        cdsKekv.AddIndex('OnKekv', 'KEKV', []);
        cdsKekv.IndexName := 'OnKekv';
        cdsKekv.Open;
        Inc(nNumberSchBU);
        if nNumberSchBU > 1 then begin
          Inc(iRow);
          AddRowPageBreak(iRow);
        end;
        ShapkaMo(F6B, nY, nM, iRow, iCol);
        bIsKrtTitle := false;
        bIsDbtTitle := false;
        nSmDolgTM := 0;
        nSmDolgPM := 0;
        nSmVnu_1 := 0;   // для группы больничных видов
        nSmVnu00 := 0;   // для СреднЗП по мобилизации
        nSmVnu01 := 0;   //            виды начилений
        nSmVnu02 := 0;   //            виды удержаний
        nSmVnu03 := 0;   //            прочие (удалил все)
        nSmVnu04 := 0;   //            выплаты и долги (коп., ПМ, ТМ)
        nSmForPrpPfCmn       := 0;
        nSmForPrpPfCmnBln5dn := 0;
