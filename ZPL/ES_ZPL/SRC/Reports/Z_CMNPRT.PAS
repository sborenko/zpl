procedure F6PrtNyByYears(nGodPrc : SmallInt; cdsRpt : TDataSet);
var iRow, nMaxCol, nMyConst, nPp : integer;
    cMsg : ShortString;
    nTtSZ, nTtSZP, nTtSL, nTtBSV, nTtSPD, nTtSPDP, nTtSvP : double;
    PgSetup : F1PageSetup;
begin
  Screen.Cursor := crHourGlass;
  FormZpCmnPrt := TFormZpCmnPrt.Create(Application);
  with FormZpCmnPrt, F6B do begin
    PgSetup := CreateNewPageSetup;
    SetPageParams(PgSetup);
    SetPageSetup(PgSetup);
    nMyConst := RowHeight[1];
    nMaxCol := 9;
    ShowGridLines    := false;
    ShowColHeading   := true;
    ShowRowHeading   := true;
    ShowZeroValues   := false;
    ShowTabs         := 0;
    PrintNoColor     := true;
    PrintGridLines   := false;
    PrintFooter      := '';
    PrintHeader      := '';
    PrintLandscape   := true;
    DefaultFontCharSet := F1RussianCharSet;
    DefaultFontSize := 10;
    iRow := 2;
    ColWidth[1] := Round( 4 * nMyConst);
    ColWidth[2] := Round( 7 * nMyConst);
    ColWidth[3] := Round(15 * nMyConst);
    ColWidth[4] := Round(15 * nMyConst);
    ColWidth[5] := Round(12 * nMyConst);
    ColWidth[6] := Round(12 * nMyConst);
    ColWidth[7] := Round(15 * nMyConst);
    ColWidth[8] := Round(15 * nMyConst);
    ColWidth[9] := Round(15 * nMyConst);
    cMsg := 'Распределение сумм, начисленных в ' + IntToStr(nGodPrc) +
                                                  ' году, по годам "ЗаГод"';
    TextRC[iRow, 1] := cMsg;
    SetSelection(iRow, 1, iRow, nMaxCol);
    SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
    Inc(iRow, 2);
    TextRC[iRow, 1] := '№ п/п';
    TextRC[iRow, 2] := 'За год';
    TextRC[iRow, 3] := 'Начислено зарплаты';
    TextRC[iRow, 4] := 'Подлежит обложению в ПФ';
    TextRC[iRow, 5] := 'В т.ч. больничных';
    TextRC[iRow, 6] := 'В т.ч. декретных';
    TextRC[iRow, 7] := 'Удерж. в ПФ с сотр.';
    TextRC[iRow, 8] := 'Взносы предпр. в ПФ';
    TextRC[iRow, 9] := 'Сумма СверхПорогов';
    SetSelection(iRow, 1, iRow, nMaxCol);
    SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
    SetBorder(1, 1, 1, 1, 1, 0, clBlack, clBlack, clBlack, clBlack, clBlack);
    nPp     := 0;
    nTtSZ   := 0;
    nTtSZP  := 0;
    nTtSL   := 0;
    nTtBSV  := 0;
    nTtSPD  := 0;
    nTtSPDP := 0;
    nTtSvP  := 0;
    with cdsRpt do begin
      First;
      while not Eof do begin
        Inc(iRow);
        Inc(nPp);
        NumberRC[iRow, 1] := nPp;
        NumberRC[iRow, 2] := FieldByName('God').AsInteger;
        SetSelection(iRow, 2, iRow, 2);
        SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);
        NumberRC[iRow, 3] := FieldByName('SZ').AsFloat;
        NumberRC[iRow, 4] := FieldByName('SZP').AsFloat;
        NumberRC[iRow, 5] := FieldByName('SL').AsFloat;
        NumberRC[iRow, 6] := FieldByName('SBSV').AsFloat;
        NumberRC[iRow, 7] := FieldByName('SPD').AsFloat;
        NumberRC[iRow, 8] := FieldByName('SPDP').AsFloat;
        NumberRC[iRow, 9] := FieldByName('SSvPorog').AsFloat;
        SetSelection(iRow, 3, iRow, nMaxCol);
        FormatFixed2;
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetBorder(1, 1, 1, 1, 1, 0, clBlack,clBlack,clBlack,clBlack,clBlack);
        nTtSZ   := nTtSZ   + FieldByName('SZ').AsFloat;
        nTtSZP  := nTtSZP  + FieldByName('SZP').AsFloat;
        nTtSL   := nTtSL   + FieldByName('SL').AsFloat;
        nTtBSV  := nTtBSV  + FieldByName('SBSV').AsFloat;
        nTtSPD  := nTtSPD  + FieldByName('SPD').AsFloat;
        nTtSPDP := nTtSPDP + FieldByName('SPDP').AsFloat;
        nTtSvP  := nTtSvP  + FieldByName('SSvPorog').AsFloat;
        Next;
      end;
      Inc(iRow);
      TextRC[iRow, 1] := 'В с е г о:';
      SetSelection(iRow, 1, iRow, 2);
      SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignBottom, 0);
