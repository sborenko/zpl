procedure F6_PrtVedAlmOLD(dDtProc : TDateTime; cdsAlm : TDataSet;
                            LbxVedType : TListBox; bIsKss, bIsPosta : boolean);
var i, k, iRow, iCol, nStartRow, nMyConst, nMaxCol, nLastKssRow,
                                           nPp, nPage, nKopeek, nSpecNR : integer;
    cMsg, cKssFileNm, cPostaFileNm  : string;
    nY, nM, nD : word;
    PgSetup : F1PageSetup;
    cKuda, cKomu, cPSch : ShortString;
    nSmPerevoda, nSmPsb, nSmNds, nSmBezNds : double;
    nSmPerevodaTts, nSmPsbTts, nSmNdsTts, nSmBezNdsTts : double;
    nKdPst : SmallInt;
    cIsPst: string;
    nColNum: integer;
begin
  Screen.Cursor := crHourGlass;
  FormZpCmnPrt := TFormZpCmnPrt.Create(Application);
  with FormZpCmnPrt, F6B do begin
    PgSetup := CreateNewPageSetup;
    SetPageParams(PgSetup);
    SetPageSetup(PgSetup);
    DecodeDate(dDtProc, nY, nM, nd);
    nMyConst := RowHeight[1];
    ShowGridLines    := false;
    ShowColHeading   := true;
    ShowRowHeading   := true;
    ShowZeroValues   := false;
    ShowTabs         := 0;
    PrintNoColor     := true;
    PrintGridLines   := false;
    PrintFooter      := '';
    PrintHeader      := '';
    PrintLandscape   := false;
    DefaultFontCharSet := F1RussianCharSet;
    DefaultFontSize := 10;
    nLastKssRow := 0;
    if bIsKss then begin
      with cdsTmp do begin
        if Active then Close;
        FieldDefs.Clear;
        IndexDefs.Clear;
        IndexName := '';
        FieldDefs.Add('NR', ftAutoInc);
        FieldDefs.Add('PSch', ftString, 10);
        FieldDefs.Add('KEKV', ftString, 5);
        FieldDefs.Add('SMM', ftFloat);
        CreateDataSet;
        Open;
        IndexDefs.Add('OnPSch', 'PSch', []);
        IndexName := 'OnPSch';
      end;                 // Буду собирать сведения о суммах по PSch
      nMaxCol := 5;
      nPage := 0;
      iRow := 1;
      cMsg := 'Національний університет "Одеська політехніка"';
      TextRC[iRow, 1] := cMsg;
      SetSelection(iRow, 1, iRow, nMaxCol);
      SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
      RowHeight[iRow] := Round(2.5 * nMyConst);
      Inc(iRow);
      cMsg := 'В Е Д О М О С Т Ь   N _______';
      TextRC[iRow, 1] := cMsg;
      SetSelection(iRow, 1, iRow, nMaxCol);
      SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
      Inc(iRow);
      cMsg := 'на выплату алиментов за ' +
                                   MesRus(nM) + ' ' + IntToStr(nY) + ' г.';
      TextRC[iRow, 1] := cMsg;
      SetSelection(iRow, 1, iRow, nMaxCol);
      SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
      Inc(nPage);
      Inc(iRow);
      cMsg := 'Лист ' + IntToStr(nPage);
      TextRC[iRow, nMaxCol] := cMsg;
      SetSelection(iRow, nMaxCol, iRow, nMaxCol);
      SetAlignment(F1HAlignRight, false, F1VAlignCenter, 0);
      Inc(iRow);
      iCol := 1;
      TextRC[iRow, iCol] := '№ п/п';
      ColWidth[iCol] := Round(5 * nMyConst);     // № п/п
      Inc(iCol);
      TextRC[iRow, iCol] := 'Таб. номер';
      ColWidth[iCol] := Round(8 * nMyConst);     // TabN
      Inc(iCol);
      TextRC[iRow, iCol] := 'Фамилия, Имя, Отчество';
      ColWidth[iCol] := Round(40 * nMyConst);    // Komu
      Inc(iCol);
      TextRC[iRow, iCol] := 'Сумма';
      ColWidth[iCol] := Round(12 * nMyConst);    // SmPerevoda
      Inc(iCol);
      TextRC[iRow, iCol] := 'Роспись получателя';
      ColWidth[iCol] := Round(20 * nMyConst);    // Роспись
      SetSelection(iRow, 1, iRow, nMaxCol);
      SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
      SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
      inc(iRow); // пустая строка для Т.Н.
      with cdsAlm do begin
        First;
        nPp := 0;
        nSmPerevodaTts := 0;
        while not Eof do begin
          if (FieldByName('KdPst').AsInteger <> 0) or
                       (FieldByName('SmPerevoda').AsFloat < 0) then begin
            Next;
            Continue;
          end;
          Inc(iRow);
          RowHeight[iRow] := Round(2 * nMyConst);
          Inc(nPp);
          iCol := 1;
          TextRC[iRow, iCol] := IntToStr(nPp);
          SetSelection(iRow, iCol, iRow, iCol);
          SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
          Inc(iCol);
          TextRC[iRow, iCol] := FieldByName('TabN').AsString;
          SetSelection(iRow, iCol, iRow, iCol);
          SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);
          Inc(iCol);
          TextRC[iRow, iCol] := FieldByName('Komu').AsString;
          SetSelection(iRow, iCol, iRow, iCol);
          SetAlignment(F1HAlignLeft, true, F1VAlignBottom, 0);
          Inc(iCol);
          NumberRC[iRow, iCol] := FieldByName('SmPerevoda').AsFloat;
          SetSelection(iRow, iCol, iRow, iCol);
          FormatFixed2;
          nSmPerevodaTts := nSmPerevodaTts + FieldByName('SmPerevoda').AsFloat;
          SetSelection(iRow, 1, iRow, nMaxCol);
          SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
          cPSch := FieldByName('PSch').AsString;
          if not cdsTmp.Locate('PSch', cPSch, []) then begin
            cdsTmp.Append;
            cdsTmp.FieldByName('PSCh').AsString := cPSch; end
          else
            cdsTmp.Edit;
          cdsTmp.FieldByName('SMM').AsFloat :=
                    cdsTmp.FieldByName('SMM').AsFloat +
                                            FieldByName('SmPerevoda').AsFloat;
          cdsTmp.Post;
          Next;
        end;
      end;
      Inc(iRow, 2);
      iCol := 3;
      TextRC[iRow, iCol] := 'Итого по ведомости:';
      SetSelection(iRow, iCol, iRow, iCol);
      SetAlignment(F1HAligncenter, false, F1VAlignBottom, 0);
      iCol := 4;
      NumberRC[iRow, iCol] := nSmPerevodaTts;
      SetSelection(iRow, iCol, iRow, iCol);
      FormatFixed2;
      FontBold := true;
      Inc(iRow, 2);
      RowHeight[iRow] := Round(3.5 * nMyConst);
      cMsg := SumPropis(nSmPerevodaTts, 'w', nKopeek);
      if cMsg <> '' then
        cMsg := AnsiUpperCase(Copy(cMsg, 1, 1)) +
                                Copy(cMsg, 2, Length(cMsg)) + ' грн., '
      else
        cMsg := 'Ноль грн., ';
      if nKopeek <> 0 then begin
        if nKopeek < 10 then
          cMsg := cMsg + '0';
        cMsg := cMsg + IntToStr(nKopeek) + ' коп.'; end
      else
        cMsg := cMsg + '00 коп.';
      iCol := 1;
      TextRC[iRow, iCol] := cMsg;
      SetSelection(iRow, iCol, iRow, nMaxCol);
      FontBold := true;
      FontSize := 12;
      SetAlignment(F1HAlignCenterAcrossCells, true, F1VAlignCenter, 0);
      Inc(iRow, 2);
      cMsg := 'В кассу для выплаты в срок с "__" ______ по "__" ______ ' +
                        IntToStr(nY) + ' г.';
      TextRC[iRow, 1] := cMsg;
      SetSelection(iRow, 1, iRow, nMaxCol);
      SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
      if cdsTmp.RecordCount > 0 then begin
        Inc(iRow);
        cdsTmp.First;
        while not cdsTmp.Eof do begin
          Inc(iRow);
          if cdsTmp.FieldByName('PSch').AsString = '801' then
            cMsg := 'КЕКВ 2111/1:'
          else if cdsTmp.FieldByName('PSch').AsString = '811' then
            cMsg := 'КЕКВ 2111/6:';
          TextRC[iRow, 3] := cMsg;
          SetSelection(iRow, 3, iRow, 3);
          SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);
          NumberRC[iRow, 4] := cdsTmp.FieldByName('SMM').AsFloat;
          SetSelection(iRow, 4, iRow, 4);
          FormatFixed2;
          SetSelection(iRow, 3, iRow, 4);
          SetBorder(1, 1, 1, 1, 1, 0, clBlack,
                                  clBlack, clBlack, clBlack, clBlack);
          cdsTmp.Next;
        end;
      end;
      Inc(iRow, 2);
      TextRC[iRow, nMaxCol] := 'Керiвник __________________';
      SetSelection(iRow, nMaxCol, iRow, nMaxCol);
      SetAlignment(F1HAlignRight, false, F1VAlignCenter, 0);
      Inc(iRow, 2);
      TextRC[iRow, nMaxCol] := 'Гл. бухгалтер __________________';
      SetSelection(iRow, nMaxCol, iRow, nMaxCol);
      SetAlignment(F1HAlignRight, false, F1VAlignCenter, 0);
      Inc(iRow, 2);
      TextRC[iRow, nMaxCol] := 'Бухгалтер __________________ ' +
                                               Form_Dm.KdUsr2FioUsr(nAppKdUsr);
      SetSelection(iRow, nMaxCol, iRow, nMaxCol);
      SetAlignment(F1HAlignRight, false, F1VAlignCenter, 0);
      Inc(iRow, 2);
      TextRC[iRow, 1] := 'По данной ведомости :';
      Inc(iRow, 2);
      TextRC[iRow, 1] := 'выдано __________  депонировано __________  ' +
                                                    'Кассир ____________';
      nLastKssRow := iRow;
      cKssFileNm := RandomFileName;
      if bAppDocsToExcel then begin
        cKssFileNm := cKssFileNm + '.xls';
        WriteEx(cDirTemp + cKssFileNm, F1FileExcel97); end
      else begin
        cKssFileNm := cKssFileNm + '.vts';
        WriteEx(cDirTemp + cKssFileNm, F1FileFormulaOne6);
      end;
      Screen.Cursor := crDefault;
    end;
    if bIsPosta then with cdsAlm do begin
      Screen.Cursor := crHourGlass;
      nMaxCol := 7;
      if bIsKss then // Почистить лист от кассовых дел
        DeleteRange(1, -1, nLastKssRow, -1, F1ShiftRows);
      First;
      iRow := 1;
      while not Eof do begin
        if FieldByName('KdPst').AsInteger = 0 then begin
          Next;
          Continue;
        end;
        nKdPst := FieldByName('KdPst').AsInteger;
        cPSch  := FieldByName('PSch').AsString;
        cIsPst := FieldByName('Is_Pst').AsString;
        Inc(iRow);
        TextRC[iRow, nMaxCol] := 'Счёт ' + cPSch;
        SetSelection(iRow, nMaxCol, iRow, nMaxCol);
        SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
        FontUnderLine := true;
        Inc(iRow);
        cMsg := 'С П И С О К';
        TextRC[iRow, 1] := cMsg;
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
        if (cIsPst = 'Y') then begin
          Inc(iRow);
          cMsg := 'почтовых переводов алиментов,';
          TextRC[iRow, 1] := cMsg;
          SetSelection(iRow, 1, iRow, nMaxCol);
          SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
        end;
        Inc(iRow);
        cMsg := '';
        if (cIsPst = 'Y') then
          cMsg := cMsg + 'поданых в почтовое отделение № ___ ';
        cMsg := cMsg + 'за ' + MesRus(nM) + ' ' + IntToStr(nY) + ' г.';
        TextRC[iRow, 1] := cMsg;
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
        Inc(iRow, 2);
        cMsg := 'Отправитель:   Національний університет "Одеська політехніка"';
        TextRC[iRow, 1] := cMsg;
        RowHeight[iRow] := Round(1.5 * nMyConst);
        SetSelection(iRow, 1, iRow, 1);
        SetAlignment(F1HAlignLeft, false, F1VAlignCenter, 0);
        Inc(iRow);
        cMsg := 'Платежное поручение № _____ от "___" _______ _____ г.';
        TextRC[iRow, 1] := cMsg;
        RowHeight[iRow] := Round(1.5 * nMyConst);
        SetSelection(iRow, 1, iRow, 1);
        SetAlignment(F1HAlignLeft, false, F1VAlignCenter, 0);
        Inc(iRow);
        iCol := 1;
        TextRC[iRow, iCol] := '№ п/п';
        ColWidth[iCol] := Round(4 * nMyConst);     // 1. № п/п
        Inc(iCol);
        TextRC[iRow, iCol] := 'Куда';
        ColWidth[iCol] := Round(34 * nMyConst);    // 2. ФИО
        Inc(iCol);
        TextRC[iRow, iCol] := 'Кому';
        ColWidth[iCol] := Round(25 * nMyConst);    // 3. Komu
        Inc(iCol);
        TextRC[iRow, iCol] := 'Сумма перевода';
        ColWidth[iCol] := Round(9 * nMyConst);    // 4. SmPerevoda
        if (cIsPst = 'Y') then begin
          Inc(iCol);
          TextRC[iRow, iCol] := 'Почтовый сбор';
          ColWidth[iCol] := Round(9 * nMyConst);    // 5. SmPsb
          Inc(iCol);
          TextRC[iRow, iCol] := 'НДС на почтовый сбор';
          ColWidth[iCol] := Round(9 * nMyConst);    // 6. SmNDS
          Inc(iCol);
          TextRC[iRow, iCol] := 'Почтовый сбор без НДС';
          ColWidth[iCol] := Round(9 * nMyConst);    // 7. SmBezNds
          nColNum := nMaxCol;
        end else
          nColNum := nMaxCol - 3;
        SetSelection(iRow, 1, iRow, {nMaxCol} nColNum);
        SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
        SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
        nStartRow := iRow + 1;
        nSmPerevodaTts := 0;
        nSmPsbTts := 0;
        nSmNdsTts := 0;
        nSmBezNdsTts := 0;
        nPp := 0;
        while (FieldByName('KdPst').AsInteger = nKdPst) and
                 (FieldByName('PSch').AsString = cPSch) and not Eof do begin
          nSpecNR := FieldByName('SpecNR').AsInteger;
          cKuda := '';
          cKomu := '';
          nSmPerevoda := 0;
          nSmPsb := 0;
          nSmNds := 0;
          nSmBezNds := 0;
          while (FieldByName('SpecNR').AsInteger = nSpecNR) and
                                                         not Eof do begin
            if FieldByName('Kuda').AsString <> '' then
              cKuda := cKuda + ' ' + FieldByName('Kuda').AsString;
            if FieldByName('Komu').AsString <> '' then
              cKomu := cKomu + ' ' + FieldByName('Komu').AsString;
            nSmPerevoda := nSmPerevoda + FieldByName('SmPerevoda').AsFloat;
            nSmPsb := nSmPsb + FieldByName('SmPsb').AsFloat;
            nSmNds := nSmNds + FieldByName('SmNds').AsFloat;
            nSmBezNds := nSmBezNds + FieldByName('SmBezNds').AsFloat;
            nSmPerevodaTts := nSmPerevodaTts +
                                            FieldByName('SmPerevoda').AsFloat;
            nSmPsbTts := nSmPsbTts + FieldByName('SmPsb').AsFloat;
            nSmNdsTts := nSmNdsTts + FieldByName('SmNds').AsFloat;
            nSmBezNdsTts := nSmBezNdsTts + FieldByName('SmBezNds').AsFloat;
            Next;
          end;
          Inc(nPp);
          Inc(iRow);
          iCol := 1;
          TextRC[iRow, iCol] := IntToStr(nPp) + '.';
          SetSelection(iRow, iCol, iRow, iCol);
          SetAlignment(F1HAlignRight, true, F1VAlignBottom, 0);
          Inc(iCol);
          TextRC[iRow, iCol] := cKuda;
          Inc(iCol);
          TextRC[iRow, iCol] := cKomu;
          SetSelection(iRow, iCol-1, iRow, iCol);
          SetAlignment(F1HAlignLeft, true, F1VAlignBottom, 0);
          Inc(iCol);
          NumberRC[iRow, iCol] := nSmPerevoda;
          if (cIsPst = 'Y') then begin
            Inc(iCol);
            NumberRC[iRow, iCol] := nSmPsb;
            Inc(iCol);
            NumberRC[iRow, iCol] := nSmNds;
            Inc(iCol);
            NumberRC[iRow, iCol] := nSmBezNds;
            nColNum := nMaxCol;
          end else
            nColNum := nMaxCol - 3;
          SetSelection(iRow, iCol-3, iRow, iCol);
          FormatFixed2;
        end;
        SetSelection(nStartRow, 1, iRow, {nMaxCol} nColNum);
        SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
        Inc(iRow);
