            cPole := cPole + IntToStr(i);
            if FieldByName(cPole).AsFloat <> 0 then
              NumberRC[iRow, iCol] := FieldByName(cPole).AsFloat;
            Inc(iCol);
            if (FieldByName('VidN').AsString <> '9999') then begin
              cPole := 'SmZa';
              if i < 10 then
                cPole := cPole + '0';
              cPole := cPole + IntToStr(i);
