          NumberRC[iRow, 4] := FieldByName('KdObj').AsInteger;
          TextRC[iRow, 5]   := FieldByName('VidN').AsString;
          TextRC[iRow, 6]   := FieldByName('ShVidN').AsString;
          TextRC[iRow, 7]   := Copy(FieldByName('DtBeg').AsString, 1, 6) +
                                      Copy(FieldByName('DtBeg').AsString, 9, 2);
          TextRC[iRow, 8]   := FieldByName('NrPrBeg').AsString;
          if not FieldByName('DtPrBeg').IsNull then
            TextRC[iRow, 9] := Copy(FieldByName('DtPrBeg').AsString, 1, 6) +
                                      Copy(FieldByName('DtPrBeg').AsString, 9, 2);
          NumberRC[iRow,10] := FieldByName('Sovm').AsInteger;
          TextRC[iRow, 11]  := FieldByName('Notes').AsString;
          SetSelection(iRow, 1, iRow, nMaxCol);
          SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
          Inc(nCntPgLn);
        end;
        Next;
      end;
      Locate('NR', nSvNR, []);
      EnableControls;
    end;
    cRandomFileName := RandomFileName;
    if bAppDocsToExcel then begin
      cRandomFileName := cRandomFileName + '.xls';
      WriteEx(cDirTemp + cRandomFileName, F1FileExcel97); end
    else begin
      cRandomFileName := cRandomFileName + '.vts';
      WriteEx(cDirTemp + cRandomFileName, F1FileFormulaOne6);
    end;
    Screen.Cursor := crDefault;
    Free;
  end;
  Screen.Cursor := crDefault;
  MyPreView(cDirTemp, cRandomFileName);
end;
