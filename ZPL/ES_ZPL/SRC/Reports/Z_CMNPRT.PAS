procedure F6UniPrt(cTitle : string; dtsUni : TDataSet);
var i, nPp, iRow, iCol, nMaxCol, nMyConst : integer;
    cMsg : string;
    mBookMark : TBookMark;
    PgSetup : F1PageSetup;
begin
  Screen.Cursor := crHourGlass;
  FormZpCmnPrt := TFormZpCmnPrt.Create(Application);
  with FormZpCmnPrt, F6B do begin
    PgSetup := CreateNewPageSetup;
    SetPageParams(PgSetup);
    SetPageSetup(PgSetup);
    nMyConst := RowHeight[1];
    nMaxCol := 0;
    for i := 0 to dtsUni.Fields.Count-1 do begin
      if dtsUni.Fields[i].Visible then
        Inc(nMaxCol);
    end;
    nMaxCol := nMaxCol + 1;  // +1 для "№ п/п"
    ShowGridLines    := false;
    ShowColHeading   := true;
    ShowRowHeading   := true;
    ShowZeroValues   := false;
    ShowTabs         := 0;
    PrintNoColor     := true;
    PrintGridLines   := false;
    PrintFooter      := '';
    PrintHeader      := '';
    PrintLandscape   := false;
    DefaultFontCharSet := F1RussianCharSet;
    DefaultFontSize := 9;
    iRow := 1;
    iCol := 1;
    TextRC[iRow, iCol] := cTitle;
    SetSelection(iRow, 1, iRow, nMaxCol);
    SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
    Inc(iRow);
    cMsg := '' + DateTimeToStr(Now);
    TextRC[iRow, nMaxCol] := cMsg;
    SetSelection(iRow, nMaxCol, iRow, nMaxCol);
    SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
    FontSize := 7;
    Inc(iRow);
    iCol := 1;
    TextRC[iRow, iCol]  := '№ п/п';
    ColWidth[iCol] := Round(5 * nMyConst);
    for i := 0 to dtsUni.Fields.Count-1 do begin
      if dtsUni.Fields[i].Visible then begin
        Inc(iCol);
        TextRC[iRow, iCol] := dtsUni.Fields[i].DisplayLabel;
      end;
    end;
    SetSelection(iRow, 1, iRow, nMaxCol);
    SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
    SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
    nPp := 0;
    with dtsUni do begin
      mBookMark := GetBookMark;
      DisableControls;
      First;
      while not Eof do begin
        Inc(nPp);
        Inc(iRow);
        iCol := 1;
        NumberRC[iRow, iCol] := nPp;
        for i := 0 to dtsUni.Fields.Count-1 do begin
          if dtsUni.Fields[i].Visible then begin
            Inc(iCol);
            if (dtsUni.Fields[i].DataType in
                        [ftSmallint, ftInteger, ftWord]) then
              NumberRC[iRow, iCol] := dtsUni.Fields[i].AsInteger
            else if (dtsUni.Fields[i].DataType in
                       [ftString,ftDate, ftTime, ftDateTime, ftTimeStamp]) then
              TextRC[iRow, iCol] := dtsUni.Fields[i].AsString
            else if (dtsUni.Fields[i].DataType in
                           [ftFloat, ftCurrency, ftBCD]) then begin
              NumberRC[iRow, iCol] := dtsUni.Fields[i].AsFloat;
              SetSelection(iRow, iCol, iRow, iCol);
              FormatFixed2; end
            else
              TextRC[iRow, iCol] := dtsUni.Fields[i].AsString;
          end;
        end;
        SetColWidthAuto(iRow, 2, iRow, nMaxCol, false);
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
        Next;
      end;
      GoToBookMark(mBookMark);
      FreeBookMark(mBookMark);
      EnableControls;
    end;
    Inc(iRow, 2);
    TextRC[iRow, nMaxCol] := 'Бухгалтер ____________ ' +
                                               Form_Dm.KdUsr2FioUsr(nAppKdUsr);
    SetSelection(iRow, nMaxCol, iRow, nMaxCol);
    SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
    Screen.Cursor := crHourGlass;
    cRandomFileName := RandomFileName;
    if bAppDocsToExcel then begin
      cRandomFileName := cRandomFileName + '.xls';
      WriteEx(cDirTemp + cRandomFileName, F1FileExcel97); end
    else begin
      cRandomFileName := cRandomFileName + '.vts';
      WriteEx(cDirTemp + cRandomFileName, F1FileFormulaOne6);
    end;
    Screen.Cursor := crDefault;
    Free;
  end;
  MyPreView(cDirTemp, cRandomFileName);
end;
