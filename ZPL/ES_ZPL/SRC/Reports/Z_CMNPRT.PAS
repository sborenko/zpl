    ColWidth[4]  := Round( 8 * nMyConst);  // НР в Кмд'
    ColWidth[5]  := Round( 8 * nMyConst);  // Р_Мес в Кмд
    ColWidth[6]  := Round(11 * nMyConst);  // Дата начала
