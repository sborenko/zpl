procedure F6_PrtActiveAlm(dDtPrc, dDtLastPrc : TDateTime;
                                  qryAlm, qryUdrg : TQuery; bPrtAll : boolean);
var nSvTabN, iRow, nMyConst, nPp, nMaxCol : integer;
    cMsg : ShortString;
    PgSetup : F1PageSetup;
    nY, nM, nD : word;
begin
  Screen.Cursor := crHourGlass;
  FormZpCmnPrt := TFormZpCmnPrt.Create(Application);
  with FormZpCmnPrt, F6B do begin
    PgSetup := CreateNewPageSetup;
    SetPageParams(PgSetup);
    SetPageSetup(PgSetup);
    nMyConst := RowHeight[1];
    ShowGridLines    := false;
    ShowColHeading   := true;
    ShowRowHeading   := true;
    ShowZeroValues   := false;
    ShowTabs         := 0;
    PrintNoColor     := true;
    PrintGridLines   := false;
    PrintFooter      := '';
    PrintHeader      := '';
    PrintLandscape   := true;
    DefaultFontCharSet := F1RussianCharSet;
    DefaultFontSize := 10;
    nMaxCol := 9;
    nPp := 0;
    ColWidth[1] := Round(10 * nMyConst);  // Дата начала
    ColWidth[2] := Round(10 * nMyConst);  // Дата оконч.
    ColWidth[3] := Round(10 * nMyConst);  // Сумма(%)
    ColWidth[4] := Round( 3 * nMyConst);  // %
    ColWidth[5] := Round(12 * nMyConst);  // Документ
    ColWidth[6] := Round(30 * nMyConst);  // Получатель
    ColWidth[7] := Round(40 * nMyConst);  // Адрес
    ColWidth[8] := Round( 7 * nMyConst);  // Почта
    ColWidth[9] := Round( 7 * nMyConst);  // % п/сб.
    iRow := 1;
    DecodeDate(dDtPrc, nY, nM, nD);
    cMsg := 'Список плательщиков алиментоа по состоянию на ' +
                               MesRus(nM) + ' ' + IntToStr(nY) + ' г.';
    TextRC[iRow, 1] := cMsg;
    SetSelection(iRow, 1, iRow, nMaxCol);
    SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
    RowHeight[iRow] := Round(1.5 * nMyConst);
    FontSize := 11;
    FontBold := true;
    Inc(iRow);
    RowHeight[iRow] := Round(2.5 * nMyConst);
    SetSelection(iRow, 1, iRow, nMaxCol);
    SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
    SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
    TextRC[iRow, 1] := 'Дата начала';
    TextRC[iRow, 2] := 'Дата оконч.';
    TextRC[iRow, 3] := 'Сумма(%)';
    TextRC[iRow, 4] := '%';
    TextRC[iRow, 5] := 'Документ';
    TextRC[iRow, 6] := 'Получатель';
    TextRC[iRow, 7] := 'Адрес';
    TextRC[iRow, 8] := 'Почта';
    TextRC[iRow, 9] := '% п/сб.';
    with qryAlm do begin
      nSvTabN := FieldByName('TabN').AsInteger;
      //DisableControls;
      First;
      while not Eof do begin
        if not bPrtAll and FieldByName('Uvolen').AsBoolean then begin
          Next;
          Continue;
        end;
        Inc(iRow);
        Inc(nPp);
        NumberRC[iRow, 1] := nPp;
        TextRC[iRow, 2] := 'ТабНр ' + FieldByName('TabN').AsString +
                                     ' ' + FieldByName('FamIO').AsString;
        SetSelection(iRow, 2, iRow, nMaxCol);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignBottom, 0);
        SetSelection(iRow, 1, iRow, nMaxCol);
        FontSize := 11;
        FontItalic := true;
        if not FieldByName('Uvolen').AsBoolean then
          FontBold := true;
        SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
        qryUdrg.First;
        while not qryUdrg.Eof do begin
          if (qryUdrg.FieldByName('Dt_Beg').AsDateTime < dDtLastPrc) and
               ((qryUdrg.FieldByName('Dt_End').IsNull) or
                (qryUdrg.FieldByName('Dt_End').AsDateTime >= dDtPrc)) then begin
            Inc(iRow);
            TextRC[iRow, 1] := qryUdrg.FieldByName('Dt_Beg').AsString;
            TextRC[iRow, 2] := qryUdrg.FieldByName('Dt_End').AsString;
            NumberRC[iRow, 3] := qryUdrg.FieldByName('SumVzn').AsFloat;
            SetSelection(iRow, 3, iRow, 3);
            FormatFixed2;
            TextRC[iRow, 4] := qryUdrg.FieldByName('SP').AsString;
            TextRC[iRow, 5] := qryUdrg.FieldByName('NomDok').AsString;
            TextRC[iRow, 6] := qryUdrg.FieldByName('Komu').AsString;
            TextRC[iRow, 7] := qryUdrg.FieldByName('Adres').AsString;
            SetSelection(iRow, 5, iRow, 7);
            SetAlignment(F1HAlignLeft, true, F1VAlignBottom, 0);
            TextRC[iRow, 8] := qryUdrg.FieldByName('ShPst').AsString;
            NumberRC[iRow, 9] := qryUdrg.FieldByName('PrcPsb').AsFloat;
            SetSelection(iRow, 9, iRow, 9);
            FormatFixed2;
            SetSelection(iRow, 1, iRow, nMaxCol);
            SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
          end;
          qryUdrg.Next;
        end;
        Next;
      end;
      Locate('TabN', nSvTabN, []);
      EnableControls;
    end;
    cRandomFileName := RandomFileName;
    if bAppDocsToExcel then begin
      cRandomFileName := cRandomFileName + '.xls';
      WriteEx(cDirTemp + cRandomFileName, F1FileExcel97); end
    else begin
      cRandomFileName := cRandomFileName + '.vts';
      WriteEx(cDirTemp + cRandomFileName, F1FileFormulaOne6);
    end;
    Screen.Cursor := crDefault;
    Free;
  end;
  Screen.Cursor := crDefault;
  MyPreView(cDirTemp, cRandomFileName);
end;
