            SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
            qryTmp2.First;
            nPp := 0;
            while not qryTmp2.Eof do begin
              Inc(iRow);
              Inc(nPp);
              // Inc(nCntLineInSch);
              NumberRC[iRow, 1] := nPp;
              cVidN := qryTmp2.FieldByName('VidN').AsString;
              TextRC[iRow, 2] := cVidN;
              if (cVidN <> '8713') and (cVidN <> '8717') then begin
                SetSelection(iRow, 3, iRow, 4);
                mCellFormat := CreateNewCellFormat;
                mCellFormat.MergeCells := true;
                mCellFormat.WordWrap   := false;
                SetCellFormat(mCellFormat);
                TextRC[iRow, 3] := qryTmp2.FieldByName('NmVidN').AsString;
                TextRC[iRow, 5] := 
                    DMAccMap.MapAccounts(cSchBU, '', PaymentAcc).Accnt;
                TextRC[iRow, 6] := qryTmp2.FieldByName('Vid_KEKV').AsString;
                TextRC[iRow, 7] := qryTmp2.FieldByName('Vid_SPZ').AsString;
                SetSelection(iRow, 5, iRow, 7);
                SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);
                if (cVidN = '8711') or (cVidN = '8712') or
                                  (cVidN = '8715') or (cVidN = '8716') then
                  nEsvPrpDoMinZp := nEsvPrpDoMinZp +
                                        qryTmp2.FieldByName('SMM').AsFloat;
                NumberRC[iRow, 8] := -qryTmp2.FieldByName('SMM').AsFloat; end
              else begin
                TextRC[iRow, 3] := qryTmp2.FieldByName('NmVidN').AsString;
                NumberRC[iRow, 4] := qryTmp2.FieldByName('SMM').AsFloat;
              end;
              SetSelection(iRow, 8, iRow, 8);
              FormatFixed2;
              SetSelection(iRow, 1, iRow, nMaxCol);
              SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
              qryTmp2.Next;
            end;
            Inc(iRow);
            TextRC[iRow, 1] := 'Всього обов`язкових платежів до рівня ' +
                                                  'мін. з/пл:';
            SetSelection(iRow, 1, iRow, 7);
            SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignBottom, 0);
            FontItalic := true;
            SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
            NumberRC[iRow, 8] := -nEsvPrpDoMinZp;
            SetSelection(iRow, 8, iRow, 8);
            FormatFixed2;
            SetSelection(iRow, 1, iRow, nMaxCol);
            FontItalic := true;
            SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
          end;
          Inc(iRow);
          RowHeight[iRow] := Round(0.3 * nMyConst);
          SetSelection(iRow, 1, iRow, nMaxCol);
          SetBorder(1,0,0,0,0,0,clBlack,clBlack,clBlack,clBlack,clBlack);
          Inc(iRow);
          SetSelection(iRow, 1, iRow, nMaxCol-1);
          SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignBottom, 0);
          TextRC[iRow, 1] := 'Всього обов`язкових платежів:';
          FontBold := true;
          nSmPrpItg := nSmPrpItg + -nEsvPrpDoMinZp;
          NumberRC[iRow, 8] := nSmPrpItg;
          SetSelection(iRow, 8, iRow, 8);
          FormatFixed2;
          SetSelection(iRow, 1, iRow, nMaxCol);
          FontBold := true;
          SetSelection(iRow, 1, iRow, nMaxCol);
          SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
          Inc(iRow);
          RowHeight[iRow] := Round(0.3 * nMyConst);
          SetSelection(iRow, 1, iRow, nMaxCol);
          SetBorder(1,0,0,0,0,0,clBlack,clBlack,clBlack,clBlack,clBlack);
          Inc(iRow);
          RowHeight[iRow] := Round(1.5 * nMyConst);
          cMsg := 'Всього обертів по М/О';
          TextRC[iRow, 1] := cMsg;
          SetSelection(iRow, 1, iRow, nMaxCol-1);
          SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
          NumberRC[iRow, 8] := RoundTo(nSmVnu_1 + nSmVnu00 + nSmVnu01, -2) +
                                   RoundTo(nSmVnu02 + nSmVnu03 + nSmVnu04, -2) +
                                                         RoundTo(nSmPrpItg, -2);
          SetSelection(iRow, nMaxCol, iRow, nMaxCol);
          SetAlignment(F1HAlignRight, false, F1VAlignCenter, 0);
          FormatFixed2;
          SetSelection(iRow, 1, iRow, nMaxCol);
          FontBold := true;
          FontSize := 11;
          SetColWidthAuto(iRow, 8, iRow, 8, false);
          SetSelection(iRow, 1, iRow, nMaxCol);
          SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
        end;
        nSmVnu04 := 0;

        Inc(iRow, 2);
        cMsg := 'Заступник головнго бухгалтера ____________ ' +
          Form_Dm.KdUsr2FioUsr(102);
        TextRC[iRow, nMaxCol] := cMsg;
        SetSelection(iRow, nMaxCol, iRow, nMaxCol);
        SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);

        Inc(iRow, 2);
        cMsg := 'Бухгалтер ____________ ' + Form_Dm.KdUsr2FioUsr(nAppKdUsr);
        TextRC[iRow, nMaxCol] := cMsg;
        SetSelection(iRow, nMaxCol, iRow, nMaxCol);
        SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
      end; {while cdsSPZ}
      First;
      EnableControls;
    end; {with cdsSPZ}
    cRandomFileName := RandomFileName;
    if bAppDocsToExcel then begin
      cRandomFileName := cRandomFileName + '.xls';
      WriteEx(cDirTemp + cRandomFileName, F1FileExcel97); end
    else begin
      cRandomFileName := cRandomFileName + '.vts';
      WriteEx(cDirTemp + cRandomFileName, F1FileFormulaOne6);
    end;
    Screen.Cursor   := crDefault;
    Free;
  end;

  DmAccMap.Free;

  Screen.Cursor := crDefault;
  MyPreView(cDirTemp, cRandomFileName);
end;  {F6AnalitMo2011}

//===============  Печать МО сборному (синтетическому) счёту ===================
procedure F6SintMo2011(bFinal : boolean; cdsSpZ, cdsPrp : TDataSet;
                                    dDtProc : TDateTime; cPrtCaption : string);
var nMyConst, iRow, iCol, nMaxCol, nStartRow, nPp, nCntLineInSch : integer;
    cMsg, cVidNotes, cKrSch, cSchZp, cPSch,
                     cNmPSch, cNmVidN, cKEKV, cKekv1111, cTmpSch : ShortString;
    cVidN : string4;
    nSvNR, nCntStrok : integer;
    nSmVidN, nSmKrSch, nSmDolgTM, nSmDolgPM : double;
    nSmVnu_1, nSmVnu00, nSmVnu01, nSmVnu02, nSmVnu03, nSmVnu04 : double;
    nSmSch, nSmNach, nSmUdrg, nSmTots, nSmPrpItg : double;
    nNumberPSCH, nY, nM, nD : word;
    bIsKrtTitle, bIsDbtTitle : boolean;
    nSmForPrpCmn, nSmForPrpPps, nSmForPrpInvCmn, nSmForPrpInvPps,
                                      nSmForPrpBln, nSmForPrpDgv,
    nSmSvPrgCmn, nSmSvPrgPps, nSmSvPrgInvCmn, nSmSvPrgInvPps,
                                      nSmSvPrgBln, nSmSvPrgDgv,
    nSmToPrpCmn, nSmToPrpPps, nSmToPrpInvCmn, nSmToPrpInvPps,
                                      nSmToPrpBln, nSmToPrpDgv : double;
    cSchToPrpCmn, cSchToPrpPps,
                  cSchToPrpBln, cSchToPrpDgv, cSchToPrpInv : ShortString;
    nPrtObj, nVNU : integer;   // -1 для группы больничных (только за сч.СС)
                               // 0           вид 1210 СреднДляМобилизованных
                               // 1           виды начислений
                               // 2           виды удержаний
                               // 3           прочие (удалил все)
                               // 4           выплаты и долги (коп., ПМ, ТМ)
    // сортировка табл0ицы KdObj;VNU;SchBU;VidN
    nCntPSCH : integer;
    cTmp : string; cRoot : string3; nCntInRoot : integer; nSmRoot : double;
    PgSetup : F1PageSetup;
    {nSmDbg,} nSmTmp, nSmSldPN, nSmmFor, nSmmPrg : double;
    nSmBnk101, nSmBnkOther : double;
    dDt_2009_04 : TDateTime;
    nGrp, nCntBnk : SmallInt;
    i, iKekv : SmallInt;
    cSp_PF : ShortString;
    bIsNICH, bIsUdVes : boolean;
    nPrcPdN, nDummy, nSmPdN, nPrcPdn2, nSmKekvTt, nSmOst, nSmKekv : double;
    nSmFor, nSmSvPrg, nSmTo, nTmp, nSmToGrp, nPrcCmn, nPrcPps,
                        nPrcBln, nPrcBlnInv, nPrcDkr, nPrcDgv, nPrcInv : double;
    nEsvPrpDoMinZp, nSmDbg : double;

    DmAccMap: TDMAccMap;
    MapInfo: TMapInfo;

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    procedure ShapkaMo(F6B : TF6Book; nY, nM : word; var iRow, iCol : integer);
    var cMsg : ShortString;
    begin
      with F6B do begin
        Inc(iRow);
        iCol := 1;
        TextRC[iRow, iCol] := 'Національний унiверситет "Одеська полiтехнiка"';
        SetSelection(iRow, iCol, iRow, nMaxCol);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
        FontSize := 10;
        FontBold := true;
        Inc(iRow);
        TextRC[iRow, iCol] := 'ЄДРПОУ 43861328';
        SetSelection(iRow, iCol, iRow, nMaxCol);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
        Inc(iRow);
        Inc(iRow);
        cMsg := 'Меморіальний ордер';
        if MapInfo.MemOrdNm <> '' then
          cMsg := cMsg + ' № ' + MapInfo.MemOrdNm;
        TextRC[iRow, iCol] := cMsg;
        RowHeight[iRow] := Round(1.2 * nMyConst);
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
        FontSize := 10;
        FontBold := true;
        Inc(iRow);
        if (cPSCH = '801/1-1') or (cPSCH = '801/1-2') or (cPSCH = '823/1') then
          bIsNICH := true;
        cMsg := 'Рахунок ' + MapInfo.Accnt + ' ' + MapInfo.AccNm;
        TextRC[iRow, iCol] := cMsg;
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
        Inc(iRow);
        cMsg := 'за ' + UkrMes(nM) + ' ' + IntToStr(nY) + ' року';
        TextRC[iRow, iCol] := cMsg;
        RowHeight[iRow] := Round(1.2 * nMyConst);
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
        FontSize := 10;
        FontBold := true;
        Inc(iRow);
        iCol := 1;
        TextRC[iRow, iCol] := '№ з/п';
        ColWidth[iCol] := Round(4 * nMyConst);
        Inc(iCol);
        TextRC[iRow, iCol] := 'Вид';
        ColWidth[iCol] := Round(5 * nMyConst);
        Inc(iCol);
        ColWidth[iCol] := Round(35 * nMyConst);
        ColWidth[iCol+1] := Round(10 * nMyConst);
        SetSelection(iRow, iCol, iRow, iCol+1);
        mCellFormat := CreateNewCellFormat;
        mCellFormat.MergeCells := true;
        mCellFormat.WordWrap   := false;
        SetCellFormat(mCellFormat);
        TextRC[iRow, iCol] := 'Найменування';
        Inc(iCol, 2);
        TextRC[iRow, iCol] := 'Дебет рахунку';
        ColWidth[iCol] := Round(8 * nMyConst);
        Inc(iCol);
        TextRC[iRow, iCol] := 'КЕКВ';
        ColWidth[iCol] := Round(7 * nMyConst);
        Inc(iCol);
        TextRC[iRow, iCol] := 'Кредит рахунку';
        ColWidth[iCol] := Round(8 * nMyConst);
        Inc(iCol);
        TextRC[iRow, iCol] := 'Сума';
        ColWidth[iCol] := Round(15 * nMyConst);
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
        RowHeight[iRow] := Round(2 * nMyConst);
        SetSelection(iRow, 1, iRow, nMaxCol);;
        SetBorder(1, 1, 1, 1, 1, 0, clBlack,clBlack,clBlack,clBlack,clBlack);
      end;
    end;
    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
begin
  DmAccMap := TDmAccMap.Create(nil);

  dDt_2009_04 := EncodeDate(2009, 4, 1);
  if dDtProc < EncodeDate(2013, 1, 1) then
    cKekv1111 := '1111'
  else
    cKekv1111 := '2111';
  Screen.Cursor := crHourGlass;
  FormZpCmnPrt := TFormZpCmnPrt.Create(Application);
  with FormZpCmnPrt, F6B do begin
    PgSetup := CreateNewPageSetup;
    SetPageParams(PgSetup);
    SetPageSetup(PgSetup);
    DecodeDate(dDtProc, nY, nM, nD);
    ShowGridLines  := false;
    ShowColHeading := true;
    ShowRowHeading := true;
    ShowZeroValues := false;
    ShowTabs       := 0;
    PrintNoColor   := true;
    PrintGridLines := false;
    PrintFooter    := '';
    PrintHeader    := '';
    PrintLandscape := false;
    DefaultFontCharSet := F1RussianCharSet;
    DefaultFontSize := 10;
    bIsNICH := false;
    DmMain.GetPdnInfo(dDtProc, nPrcPdn, nPrcPdn2, nDummy, nDummy, nDummy,
                                  nDummy, nDummy, nDummy, nDummy, nDummy,
                                                            nDummy, nDummy);
    bIsUdVes := false; // Не расчитывались удельные веса в cdsKekv
    nMaxCol := 8;
    nMyConst := RowHeight[1];
    iRow := 1;
    iCol := 1;
    TextRC[iRow, nMaxCol] := cPrtCaption;
    RowHeight[iRow] := Round(1.2 * nMyConst);
    SetSelection(iRow, nMaxCol, iRow, nMaxCol);
    FontUnderLine := true;
    SetAlignment(F1HAlignRight, false, F1VAlignCenter, 0);
    with cdsSpZ do begin          // Сортировка cdsSpZ - 'PSch;SchBU;VNU;VidN'
      DisableControls;
      First;
      nStartRow := iRow + 1;
      cSchZp := '6511';                // до 2017 г. '661';
      nNumberPSCH := 0;
      while not Eof do begin
        if (FieldByName('VNU').AsInteger > 4) {взносы прп пока пропускаю} or
                     (FieldByName('Smm').AsFloat = 0) then begin
          Next;
          Continue;
        end;
        nPp := 0;
        cPSCH := FieldByName('PSch').AsString;   ///////////////
        // cPSCH := Trim(FieldByName('PSch').AsString);   ///////////////
        cNmPSch := Form_Dm.SchBu22NmSbu(cPSch);

        MapInfo := DMAccMap.MapAccounts(cPSCH, cNmPSch, BaseAcc);

        Inc(nNumberPSCH);
        if nNumberPSCH > 1 then begin
          Inc(iRow);
          AddRowPageBreak(iRow);
        end;
        ShapkaMo(F6B, nY, nM, iRow, iCol);  ////////////////////
        bIsKrtTitle := false;
        bIsDbtTitle := false;
        nSmDolgTM := 0;
        nSmDolgPM := 0;
        nSmVnu_1 := 0;   // для группы больничных видов
        nSmVnu00 := 0;   //            вид 1210 СрДляМобилизованных
        nSmVnu01 := 0;   //            виды начилений
        nSmVnu02 := 0;   //            виды удержаний
        nSmVnu03 := 0;   //            прочие (удалил все)
        nSmVnu04 := 0;   //            выплаты и долги (коп., ПМ, ТМ)
        nSmSldPN := 0;   // для скорректированной суммы Сальдо на конец месяца
        // Сортировка cdsZpZ - 'PSch;SchBU;VNU;VidN'
        nEsvPrpDoMinZp := 0;
        while (FieldByName('PSch').AsString = cPSCH) and not Eof do begin
          nVNU := FieldByName('VNU').AsInteger;
          if (nVNU < 2) and not bIsKrtTitle then begin
            cMsg := 'Кредит рахунку ' + cSchZp + ' в дебет рахунку:';
            Inc(iRow);
            TextRC[iRow, 1] := cMsg;
            SetSelection(iRow, 1, iRow, nMaxCol);
            SetBorder(1,0,0,0,0,0,clBlack,clBlack,clBlack,clBlack,clBlack);
            SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
            FontBold := true;
            FontUnderLine := true;
            bIsKrtTitle := true; end
          else if (nVNU = 2) and not bIsDbtTitle then begin
            if (nSmVnu_1 <> 0) or (nSmVnu00 <> 0) or (nSmVnu01 <> 0) then begin
              Inc(IRow);
              SetSelection(iRow, 1, iRow, nMaxCol-1);
              mCellFormat := CreateNewCellFormat;
              mCellFormat.AlignHorizontal := F1HAlignCenter;
              mCellFormat.AlignVertical := F1VAlignBottom;
              mCellFormat.MergeCells := true;
              mCellFormat.WordWrap   := false;
              mCellFormat.FontBold   := true;
              SetCellFormat(mCellFormat);
              TextRC[iRow, 1] := 'Всього по видах нарахування:';
              NumberRC[iRow, 8] := nSmVnu_1 + nSmVnu00 + nSmVnu01;
              SetSelection(iRow, 8, iRow, 8);
              FontBold := true;
              FormatFixed2;
              SetSelection(iRow, 1, iRow, nMaxCol);
              SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
              Inc(iRow);
              SetSelection(iRow, 1, iRow, nMaxCol);
              SetBorder(1,0,0,0,0,0,clBlack,clBlack,clBlack,clBlack,clBlack);
            end;
            cMsg := 'Дебет рахунку ' + cSchZp + ' в кредит рахунку:';
            Inc(iRow);
            TextRC[iRow, 1] := cMsg;
            SetSelection(iRow, 1, iRow, nMaxCol);
            SetBorder(1,0,0,0,0,0,clBlack,clBlack,clBlack,clBlack,clBlack);
            SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
            FontBold := true;
            FontUnderLine := true;
            bIsDbtTitle := true;
          end;
          while (FieldByName('VNU').AsInteger = nVNU) and
                  (FieldByName('PSch').AsString = cPSCH) and not Eof do begin
            if (FieldByName('VNU').AsInteger >= 4) and
                       (FieldByName('Smm').AsFloat = 0) then begin
              Next;
              Continue; end
            else begin
              cKrSch := FieldByName('KrSch').AsString;
              nSmKrSch := 0;
              nCntLineInSch := 0;
              while (FieldByName('KrSch').AsString = cKrSch) and
                                                             not Eof do begin
                Inc(nCntLineInSch);
                cVidN := FieldByName('VidN').AsString;
                cNmVidN := FieldByName('NmVidN').AsString;
                cKEKV := FieldByName('Vid_KEKV').AsString;
                nSmVidN := 0;
                cSp_PF := FieldByName('SP_PF').AsString;
                while (FieldByName('VidN').AsString = cVidN) and
                                                             not Eof do begin
                  if (cVidN = '6001') and
                                 (FieldByName('My_NR').AsInteger = -111) then
                    nSmSldPN := FieldByName('Smm').AsFloat;
                  nSmVidN := nSmVidN + FieldByName('Smm').AsFloat;
                  if (cVidN = '2723') or (cVidN = '6623') then
                    // возврат и удержание копеек - просто пропускю
                  else if cVidN = '2724' then
                    nSmDolgTM := nSmDolgTM + FieldByName('Smm').AsFloat
                  else if cVidN = '6624' then
                    nSmDolgPM := nSmDolgPM - FieldByName('Smm').AsFloat
                                           // будет плюсовым, хотя удерж.
                  else if cVidN < '6000' then
                    nSmKrSch := nSmKrSch + FieldByName('Smm').AsFloat
                  else if cVidN < '8600' then
                    nSmKrSch := nSmKrSch - FieldByName('Smm').AsFloat;
                  Next;
                end;
                if (cVidN <> '2723') and (cVidN <> '2724') and
                      (cVidN <> '6623') and (cVidN <> '6624') and
                          ((cVidN < '5000') or (cVidN >= '6000')) and
                                                 (cVidN < '8600') then begin
                  Form_Dm.GetEsvPrc(dDtProc, nPrcCmn, nPrcPps, nPrcBln,
                                                              nPrcDkr, nPrcDgv);
                  Inc(nPp);
                  Inc(iRow);
                  NumberRC[iRow, 1] := nPp;
                  TextRC[iRow, 2] := cVidN;
                  SetSelection(iRow, 2, iRow, 2);
                  SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);
                  SetSelection(iRow, 3, iRow, 4);
                  mCellFormat := CreateNewCellFormat;
                  mCellFormat.MergeCells := true;
                  mCellFormat.WordWrap   := false;
                  mCellFormat.FontSize := 8;
                  SetCellFormat(mCellFormat);
                  cMsg := cNmVidN;
                  if (cVidN = '6001') and (nSmSldPN <> 0) then begin
                    //nSmDbg := nSmSldPN - nSmVidN;
                    //if bFlagDbg then
                    //   ShowMessage('nSmVidN = ' + FloatToStr(nSmVidN) +
                    //               ' nSmSldPN = ' + FloatToStr(nSmSldPN) +
                    //               ' nSmDbg = ' + FloatToStr(nSmDbg));
                    nSmTmp := nSmSldPN - nSmVidN;
                    cMsg := cMsg + ' (' + FloatToStrF(nSmTmp, ffNumber, 18, 2);
                    if nSmSldPN > 0 then
                      cMsg := cMsg + ' - '
                    else
                      cMsg := cMsg + ' + ';
                    nSmSldPN := Abs(nSmSldPN);
                    cMsg := cMsg + FloatToStrF(nSmSldPN,ffNumber,18,2) + ' = ';
                    cMsg := cMsg +
                            FloatToStrF(-nSmVidN, ffNumber, 18, 2) + ')'; end
                  else if cVidN = '6201' then begin
                    if cdsPrp.Locate('PSch;VidN',
                                   VarArrayOf([cPSch,cVidN]), []) then begin
                      nSmFor := cdsPrp.FieldByName('SmFor').AsFloat;
                      nSmSvPrg := cdsPrp.FieldByName('SmSvPrg').AsFloat;
                      //nSmTo := cdsPrp.FieldByName('SmTo').AsFloat;
                      cMsg := cMsg + ' ' + FloatToStr(nPrcCmn) + '% (' +
                                          FloatToStrF(nSmFor, ffFixed, 18, 2);
                      if nSmSvPrg <> 0 then begin
                        cMsg := cMsg + ' - ' +
                                        FloatToStrF(nSmSvPrg, ffFixed, 18, 2);
                        cMsg := cMsg + ' = ' +
                                  FloatToStrF(nSmFor-nSmSvPrg, ffFixed, 18, 2);
                      end;
                      cMsg := cMsg + ')';
                    end; end
                  else if cVidN = '6206' then begin
                    if cdsPrp.Locate('PSch;VidN',
                                   VarArrayOf([cPSch,cVidN]), []) then begin
                      nSmFor := cdsPrp.FieldByName('SmFor').AsFloat;
