function TFormZpCmnPrt.GetNameFileOpu(dDtPrdFile : TDateTime;
                                           nNrPrdFile : integer) : ShortString;
var nY, nM, nD : word;
begin
(*  Так было до декабря 2008 г.
  DecodeDate(dDtPrdFile, nY, nM, nD);
  Result := 'z';
  if nD < 10 then
    Result := Result + '0';
  Result := Result + IntToStr(nD);
  if nM < 10 then
    Result := Result + '0';
  Result := Result + IntToStr(nM);
  Result := Result + Copy(IntToStr(nY), 3, 2);
  Result := Result + IntToStr(nNrPrdFile);
*)
  DecodeDate(dDtPrdFile, nY, nM, nD);
  Result := '#43861328';       // Решеточка и ОКПО ОПИ
  if nD < 10 then
    Result := Result + '0';
  Result := Result + IntToStr(nD);
  if nM < 10 then
    Result := Result + '0';
  Result := Result + IntToStr(nM);
  Result := Result + Copy(IntToStr(nY), 3, 2);  // Дата ДДММГГ
  //Result := Result + IntToStr(nNrPrdFile); nNrPrdFile перешел в расширение
end;
