procedure PrtNichVed(cdsSps : TDataSet; dDtPrc : TDateTime);
var nPp, iRow, iCol, nMaxCol, nMyConst : integer;
    cMsg : string;
    nY, nM, nD : word;
    PgSetup : F1PageSetup;
    cPSCH, cSchBU, cSchMsg, cHeadMsg : ShortString;
    nTabN : integer;
    nCntInTabN, nCntNach : SmallInt;
    nSmN, nSmU, nSmNTema, nSmUTema : double;
    bFirstVidUdrg : boolean;
    cVidN, cShVidN : ShortString;
    nSmVida : double;
    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    procedure ShapSmallNichVed(F6B : TF6Book; var iRow, iCol : integer);
    begin
      with F6B do begin
        Inc(iRow);
        iCol := 1;
        TextRC[iRow, iCol]  := '№ п/п';
        ColWidth[iCol] := Round(4 * nMyConst);
        Inc(iCol);
        TextRC[iRow, iCol] := 'Таб. н-р';
        ColWidth[iCol] := Round(6 * nMyConst);
        Inc(iCol);
        TextRC[iRow, iCol] := 'Фамилия И.О.';
        ColWidth[iCol] := Round(25 * nMyConst);
        Inc(iCol);
        TextRC[iRow, iCol] := 'Оклад (Тариф)';
        ColWidth[iCol] := Round(9 * nMyConst);
        Inc(iCol);
        TextRC[iRow, iCol] := 'Дн ей';
        ColWidth[iCol] := Round(4 * nMyConst);
        Inc(iCol);
        TextRC[iRow, iCol] := 'Вид';
        ColWidth[iCol] := Round(6 * nMyConst);
        Inc(iCol);
        TextRC[iRow, iCol] := 'Шифр вида';
        ColWidth[iCol] := Round(15 * nMyConst);
        Inc(iCol);
        TextRC[iRow, iCol] := 'За месяц';
        ColWidth[iCol] := Round(6 * nMyConst);
        Inc(iCol);
        TextRC[iRow, iCol] := 'Начислено';
        ColWidth[iCol] := Round(14 * nMyConst);
        Inc(iCol);
        TextRC[iRow, iCol] := 'Удержано';
        ColWidth[iCol] := Round(12 * nMyConst);
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
        SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
      end;
    end;
begin
  Screen.Cursor := crHourGlass;
  FormZpCmnPrt := TFormZpCmnPrt.Create(Application);
  with FormZpCmnPrt, F6B do begin
    PgSetup := CreateNewPageSetup;
    SetPageParams(PgSetup);
    SetPageSetup(PgSetup);
    nMyConst := RowHeight[1];
    nMaxCol := 10;
    ShowGridLines    := false;
    ShowColHeading   := true;
    ShowRowHeading   := true;
    ShowZeroValues   := false;
    ShowTabs         := 0;
    PrintNoColor     := true;
    PrintGridLines   := false;
    PrintFooter      := '';
    PrintHeader      := '';
    PrintLandscape   := false;
    DefaultFontCharSet := F1RussianCharSet;
    DefaultFontSize := 9;
    iRow := 0;
    iCol := 1;
    DecodeDate(dDtPrc, nY, nM, nD);
    cHeadMsg := 'Расчётная ведомость по зарплате за ' +
                                 MesRus(nM) + ' ' + IntToStr(nY) + ' г.';
    nPp := 0;
    with cdsSps do begin
      DisableControls;
      First;
      while not Eof do begin
        cPSCH := FieldByName('PSCH').AsString;
        while (FieldByName('PSCH').AsString = cPSCH) and not Eof do begin
          cSchBU := FieldByName('SchBU').AsString;
          Inc(iRow);
          TextRC[iRow, 1] := cHeadMsg;
          SetSelection(iRow, 1, iRow, nMaxCol);
          SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
          Inc(iRow);
          cMsg := 'СубСчёт ' + cSchBU + ' ' + FieldByName('NmSch').AsString;
          cSchMsg := cSchBU + ' ' + FieldByName('NmSch').AsString;
          TextRC[iRow, 1] := cMsg;
          SetSelection(iRow, 1, iRow, nMaxCol);
          SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
          ShapSmallNichVed(F6B, iRow, iCol);
          nSmNTema := 0;
          nSmUTema := 0;
          if cdsTmp.Active then cdsTmp.Close;
          cdsTmp.FieldDefs.Clear;
          cdsTmp.IndexDefs.Clear;
          cdsTmp.IndexName := '';
          cdsTmp.FieldDefs.Add('VidN', ftString, 4);
          cdsTmp.FieldDefs.Add('ShVidN', ftString, 15);
          cdsTmp.FieldDefs.Add('SmN', ftFloat);
          cdsTmp.FieldDefs.Add('SmU', ftFloat);
          cdsTmp.CreateDataSet;
          cdsTmp.AddIndex('OnVidN', 'VidN', []);
          cdsTmp.IndexName := 'OnVidN';
          cdsTmp.Open;
          while (FieldByName('SchBU').AsString = cSchBU) and
                  (FieldByName('PSCH').AsString = cPSCH) and not Eof do begin
            nTabN := FieldByName('TabN').AsInteger;
            nCntInTabN := 0;
            nCntNach := 0;
            nSmN := 0;
            nSmU := 0;
            bFirstVidUdrg := false;
            while (FieldByName('TabN').AsInteger = nTabN) and
                   (FieldByName('SchBU').AsString = cSchBU) and
                    (FieldByName('PSCH').AsString = cPSCH) and not Eof do begin
              if FieldByName('Summa').IsNull or
                       (FieldByName('Summa').AsFloat = 0) then begin
                Next;
                Continue;
              end;
              Inc(nCntInTabN);
              if (nCntInTabN > 0) and (nCntNach > 0) and
                         (FieldByName('VidN').AsString >= '6000') and
                                                 not bFirstVidUdrg then begin
                bFirstVidUdrg := true;
                Inc(iRow);
                TextRC[iRow, 6] := 'Итого начисл.';
                SetSelection(iRow, 6, iRow, 8);
                SetAlignment(F1HAlignCenterAcrossCells,false,F1VAlignBottom,0);
                NumberRC[iRow, 9] := nSmN;
                SetSelection(iRow, 9, iRow, 10);
                FormatFixed2;
                SetSelection(iRow, 6, iRow, nMaxCol);
                FontItalic := true;
                SetSelection(iRow, 1, iRow, nMaxCol);
                SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
              end;
              Inc(iRow);
              if nCntInTabN = 1 then begin
                Inc(nPp);
                NumberRC[iRow, 1] := nPp;
                NumberRC[iRow, 2] := nTabN;
                TextRC[iRow, 3] := DmMain.TabN2FamIO(nTabN);
              end;
              cVidN := Trim(FieldByName('VidN').AsString);
              cShVidN := FieldByName('ShVidN').AsString;;
              if cVidN < '6000' then begin
                TextRC[iRow, 6] := cVidN;
                TextRC[iRow, 7] := cShVidN;
                Inc(nCntNach);
                cMsg := Copy(FieldByName('ZaMesGod').AsString, 4, 2) + '-' +
                        Copy(FieldByName('ZaMesGod').AsString, 9, 2);
                TextRC[iRow, 8] := cMsg;
                SetSelection(iRow, 8, iRow, 8);
                SetAlignment(F1HAlignCenter,false,F1VAlignBottom,0);
                nSmVida := FieldByName('Summa').AsFloat;
                NumberRC[iRow, 9] := nSmVida;
                nSmNTema := nSmNTema + nSmVida;
                nSmN := nSmN + nSmVida;
                Next; end
              else begin
                nSmVida := 0;
                while (FieldByName('VidN').AsString = cVidN) and
                                                       not Eof do begin
                  nSmVida := nSmVida - FieldByName('Summa').AsFloat;
                  nSmUTema := nSmUTema + FieldByName('Summa').AsFloat;
                  nSmU := nSmU + FieldByName('Summa').AsFloat;
                  Next;
                end;
                TextRC[iRow, 6] := cVidN;
                TextRC[iRow, 7] := cShVidN;
                NumberRC[iRow, 10] := nSmVida;
              end;
              SetSelection(iRow, 9, iRow, 10);
              FormatFixed2;
              SetSelection(iRow, 1, iRow, nMaxCol);
              SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
              cdsTmp.EditKey;
              cdsTmp.FieldByName('VidN').AsString := cVidN;
              if not cdsTmp.GotoKey then begin
                cdsTmp.Append;
                cdsTmp.FieldByName('VidN').AsString := cVidN;
                cdsTmp.FieldByName('ShVidN').AsString := cShVidN; end
              else
                cdsTmp.Edit;
              if cVidN < '6000' then
                cdsTmp.FieldByName('SmN').AsFloat :=
                                   cdsTmp.FieldByName('SmN').AsFloat + nSmVida
              else
                cdsTmp.FieldByName('SmU').AsFloat :=
                                   cdsTmp.FieldByName('SmU').AsFloat + nSmVida;
              cdsTmp.Post;
            end;
            if nCntInTabN > 0 then begin
              Inc(iRow);
              TextRC[iRow, 6] := 'Итого удерж.';
              SetSelection(iRow, 6, iRow, 8);
              SetAlignment(F1HAlignCenterAcrossCells,false,F1VAlignBottom,0);
              NumberRC[iRow, 10] := -nSmU;
              SetSelection(iRow, 10, iRow, 10);
              FormatFixed2;
              SetSelection(iRow, 6, iRow, nMaxCol);
              FontItalic := true;
              SetSelection(iRow, 1, iRow, nMaxCol);
              SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
              Inc(iRow);
              TextRC[iRow, 6] := 'К выплате';
              SetSelection(iRow, 6, iRow, 8);
              SetAlignment(F1HAlignCenterAcrossCells,false,F1VAlignBottom,0);
              NumberRC[iRow, 9] := nSmN + nSmU;
              SetSelection(iRow, 9, iRow, 10);
              FormatFixed2;
              SetSelection(iRow, 9, iRow, 10);
              SetAlignment(F1HAlignCenterAcrossCells,false,F1VAlignBottom,0);
              SetSelection(iRow, 6, iRow, nMaxCol);
              FontItalic := true;
              SetSelection(iRow, 1, iRow, nMaxCol);
              SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
            end;
          end;
          if bFlagDbg and (cSchBU = '801/1-2001') then
            cdsTmp.SaveToFile(cDirTemp + 'BySchBu.cds');
          cdsTmp.First;
          nCntInTabN := 0;
          nCntNach := 0;
          nSmN := 0;
          nSmU := 0;
          bFirstVidUdrg := false;
          while not cdsTmp.Eof do begin
            Inc(nCntInTabN);
            if (nCntInTabN > 0) and (nCntNach > 0) and
                          (cdsTmp.FieldByName('VidN').AsString >= '6000') and
                                                   not bFirstVidUdrg then begin
              bFirstVidUdrg := true;
              Inc(iRow);
              TextRC[iRow, 6] := 'Итого начисл.';
              SetSelection(iRow, 6, iRow, 8);
              SetAlignment(F1HAlignCenterAcrossCells,false,F1VAlignBottom,0);
              NumberRC[iRow, 9] := nSmN;
              SetSelection(iRow, 9, iRow, 10);
              FormatFixed2;
              SetSelection(iRow, 1, iRow, nMaxCol);
              SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
            end;
            Inc(iRow);
            if nCntInTabN = 1 then begin
              TextRC[iRow, 1] := 'Итого по субСчёту: ' + cSchMsg;
              SetSelection(iRow, 1, iRow, 5);
              SetAlignment(F1HAlignCenterAcrossCells,false,F1VAlignBottom,0);
            end;
            if cdsTmp.FieldByName('VidN').AsString < '6000' then
              Inc(nCntNach);
            TextRC[iRow, 6] := cdsTmp.FieldByName('VidN').AsString;
            TextRC[iRow, 7] := cdsTmp.FieldByName('ShVidN').AsString;
            NumberRC[iRow, 9] := cdsTmp.FieldByName('SmN').AsFloat;
            NumberRC[iRow, 10] := cdsTmp.FieldByName('SmU').AsFloat;
            nSmN := nSmN + cdsTmp.FieldByName('SmN').AsFloat;
            nSmU := nSmU + cdsTmp.FieldByName('SmU').AsFloat;
            SetSelection(iRow, 9, iRow, 10);
            FormatFixed2;
            SetSelection(iRow, 1, iRow, nMaxCol);
            SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
            cdsTmp.Next;
          end;
          Inc(iRow);
          TextRC[iRow, 6] := 'Итого удерж.';
          SetSelection(iRow, 6, iRow, 8);
          SetAlignment(F1HAlignCenterAcrossCells,false,F1VAlignBottom,0);
          NumberRC[iRow, 10] := nSmU;
          SetSelection(iRow, 10, iRow, 10);
          FormatFixed2;
          SetSelection(iRow, 1, iRow, nMaxCol);
          SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
          Inc(iRow);
          TextRC[iRow, 6] := 'К выплате';
          SetSelection(iRow, 6, iRow, 8);
          SetAlignment(F1HAlignCenterAcrossCells,false,F1VAlignBottom,0);
          NumberRC[iRow, 9] := nSmN - nSmU;
          SetSelection(iRow, 9, iRow, 10);
          FormatFixed2;
          SetSelection(iRow, 9, iRow, 10);
          SetAlignment(F1HAlignCenterAcrossCells,false,F1VAlignBottom,0);
          SetSelection(iRow, 1, iRow, nMaxCol);
          SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
          Inc(iRow, 2);
          TextRC[iRow, nMaxCol] := 'Бухгалтер ____________ ' +
                                               Form_Dm.KdUsr2FioUsr(nAppKdUsr);
          SetSelection(iRow, nMaxCol, iRow, nMaxCol);
          SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
          Inc(iRow);
          AddRowPageBreak(iRow);
        end;
      end;
      EnableControls;
    end;
    SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
    Screen.Cursor := crHourGlass;
    cRandomFileName := RandomFileName;
    if bAppDocsToExcel then begin
      cRandomFileName := cRandomFileName + '.xls';
      WriteEx(cDirTemp + cRandomFileName, F1FileExcel97); end
    else begin
      cRandomFileName := cRandomFileName + '.vts';
      WriteEx(cDirTemp + cRandomFileName, F1FileFormulaOne6);
    end;
    Screen.Cursor := crDefault;
    Free;
  end;
  MyPreView(cDirTemp, cRandomFileName);
end;
