procedure TFormZpCmnPrt.AddInfInCdsKekv(cKekv: ShortString; nSmVidN: double);
begin
  with cdsKekv do begin
    if not Locate('KEKV', cKekv, []) then begin
      Append;
      FieldByName('KEKV').AsString := cKekv; end
    else
      Edit;
    FieldByName('SmN').AsFloat := FieldByName('SmN').AsFloat + nSmVidN;
    Post;
  end;
end;
//------------------------------------------------------------------------------
procedure TFormZpCmnPrt.AddPFInCdsKekv(cKekv : ShortString; nSmVidN : double);
begin
  with cdsKekv do begin
    if not Locate('KEKV', cKekv, []) then begin
      Append;
      FieldByName('KEKV').AsString := cKekv; end
    else
      Edit;
    FieldByName('SmForPF').AsFloat := FieldByName('SmForPF').AsFloat + nSmVidN;
    Post;
  end;
end;
//------------------------------------------------------------------------------
procedure TFormZpCmnPrt.RaschetUdVesa;
var nSmAllKekvs : double;
begin
  nSmAllKekvs := 0;
  with cdsKekv do begin
    First;
    while not Eof do begin
      nSmAllKekvs := nSmAllKekvs + FieldByName('SmN').AsFloat;
      Next;
    end;
    if nSmAllKekvs <> 0 then begin
      First;
      while not Eof do begin
        Edit;
        FieldByName('UdVes').AsFloat := FieldByName('SmN').AsFloat / nSmAllKekvs;
        Post;
        Next;
      end;
    end;
  end;
end;
