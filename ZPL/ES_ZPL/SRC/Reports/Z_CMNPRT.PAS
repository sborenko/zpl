    ShowTabs         := 0;
    PrintNoColor     := true;
    PrintGridLines   := false;
    PrintFooter      := '';
    PrintHeader      := '';
    PrintLandscape   := false;
    DefaultFontCharSet := F1RussianCharSet;
    DefaultFontSize := 9;
    nMaxCol := 11;
    nMaxCntPgLn := 61;
    nCntPgLn := 0;
    nPg := 0;
    iRow := 1;
