        Inc(iRow);
        Inc(nPp);
        NumberRC[iRow, 1] := nPp;
        TextRC[iRow, 2] := FieldByName('VidN').AsString;
        TextRC[iRow, 3] := FieldByName('ShVidN').AsString;
