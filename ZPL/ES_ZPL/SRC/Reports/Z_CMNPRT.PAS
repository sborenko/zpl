            end;
          end;
          SetSelection(iRow, 4, iRow, nMaxCol01);
          FormatFixed2;
          iCol := 17;
          for i := 7 to 12 do begin
            Inc(iCol);
            cPole := 'Sm';
            if i < 10 then
              cPole := cPole + '0';
            cPole := cPole + IntToStr(i);
            if FieldByName(cPole).AsFloat <> 0 then
              NumberRC[iRow, iCol] := FieldByName(cPole).AsFloat;
            Inc(iCol);
            if (FieldByName('VidN').AsString <> '9999') then begin
              cPole := 'SmZa';
              if i < 10 then
                cPole := cPole + '0';
              cPole := cPole + IntToStr(i);
              if FieldByName(cPole).AsFloat <> 0 then
                NumberRC[iRow, iCol] := FieldByName(cPole).AsFloat;
            end;
          end;
