        iRow := iRow + 2;
        TextRC[iRow, 1] := 'Всего по ведомости:';
        Inc(iRow);
        cMsg := SumPropis(nSmVed, 'w', nKopeek);
        cMsg := AnsiUpperCase(Copy(cMsg, 1, 1)) +
                              Copy(cMsg, 2, Length(cMsg)) + ' грн., ';
        if nKopeek <> 0 then
          cMsg := cMsg + IntToStr(nKopeek) + ' коп.'
        else
          cMsg := cMsg + '00 коп.';
        SetSelection(iRow, 2, iRow, 5);
        mCellFormat := CreateNewCellFormat;
        mCellFormat.AlignHorizontal := F1HAlignGeneral;
        mCellFormat.AlignVertical := F1VAlignCenter;
        mCellFormat.MergeCells := true;
        mCellFormat.WordWrap   := true;
        mCellFormat.FontBold   := true;
        SetCellFormat(mCellFormat);
        TextRC[iRow, 2] := cMsg;
        iRow := iRow + 2;
        if cDirDolgn <> '' then
          cMsg := cDirDolgn + ' ____________  ' + cDirFIO
        else
          cMsg := 'Руководитель ____________  ____________';
        TextRC[iRow, 5] := cMsg;
        iRow := iRow + 2;
        if cGlBuhDolgn <> '' then
          cMsg := cGlBuhDolgn + ' ____________  ' + cGlBuhFIO
        else
          cMsg := 'Бухгалтер ____________ ' + Form_Dm.KdUsr2FioUsr(nAppKdUsr);
        TextRC[iRow, 5] := cMsg;
        SetSelection(iRow-2, 5, iRow, 5);
        SetAlignment(F1HAlignRight, false, F1VAlignCenter, 0);
      end;
      Locate('TabN', nSvTabN, []);
    end;
    cRandomFileName := RandomFileName;
    if bAppDocsToExcel then begin
      cRandomFileName := cRandomFileName + '.xls';
      WriteEx(cDirTemp + cRandomFileName, F1FileExcel97); end
    else begin
      cRandomFileName := cRandomFileName + '.vts';
      WriteEx(cDirTemp + cRandomFileName, F1FileFormulaOne6);
    end;
    Screen.Cursor := crDefault;
    Free;
  end;
  Screen.Cursor := crDefault;
  MyPreView(cDirTemp, cRandomFileName);
