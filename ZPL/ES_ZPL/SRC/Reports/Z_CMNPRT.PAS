procedure F6PrtSvdBySPZ(cdsSPZ, cdsDet : TDataSet;
                                        dDtProc : TDateTime; bForm2 : boolean);
var nMyConst, iRow, iCol, nMaxCol, nStartRow, nPp : integer;
    cMsg, cNmObj : string; nPrtObj : integer;
    nSvNR : integer;
    nSmNachVN, nSmUdrgVN, nSmNachVU, nSmUdrgVU : double;
    nY, nM, nD : word;
    bIsTotalsVN, bIsTotalsVU : boolean;
    cKekv1111 : ShortString;
    cTmp : string; cRoot : string3; nCntInRoot : integer; nSmRoot : double;
begin
  Screen.Cursor := crHourGlass;
  FormZpCmnPrt := TFormZpCmnPrt.Create(Application);
  with FormZpCmnPrt, F6B do begin
    if dDtProc < EncodeDate(2013, 1, 1) then
      cKekv1111 := '1111'
    else
      cKekv1111 := '2111';
    DecodeDate(dDtProc, nY, nM, nD);
    ShowGridLines  := false;
    ShowColHeading := true;
    ShowRowHeading := true;
    ShowZeroValues := false;
    ShowTabs       := 0;
    PrintNoColor   := true;
    PrintGridLines := false;
    PrintFooter    := '';
