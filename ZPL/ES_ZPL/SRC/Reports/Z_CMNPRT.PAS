procedure F6PrtSvdByVidN(dtsSvd : TDataSet; dDtProc : TDateTime);
var nMyConst, iRow, iCol, nMaxCol, nPp : integer;
    cMsg : string;
    cVidN : string4; cShVidN : string15;
    cNmVidN : ShortString;
    cShObj, cNmObj : string;
    nKdObj, nCntObj : integer;
    nY, nM, nD : word;
    nSmNachV, nSmUdrgV : double;
    nSmNachVN, nSmUdrgVN : double; // по видам начисления
    nSmNachVU, nSmUdrgVU : double; // по видам удержания
    PgSetup : F1PageSetup;
    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    procedure ShapochkaVidN(F6B : TF6Book; nY, nM : word; nKdObj : integer;
                                                   var iRow, iCol : integer);
    var cMsg : string;
    begin
      with F6B do begin
        Inc(iRow);
        if nCntObj > 1 then begin
          AddRowPageBreak(iRow);
        end;
        Inc(iRow);
        iCol := 1;
        if nKdObj = 27777 then begin
          TextRC[iRow, iCol] := 'Свод по видам начислений / удержаний';
          RowHeight[iRow] := Round(1.2 * nMyConst);
          SetSelection(iRow, 1, iRow, nMaxCol);
          SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
          FontSize := 10;
          FontBold := true;
          Inc(iRow);
          TextRC[iRow, iCol] := 'по выделенным подразделениям';
          RowHeight[iRow] := Round(1.2 * nMyConst);
          SetSelection(iRow, 1, iRow, nMaxCol);
          SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
          FontSize := 10;
          FontBold := true; end
        else begin
          TextRC[iRow, iCol] := 'Свод по видам начислений / удержаний';
          RowHeight[iRow] := Round(1.2 * nMyConst);
          SetSelection(iRow, 1, iRow, nMaxCol);
          SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
          FontSize := 10;
          FontBold := true;
          Inc(iRow);
          TextRC[iRow, iCol] := 'подразделение ' + cNmObj;
          RowHeight[iRow] := Round(1.2 * nMyConst);
          SetSelection(iRow, 1, iRow, nMaxCol);
          SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
          FontSize := 10;
          FontBold := true;
        end;
        Inc(iRow);
        cMsg := 'за ' + MesRus(nM) + ' ' + IntToStr(nY) + ' года';
        TextRC[iRow, iCol] := cMsg;
        RowHeight[iRow] := Round(1.2 * nMyConst);
        SetSelection(iRow-1, 1, iRow, nMaxCol);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
        FontSize := 10;
        FontBold := true;
        Inc(iRow);
        TextRC[iRow, iCol] := '№ п/п';
        ColWidth[iCol] := Round(5 * nMyConst);
        Inc(iCol);
        TextRC[iRow, iCol] := 'Вид';
        ColWidth[iCol] := Round(5 * nMyConst);
        Inc(iCol);
        TextRC[iRow, iCol] := 'Наименование вида';
        ColWidth[iCol] := Round(55 * nMyConst);
        Inc(iCol);
        TextRC[iRow, iCol] := 'Начислено';
        ColWidth[iCol] := Round(12 * nMyConst);
        Inc(iCol);
        TextRC[iRow, iCol] := 'Удержано';
        ColWidth[iCol] := Round(12 * nMyConst);
        Inc(iCol);
        TextRC[iRow, iCol] := 'Итого';
        ColWidth[iCol] := Round(12 * nMyConst);
        SetSelection(1, 1, 1, nMaxCol);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
        FontSize := 10;
        FontBold := true;
        RowHeight[iRow] := Round(2 * nMyConst);
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
        SetBorder(1, 1, 1, 1, 1, 0, clBlack,clBlack,clBlack,clBlack,clBlack);
      end;
    end;
    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
begin
  Screen.Cursor := crHourGlass;
  FormZpCmnPrt := TFormZpCmnPrt.Create(Application);
  with FormZpCmnPrt, F6B do begin
    PgSetup := CreateNewPageSetup;
    SetPageParams(PgSetup);
    SetPageSetup(PgSetup);
    DecodeDate(dDtProc, nY, nM, nD);
    ShowGridLines  := false;
    ShowColHeading := true;
    ShowRowHeading := true;
    ShowZeroValues := false;
    ShowTabs       := 0;
    PrintNoColor   := true;
    PrintGridLines := false;
    PrintFooter    := '';
    PrintHeader    := '';
    PrintLandscape := false;
    DefaultFontCharSet := F1RussianCharSet;
    DefaultFontSize := 10;
    nMyConst := RowHeight[1];
    iRow := 1;
    iCol := 1;
    nMaxCol := 6;
    nPp := 0;
    with dtsSvd do begin
      DisableControls;
      First;
      nCntObj := 0;
      while not Eof do begin   // Помнить, что под nKdObj = 27777 идет итог по
                          // всем выбранным подразделением (см. SQL в z_SvVidN)
        Inc(nCntObj);
        nKdObj := FieldByName('KdObj').AsInteger;
        cShObj := DmMain.KdObj2ShObj(nKdObj, cNmObj);
        ShapochkaVidN(F6B, nY, nM, nKdObj, iRow, iCol);
        nSmNachVN := 0;
        nSmUdrgVN := 0; // по видам начисления
        nSmNachVU := 0;
        nSmUdrgVU := 0; // по видам удержания
        while (FieldByName('KdObj').AsInteger = nKdObj) and not Eof do begin
          cVidN := FieldByName('VidN').AsString;
          cShVidN := FieldByName('ShVidN').AsString;
          cNmVidN := FieldByName('NmVidN').AsString;
          nSmNachV := 0;
          nSmUdrgV := 0; // по виду
          while (FieldByName('KdObj').AsInteger = nKdObj) and
                     (FieldByName('VidN').AsString = cVidN) and not Eof do begin
            if FieldByName('Znak').AsInteger > 0 then begin
              if cVidN < '6000' then
                nSmNachVN := nSmNachVN + FieldByName('Summa').AsFloat
              else
                nSmNachVU := nSmNachVU + FieldByName('Summa').AsFloat;
              nSmNachV := nSmNachV + FieldByName('Summa').AsFloat; end
            else begin  // отрицательная сумма
              if cVidN < '6000' then
                nSmUdrgVN := nSmUdrgVN - FieldByName('Summa').AsFloat
              else
                nSmUdrgVU := nSmUdrgVU - FieldByName('Summa').AsFloat;
              nSmUdrgV := nSmUdrgV - FieldByName('Summa').AsFloat;
            end;
            Next;
          end;  // Закончился вид
          Inc(nPp);
          Inc(iRow);
          NumberRC[iRow, 1] := nPp;
          TextRC[iRow, 2] := cVidN;
          TextRC[iRow, 3] := cNmVidN;
          NumberRC[iRow, 4] := nSmNachV;
          NumberRC[iRow, 5] := nSmUdrgV;
          NumberRC[iRow, 6] := nSmNachV - nSmUdrgV;
          SetSelection(iRow, 1, iRow, nMaxCol);
          SetBorder(1, 1, 1, 1, 1, 0, clBlack,
                                  clBlack, clBlack, clBlack, clBlack);
          SetSelection(iRow, 4, iRow, 6);
          FormatFixed2;
        end;    // Закончилось подразделение
        Inc(iRow);
        if nKdObj = 27777 then
          cMsg := 'Итого по выделенным подразделениям'
        else
          cMsg := 'Итого по подразделению ' + cNmObj;
        TextRC[iRow, 1] := cMsg;
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
        FontUnderline := true;
        Inc(iRow);
        TextRC[iRow, 1] := 'По видам начисления';
        SetSelection(iRow, 1, iRow, 3);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
        NumberRC[iRow, 4] := nSmNachVN;
        NumberRC[iRow, 5] := nSmUdrgVN;
        NumberRC[iRow, 6] := nSmNachVN - nSmUdrgVN;
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetBorder(1, 1, 1, 1, 1, 0, clBlack,
                                  clBlack, clBlack, clBlack, clBlack);
        SetSelection(iRow, 4, iRow, 6);
        FormatFixed2;
        Inc(iRow);
        TextRC[iRow, 1] := 'По видам удержания';
        SetSelection(iRow, 1, iRow, 3);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
        NumberRC[iRow, 4] := nSmNachVU;
        NumberRC[iRow, 5] := nSmUdrgVU;
        NumberRC[iRow, 6] := nSmNachVU - nSmUdrgVU;
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetBorder(1, 1, 1, 1, 1, 0, clBlack,
                                  clBlack, clBlack, clBlack, clBlack);
        SetSelection(iRow, 4, iRow, 6);
        FormatFixed2;
        Inc(iRow);
        if nKdObj = 27777 then
          TextRC[iRow, 1] := 'В с е г о'
        else
          TextRC[iRow, 1] := 'И т о г о';
        SetSelection(iRow, 1, iRow, 3);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
        NumberRC[iRow, 4] := nSmNachVN + nSmNachVU;
        NumberRC[iRow, 5] := nSmUdrgVN + nSmUdrgVU;
        NumberRC[iRow, 6] := (nSmNachVN + nSmNachVU) - (nSmUdrgVN + nSmUdrgVU);
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetBorder(1, 1, 1, 1, 1, 0, clBlack,
                                  clBlack, clBlack, clBlack, clBlack);
        SetSelection(iRow, 4, iRow, 6);
        FormatFixed2;
      end;
      First;
      EnableControls;
    end;

    Inc(iRow, 3);
    if cBuhDolgn <> '' then
      cMsg := cBuhDolgn + '  ___________  ' + cBuhFIO
    else
      cMsg := 'Бухгалтер ____________ ' + Form_Dm.KdUsr2FioUsr(nAppKdUsr);
    TextRC[iRow, nMaxCol] := cMsg;
    SetSelection(iRow, nMaxCol, iRow, nMaxCol);
    SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);

    cRandomFileName := RandomFileName;
    if bAppDocsToExcel then begin
      cRandomFileName := cRandomFileName + '.xls';
      WriteEx(cDirTemp + cRandomFileName, F1FileExcel97); end
    else begin
      cRandomFileName := cRandomFileName + '.vts';
      WriteEx(cDirTemp + cRandomFileName, F1FileFormulaOne6);
    end;
    Screen.Cursor   := crDefault;
    Free;
  end;
  Screen.Cursor := crDefault;
  MyPreView(cDirTemp, cRandomFileName);
end;
