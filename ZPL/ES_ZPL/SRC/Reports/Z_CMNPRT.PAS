    PrintFooter      := '';
    PrintHeader      := '';
    PrintLandscape   := false;
    DefaultFontCharSet := F1RussianCharSet;
    DefaultFontSize := 9;
    iRow := 1;
    ColWidth[1] := Round( 7 * nMyConst);  // TabN
    ColWidth[2] := Round(20 * nMyConst);  // FamIO
    ColWidth[3] := Round( 9 * nMyConst);  // ZaMesGod
    ColWidth[4] := Round( 7 * nMyConst);  // SchBU
    ColWidth[5] := Round( 6 * nMyConst);  // KEKV
    ColWidth[6] := Round( 6 * nMyConst);  // Chas
    ColWidth[7] := Round(12 * nMyConst);  // Summa
    ColWidth[8] := Round( 6 * nMyConst);  // KdObj
    ColWidth[9] := Round(12 * nMyConst);  // Notes
    TextRC[iRow, 1] := 'Записи из файла НУ в месяце ' +
                                            Copy(DateToStr(dDtPrc), 4, 7);
    Inc(iRow);
    TextRC[iRow, 1] := 'Вид ' + cVidN + ' ' + cShVidN + ', Счёт ' + cPSch;
    SetSelection(iRow-1, 1, iRow, nMaxCol);
    SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
    Inc(iRow);
    TextRC[iRow, 1] := 'ТабНр';
    TextRC[iRow, 2] := 'Фамилия И.О.';
    TextRC[iRow, 3] := 'За мес.';
    TextRC[iRow, 4] := 'СчБУ';
    TextRC[iRow, 5] := 'КЕКВ';
    TextRC[iRow, 6] := 'Часы';
    TextRC[iRow, 7] := 'Сумма';
    TextRC[iRow, 8] := 'Пдрзд';
    TextRC[iRow, 9] := 'Примеч.';
    SetSelection(iRow, 1, iRow, nMaxCol);
    SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
    SetBorder(1, 1, 1, 1, 1, 0, clBlack, clBlack, clBlack, clBlack, clBlack);
    nSmTt := 0;
    nSmTtN := 0;
    nSmTtU := 0;
    with qryMoDt do begin
      nSvTabN := FieldByName('TabN').AsInteger;
      DisableControls;
      First;
      while not Eof do begin
        Inc(iRow);
        NumberRC[iRow, 1] := FieldByName('TabN').AsInteger;
        TextRC[iRow, 2]   := FieldByName('FamIO').AsString;
        TextRC[iRow, 3]   := Copy(FieldByName('ZaMesGod').AsString, 4, 7);
        TextRC[iRow, 4]   := FieldByName('SchBU').AsString;
        TextRC[iRow, 5]   := FieldByName('VID_KEKV').AsString;
        NumberRC[iRow, 6] := FieldByName('Chas').AsFloat;
        NumberRC[iRow, 7] := FieldByName('Summa').AsFloat;
        SetSelection(iRow, 7, iRow, 7);
        FormatFixed2;
        NumberRC[iRow, 8] := FieldByName('KdObj').AsInteger;
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetBorder(1, 1, 1, 1, 1, 0, clBlack,clBlack,clBlack,clBlack,clBlack);
        nSmTt  := nSmTt + FieldByName('Summa').AsFloat;
        if FieldByName('Summa').AsFloat >= 0 then
          nSmTtN := nSmTtN + FieldByName('Summa').AsFloat
        else
          nSmTtU := nSmTtU - FieldByName('Summa').AsFloat;
        Next;
      end;
      Inc(iRow);
      TextRC[iRow, 4] := 'Итого';
      SetSelection(iRow, 4, iRow, 6);
      FontUnderLine := true;
      SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignBottom, 0);
      NumberRC[iRow, 7] := nSmTt;
      SetSelection(iRow, 7, iRow, 7);
      FormatFixed2;
      if (nSmTtN <> 0) and (nSmTtU <> 0) then begin
        Inc(iRow);
        TextRC[iRow, 4] := 'в т.ч.';
        TextRC[iRow, 5] := 'начислено';
        NumberRC[iRow, 7] := nSmTtN;
        SetSelection(iRow, 7, iRow, 7);
        FormatFixed2;
        Inc(iRow);
        TextRC[iRow, 5] := 'удержано';
        NumberRC[iRow, 7] := nSmTtU;
        SetSelection(iRow, 7, iRow, 7);
        FormatFixed2;
      end;
      Locate('TabN', nSvTabN, []);
      EnableControls;
    end;
    cRandomFileName := RandomFileName;
    if bAppDocsToExcel then begin
      cRandomFileName := cRandomFileName + '.xls';
      WriteEx(cDirTemp + cRandomFileName, F1FileExcel97); end
    else begin
      cRandomFileName := cRandomFileName + '.vts';
      WriteEx(cDirTemp + cRandomFileName, F1FileFormulaOne6);
    end;
    Screen.Cursor := crDefault;
    Free;
  end;
  MyPreView(cDirTemp, cRandomFileName);
end;
