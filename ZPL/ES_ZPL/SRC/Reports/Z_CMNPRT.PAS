      FormatFixed2;
      SetSelection(iRow-1, 1, iRow, nMaxCol);
      SetBorder(1,-1,-1,-1,-1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
    end;
    cMsg := 'Начисление отпускных';
    Inc(iRow);
    TextRC[iRow, 1] := cMsg;
    SetSelection(iRow, 1, iRow, nMaxCol);
    FontBold := true;
    SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
    Inc(iRow);
    TextRC[iRow, 1] := '№№ п/п';
    ColWidth[1] := Round(5 * nMyConst);
    TextRC[iRow, 2] := 'Дата начала:';
    TextRC[iRow, 3] := 'Дата окончания:';
    if nRK = 0 then
      TextRC[iRow, 5] := 'Раб. дней'
    else
      TextRC[iRow, 5] := 'Календ. дней';
    TextRC[iRow, 6] := 'Сумма отпускных';
    SetSelection(iRow, 1, iRow, 2);
    SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
    SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
    SetSelection(iRow, 3, iRow, 5);
    SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
    SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
    SetSelection(iRow, 5, iRow, 6);
    SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
    SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
    nStartRow := iRow + 1;
    with tblROtp do begin
      First;
      nPp := 0;
      nCntDays := 0;
      nSmOtpTt := 0;
      while not Eof do begin
        if FieldByName('VidN').AsString <> '1810' then begin
          //МатПомощь на оздоровление не показываю
          Inc(iRow);
          Inc(nPp);
          TextRC[iRow, 1] := IntToStr(nPp);
          SetSelection(iRow, 1, iRow, 1);
          SetAlignment(F1HAlignRight, false, F1VAlignCenter, 0);
          if (cVidN <> '2406') and (cVidN <> '2411') then begin
            TextRC[iRow, 2] := FieldByName('DtBeg').AsString;
            SetSelection(iRow, 2, iRow, 2);
            SetAlignment(F1HAlignCenter, false, F1VAlignCenter, 0);
            TextRC[iRow, 3] := FieldByName('DtEnd').AsString;
          end;
          SetSelection(iRow, 3, iRow, 4);
          mCellFormat := CreateNewCellFormat;
          mCellFormat.AlignHorizontal := F1HAlignCenter;
          mCellFormat.AlignVertical := F1VAlignCenter;
          mCellFormat.MergeCells := true;
          mCellFormat.WordWrap   := false;
          SetCellFormat(mCellFormat);
          NumberRC[iRow, 5] := FieldByName('CntDays').AsFloat;
          SetSelection(iRow, 5, iRow, 5);
          FormatFixed;
          NumberRC[iRow, 6] := FieldByName('Smm').AsFloat;
          SetSelection(iRow, 6, iRow, 6);
          FormatFixed2;
          nCntDays := nCntDays + FieldByName('CntDays').AsFloat;
          nSmOtpTt := nSmOtpTt + FieldByName('Smm').AsFloat;
        end;
        Next;
      end;
      SetSelection(nStartRow, 1, iRow, nMaxCol);
      SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
    end;
    if nPp > 1 then begin
      Inc(iRow);
      TextRC[iRow, 2] := 'Итого:';
      NumberRC[iRow, 5] := nCntDays;
      SetSelection(iRow, 5, iRow, 5);
      FormatFixed;
      NumberRC[iRow, 6] := nSmOtpTt;
      SetSelection(iRow, 6, iRow, 6);
      FormatFixed2;
      SetSelection(iRow-1, 1, iRow, nMaxCol);
      SetBorder(1,-1,-1,-1,-1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
    end;
    cRandomFileName := RandomFileName;
    if bAppDocsToExcel then begin
      cRandomFileName := cRandomFileName + '.xls';
      WriteEx(cDirTemp + cRandomFileName, F1FileExcel97); end
    else begin
      cRandomFileName := cRandomFileName + '.vts';
      WriteEx(cDirTemp + cRandomFileName, F1FileFormulaOne6);
    end;
    Screen.Cursor   := crDefault;
  end;
  FormZpCmnPrt.Free;
  Screen.Cursor := crDefault;
  MyPreView(cDirTemp, cRandomFileName);
end; {F6_PrtOtp}


(*
//------------------------------------------------------------------------------
procedure TFormZpCmnPrt.RL_Prt(
  QryNu: TDataSet;
  DtProc: TDateTime;
  DeptId, EmplId, ColWidthUnit: Integer;
  FamIO, MesGod : ShortString;
  var StartRow, LstCntRow: Integer);
const
  ColNPp = 1;
  ColMesGod = 2;
  ColVidN = 3;
  ColShVidN = 4;
  ColHours = 5;
  ColSumNach = 6;
  ColSumUdrg = 7;
  ColSep1 = 8;
  ColSep2 = 9;

  List2Offset = 9;
var
  DeptName, DeptSh: String;
  DtEndDtPrc, ZaMG: TDateTime;
  DummyInt, KdSpz: Integer;
  DummyDouble, OklTrf: Double;
  DummyString: String;
  DummyDate: TDateTime;
  DummyBool, VidIsNonPay: Boolean;
  DummySmallInt: SmallInt;
  SavedNr, CurRow, BodyStartRow, SavedRow, OrdNum: Integer;
  VidN, ShVidN, MnthYear: ShortString;
  SmNachVid, SmUdrgVid, SmNachTt, SmUdrgTt, SmVuplTt, SmKVupl, SmPrt: Double;
  Hours: Double;
  DummyStr1: String1;

  procedure AddRecord(VidN: ShortString; Period: TPeriod);
  begin
    with CdsStornedTypes do begin
      Append;
      FieldByName('VidN').AsString := VidN;
      FieldByName('Dt_Beg').AsDateTime := Period.Start;
      FieldByName('Dt_End').AsDateTime := Period.Finish;
      Post;
    end;
  end;

  procedure EditRecord(Period: TPeriod);
  begin
    with CdsStornedTypes do begin
      Edit;
      FieldByName('Dt_Beg').AsDateTime := Period.Start;
      FieldByName('Dt_End').AsDateTime := Period.Finish;
      Post;
    end;
  end;

  procedure JoinRecords(NewPeriod: TPeriod);
  var
    CurrentPeriod, JoinedPeriod: TPeriod;
  begin
    with CdsStornedTypes, TDateUtils do begin
      CurrentPeriod := InitPeriod(
        FieldByName('DtBeg').AsDateTime, FieldByName('DtEnd').AsDateTime);

      JoinedPeriod := JoinPeriods(CurrentPeriod, NewPeriod);

      if PeriodsAreEqual(JoinedPeriod, CurrentPeriod) then
        AddRecord(FieldByName('VidN').AsString, NewPeriod)
      else
        EditRecord(NewPeriod);
    end;
  end;

  procedure SubtractRecords(Subtrahend: TPeriod);
  var
    Minuend: TPeriod;
    Schedule: TSchedule;
    Len: integer;
  begin
    with CdsStornedTypes, TDateUtils do begin
      Minuend := InitPeriod(
        FieldByName('Dt_Beg').AsDateTime, FieldByName('Dt_End').AsDateTime);

      Schedule := SubtractPeriods(Minuend, Subtrahend);
      Len := Length(Schedule);

      if Len = 0 then
        Delete
      else begin
        Minuend := Schedule[0];

        Edit;
        FieldByName('Dt_Beg').AsDateTime := Minuend.Start;
        FieldByName('Dt_End').AsDateTime := Minuend.Finish;
        Post;

        if Len > 1 then begin
          Minuend := Schedule[1];

          TQryUtils.InsertCopy(CdsStornedTypes);
          FieldByName('Dt_Beg').AsDateTime := Minuend.Start;
          FieldByName('Dt_End').AsDateTime := Minuend.Finish;
          Post;
        end;
      end;
    end;
  end;

  procedure Hash500x(VidN: ShortString; Period: TPeriod; Storn: boolean);
  begin
    with CdsStornedTypes do begin
      if Locate('VidN', VidN, []) then
        if Storn then
          SubtractRecords(Period)
        else
          JoinRecords(Period)
      else
        if not Storn then
          Append;
    end;
  end;

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  procedure SetColsWidth(Offset: Word);
  begin
    with F6B do begin
      ColWidth[ColNPp + Offset] := Round(4 * ColWidthUnit);
      ColWidth[ColMesGod + Offset] := Round(5.5 * ColWidthUnit);
      ColWidth[ColVidN + Offset] := Round(5 * ColWidthUnit);
      ColWidth[ColShVidN + Offset] := Round(13 * ColWidthUnit);
      ColWidth[ColHours + Offset] := Round(7 * ColWidthUnit);
      ColWidth[ColSumNach + Offset] := Round(10 * ColWidthUnit);
      ColWidth[ColSumUdrg + Offset] := Round(10 * ColWidthUnit);
    end;
  end;

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  procedure PrintListHeader(HeaderRow,  Offset: Integer);
  begin
    CurRow := HeaderRow;

    with F6B do begin
      TextRC[CurRow, ColNPp + Offset] := 'Расчётный листок за ' + MesGod;
      SetSelection(CurRow, ColNPp + Offset, CurRow, ColSumUdrg + Offset);
      SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignBottom, 0);

      Inc(CurRow);
      TextRC[CurRow, ColNPp + Offset] := 'Таб.Нр ' + IntToStr(EmplId);
      SetSelection(CurRow, ColNPp + Offset, CurRow, ColNPp + Offset);
      FontBold := true;
      TextRC[CurRow, ColSumUdrg + Offset] := DeptName;
      SetSelection(CurRow, ColSumUdrg + Offset, CurRow, ColSumUdrg + Offset);
      FontUnderLine := true;
      SetAlignment(F1HAlignRight, false, F1VAlignCenter, 0);

      Inc(CurRow);
      TextRC[CurRow, ColNPp + Offset] := FamIO;
      SetSelection(CurRow, ColNPp + Offset, CurRow, ColNPp + Offset);
      FontBold := true;
      TextRC[CurRow, ColSumUdrg + Offset] :=
        'Оклад ' + FloatToStrF(OklTrf, ffFixed, 18, 2);
      SetSelection(CurRow, ColSumUdrg + Offset, CurRow, ColSumUdrg + Offset);
      FontBold := true;
      SetAlignment(F1HAlignRight, false, F1VAlignCenter, 0);

      Inc(CurRow);
      TextRC[CurRow, ColNPp + Offset] := '№ п/п';
      TextRC[CurRow, ColMesGod + Offset] := 'Мес. Год';
      SetSelection(CurRow, ColNPp + Offset, CurRow, ColMesGod + Offset);
      SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
      TextRC[CurRow, ColVidN + Offset] := 'Вид начисления (удержания)';
      SetSelection(CurRow, ColVidN + Offset, CurRow, ColShVidN + Offset);
      SetAlignment(F1HAlignCenterAcrossCells, true, F1VAlignCenter, 0);
      TextRC[CurRow, ColHours + Offset] := 'Часы';
      TextRC[CurRow, ColSumNach + Offset] := 'Начислено';
      TextRC[CurRow, ColSumUdrg + Offset] := 'Удержано';
      SetSelection(CurRow, ColHours + Offset, CurRow, ColSumUdrg + Offset);
      SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
      SetSelection(CurRow, ColNPp + Offset, CurRow + 1, ColSumUdrg + Offset);
      SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
    end;
  end;

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  procedure PrintRow(Offset: Word);
  begin
    with F6B do begin
      NumberRC[CurRow, ColNPp + Offset] := OrdNum;
      TextRC[CurRow, ColMesGod + Offset] := MnthYear;
      TextRC[CurRow, ColVidN + Offset] := VidN;
      TextRC[CurRow, ColShVidN + Offset] := ShVidN;
      if Hours <> 0 then
        NumberRC[CurRow, ColHours + Offset] := Hours;
      if SmNachVid <> 0 then
        NumberRC[CurRow, ColSumNach + Offset] := SmNachVid;
      if SmUdrgVid <> 0 then
        NumberRC[CurRow, ColSumUdrg + Offset] := SmUdrgVid;
      SetSelection(CurRow, ColSumNach + Offset, CurRow, ColSumUdrg + Offset);
      FormatFixed2;
    end;
  end;

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  procedure PrintBody;
  begin
    OrdNum := 0;

    SmNachTt := 0;
    SmUdrgTt := 0;
    SmVuplTt := 0;

    with F6B, QryNU do begin
      while not Eof do begin
        if FieldByName('VidN').AsString < '8000' then begin
          VidN := FieldByName('VidN').AsString;
          ZaMG := FieldByName('ZaMesGod').AsDateTime;
          ShVidN := FieldByName('ShVidN').AsString;

          VidIsNonPay := false;
          SmNachVid := 0;
          SmUdrgVid := 0;
          SmPrt := 0;
          Hours := 0;

          if VidN < '6000' then begin
            // Начисления
            while (FieldByName('VidN').AsString = VidN) and
                (FieldByName('ZaMesGod').AsDateTime = ZaMG) and not Eof do begin

              SmPrt := SmPrt + FieldByName('Summa').AsFloat;
              Hours := Hours  + FieldByName('Chas').AsFloat;

      {
              if (cPrtVid = '5002') or (cPrtVid = '5005') or (cPrtVid = '5008') then
                Hash500x(cPrtVid,
                  TDateUtils.InitPeriod(
                    FieldByName('Dt_Beg').AsDateTime,
                    FieldByName('Dt_End').AsDateTime),
                  FieldByName('Storn').AsString = 'Y');
      }

              Next;
            end;

            VidIsNonPay := (VidN >= '5000') and (VidN < '6000');

            if SmPrt >= 0 then
              SmNachVid := RoundTo(SmNachVid + SmPrt, -2)
            else
              SmUdrgVid := RoundTo(SmUdrgVid - SmPrt, -2);

          end else if VidN < '7500' then begin
            // Удержания
            while (FieldByName('VidN').AsString = VidN) and
                (FieldByName('ZaMesGod').AsDateTime = ZaMG) and not Eof do begin
              SmPrt := SmPrt + FieldByName('Summa').AsFloat;
              Next;
            end;

            if SmPrt >= 0 then
              SmNachVid := RoundTo(SmNachVid + SmPrt, -2)
            else
              SmUdrgVid := RoundTo(SmUdrgVid - SmPrt, -2);

          end else begin
            // Выплаты расписывать каждую в своей строке
            if FieldByName('Summa').AsFloat >= 0 then
              SmNachVid := SmNachVid + FieldByName('Summa').AsFloat
            else
              SmUdrgVid := SmUdrgVid - FieldByName('Summa').AsFloat;

            Next;
          end;
        end else
          Next;

        if true {(nSmNachVid <> nSmUdrgVid)
            or bVidIsNeopl and (nChasuVid <> 0)
            or (FieldByName('ZaMesGod').AsDateTime <>
              FieldByName('DtProc').AsDateTime)} then begin
          SmNachTt := SmNachTt + SmNachVid;
          SmUdrgTt  := SmUdrgTt  + SmUdrgVid;

          MnthYear := DateToStr(ZaMG);
          MnthYear := Copy(MnthYear, 4, 3) + Copy(MnthYear, 9, 2);

          Inc(CurRow);
          Inc(OrdNum);

          PrintRow(0);
          PrintRow(List2Offset);
        end;
      end;
    end;
//    ProcessRL(QryNu, PrintRLRow, nil);
  end;

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  procedure PrintListFooter(FooterRow,  Offset: Integer);
  begin
    CurRow := FooterRow;

    with F6B do begin
      Inc(CurRow);
      TextRC[CurRow, ColMesGod + Offset] := ' Итого: ';
      SetSelection(CurRow, ColMesGod + Offset, CurRow, ColHours + Offset);
      SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignBottom, 0);
      NumberRC[CurRow, ColSumNach + Offset] := SmNachTt;
      NumberRC[CurRow, ColSumUdrg + Offset] := SmUdrgTt;
      SetSelection(CurRow, ColSumNach + Offset, CurRow, ColSumUdrg + Offset);
      FormatFixed2;

      Inc(CurRow);
      TextRC[CurRow, ColMesGod + Offset] := ' Сумма к выплате';
      SetSelection(CurRow, ColMesGod + Offset, CurRow, ColHours + Offset);
      SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignBottom, 0);
      SmKVupl := RoundTo(SmNachTt - SmUdrgTt, -2);
      if SmKVupl <> 0 then
        TextRC[CurRow, ColSumNach + Offset] := FloatToStr(SmKVupl)
      else
        TextRC[CurRow, ColSumNach + Offset] := '-';
      SetSelection(CurRow, ColSumNach + Offset, CurRow, ColSumUdrg + Offset);
      SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignBottom, 0);
      FormatFixed2;
      SetSelection(CurRow, 1 + Offset, CurRow, ColSumUdrg + Offset);
      FontBold := true;
    end;
  end;

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  procedure DrawBorder(Offset: Integer);
  begin
    with F6B do begin
      SetSelection(BodyStartRow, ColNPp + Offset, CurRow, ColSumUdrg + Offset);
      SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
    end;
  end;

begin
  with F6B do begin
    // Ширины столбцов левого листа
    SetColsWidth(0);
    ColWidth[ColSep1] := Round(2 * ColWidthUnit);
    ColWidth[ColSep2] := Round(2 * ColWidthUnit);
    // Ширины столбцов правого листа
    SetColsWidth(List2Offset);

    // Актуальное перемещение на конец месяца
    with DmMain do begin
      GetPereInf(EmplId, MyLastDom(DtProc), DeptId, DummyInt, DummyInt,
        DummyInt, DummyInt, KdSpZ, DummyInt, DummyInt,
        OklTrf, DummyDouble, DummyDouble, DummyStr1, DummyString, DummyString,
        DummyDate, DummyBool, DummyBool, DummyBool, DummySmallInt);
      DeptSh := KdObj2ShObj(DeptId, DeptName);
      DeptName := Copy(DeptName, 1, 32);
      DeptName := IntToStr(DeptId) + ' ' +  DeptName;
    end;

    SavedRow := StartRow;
    // Заголовок левого листа
    PrintListHeader(StartRow, 0);
    // Заголовок правого листа
    PrintListHeader(SavedRow, List2Offset);

    with CdsStornedTypes do begin
      CreateDataSet;
      Open;
    end;

    with QryNu do begin
      DisableControls;

      SavedNr := FieldByName('NR').AsInteger;
      First;

      // Контент левого и правого листов
      BodyStartRow := CurRow + 1;
      PrintBody;

      Locate('NR', SavedNr, []);
      EnableControls;
    end;

    SavedRow := CurRow;
    // Итоги левого листа
    PrintListFooter(SavedRow, 0);
    // Итоги правого листа
    PrintListFooter(SavedRow, List2Offset);

    // Обрамление левого листа
    DrawBorder(0);
    // Обрамление правого листа
    DrawBorder(List2Offset);

    // Линия отреза
    SetSelection(1, ColSep2 - 1, CurRow, ColSep2 - 1);
    SetBorder(-1,4,-1,-1,-1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
  end;

  with CdsStornedTypes do begin
    EmptyDataSet;
    Close;
  end;

  // Выходные параметры
  LstCntRow := CurRow - StartRow + 1;
  StartRow := CurRow + 1;
end;
*)

//------------------------------------------------------------------------------
procedure F6PrtVedZp(nKdObj : integer; dDtProc : TDateTime;
                                                            qryVed : TDataSet);
var iRow, nLstCntRow, nCntOtpechatano, nMyConst : integer;
    nGod, nMes, nDay : word;
begin
  Screen.Cursor := crHourGlass;
  FormZpCmnPrt := TFormZpCmnPrt.Create(Application);
  with FormZpCmnPrt, F6B do begin
    DecodeDate(dDtProc, nGod, nMes, nDay);
    nMyConst := RowHeight[1];
    ShowGridLines    := false;
    ShowColHeading   := true;
    ShowRowHeading   := true;
    ShowZeroValues   := false;
    ShowTabs         := 0;
    PrintNoColor     := true;
    PrintGridLines   := false;
    PrintFooter      := '';
    PrintHeader      := '';
    PrintLandscape   := false;
    DefaultFontCharSet := F1RussianCharSet;
    DefaultFontSize := 10;
    iRow := 1;
    nLstCntRow := 0;
    nCntOtpechatano := 0;
    PrtVedZp(qryVed, nMes, nGod, nKdObj, nMyConst,
                                 iRow, nLstCntRow, nCntOtpechatano);
    cRandomFileName := RandomFileName;
    if bAppDocsToExcel then begin
      cRandomFileName := cRandomFileName + '.xls';
      WriteEx(cDirTemp + cRandomFileName, F1FileExcel97); end
    else begin
      cRandomFileName := cRandomFileName + '.vts';
      WriteEx(cDirTemp + cRandomFileName, F1FileFormulaOne6);
    end;
    Screen.Cursor   := crDefault;
  end;
  FormZpCmnPrt.Free;
  Screen.Cursor := crDefault;
  MyPreView(cDirTemp, cRandomFileName);
end; {F6PrtVedZp}
//------------------------------------------------------------------------------
procedure TFormZpCmnPrt.PrtVedZp(qryVed : TDataSet;
                                 nMes, nGod, nKdObj, nMyConst : integer;
                               var iRow, nLstCntRow, nCntOtpechatano : integer);
var nStartRow, nPp, iCol, nMaxCol, iRowObj, iRowHead, iRowVed : integer;
    nSmTt, nSmZp : double;
    cMsg, cNmObj, cFio : string;
    nSvTabN, nTabN, nKopeek : integer;
begin
  ShowMessage('Надо перепроверять - дотогошная схема');
  Exit;
  with qryVed, F6B do begin
    Inc(nCntOtpechatano);
    Inc(nLstCntRow);
    Inc(iRow);
    iRowObj := iRow;   // Запомнил строку для наименования подразд.
    iCol := 1;
    Inc(iRow);
    iRowVed := iRow;
    cMsg := 'Ведомость заработной платы за ' +
                         MesRus(nMes) + ' ' + IntToStr(nGod) + ' г.';
    TextRC[iRow, iCol] := cMsg;
    Inc(iRow);
    iRowHead := iRow;
    TextRC[iRow, iCol] := '№ п/п';
    ColWidth[iCol] := Round(4 * nMyConst);
    Inc(iCol);
    TextRC[iRow, iCol] := 'Таб. н-р';
    ColWidth[iCol] := Round(5 * nMyConst);
    Inc(iCol);
    TextRC[iRow, iCol] := 'Фамилия И.О.';
    ColWidth[iCol] := Round(35 * nMyConst);
    Inc(iCol);
    TextRC[iRow, iCol] := 'Сумма';
    ColWidth[iCol] := Round(11 * nMyConst);
    Inc(iCol);
    TextRC[iRow, iCol] := 'Роспись о получении';
    ColWidth[iCol] := Round(16 * nMyConst);
    nMaxCol := iCol;
    if nKdObj <> 0 then begin
      cMsg := DmMain.KdObj2ShObj(nKdObj, cNmObj);
      TextRC[iRowObj, nMaxCol] := cNmObj; end
    else
      TextRC[iRowObj, nMaxCol] := cFirma;
    SetSelection(iRowObj, nMaxCol, iRowObj, nMaxCol);
    FontUnderLine := true;
    SetAlignment(F1HAlignRight, false, F1VAlignCenter, 0);
    SetSelection(iRowVed, 1, iRowVed, nMaxCol);
    FontBold := true;
    SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
    SetSelection(iRowHead, 1, iRowHead, nMaxCol);
    SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
    RowHeight[iRowHead] := Round(2.5 * nMyConst);
    nSmTt := 0;
    with qryVed do begin
      nSvTabN := FieldByName('TabN').AsInteger;
      DisableControls;
      First;
      nStartRow := iRow + 1;
      nPp := 0;
      while not Eof do begin
        if (FieldByName('VidN').AsString = '63а') then begin
          Next;
          Continue;
        end;
        nTabN := FieldByName('TabN').AsInteger;
        nSmZp := 0;
        cFio := FieldByName('FamIO').AsString;
        while (FieldByName('TabN').AsInteger = nTabN) and
                                                    not Eof do begin
          if (FieldByName('VidN').AsString = '63а') then begin
            Next;
            Continue;
          end;
          nSmZp := nSmZp + FieldByName('Summa').AsFloat;
          Next;
        end;
        if nSmZp > 0 then begin
          Inc(iRow);
          Inc(nPp);
          iCol := 1;
          NumberRC[iRow, iCol] := nPp;
          Inc(iCol);
          NumberRC[iRow, iCol] := nTabN;
          Inc(iCol);
          TextRC[iRow, iCol] := cFio;
          Inc(iCol);
          NumberRC[iRow, iCol] := nSmZp;
          SetSelection(iRow, iCol, iRow, iCol);
          FormatFixed2;
          nSmTt := nSmTt + nSmZp;
        end;
      end;
      Locate('TabN', nSvTabN, []);
      EnableControls;
    end;
    if nPp <> 0 then begin
      Inc(iRow);
      iCol := 3;
      TextRC[iRow, iCol] := 'Итого';
      Inc(iCol);
      NumBerRC[iRow, iCol] := nSmTt;
      SetSelection(iRow, iCol, iRow, iCol);
      FormatFixed2;
    end;
    SetSelection(nStartRow-1, 1, iRow, nMaxCol);
    SetBorder(6,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
    SetColWidthAuto(nStartRow, 1, iRow, nMaxCol, false);
    if nSmTt <> 0 then begin
      iRow := iRow + 2;
      TextRC[iRow, 1] := 'Всего по ведомости:';
      Inc(iRow);
      cMsg := SumPropis(nSmTt, 'w', nKopeek);
      cMsg := AnsiUpperCase(Copy(cMsg,1,1)) +
                              Copy(cMsg, 2, Length(cMsg)) + ' грн., ';
      if nKopeek <> 0 then
        cMsg := cMsg + IntToStr(nKopeek) + ' коп.'
      else
        cMsg := cMsg + '00 коп.';
      SetSelection(iRow, 2, iRow, nMaxCol);
      mCellFormat := CreateNewCellFormat;
      mCellFormat.AlignHorizontal := F1HAlignGeneral;
      mCellFormat.AlignVertical := F1VAlignCenter;
      mCellFormat.MergeCells := true;
      mCellFormat.WordWrap   := true;
      mCellFormat.FontBold   := true;
      SetCellFormat(mCellFormat);
      TextRC[iRow, 2] := cMsg;
      iRow := iRow + 2;
      if (cDirDolgn <> '') and (cDirFIO <> '') then
        TextRC[iRow, nMaxCol] := cDirDolgn + ' ____________ ' + cDirFIO
      else
        TextRC[iRow, nMaxCol] := 'Руководитель ____________  ____________';
      iRow := iRow + 2;
      if (cGlBuhDolgn <> '') and (cGlBuhFIO <> '') then
        TextRC[iRow, nMaxCol] := cGlBuhDolgn + ' ____________ ' + cGlBuhFIO
      else
        TextRC[iRow, nMaxCol] := 'Бухгалтер ____________ ' +
                                                Form_Dm.KdUsr2FioUsr(nAppKdUsr);
      SetSelection(iRow-2, nMaxCol, iRow, nMaxCol);
      SetAlignment(F1HAlignRight, false, F1VAlignCenter, 0);
    end;
  end;
end;
