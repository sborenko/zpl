function GetPrcPfPrp(dDtMes : TDateTime; bInv : boolean) : double;
begin
  Result := 0;
  with FormZpCmnPrt.qryTmp do begin
    if Active then Close;
    SQL.Clear;
    DataBaseName := CESMAIN;
    SQL.Add('Select * from z_TblPrp where DtBeg <= :dDtMes ' +
            ' order by DtBeg desc, NR desc');
    ParamByName('dDtMes').AsDateTime := dDtMes;
    Open;
    if RecordCount > 0 then begin
      if bInv then
        Result := FieldByName('PrcPfInv').AsFloat
      else
        Result := FieldByName('PrcPfCmn').AsFloat;
    end;
    Close;
    SQL.Clear;
    DataBaseName := '';
  end;
end;
