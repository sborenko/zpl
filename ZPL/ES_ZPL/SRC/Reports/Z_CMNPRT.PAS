      DmMain.GetPereInf(TabN, dDtProc, nKdObj, nDum1, nDum1, nDum1,
                                  nDum1, nDum1, nDum1, nDum1,
                                  nOklTrf, nAvans, nProcLG, cSpAv,
                                  cDolgnost, cNrPrikaza, dDtPrikaza,
                                  bDum1, bDum1, bDum1, nDumSmInt);
