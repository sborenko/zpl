      SetSelection(iRow, 8, iRow, 8);
      FormatFixed2;
      SetSelection(iRow-1, 1, iRow, nMaxCol);
      SetBorder(1,-1,-1,-1,-1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
    end;
    Inc(iRow, 3);
    TextRC[iRow, 4] := 'Керiвник';
    TextRC[iRow, 5] := '____________________';
