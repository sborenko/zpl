        SetSelection(iRow, 4, iRow, nMaxCol);
        FormatFixed2;
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
        if (FieldByName('VidN').AsString = '6000') or
                (FieldByName('VidN').AsString = '8000')  or
                (FieldByName('VidN').AsString = '9999') then begin
          FontBold := true;
          SetColWidthAuto(iRow, 4, iRow, nMaxCol, false);
          //SetColWidthAuto(iRow, 18, iRow, nMaxCol, false);
        end;
        Next;
      end;
{
      Inc(iRow);
      TextRC[iRow, 1] := 'Примечание:    В любом месяце могут быть начисления' +
                        ' как за прошедшие месяцы (больничные, исправления' +
                       ' и др), так и за будущие (отпускные, декретные и др.).';
      SetSelection(iRow, 1, iRow, 1);
      FontSize := 8;
      Inc(iRow);
      TextRC[iRow, 3] := 'Поэтому начисления и удержания выводятся в две ' +
                       'колонки: 1. Месяц, в котором производились выплаты, ' +
                       ' и  2. Месяц, за который делались начисления.';
      SetSelection(iRow, 3, iRow, 3);
      FontSize := 8;
}
      if CaseNich = 1 then
        cMsg := '(Без нарахувань по НДЧ)'
      else if CaseNich = 2 then
        cMsg := '(Тiльки по нарахуванням НДЧ)';
      if (CaseNich = 1) or (CaseNich = 2) then begin
        Inc(iRow);
        TextRC[iRow, 1] := cMsg;
        SetSelection(iRow, 1, iRow, 1);
        FontSize := 8;
        Inc(iRow);
      end;
      Inc(iRow, 2);
      TextRC[iRow, nMaxCol] := 'Бухгалтер ____________  ' +
                                               Form_Dm.KdUsr2FioUsr(nAppKdUsr);
      SetSelection(iRow, nMaxCol, iRow, nMaxCol);
      SetAlignment(F1HAlignRight, false, F1VAlignCenter, 0);
      Inc(iRow);
