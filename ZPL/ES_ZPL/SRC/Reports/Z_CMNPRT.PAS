procedure F6PrtTotsNU(nTabN : integer; cFamIO : string; qryTots : TDataSet);
var iRow, nStartRow, nMyConst, nMaxCol, nPp : integer;
    dSvDtProc : TDateTime; cMsg : string;
    nSmN, nSmU, nSmV, nSmR : double;
begin
  Screen.Cursor := crHourGlass;
  FormZpCmnPrt := TFormZpCmnPrt.Create(Application);
  with FormZpCmnPrt, F6B do begin
    nMyConst := RowHeight[1];
    ShowGridLines    := false;
    ShowColHeading   := true;
    ShowRowHeading   := true;
    ShowZeroValues   := false;
    ShowTabs         := 0;
    PrintNoColor     := true;
    PrintGridLines   := false;
    PrintFooter      := '';
    PrintHeader      := '';
    PrintLandscape   := false;
    DefaultFontCharSet := F1RussianCharSet;
    DefaultFontSize := 10;
    nMaxCol := 7;
    ColWidth[1] := Round(5 * nMyConst);      //  № п/п
    ColWidth[2] := Round(15 * nMyConst);     //  MesRus_1
    ColWidth[3] := Round(12 * nMyConst);     //  SmNach
    ColWidth[4] := Round(12 * nMyConst);     //  SmUdrg
    ColWidth[5] := Round(12 * nMyConst);     //  SmVupl
    ColWidth[6] := Round(12 * nMyConst);     //  SmNaruki
    ColWidth[7] := Round(15 * nMyConst);     //  Примечания
    iRow := 1;
    cMsg := 'Сведения о начисленных и удержанных суммах';
    TextRC[iRow, 1] := cMsg;
    SetSelection(iRow, 1, iRow, nMaxCol);
    SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
    FontBold := true;
    RowHeight[iRow] := Round(1.5 * nMyConst);
    Inc(iRow);
    TextRC[iRow, 1] := 'Таб.н-р ' + IntToStr(nTabN);
    SetSelection(iRow, 1, iRow, 1);
    SetAlignment(F1HAlignLeft, false, F1VAlignCenter, 0);
    TextRC[iRow, nMaxCol] := cFamIO;
    SetSelection(iRow, nMaxCol, iRow, nMaxCol);
    SetAlignment(F1HAlignRight, false, F1VAlignCenter, 0);
    SetSelection(iRow, 1, iRow, nMaxCol);
    FontBold := true;
    FontUnderline := true;
    RowHeight[iRow] := Round(2 * nMyConst);
    Inc(iRow);
    TextRC[iRow, 1] := '№ п/п';
    TextRC[iRow, 2] := 'Месяц';
    TextRC[iRow, 3] := 'Начислено';
    TextRC[iRow, 4] := 'Удержано';
    TextRC[iRow, 5] := 'Выплачено';
    TextRC[iRow, 6] := 'На руки';
    TextRC[iRow, 7] := 'Примечания';
    SetSelection(iRow, 1, iRow, nMaxCol);
    SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
    RowHeight[iRow] := Round(2.5 * nMyConst);
    SetSelection(iRow, 1, iRow, nMaxCol);
    SetBorder(6,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
    with qryTots do begin
      nStartRow := iRow+1;
      dSvDtProc := FieldByName('DtProc').AsDateTime;
      DisableControls;
      First;
      nPp := 0;
      nSmN := 0;
      nSmU := 0;
      nSmV := 0;
      nSmR := 0;
      while not Eof do begin
        Inc(iRow);
        Inc(nPp);
        TextRC[iRow, 1] := IntToStr(nPp);
        SetSelection(iRow, 1, iRow, 1);
        SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
        TextRC[iRow, 2] := FieldByName('MesRus').AsString;
        NumberRC[iRow, 3] := FieldByName('SmNach').AsFloat;
        NumberRC[iRow, 4] := -FieldByName('SmUdrg').AsFloat;
        NumberRC[iRow, 5] := -FieldByName('SmVupl').AsFloat;
        NumberRC[iRow, 6] := FieldByName('SmNaRuki').AsFloat;
        SetSelection(iRow, 3, iRow, 6);
        FormatFixed2;
        nSmN := nSmN + FieldByName('SmNach').AsFloat;
        nSmU := nSmU - FieldByName('SmUdrg').AsFloat;
        nSmV := nSmV - FieldByName('SmVupl').AsFloat;
        nSmR := nSmR + FieldByName('SmNaRuki').AsFloat;
        Next;
      end;
      Locate('DtProc', dSvDtProc, []);
      EnableControls;
    end;
    Inc(iRow);
    TextRC[iRow, 2] := 'Итого';
    SetSelection(iRow, 2, iRow, 2);
    SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);
    NumberRC[iRow, 3] := nSmN;
    NumberRC[iRow, 4] := nSmU;
    NumberRC[iRow, 5] := nSmV;
    NumberRC[iRow, 6] := nSmR;
    SetSelection(iRow, 3, iRow, 6);
    FormatFixed2;
    SetSelection(iRow, 2, iRow, 6);
    FontBold := true;
    SetSelection(nStartRow-1, 1, iRow, nMaxCol);;
    SetBorder(6, 1, 1, 1, 1, 0, clBlack,
                                  clBlack, clBlack, clBlack, clBlack);
    SetSelection(nStartRow-1, 1, nStartRow-1, nMaxCol);
    SetBorder(-1, -1, -1, -1, 2, 0, clBlack,
                                  clBlack, clBlack, clBlack, clBlack);
    IRow := iRow + 2;
    if cBuhDolgn <> '' then
      cMsg := cBuhDolgn + '  ___________  ' + cBuhFIO
    else
      cMsg := 'Бухгалтер ____________ ' + Form_Dm.KdUsr2FioUsr(nAppKdUsr);

    TextRC[iRow, nMaxCol] := cMsg;
    SetSelection(iRow, nMaxCol, iRow, nMaxCol);
    SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
    cRandomFileName := RandomFileName;
    cRandomFileName := RandomFileName;
    if bAppDocsToExcel then begin
      cRandomFileName := cRandomFileName + '.xls';
      WriteEx(cDirTemp + cRandomFileName, F1FileExcel97); end
    else begin
      cRandomFileName := cRandomFileName + '.vts';
      WriteEx(cDirTemp + cRandomFileName, F1FileFormulaOne6);
    end;
    Screen.Cursor := crDefault;
    Free;
  end;
  Screen.Cursor := crDefault;
  MyPreView(cDirTemp, cRandomFileName);
end;
