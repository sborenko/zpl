procedure F6CmbOkl(dDtPrc : TDateTime; cdsSps, qryPere : TDataSet);
var iRow, iCol, nMaxCol, nMyConst : integer;
    cMsg : string;
    PgSetup : F1PageSetup;
    i, nSvTabN : integer;
    nY, nM, nD : word;
    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    procedure Shapka(F6B : TF6Book; var iRow, iCol : integer);
    begin
      with F6B do begin
        Inc(iRow);
        iCol := 1;
        SetSelection(iRow, iCol, iRow+1, iCol);
        mCellFormat := CreateNewCellFormat;
        mCellFormat.MergeCells := true;
        mCellFormat.WordWrap   := true;
        SetCellFormat(mCellFormat);
        TextRC[iRow, iCol] := '№ п/п';
        ColWidth[iCol] := Round(4 * nMyConst); // № п/п
        Inc(iCol);
        SetSelection(iRow, iCol, iRow+1, iCol);
        mCellFormat := CreateNewCellFormat;
        mCellFormat.MergeCells := true;
        mCellFormat.WordWrap   := true;
        SetCellFormat(mCellFormat);
        TextRC[iRow, iCol] := 'Табель ный н-р';
        ColWidth[iCol] := Round(7 * nMyConst);
        Inc(iCol);
        SetSelection(iRow, iCol, iRow+1, iCol);
        mCellFormat := CreateNewCellFormat;
        mCellFormat.MergeCells := true;
        mCellFormat.WordWrap   := true;
        SetCellFormat(mCellFormat);
        TextRC[iRow, iCol] := 'Фамилия И.О.';
        ColWidth[iCol] := Round(25 * nMyConst);
        Inc(iCol);
        SetSelection(iRow, iCol, iRow+1, iCol);
        mCellFormat := CreateNewCellFormat;
        mCellFormat.MergeCells := true;
        mCellFormat.WordWrap   := true;
        SetCellFormat(mCellFormat);
        TextRC[iRow, iCol] := 'Подразд.';
        ColWidth[iCol] := Round(9 * nMyConst);
        Inc(iCol);
        SetSelection(iRow, iCol, iRow+1, iCol);
        mCellFormat := CreateNewCellFormat;
        mCellFormat.MergeCells := true;
        mCellFormat.WordWrap   := true;
        SetCellFormat(mCellFormat);
        TextRC[iRow, iCol] := 'Начиная с:';
        ColWidth[iCol] := Round(10 * nMyConst);
        Inc(iCol);
        SetSelection(iRow, iCol, iRow, iCol+1);
        mCellFormat := CreateNewCellFormat;
        mCellFormat.MergeCells := true;
        mCellFormat.WordWrap   := true;
        SetCellFormat(mCellFormat);
        TextRC[iRow, iCol] := 'Суммы по счетам';
        ColWidth[iCol] := Round(10 * nMyConst);
        ColWidth[iCol+1] := Round(12 * nMyConst);
        TextRC[iRow+1, iCol] := 'Счёт';
        TextRC[iRow+1, iCol+1] := 'Сумма';
        Inc(iCol, 2);
        SetSelection(iRow, iCol, iRow+1, iCol);
        mCellFormat := CreateNewCellFormat;
        mCellFormat.MergeCells := true;
        mCellFormat.WordWrap   := true;
        SetCellFormat(mCellFormat);
        TextRC[iRow, iCol] := 'Составной оклад';
        ColWidth[iCol] := Round(12 * nMyConst);
        SetSelection(iRow, 1, iRow+1, nMaxCol);
        SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
        SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
        Inc(iRow);
      end;
    end;
begin
  Screen.Cursor := crHourGlass;
  FormZpCmnPrt := TFormZpCmnPrt.Create(Application);
  with FormZpCmnPrt, F6B do begin
    PgSetup := CreateNewPageSetup;
    SetPageParams(PgSetup);
    SetPageSetup(PgSetup);
    ShowGridLines    := false;
    ShowColHeading   := true;
    ShowRowHeading   := true;
    ShowZeroValues   := false;
    ShowTabs         := 0;
    PrintNoColor     := true;
    PrintGridLines   := false;
    PrintFooter      := '';
    PrintHeader      := '';
    PrintLandscape   := false;
    DefaultFontCharSet := F1RussianCharSet;
    DefaultFontSize := 9;
    nMyConst := RowHeight[1];
    nMaxCol := 8;
    DecodeDate(dDtPrc, nY, nM, nD);
    iCol := 1;
    iRow := 1;
    cMsg := 'Список сотрудников с "составными" окладами (оклады ' +
               'частями) на 01 ' + MesRod(nM) + ' ' + IntToStr(nY) + ' г.';
    TextRC[iRow, 1] := cMsg;
    SetSelection(iRow, 1, iRow, nMaxCol);
    SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
    FontUnderLine := true;
    Inc(iRow);
    Shapka(F6B, iRow, iCol);
    with cdsSps do begin
      nSvTabN := FieldByName('TabN').AsInteger;
      First;
      while not Eof do begin
        Inc(iRow);
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
        NumberRC[iRow, 1] := FieldByName('NR').AsInteger;
        NumberRC[iRow, 2] := FieldByName('TabN').AsInteger;
        TextRC[iRow, 3] := FieldByName('FamIO').AsString;
        NumberRC[iRow, 4] := FieldByName('KdObj').AsInteger;
        SetSelection(iRow, 4, iRow, 4);
        SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);
        TextRC[iRow, 5] := FieldByName('Dt_Beg').AsString;
        qryPere.First;
        i := 0;
        while not qryPere.Eof do begin
          if i > 0 then
            Inc(iRow);
          Inc(i);
          TextRC[iRow, 6] := qryPere.FieldByName('SchBU').AsString;
          SetSelection(iRow, 6, iRow, 6);
          SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);
          NumberRC[iRow, 7] := qryPere.FieldByName('OklTrf').AsFloat;
          SetSelection(iRow, 7, iRow, 7);
          FormatFixed2;
          qryPere.Next;
        end;
        NumberRC[iRow, 8] := FieldByName('OklTrf').AsFloat;
        SetSelection(iRow, 8, iRow, 8);
        FormatFixed2;
        FontBold := true;
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
        Next;
      end;
      Locate('TabN', nSvTabN, []);
    end;
    Inc(iRow, 2);
    cMsg := 'Бухгалтер  __________  ' + Form_Dm.KdUsr2FioUsr(nAppKdUsr);
    TextRC[iRow, nMaxCol] := cMsg;
    SetSelection(iRow, nMaxCol, iRow, nMaxCol);
    SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
    cRandomFileName := RandomFileName;
    if bAppDocsToExcel then begin
      cRandomFileName := cRandomFileName + '.xls';
      WriteEx(cDirTemp + cRandomFileName, F1FileExcel97); end
    else begin
      cRandomFileName := cRandomFileName + '.vts';
      WriteEx(cDirTemp + cRandomFileName, F1FileFormulaOne6);
    end;
    Screen.Cursor := crDefault;
    Free;
  end;
  MyPreView(cDirTemp, cRandomFileName);
end;
