  procedure PrintSums(F6B: TF6Book; DsUni: TDataSet);
  var
    Mnth: Word;
  begin
    with F6B, CdsUni do begin
      iCol := 3;
      for Mnth := MnthBeg to MnthEnd do begin
        Inc(iCol);
        if DateMode = 'DtPrc' then
          cPole := 'Sm'
        else
          cPole := 'SmZa';
        if Mnth < 10 then
          cPole := cPole + '0';
        cPole := cPole + IntToStr(Mnth);

        if
          // непонятно зачем запрещается печать итогов при ZaMG, комментируем:
          // not ((cVar = 'ZaMG')
          // чтобы не печаталось "НаРуки" при cVar = "ZaMG"
          // and (FieldByName('VidN').AsString = '9999'))
          // and
          (FieldByName(cPole).AsFloat <> 0)
        then
          if (FieldByName('VidN').AsString = '5005')
              or (FieldByName('VidN').AsString = '5008') then begin
            SetSelection(iRow, iCol, iRow+1, iCol);
            mCellFormat := CreateNewCellFormat;
            mCellFormat.AlignHorizontal := F1HAlignRight;
            SetCellFormat(mCellFormat);

            TextRC[iRow, iCol] := FieldByName(cPole).AsString + ' год'
          end else
            NumberRC[iRow, iCol] := FieldByName(cPole).AsFloat;
      end;
    end;
  end;

