procedure F6_PrtFixIndx(qryFIndx : TDataSet);
var nSvNR, iRow, nMaxCol, nMyConst : integer;
    nCntPgLn, nMaxCntPgLn, nPg : SmallInt;
    cMsg : ShortString;
    PgSetup : F1PageSetup;
    nY, nM, nD : word;
    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    procedure Shapka(F6B : TF6Book; var iRow : integer);
    begin
      with F6B do begin
        Inc(iRow);
        Inc(nPg);
        if nPg = 1 then
          TextRC[iRow, 1] := DateToStr(Date);
        TextRC[iRow, nMaxCol] := 'Стр. ' + IntToStr(nPg);
        SetSelection(iRow, nMaxCol, iRow, nMaxCol);
        SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
        Inc(iRow);
        Inc(nCntPgLn, 2);
        TextRC[iRow, 1] := 'Таб. номер';
        TextRC[iRow, 2] := 'Фамилия И.О.';
        TextRC[iRow, 3] := 'Дата увольн.';
        TextRC[iRow, 4] := 'Месяц начис ления';
        TextRC[iRow, 5] := 'Сумма ФСмм_1';
        TextRC[iRow, 6] := 'Дельта ОклНдб.';
        TextRC[iRow, 7] := 'Фикс. сумма индекс';
        TextRC[iRow, 8] := 'Примечание';
        TextRC[iRow, 9] := 'Уд';
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
        SetBorder(1, 1, 1, 1, 1, 0, clBlack,clBlack,clBlack,clBlack,clBlack);
      end;
    end;
begin
  Screen.Cursor := crHourGlass;
  FormZpCmnPrt := TFormZpCmnPrt.Create(Application);
  with FormZpCmnPrt, F6B do begin
    PgSetup := CreateNewPageSetup;
    SetPageParams(PgSetup);
    SetPageSetup(PgSetup);
    nMyConst := RowHeight[1];
    ShowGridLines    := false;
    ShowColHeading   := true;
    ShowRowHeading   := true;
    ShowZeroValues   := false;
    ShowTabs         := 0;
    PrintNoColor     := true;
    PrintGridLines   := false;
    PrintFooter      := '';
    PrintHeader      := '';
    PrintLandscape   := false;
    DefaultFontCharSet := F1RussianCharSet;
    DefaultFontSize := 9;
    nMaxCol := 9;
    nMaxCntPgLn := 59;
    nCntPgLn := 0;
    nPg := 0;
    iRow := 1;
    ColWidth[1]  := Round( 7 * nMyConst);  // ТабНр
    ColWidth[2]  := Round(25 * nMyConst);  // ФИО
    ColWidth[3]  := Round(12 * nMyConst);  // ДтУвольн.
    ColWidth[4]  := Round( 8 * nMyConst);  // МесяцНачисления
    ColWidth[5]  := Round(12 * nMyConst);  // Сумма ФСмм_1
    ColWidth[6]  := Round(10 * nMyConst);  // ДельтаОклНдб
    ColWidth[7]  := Round(12 * nMyConst);  // ФиксСуммаИндкс
    ColWidth[8]  := Round(20 * nMyConst);  // Примеч.
    ColWidth[9]  := Round( 3 * nMyConst);  // "Удалённая"
    Inc(iRow);
    Inc(nCntPgLn);
    DecodeDate(Date, nY, nM, nD);
    cMsg := 'Таблица фиксированных сумм индексации по состоянию на ' +
            IntToStr(nD) + ' ' + MesRod(nM) + ' ' + IntToStr(nY) + ' г.';
    TextRC[iRow, 1] := cMsg;
    SetSelection(iRow, 1, iRow, nMaxCol);
    FontBold := true;
    FontUnderLine := true;
    SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignBottom, 0);
    Inc(iRow);
    Inc(nCntPgLn);
    with qryFIndx do begin
      nSvNR := FieldByName('NR').AsInteger;
      DisableControls;
      First;
      Shapka(F6B, iRow);
      while not Eof do begin
        Inc(nCntPgLn);
        if nCntPgLn > nMaxCntPgLn then begin
          Inc(iRow);
          AddRowPageBreak(iRow);
          nCntPgLn := 0;
          Shapka(F6B, iRow);
          //Inc(iRow);
        end;
        Inc(iRow);
        NumberRC[iRow, 1] := FieldByName('TabN').AsInteger;
        cMsg := FieldByName('FamIO').AsString;
        TextRC[iRow, 2] := cMsg;
        if Length(cMsg) > 20 then begin
          SetSelection(iRow, 2, iRow, 2);
          FontSize := 8;
        end;
        TextRC[iRow, 3]   := FieldByName('LastDtUv').AsString;
        cMsg := Copy(FieldByName('FixMes').AsString, 4, 7);
        TextRC[iRow, 4]   := cMsg;
        NumberRC[iRow, 5] := FieldByName('F_Smm').AsFloat;
        NumberRC[iRow, 6] := FieldByName('D_OklNdb').AsFloat;
        NumberRC[iRow, 7] := FieldByName('FixSmm').AsFloat;
        SetSelection(iRow, 5, iRow, 7);
        FormatFixed2;
        TextRC[iRow, 8] := FieldByName('Notes').AsString;
        if FieldByName('DEL').AsString = 'Y' then begin
          TextRC[iRow, 9] := 'X';
          SetSelection(iRow, 9, iRow, 9);
          FontBold := true;
          SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);
        end;
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetBorder(1, 1, 1, 1, 1, 0, clBlack,clBlack,clBlack,clBlack,clBlack);
        Next;
      end;
      Locate('NR', nSvNR, []);
      EnableControls;
      Inc(iRow,3);
      TextRC[iRow, nMaxCol] := 'Исполнитель ____________ ' +
                                              Form_Dm.KdUsr2FioUsr(nAppKdUsr);
      SetSelection(iRow, nMaxCol, iRow, nMaxCol);
      SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
    end;
    cRandomFileName := RandomFileName;
    if bAppDocsToExcel then begin
      cRandomFileName := cRandomFileName + '.xls';
      WriteEx(cDirTemp + cRandomFileName, F1FileExcel97); end
    else begin
      cRandomFileName := cRandomFileName + '.vts';
      WriteEx(cDirTemp + cRandomFileName, F1FileFormulaOne6);
    end;
    Screen.Cursor := crDefault;
    Free;
  end;
  MyPreView(cDirTemp, cRandomFileName);
end;
