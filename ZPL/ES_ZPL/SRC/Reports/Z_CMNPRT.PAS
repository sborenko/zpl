      end;
    end;
begin
  Screen.Cursor := crHourGlass;
  FormZpCmnPrt := TFormZpCmnPrt.Create(Application);
  with FormZpCmnPrt, F6B do begin
    PgSetup := CreateNewPageSetup;
    SetPageParams(PgSetup);
    SetPageSetup(PgSetup);
    nMyConst := RowHeight[1];
    ShowGridLines    := false;
    ShowColHeading   := true;
    ShowRowHeading   := true;
    ShowZeroValues   := false;
    ShowTabs         := 0;
    PrintNoColor     := true;
    PrintGridLines   := false;
    PrintFooter      := '';
    PrintHeader      := '';
    PrintLandscape   := true;
    DefaultFontCharSet := F1RussianCharSet;
    DefaultFontSize := 10;
    nMaxCol := 10;
    iRow := 1;
    ColWidth[1] := Round( 7 * nMyConst);
    ColWidth[2] := Round(12 * nMyConst);
    ColWidth[3] := Round(14 * nMyConst);
    ColWidth[4] := Round(14 * nMyConst);
    ColWidth[5] := Round(14 * nMyConst);
    ColWidth[6] := Round(12 * nMyConst);
    ColWidth[7] := Round(12 * nMyConst);
    ColWidth[8] := Round(15 * nMyConst);
    ColWidth[9] := Round(12 * nMyConst);
    ColWidth[10] := Round(12 * nMyConst);
    with qryVedL do begin
      nSvTabN := FieldByName('TabN').AsInteger;
//      DisableControls;
      First;
      while not Eof do begin
        nTabN   := FieldByName('TabN').AsInteger;
        nSpecNR := FieldByName('Spec_NR').AsInteger;
        cNomDok := FieldByName('NomDok').AsString;
        cVidN   := FieldByName('VidN').AsString;
        dDtTmp  := dDtBeg;
        Shapka(F6B, iRow);
        while (FieldByName('TabN').AsInteger = nTabN) and
               (FieldByName('VidN').AsString = cVidN) and
               (FieldByName('NomDok').AsString = cNomDok) and
               (FieldByName('Spec_NR').AsInteger = nSpecNR) and not Eof do begin
          if (FieldByName('DtProc').AsDateTime <> dDtTmp) then begin
            Inc(iRow);// Сделать пустые строки до ('DtProc').AsDateTime = dDtTmp
            DecodeDate(dDtTmp, nY, nM, nD);
            NumberRC[iRow, 1] := nY;
            SetSelection(iRow, 1, iRow, 1);
            SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);
            TextRC[iRow, 2] := UkrMes(nM);
            SetSelection(iRow, 1, iRow, nMaxCol);
            SetBorder(1, 1, 1, 1, 1, 0, clBlack,clBlack,clBlack,clBlack,clBlack);
            dDtTmp := MyLastDOM(dDtTmp) + 1; end
          else begin

            n_TabN  := qryVedL.FieldByName('TabN').AsInteger;
            n_SpecNR := qryVedL.FieldByName('Spec_NR').AsInteger;
            nSmCmnD := qryVedL.FieldByName('SUMDOLG').AsFloat;
            nSmVzn  := qryVedL.FieldByName('Summa').AsFloat;
            dDtPrc  := qryVedL.FieldByName('DtProc').AsDateTime;
            nSmCmnU := GetSmUdrg(n_TabN, n_SpecNr, dDtPrc);
            nSmOst := nSmCmnD + nSmCmnU + nSmVzn;
            Inc(iRow);
            DecodeDate(dDtTmp, nY, nM, nD);
            NumberRC[iRow, 1] := nY;
            SetSelection(iRow, 1, iRow, 1);
            SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);
            TextRC[iRow, 2] := UkrMes(nM);

            SetSelection(iRow, 1, iRow, nMaxCol);
            SetBorder(1,1,1,1,1,0, clBlack,clBlack,clBlack,clBlack,clBlack);

            NumberRC[iRow, 3] := nSmCmnD;
            NumberRC[iRow, 4] := FieldByName('SumForIspL').AsFloat;
            NumberRC[iRow, 5] := -FieldByName('SumNalog').AsFloat;
            if FieldByName('SP').AsString = '%' then
              cMsg := FieldByName('SumVzn').AsString + ' %'
            else
              cMsg := FloatToStrF(FieldByName('SumVzn').AsFloat,
                                                    ffFixed, 18, 2) + ' грн.';
            TextRC[iRow, 6] := cMsg;
            if nSmCmnD <> 0 then
              NumberRC[iRow, 10] := nSmOst;
            SetSelection(iRow, 6, iRow, 6);
            SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);
            NumberRC[iRow, 7] := -FieldByName('Summa').AsFloat;
            SetSelection(iRow, 3, iRow, 5);
            FormatFixed2;
            SetSelection(iRow, 6, iRow, 7);
            FormatFixed2;
            SetSelection(iRow, 10, iRow, 10);
            FormatFixed2;
            SetSelection(iRow, 1, iRow, nMaxCol);
            SetBorder(1, 1, 1, 1, 1, 0, clBlack,clBlack,clBlack,clBlack,clBlack);
            dDtTmp := MyLastDOM(dDtTmp) + 1;
            Next;
          end;
        end;
        while (dDtTmp <= dDtEnd) do begin
          Inc(iRow); // Вставить пустые строки после ('DtProc').AsDateTime = dDtEnd
          DecodeDate(dDtTmp, nY, nM, nD);
          NumberRC[iRow, 1] := nY;
          SetSelection(iRow, 1, iRow, 1);
          SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);
          TextRC[iRow, 2] := UkrMes(nM);
          SetSelection(iRow, 1, iRow, nMaxCol);
          SetBorder(1, 1, 1, 1, 1, 0, clBlack,clBlack,clBlack,clBlack,clBlack);
          dDtTmp := MyLastDOM(dDtTmp) + 1;
        end;
        Inc(iRow,3);
        TextRC[iRow, nMaxCol] := 'Гол. бухгалтер ___________ ' +
          Form_Dm.KdUsr2FioUsr(109);
        SetSelection(iRow, nMaxCol, iRow, nMaxCol);
        SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
        Inc(iRow,3);
        TextRC[iRow, nMaxCol] := 'Бухгалтер ____________ ' +
                                                Form_Dm.KdUsr2FioUsr(nAppKdUsr);
        SetSelection(iRow, nMaxCol, iRow, nMaxCol);
        SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
        Inc(iRow);
        AddRowPageBreak(iRow);
      end;
    end;
    qryVedL.Locate('TabN', nSvTabN, []);
//    qryVedL.EnableControls;
    cRandomFileName := RandomFileName;
    if bAppDocsToExcel then begin
      cRandomFileName := cRandomFileName + '.xls';
      WriteEx(cDirTemp + cRandomFileName, F1FileExcel97); end
    else begin
      cRandomFileName := cRandomFileName + '.vts';
      WriteEx(cDirTemp + cRandomFileName, F1FileFormulaOne6);
    end;
    Screen.Cursor := crDefault;
    Free;
  end;
  MyPreView(cDirTemp, cRandomFileName);
end;
