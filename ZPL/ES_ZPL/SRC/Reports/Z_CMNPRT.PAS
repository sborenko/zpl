    ColWidth[4] := Round(18 * nMyConst);
    ColWidth[5] := Round(11 * nMyConst);
    ColWidth[6] := Round(8 * nMyConst);
    ColWidth[7] := Round(8 * nMyConst);
    ColWidth[8] := Round(12 * nMyConst);
    if cCase = 'okl' then begin // по окладу
      cMsg := 'В зачет приняты виды заработка:';
      Inc(iRow);
      TextRC[iRow, iCol] := cMsg;
      SetSelection(iRow, 1, iRow, nMaxCol);
      FontBold := true;
      SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
