procedure F6_PrtVedPvdOLD(dDtPrc : TDateTime; cdsPrt : TDataSet);
var iRow, iCol, nStartRow, nMyConst, nMaxCol,
                                     nTabN, nPp, nKopeek, nSpecNR : integer;
    cMsg, cPostaFileNm  : string;
    nY, nM, nD : word;
    PgSetup : F1PageSetup;
    cKuda, cKomu, cPSch : ShortString;
    nSmPerevoda, nSmPsb, nSmNds, nSmBezNds : double;
    nSmPerevodaTts, nSmPsbTts, nSmNdsTts, nSmBezNdsTts : double;
    nKdPst : SmallInt;
    cIsPst: string;
    iColNum: integer;
    iNppCol, iKudaCol, iKomuCol,
    iSumCol, iSumPst, iSumPstNds, iSumPstBezNds: integer;
begin
  iNppCol := 1;
  iKudaCol := 2;
  iKomuCol := 3;
  iSumCol := 4;
  iSumPst := 5;
  iSumPstNds := 6;
  iSumPstBezNds := 7;

  Screen.Cursor := crHourGlass;
  FormZpCmnPrt := TFormZpCmnPrt.Create(Application);
  with FormZpCmnPrt, F6B do begin
    PgSetup := CreateNewPageSetup;
    SetPageParams(PgSetup);
    SetPageSetup(PgSetup);
    DecodeDate(dDtProc, nY, nM, nd);
    nMyConst := RowHeight[1];
    ShowGridLines    := false;
    ShowColHeading   := true;
    ShowRowHeading   := true;
    ShowZeroValues   := false;
    ShowTabs         := 0;
    PrintNoColor     := true;
    PrintGridLines   := false;
    PrintFooter      := '';
    PrintHeader      := '';
    PrintLandscape   := false;
    DefaultFontCharSet := F1RussianCharSet;
    DefaultFontSize := 10;
    with cdsPrt do begin
      Screen.Cursor := crHourGlass;
      nMaxCol := 7;
      First;
      iRow := 1;
      while not Eof do begin
        nKdPst := FieldByName('KdPst').AsInteger;
        cIsPst := FieldByName('Is_Pst').AsString;
        cPSch  := FieldByName('PSch').AsString;
        Inc(iRow);
        TextRC[iRow, nMaxCol] := 'Счёт ' + cPSch;
        SetSelection(iRow, nMaxCol, iRow, nMaxCol);
        SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
        FontUnderLine := true;
        Inc(iRow);
        cMsg := 'С П И С О К';
        TextRC[iRow, 1] := cMsg;
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);

        cMsg := '';
        if (cIsPst = 'Y') then begin
          Inc(iRow);
          TextRC[iRow, 1] := 'почтовых переводов,';
          SetSelection(iRow, 1, iRow, nMaxCol);
          SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
          cMsg := cMsg + 'поданых в почтовое отделение № ___ ';
        end;
        cMsg := cMsg + 'за ' + MesRus(nM) + ' ' + IntToStr(nY) + ' г.';

        Inc(iRow);
        TextRC[iRow, 1] := cMsg;
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
        Inc(iRow, 2);
        cMsg := 'Отправитель:   Національний університет "Одеська політехніка"';
        TextRC[iRow, 1] := cMsg;
        RowHeight[iRow] := Round(1.5 * nMyConst);
        SetSelection(iRow, 1, iRow, 1);
        SetAlignment(F1HAlignLeft, false, F1VAlignCenter, 0);
        Inc(iRow);
        cMsg := 'Платежное поручение № _____ от "___" _______ _____ г.';
        TextRC[iRow, 1] := cMsg;
        RowHeight[iRow] := Round(1.5 * nMyConst);
        SetSelection(iRow, 1, iRow, 1);
        SetAlignment(F1HAlignLeft, false, F1VAlignCenter, 0);
        Inc(iRow);
        iCol := 1;
        TextRC[iRow, iCol] := '№ п/п';
        ColWidth[iCol] := Round(4 * nMyConst);     // 1. № п/п
        Inc(iCol);
        TextRC[iRow, iCol] := 'Куда';
        ColWidth[iCol] := Round(34 * nMyConst);    // 2. ФИО
        Inc(iCol);
        TextRC[iRow, iCol] := 'Кому';
        ColWidth[iCol] := Round(25 * nMyConst);    // 3. Komu
        Inc(iCol);
        TextRC[iRow, iCol] := 'Сумма перевода';
        ColWidth[iCol] := Round(9 * nMyConst);    // 4. SmPerevoda

        if (cIsPst = 'Y') then begin
          Inc(iCol);
          TextRC[iRow, iCol] := 'Почтовый сбор';
          ColWidth[iCol] := Round(9 * nMyConst);    // 5. SmPsb
          Inc(iCol);
          TextRC[iRow, iCol] := 'НДС на почтовый сбор';
          ColWidth[iCol] := Round(9 * nMyConst);    // 6. SmNDS
          Inc(iCol);
          TextRC[iRow, iCol] := 'Почтовый сбор без НДС';
          ColWidth[iCol] := Round(9 * nMyConst);    // 7. SmBezNds
          iColNum := nMaxCol;
        end else
          iColNum := nMaxCol - 3;

        SetSelection(iRow, 1, iRow, {nMaxCol} iColNum);
        SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
        SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
        nStartRow := iRow + 1;
        nSmPerevodaTts := 0;
        nSmPsbTts := 0;
        nSmNdsTts := 0;
        nSmBezNdsTts := 0;
        nPp := 0;
        while (FieldByName('KdPst').AsInteger = nKdPst) and
                 (FieldByName('PSch').AsString = cPSch) and not Eof do begin
          nTabN   := FieldByName('TabN').AsInteger;
          nSpecNR := FieldByName('SpecNR').AsInteger;
          cKuda := '';
          cKomu := '';
          nSmPerevoda := 0;
          nSmPsb := 0;
          nSmNds := 0;
          nSmBezNds := 0;
          while (FieldByName('TabN').AsInteger = nTabN) and
                      (FieldByName('SpecNR').AsInteger = nSpecNR) and
                                                            not Eof do begin
            if FieldByName('Kuda').AsString <> '' then
              cKuda := cKuda + ' ' + FieldByName('Kuda').AsString;
            if FieldByName('Komu').AsString <> '' then
              cKomu := cKomu + ' ' + FieldByName('Komu').AsString
            else
              cKomu := FieldByName('Fam').AsString + ' ' +
                       FieldByName('Ima').AsString + ' ' +
                       FieldByName('Otch').AsString;
            nSmPerevoda := nSmPerevoda + FieldByName('SmPerevoda').AsFloat;
            nSmPsb := nSmPsb + FieldByName('SmPsb').AsFloat;
            nSmNds := nSmNds + FieldByName('SmNds').AsFloat;
            nSmBezNds := nSmBezNds + FieldByName('SmBezNds').AsFloat;
            nSmPerevodaTts := nSmPerevodaTts +
                                            FieldByName('SmPerevoda').AsFloat;
            nSmPsbTts := nSmPsbTts + FieldByName('SmPsb').AsFloat;
            nSmNdsTts := nSmNdsTts + FieldByName('SmNds').AsFloat;
            nSmBezNdsTts := nSmBezNdsTts + FieldByName('SmBezNds').AsFloat;
            Next;
          end;
          Inc(nPp);
          Inc(iRow);
          iCol := 1;
          TextRC[iRow, iCol] := IntToStr(nPp) + '.';
          SetSelection(iRow, iCol, iRow, iCol);
          SetAlignment(F1HAlignRight, true, F1VAlignBottom, 0);
          Inc(iCol);
          TextRC[iRow, iCol] := cKuda;
          Inc(iCol);
          TextRC[iRow, iCol] := cKomu;
          SetSelection(iRow, iCol-1, iRow, iCol);
          SetAlignment(F1HAlignLeft, true, F1VAlignBottom, 0);
          Inc(iCol);
          NumberRC[iRow, iCol] := nSmPerevoda;

          if (cIsPst = 'Y') then begin
            Inc(iCol);
            NumberRC[iRow, iCol] := nSmPsb;
            Inc(iCol);
            NumberRC[iRow, iCol] := nSmNds;
            Inc(iCol);
            NumberRC[iRow, iCol] := nSmBezNds;
            iColNum := nMaxCol;
          end else
            iColNum := nMaxCol - 3;

          SetSelection(iRow, iSumCol, iRow, iCol);
          FormatFixed2;
        end; {while}

        SetSelection(nStartRow, 1, iRow, {nMaxCol} iColNum);
        SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
        Inc(iRow);
        iCol := 2;
        TextRC[iRow, iCol] := 'И т о г о:';
        SetSelection(iRow, iCol, iRow, iCol);
        SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);
        iCol := 4;
        NumberRC[iRow, iCol] := nSmPerevodaTts;

        if (cIsPst = 'Y') then begin
          iCol := 5;
          NumberRC[iRow, iCol] := nSmPsbTts;
          iCol := 6;
          NumberRC[iRow, iCol] := nSmNdsTts;
          iCol := 7;
          NumberRC[iRow, iCol] := nSmBezNdsTts;
        end;

        SetSelection(iRow, iSumCol, iRow, iCol);
        FormatFixed2;
        Inc(iRow);
        iCol := 2;
        TextRC[iRow, iCol] := 'В с е г о:';
        SetSelection(iRow, iCol, iRow, iCol);
        SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);
        iCol := 4;
        NumberRC[iRow, iCol] := nSmPerevodaTts + nSmPsbTts;
        iColNum := 4;

        if (cIsPst = 'Y') then begin
          SetSelection(iRow, iCol, iRow, iCol+1);
          SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignBottom, 0);
          iCol := 6;
          NumberRC[iRow, iCol] := nSmNdsTts + nSmBezNdsTts;
          SetSelection(iRow, iCol, iRow, iCol+1);
          SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignBottom, 0);
          iColNum := 7;
        end;

        SetSelection(iRow, iSumCol, iRow, iColNum);
        FormatFixed2;

        SetSelection(iRow-1, 1, iRow, iColNum);
        SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
        Inc(iRow, 2);
        iCol := 2;
        nKopeek := 0;
        TextRC[iRow, iCol] := 'Всего переводов: ' + IntToStr(nPp) +
                                  ' (' + SumPropis(nPp, 'm', nKopeek) + ')';
        Inc(iRow, 2);
        iCol := 2;
        TextRC[iRow, iCol] := 'Сумма переводов: ';
        iCol := 3;
        nKopeek := 0;
        cMsg := SumPropis(nSmPerevodaTts, 'w', nKopeek);
        if cMsg <> '' then
          cMsg := AnsiUpperCase(Copy(cMsg, 1, 1)) +
                                Copy(cMsg, 2, Length(cMsg)) + ' грн., '
        else
          cMsg := 'Ноль грн., ';
        if nKopeek <> 0 then begin
          if nKopeek < 10 then
            cMsg := cMsg + '0';
          cMsg := cMsg + IntToStr(nKopeek) + ' коп.'; end
        else
          cMsg := cMsg + '00 коп.';
        TextRC[iRow, iCol] := cMsg;
        SetSelection(iRow, iCol, iRow, nMaxCol);
        SetAlignment(F1HAlignCenterAcrossCells, true, F1VAlignBottom, 0);
        if nSmPsbTts <> 0 then begin
          Inc(iRow);
          iCol := 2;
          TextRC[iRow, iCol] := 'Сумма почтовых сборов: ';
          iCol := 3;
          nKopeek := 0;
          cMsg := SumPropis(nSmPsbTts, 'w', nKopeek);
          if cMsg <> '' then
            cMsg := AnsiUpperCase(Copy(cMsg, 1, 1)) +
                             Copy(cMsg, 2, Length(cMsg)) + ' грн., '
          else
            cMsg := 'Ноль грн., ';
          if nKopeek <> 0 then begin
            if nKopeek < 10 then
              cMsg := cMsg + '0';
            cMsg := cMsg + IntToStr(nKopeek) + ' коп.'; end
          else
            cMsg := cMsg + '00 коп.';
          TextRC[iRow, iCol] := cMsg;
          SetSelection(iRow, iCol, iRow, nMaxCol);
          SetAlignment(F1HAlignCenterAcrossCells, true, F1VAlignBottom, 0);
        end;
        Inc(iRow, 2);
        iCol := nMaxCol;
        TextRC[iRow, iCol] := 'Керiвник        __________________';
        SetSelection(iRow, iCol, iRow, iCol);
        SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
        Inc(iRow, 2);
        iCol := nMaxCol;
        TextRC[iRow, iCol] := 'Главный бухгалтер   __________________';
        SetSelection(iRow, iCol, iRow, iCol);
        SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
        Inc(iRow, 2);
        iCol := nMaxCol;
        TextRC[iRow, iCol] := 'Бухгалтер  __________________  ' +
                                               Form_Dm.KdUsr2FioUsr(nAppKdUsr);
        SetSelection(iRow, iCol, iRow, iCol);
        SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
        Inc(iRow, 2);
        AddRowPageBreak(iRow);
      end;
      cPostaFileNm := RandomFileName;
      if bAppDocsToExcel then begin
        cPostaFileNm := cPostaFileNm + '.xls';
        WriteEx(cDirTemp + cPostaFileNm, F1FileExcel97); end
      else begin
        cPostaFileNm := cPostaFileNm + '.vts';
        WriteEx(cDirTemp + cPostaFileNm, F1FileFormulaOne6);
      end;
      Screen.Cursor := crDefault;
    end;
    Free;
  end;
  Screen.Cursor := crDefault;
  MyPreView(cDirTemp, cPostaFileNm);
end;
//------------------------------------------------------------------------------
procedure F6_PrtVedPvd(dDtPrc : TDateTime; cdsPrt : TDataSet);
var iRow, iCol, nStartRow, nMyConst, nMaxCol,
                                     nTabN, nPp, nKopeek, nSpecNR : integer;
    cMsg, cPostaFileNm  : string;
    nY, nM, nD : word;
    PgSetup : F1PageSetup;
    cKuda, cKomu, cPSch : ShortString;
    nSmPerevoda, nSmPsb, nSmNds, nSmBezNds : double;
    nSmPerevodaTts, nSmPsbTts, nSmNdsTts, nSmBezNdsTts : double;
    nKdPst : SmallInt;
    cIsPst: string;
    iColNum: integer;
    iNppCol, iKudaCol, iKomuCol,
    nKudaCols, nKomuCols: integer;
    iSumCol, iSumSborCol, iSumNDSCol, iSumBezNDSCol: integer;
begin
  Screen.Cursor := crHourGlass;
  FormZpCmnPrt := TFormZpCmnPrt.Create(Application);

  with FormZpCmnPrt, F6B do begin
    PgSetup := CreateNewPageSetup;
    SetPageParams(PgSetup);
    SetPageSetup(PgSetup);

    DecodeDate(dDtProc, nY, nM, nd);
    nMyConst := RowHeight[1];

    ShowGridLines    := false;
    ShowColHeading   := true;
    ShowRowHeading   := true;
    ShowZeroValues   := false;
    ShowTabs         := 0;
    PrintNoColor     := true;
    PrintGridLines   := false;
    PrintFooter      := '';
    PrintHeader      := '';
    PrintLandscape   := false;
    DefaultFontCharSet := F1RussianCharSet;
    DefaultFontSize := 10;

    // Ширины столбцов
    nMaxCol := 12;
    ColWidth[ 1] := Round(4 * nMyConst);   //  1. № п/п
    ColWidth[ 2] := Round(9 * nMyConst);   //  2. Куда 1
    ColWidth[ 3] := Round(9 * nMyConst);   //  3. Куда 2
    ColWidth[ 4] := Round(8 * nMyConst);   //  4. Куда 3
    ColWidth[ 5] := Round(8 * nMyConst);   //  5. Куда 4
    ColWidth[ 6] := Round(8 * nMyConst);   //  6. Кому 1         / Куда 5
    ColWidth[ 7] := Round(8 * nMyConst);   //  7. Кому 2         / Куда 6
    ColWidth[ 8] := Round(9 * nMyConst);   //  8. Кому 3         / Кому 1
    ColWidth[ 9] := Round(9 * nMyConst);   //  9. Сумма Перевода / Кому 2
    ColWidth[10] := Round(9 * nMyConst);   // 10. Сумма Почт.Сб  / Кому 3
    ColWidth[11] := Round(9 * nMyConst);   // 11. Сумма НДС      / Кому 4
    ColWidth[12] := Round(9 * nMyConst);   // 12. Сумма Без НДС  / Сумма перевода

    with cdsPrt do begin
      Screen.Cursor := crHourGlass;

      First;
      iRow := 1;
      while not Eof do begin
        nKdPst := FieldByName('KdPst').AsInteger;
        cIsPst := FieldByName('Is_Pst').AsString;
        cPSch  := FieldByName('PSch').AsString;

        // Количества столбцов в поле, в зависимости от способа перевода
        if (cIsPst = 'Y') then begin
          nKudaCols := 4;
          nKomuCols := 3;
        end else begin
          nKudaCols := 6;
          nKomuCols := 4;
        end;

        // Индексы столбцов
        iNppCol := 1;
        iKudaCol := 2;
        iKomuCol := iKudaCol + nKudaCols;
        iSumCol := iKomuCol + nKomuCols;
        iSumSborCol := iSumCol + 1;
        iSumNDSCol := iSumSborCol + 1;
        iSumBezNDSCol := iSumNDSCol + 1;

        // Номер счёта в правом верхнем углу
        Inc(iRow);
        TextRC[iRow, nMaxCol] := 'Рахунок ' + cPSch;
        SetSelection(iRow, nMaxCol, iRow, nMaxCol);
        SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
        FontUnderLine := true;

        Inc(iRow);
        TextRC[iRow, 1] := 'С П И С О К';
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);

        cMsg := '';
        if (cIsPst = 'Y') then
          cMsg := cMsg + 'почтових ';
        cMsg := cMsg + 'переказiв,';

        Inc(iRow);
        TextRC[iRow, 1] := cMsg;
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);

        cMsg := '';
        if (cIsPst = 'Y') then
          cMsg := cMsg + 'поданих в почтове вiддiлення № ___ ';
        cMsg := cMsg + 'за ' + UkrMes(nM) + ' ' + IntToStr(nY) + ' р.';

        Inc(iRow);
        TextRC[iRow, 1] := cMsg;
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);

        Inc(iRow, 2);
        TextRC[iRow, 1] := 'Вiдправник:   Національний університет "Одеська політехніка"';
        RowHeight[iRow] := Round(1.5 * nMyConst);
        SetSelection(iRow, 1, iRow, 1);
        SetAlignment(F1HAlignLeft, false, F1VAlignCenter, 0);

        Inc(iRow);
        {TextRC[iRow, 1] := 'Платежное поручение № _____ от "___" _______ _____ г.';
        RowHeight[iRow] := Round(1.5 * nMyConst);
        SetSelection(iRow, 1, iRow, 1);
        SetAlignment(F1HAlignLeft, false, F1VAlignCenter, 0);}

        // Заголовок таблицы
        Inc(iRow);
        TextRC[iRow, iNppCol] := '№ п/п';
        TextRC[iRow, iKudaCol] := 'Отримувач';
        TextRC[iRow, iKomuCol] := 'Призначення платежу';
        TextRC[iRow, iSumCol] := 'Сума переказу';
        if (cIsPst = 'Y') then begin
          TextRC[iRow, iSumSborCol] := 'Почтовий збiр';
          TextRC[iRow, iSumNDSCol] := 'НДС на почтовий збiр';
          TextRC[iRow, iSumBezNDSCol] := 'Почтовый збiр без НДС';
        end;

        // Выравнивание текста заголовка таблицы
        SetSelection(iRow, iNppCol, iRow, nMaxCol);
        SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);

        SetSelection(iRow, iKudaCol, iRow, iKudaCol + nKudaCols - 1);
        SetAlignment(F1HAlignCenterAcrossCells, true, F1VAlignCenter, 0);

        SetSelection(iRow, iKomuCol, iRow, iKomuCol + nKomuCols - 1);
        SetAlignment(F1HAlignCenterAcrossCells, true, F1VAlignCenter, 0);

        // Бордюр заголовка таблицы
        SetSelection(iRow, iNppCol, iRow, iNppCol);
        SetBorder(1,0,0,0,0,0,clBlack,clNone,clNone,clNone,clNone);

        SetSelection(iRow, iKudaCol, iRow, iKudaCol + nKudaCols - 1);
        SetBorder(1,0,0,0,0,0,clBlack,clNone,clNone,clNone,clNone);

        SetSelection(iRow, iKomuCol, iRow, iKomuCol + nKomuCols - 1);
        SetBorder(1,0,0,0,0,0,clBlack,clNone,clNone,clNone,clNone);

        SetSelection(iRow, iSumCol, iRow, iSumCol);
        SetBorder(1,0,0,0,0,0,clBlack,clNone,clNone,clNone,clNone);

        if (cIsPst = 'Y') then begin
          SetSelection(iRow, iSumSborCol, iRow, iSumSborCol);
          SetBorder(1,0,0,0,0,0,clBlack,clNone,clNone,clNone,clNone);

          SetSelection(iRow, iSumNDSCol, iRow, iSumNDSCol);
          SetBorder(1,0,0,0,0,0,clBlack,clNone,clNone,clNone,clNone);

          SetSelection(iRow, iSumBezNDSCol, iRow, iSumBezNDSCol);
          SetBorder(1,0,0,0,0,0,clBlack,clNone,clNone,clNone,clNone);
        end;

        // Инициализация итогов
        nSmPerevodaTts := 0;
        nSmPsbTts := 0;
        nSmNdsTts := 0;
        nSmBezNdsTts := 0;

        nStartRow := iRow + 1;
        nPp := 0;

        while (FieldByName('KdPst').AsInteger = nKdPst)
            and (FieldByName('PSch').AsString = cPSch) and not Eof do begin

          nTabN   := FieldByName('TabN').AsInteger;
          nSpecNR := FieldByName('SpecNR').AsInteger;
          cKuda := '';
          cKomu := '';
          nSmPerevoda := 0;
          nSmPsb := 0;
          nSmNds := 0;
          nSmBezNds := 0;

          while (FieldByName('TabN').AsInteger = nTabN)
              and (FieldByName('SpecNR').AsInteger = nSpecNR) and not Eof do begin

            if FieldByName('Kuda').AsString <> '' then begin
              if cKuda <> '' then
                cKuda := cKuda + ' ';
              cKuda := cKuda + FieldByName('Kuda').AsString;
            end;

            if FieldByName('Komu').AsString <> '' then begin
              if cKomu <> '' then
                cKomu := cKomu + ' ';
              cKomu := cKomu + FieldByName('Komu').AsString
            end else
              cKomu := FieldByName('Fam').AsString + ' '
                  + FieldByName('Ima').AsString + ' '
                  + FieldByName('Otch').AsString;

            nSmPerevoda := nSmPerevoda + FieldByName('SmPerevoda').AsFloat;
            nSmPsb := nSmPsb + FieldByName('SmPsb').AsFloat;
            nSmNds := nSmNds + FieldByName('SmNds').AsFloat;
            nSmBezNds := nSmBezNds + FieldByName('SmBezNds').AsFloat;

            nSmPerevodaTts := nSmPerevodaTts + FieldByName('SmPerevoda').AsFloat;
            nSmPsbTts := nSmPsbTts + FieldByName('SmPsb').AsFloat;
            nSmNdsTts := nSmNdsTts + FieldByName('SmNds').AsFloat;
            nSmBezNdsTts := nSmBezNdsTts + FieldByName('SmBezNds').AsFloat;

            Next;
          end; {while TabN, SpecNr}

          Inc(nPp);
          Inc(iRow);

          TextRC[iRow, iNppCol] := IntToStr(nPp) + '.';
          SetSelection(iRow, iNppCol, iRow, iNppCol);
          SetAlignment(F1HAlignRight, true, F1VAlignCenter, 0);

          TextRC[iRow, iKudaCol] := cKuda;
          SetSelection(iRow, iKudaCol, iRow, iKudaCol + nKudaCols - 1);
          SetAlignment(F1HAlignCenterAcrossCells, true, F1VAlignCenter, 0);

          TextRC[iRow, iKomuCol] := cKomu;
          SetSelection(iRow, iKomuCol, iRow, iKomuCol + nKomuCols - 1);
          SetAlignment(F1HAlignCenterAcrossCells, true, F1VAlignCenter, 0);

          NumberRC[iRow, iSumCol] := nSmPerevoda;
          if (cIsPst = 'Y') then begin
            NumberRC[iRow, iSumSborCol] := nSmPsb;
            NumberRC[iRow, iSumNDSCol] := nSmNds;
            NumberRC[iRow, iSumBezNDSCol] := nSmBezNds;
          end;
          SetSelection(iRow, iSumCol, iRow, iSumBezNDSCol);
          FormatFixed2;
          SetAlignment(F1HAlignRight, true, F1VAlignCenter, 0);
        end; {while KdPst, PSch}

        SetSelection(nStartRow, 1, iRow, nMaxCol);
        SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);

        Inc(iRow);
        TextRC[iRow, iKudaCol] := 'Р а з о м:';
        SetSelection(iRow, iKudaCol, iRow, iKudaCol);
        SetAlignment(F1HAlignCenter, false, F1VAlignCenter, 0);

        NumberRC[iRow, iSumCol] := nSmPerevodaTts;
        if (cIsPst = 'Y') then begin
          NumberRC[iRow, iSumSborCol] := nSmPsbTts;
          NumberRC[iRow, iSumNDSCol] := nSmNdsTts;
          NumberRC[iRow, iSumBezNDSCol] := nSmBezNdsTts;
        end;
        SetSelection(iRow, iSumCol, iRow, iSumBezNdsCol);
        FormatFixed2;

        Inc(iRow);
        TextRC[iRow, iKudaCol] := 'В с ь о г о:';
        SetSelection(iRow, iKudaCol, iRow, iKudaCol);
        SetAlignment(F1HAlignCenter, false, F1VAlignCenter, 0);

        NumberRC[iRow, iSumCol] := nSmPerevodaTts + nSmPsbTts;
        if (cIsPst = 'Y') then begin
          SetSelection(iRow, iSumCol, iRow, iSumSborCol);
          SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);

          NumberRC[iRow, iSumNDSCol] := nSmNdsTts + nSmBezNdsTts;
          SetSelection(iRow, iSumNDSCol, iRow, iSumBezNDSCol);
          SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
        end;
        SetSelection(iRow, iSumCol, iRow, nMaxCol);
        FormatFixed2;

        // Бордюр итогов таблицы
        SetSelection(iRow-1, iNppCol, iRow, iNppCol);
        SetBorder(1,0,0,1,1,0,clBlack,clNone,clNone,clBlack,clBlack);

        SetSelection(iRow-1, iKudaCol, iRow, iKudaCol + nKudaCols + nKomuCols -1);
        SetBorder(1,0,0,1,1,0,clBlack,clNone,clNone,clBlack,clBlack);

        SetSelection(iRow-1, iSumCol, iRow, iSumCol);
        SetBorder(1,0,0,1,1,0,clBlack,clNone,clNone,clBlack,clBlack);

        if (cIsPst = 'Y') then begin
          SetSelection(iRow-1, iSumSborCol, iRow, iSumSborCol);
          SetBorder(1,0,0,1,1,0,clBlack,clNone,clNone,clBlack,clBlack);

          SetSelection(iRow-1, iSumNDSCol, iRow, iSumNDSCol);
          SetBorder(1,0,0,1,1,0,clBlack,clNone,clNone,clBlack,clBlack);

          SetSelection(iRow-1, iSumBezNDSCol, iRow, iSumBezNDSCol);
          SetBorder(1,0,0,1,1,0,clBlack,clNone,clNone,clBlack,clBlack);
        end;

        Inc(iRow, 2);
        nKopeek := 0;
        TextRC[iRow, iKudaCol] :=
          'Всього переказiв: ' + IntToStr(nPp) + ' (' + SumPropis(nPp, 'm', nKopeek) + ')';

        Inc(iRow, 2);
        TextRC[iRow, iKudaCol] := 'Сума переказiв: ';

        nKopeek := 0;
        cMsg := UkrSumPropis(nSmPerevodaTts, 'w', nKopeek);
        if cMsg <> '' then
          cMsg := AnsiUpperCase(Copy(cMsg, 1, 1)) + Copy(cMsg, 2, Length(cMsg)) + ' грн., '
        else
          cMsg := 'Ноль грн., ';
        if nKopeek <> 0 then begin
          if nKopeek < 10 then
            cMsg := cMsg + '0';
          cMsg := cMsg + IntToStr(nKopeek) + ' коп.';
        end else
          cMsg := cMsg + '00 коп.';
        TextRC[iRow, iKomuCol] := cMsg;
        SetSelection(iRow, iKomuCol, iRow, nMaxCol);
        SetAlignment(F1HAlignCenterAcrossCells, true, F1VAlignBottom, 0);

        if nSmPsbTts <> 0 then begin
          Inc(iRow);
          TextRC[iRow, iKudaCol] := 'Сума почтових зборiв: ';

          nKopeek := 0;
          cMsg := SumPropis(nSmPsbTts, 'w', nKopeek);
          if cMsg <> '' then
            cMsg := AnsiUpperCase(Copy(cMsg, 1, 1)) + Copy(cMsg, 2, Length(cMsg)) + ' грн., '
          else
            cMsg := 'Ноль грн., ';
          if nKopeek <> 0 then begin
            if nKopeek < 10 then
              cMsg := cMsg + '0';
            cMsg := cMsg + IntToStr(nKopeek) + ' коп.';
          end else
            cMsg := cMsg + '00 коп.';
          TextRC[iRow, iKomuCol] := cMsg;
          SetSelection(iRow, iKomuCol, iRow, nMaxCol);
          SetAlignment(F1HAlignCenterAcrossCells, true, F1VAlignBottom, 0);
        end; {if}

        Inc(iRow, 2);
        TextRC[iRow, nMaxCol] := 'Керiвник        __________________';
        SetSelection(iRow, nMaxCol, iRow, nMaxCol);
        SetAlignment(F1HAlignRight, false, F1VAlignCenter, 0);

        Inc(iRow, 2);
        TextRC[iRow, nMaxCol] := 'Головний бухгалтер   __________________';
        SetSelection(iRow, nMaxCol, iRow, nMaxCol);
        SetAlignment(F1HAlignRight, false, F1VAlignCenter, 0);

        Inc(iRow, 2);
        TextRC[iRow, nMaxCol] := 'Бухгалтер  __________________  ' +
                                               Form_Dm.KdUsr2FioUsr(nAppKdUsr);
        SetSelection(iRow, nMaxCol, iRow, nMaxCol);
        SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
        Inc(iRow, 2);
        AddRowPageBreak(iRow);
      end;
      cPostaFileNm := RandomFileName;
      if bAppDocsToExcel then begin
        cPostaFileNm := cPostaFileNm + '.xls';
        WriteEx(cDirTemp + cPostaFileNm, F1FileExcel97);
      end else begin
        cPostaFileNm := cPostaFileNm + '.vts';
        WriteEx(cDirTemp + cPostaFileNm, F1FileFormulaOne6);
      end;
      Screen.Cursor := crDefault;
    end; {with cdsPrt}

    Free;
  end; {with FormZpCmnPrt, F6B}

  Screen.Cursor := crDefault;
  MyPreView(cDirTemp, cPostaFileNm);
end;
