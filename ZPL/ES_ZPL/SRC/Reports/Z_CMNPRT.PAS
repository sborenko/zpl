procedure F6PrtSvdByKatP(dtsSvd : TDataSet; dDtProc : TDateTime);
var nMyConst, iRow, iCol, nMaxCol, nPp : integer;
    cMsg : string; cNmVidN, cShKatP : ShortString;
    cPSCH : string10; cVidN : string4;
    nNumberPSCH : integer;
    nPrtKatP : integer;
    nY, nM, nD : word;
    // Помнить, что в этом своде участвуют только виды начисления (до '5000')
    // и интересует он только в разрезе средств финансировани (801 и 811)
    nSmNach, nSmUdrg : double;
    nSmNachKP, nSmUdrgKP : double; // по категориям перс.
    nSmNachVS, nSmUdrgVS : double; // по видам средств
    PgSetup : F1PageSetup;
    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    procedure ShapochkaKatP(F6B : TF6Book; nY, nM : word; cPSCH : String10;
                                                   var iRow, iCol : integer);
    var cMsg : string;
    begin
      with F6B do begin
        Inc(iRow);
        if nNumberPSCH > 1 then begin
          AddRowPageBreak(iRow);
        end;
        Inc(iRow);
        iCol := 1;
        if cPSCH = 'ВсеPSch' then begin
          TextRC[iRow, iCol] := 'Зведення за категоріями персоналу';
          RowHeight[iRow] := Round(1.2 * nMyConst);
          SetSelection(iRow, 1, iRow, nMaxCol);
          SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
          FontSize := 10;
          FontBold := true;
          Inc(iRow);
          TextRC[iRow, iCol] := '(по всіх видах финансування)';
          RowHeight[iRow] := Round(1.2 * nMyConst);
          SetSelection(iRow, 1, iRow, nMaxCol);
          SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
          FontSize := 10;
          FontBold := true;
        end else begin
          TextRC[iRow, iCol] :=
            'Зведення за категоріями персоналу (рахунок ' + cPSCH + ')';
          RowHeight[iRow] := Round(1.2 * nMyConst);
          SetSelection(iRow, 1, iRow, nMaxCol);
          SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
          FontSize := 10;
          FontBold := true;
        end;
        Inc(iRow);
        cMsg := 'за ' + UkrMes(nM) + ' ' + IntToStr(nY) + ' року';
        TextRC[iRow, iCol] := cMsg;
        RowHeight[iRow] := Round(1.2 * nMyConst);
        SetSelection(iRow-1, 1, iRow, nMaxCol);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
        FontSize := 10;
        FontBold := true;
        Inc(iRow);
        TextRC[iRow, iCol] := '№ з/п';
        ColWidth[iCol] := Round(5 * nMyConst);
        Inc(iCol);
        TextRC[iRow, iCol] := 'Вид';
        ColWidth[iCol] := Round(5 * nMyConst);
        Inc(iCol);
        TextRC[iRow, iCol] := 'Назва виду';
        ColWidth[iCol] := Round(55 * nMyConst);
        Inc(iCol);
        TextRC[iRow, iCol] := 'Нараховано';
        ColWidth[iCol] := Round(12 * nMyConst);
        Inc(iCol);
        TextRC[iRow, iCol] := 'Утримано';
        ColWidth[iCol] := Round(12 * nMyConst);
        Inc(iCol);
        TextRC[iRow, iCol] := 'Всього';
        ColWidth[iCol] := Round(12 * nMyConst);
        SetSelection(1, 1, 1, nMaxCol);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
        FontSize := 10;
        FontBold := true;
        RowHeight[iRow] := Round(2 * nMyConst);
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
        SetBorder(1, 1, 1, 1, 1, 0, clBlack,clBlack,clBlack,clBlack,clBlack);
      end;
    end;
    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
begin
  Screen.Cursor := crHourGlass;
  FormZpCmnPrt := TFormZpCmnPrt.Create(Application);
  with FormZpCmnPrt, F6B do begin
    PgSetup := CreateNewPageSetup;
    SetPageParams(PgSetup);
    SetPageSetup(PgSetup);
    DecodeDate(dDtProc, nY, nM, nD);
    ShowGridLines  := false;
    ShowColHeading := true;
    ShowRowHeading := true;
    ShowZeroValues := false;
    ShowTabs       := 0;
    PrintNoColor   := true;
    PrintGridLines := false;
    PrintFooter    := '';
    PrintHeader    := '';
    PrintLandscape := false;
    DefaultFontCharSet := F1RussianCharSet;
    DefaultFontSize := 10;
    nMyConst := RowHeight[1];
    iRow := 1;
    iCol := 1;
    nMaxCol := 6;
    with dtsSvd do begin
      DisableControls;
      First;
      nNumberPSCH := 0;
      while not Eof do begin
        Inc(nNumberPSCH);
        cPSCH := FieldByName('PSCH').AsString;
        ShapochkaKatP(F6B, nY, nM, cPSCH, iRow, iCol);
        nSmNachVS := 0;
        nSmUdrgVS := 0; // по видам средств
        while (FieldByName('PSCH').AsString = cPSCH) and not Eof do begin
          nPrtKatP := FieldByName('KdKatP').AsInteger;
          cShKatP := FieldByName('ShKatP').AsString;
          Inc(iRow);
          TextRC[iRow, 1] := 'Категория ' + IntToStr(nPrtKatP) + ' - ' +
                              FieldByName('ShKatP').AsString;
          SetSelection(iRow, 1, iRow, nMaxCol);
          SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
          FontUnderline := true;
          SetSelection(iRow, 1, iRow, nMaxCol);
          SetBorder(1, 1, 1, 1, 1, 0, clBlack,
                                  clBlack, clBlack, clBlack, clBlack);
          nSmNachKP := 0;
          nSmUdrgKP := 0; // по категориям перс.
          nPp := 0;
          while (FieldByName('KdKatP').AsInteger = nPrtKatP) and
                    (FieldByName('PSCH').AsString = cPSCH) and not Eof do begin
            cVidN := FieldByName('VidN').AsString;
            cNmVidN := FieldByName('NmVidN').AsString;
            nSmNach := 0;
            nSmUdrg := 0;
            while (FieldByName('VidN').AsString = cVidN) and
                   (FieldByName('KdKatP').AsInteger = nPrtKatP) and
                    (FieldByName('PSCH').AsString = cPSCH) and not Eof do begin
              if FieldByName('Znak').AsInteger > 0 then begin
                nSmNach := nSmNach + FieldByName('Summa').AsFloat;
                nSmNachKP := nSmNachKP + FieldByName('Summa').AsFloat;
                nSmNachVS := nSmNachVS + FieldByName('Summa').AsFloat; end
              else begin
                nSmUdrg := nSmUdrg - FieldByName('Summa').AsFloat;
                nSmUdrgKP := nSmUdrgKP - FieldByName('Summa').AsFloat;
                nSmUdrgVS := nSmUdrgVS - FieldByName('Summa').AsFloat;
              end;
              Next;
            end;
            Inc(nPp);
            Inc(iRow);
            NumberRC[iRow, 1] := nPp;
            TextRC[iRow, 2] := cVidN;
            TextRC[iRow, 3] := cNmVidN;
            NumberRC[iRow, 4] := nSmNach;
            NumberRC[iRow, 5] := nSmUdrg;
            NumberRC[iRow, 6] := nSmNach - nSmUdrg;
            SetSelection(iRow, 1, iRow, nMaxCol);
            SetBorder(1, 1, 1, 1, 1, 0, clBlack,
                                  clBlack, clBlack, clBlack, clBlack);
            SetSelection(iRow, 4, iRow, 6);
            FormatFixed2;
          end;
          Inc(iRow);
          TextRC[iRow, 1] := 'Всьго за категорією ' + cShKatP;
          SetSelection(iRow, 1, iRow, 3);
          SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
          NumberRC[iRow, 4] := nSmNachKP;
          NumberRC[iRow, 5] := nSmUdrgKP;
          NumberRC[iRow, 6] := nSmNachKP - nSmUdrgKP;
          SetSelection(iRow, 1, iRow, nMaxCol);
          SetBorder(1, 1, 1, 1, 1, 0, clBlack,
                                  clBlack, clBlack, clBlack, clBlack);
          SetSelection(iRow, 4, iRow, 6);
          FormatFixed2;
        end;
        Inc(iRow);
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetBorder(1, 1, 1, 1, 1, 0, clBlack,
                                  clBlack, clBlack, clBlack, clBlack);
        Inc(iRow);
        if cPSCH = 'ВсеPSch' then
          TextRC[iRow, 1] := 'Всього за всіма видами финансування'
        else
          TextRC[iRow, 1] := 'Всього за рахунком (видом финансування) ' + cPSCH;
        SetSelection(iRow, 1, iRow, 3);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
        NumberRC[iRow, 4] := nSmNachVS;
        NumberRC[iRow, 5] := nSmUdrgVS;
        NumberRC[iRow, 6] := nSmNachVS - nSmUdrgVS;
        SetSelection(iRow, 4, iRow, 6);
        FormatFixed2;
        SetSelection(iRow, 1, iRow, nMaxCol);
        FontBold := true;
        SetBorder(1, 1, 1, 1, 1, 0, clBlack,
                                  clBlack, clBlack, clBlack, clBlack);
      end;
      First;
      EnableControls;
    end;
    Inc(iRow, 3);
    if cBuhDolgn <> '' then
      cMsg := cBuhDolgn + '  ___________  ' + cBuhFIO
    else
      cMsg := 'Бухгалтер ____________ ' + Form_Dm.KdUsr2FioUsr(nAppKdUsr);
    TextRC[iRow, nMaxCol] := cMsg;
    SetSelection(iRow, nMaxCol, iRow, nMaxCol);
    SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
    cRandomFileName := RandomFileName;
    if bAppDocsToExcel then begin
      cRandomFileName := cRandomFileName + '.xls';
      WriteEx(cDirTemp + cRandomFileName, F1FileExcel97); end
    else begin
      cRandomFileName := cRandomFileName + '.vts';
      WriteEx(cDirTemp + cRandomFileName, F1FileFormulaOne6);
    end;
    Screen.Cursor   := crDefault;
    Free;
  end;
  Screen.Cursor := crDefault;
  MyPreView(cDirTemp, cRandomFileName);
end;
