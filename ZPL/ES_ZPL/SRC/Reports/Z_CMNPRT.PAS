procedure F6PrtVedKssByPSch(cdsPrt : TDataSet; nPrtVedNR : integer;
                 dPrtVedDate, dVedDtProc : TDateTime; cVedHead : ShortString);
// cdsPrt передается сюда сортированным по PSch и FamIO
var nStartRow, nPp, iRow, iCol, nMaxCol, nMyConst : integer;
    nSmTt : double;
    cMsg, cPSch : string;
    nSvTabN, nKopeek : integer;
    PgSetup : F1PageSetup; nY, nM : word;
    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    procedure ShapVedKssByPSch(F6B : TF6Book; nY, nM : word;
                                                   var iRow, iCol : integer);
    begin
      with F6B do begin
        Inc(iRow, 2);
        iCol := 1;
        TextRC[iRow, iCol] := cVedHead;
