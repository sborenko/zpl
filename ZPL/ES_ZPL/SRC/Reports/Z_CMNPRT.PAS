    ShowTabs         := 0;
    PrintNoColor     := true;
    PrintGridLines   := false;
    PrintFooter      := '';
    PrintHeader      := '';
    PrintLandscape   := false;
    DefaultFontCharSet := F1RussianCharSet;
    DefaultFontSize := 9;
    iRow := 1;
    iCol := 1;
    DecodeDate(dDtPrc, nY, nM, nD);
    cMsg := 'Список сотрудников ';
    if nKdObj > 0 then
      cMsg := cMsg + 'подразделения ' + IntToStr(nKdObj) + ' ';
    cMsg := cMsg + 'в ' + MesPredlogn(nM) + ' ' + IntToStr(nY) + ' г.';
    TextRC[iRow, iCol] := cMsg;
    SetSelection(iRow, 1, iRow, nMaxCol);
    SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
    Inc(iRow);
    iCol := 1;
    TextRC[iRow, iCol]  := '№№ п/п';
    ColWidth[iCol] := Round(5 * nMyConst);  // № п/п
    for i := 0 to LbxColNames.Items.Count-1 do begin
      Inc(iCol);
      TextRC[iRow, iCol] := LbxColTitles.Items[i];
    end;
    SetSelection(iRow, 1, iRow, nMaxCol);
    SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
    SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
    nPp := 0;
    with cdsSps do begin
      nSvTabN := FieldByName('TabN').AsInteger;
      DisableControls;
      First;
      while not Eof do begin
        Inc(nPp);
        Inc(iRow);
        iCol := 1;
        NumberRC[iRow, 1] := nPp;
        for i := 0 to LbxColNames.Items.Count-1 do begin
          Inc(iCol);
          cFieldName := UpperCase(LbxColNames.Items[i]);
          if (cFieldName = 'TABN') or (cFieldName = 'KDOBJ') or
                                            (cFieldName = 'KDBNK') then begin
            NumberRC[iRow, iCol] := FieldByName(LbxColNames.Items[i]).AsInteger;
            SetSelection(iRow, iCol, iRow, iCol);
            ColWidth[iCol] := Round( 7 * nMyConst); end
          else if (cFieldName = 'FAMIO') or (cFieldName = 'FAM') or
                   (cFieldName = 'IMA') or (cFieldName = 'OTCH') or
                   (cFieldName = 'DOLGNOST') or
                   (cFieldName = 'ID') or (cFieldName = 'SHBNK') or
                   (cFieldName = 'LICSCH') then
            TextRC[iRow, iCol] := FieldByName(LbxColNames.Items[i]).AsString
          else if (cFieldName = 'OKLAD') then begin
            NumberRC[iRow, iCol] := FieldByName(LbxColNames.Items[i]).AsInteger;
            SetSelection(iRow, iCol, iRow, iCol);
            FormatFixed2;
            ColWidth[iCol] := Round( 9 * nMyConst);
          end;
        end;
        SetColWidthAuto(iRow, 2, iRow, nMaxCol, false);
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
        Next;
      end;
      Locate('TabN', nSvTabN, []);
      EnableControls;
    end;
    Inc(iRow, 2);
    TextRC[iRow, nMaxCol] := 'Бухгалтер ____________ ' +
                                                Form_Dm.KdUsr2FioUsr(nAppKdUsr);
    SetSelection(iRow, nMaxCol, iRow, nMaxCol);
    SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
    Screen.Cursor := crHourGlass;
    cRandomFileName := RandomFileName;
    if bAppDocsToExcel then begin
      cRandomFileName := cRandomFileName + '.xls';
      WriteEx(cDirTemp + cRandomFileName, F1FileExcel97); end
    else begin
      cRandomFileName := cRandomFileName + '.vts';
      WriteEx(cDirTemp + cRandomFileName, F1FileFormulaOne6);
    end;
    Screen.Cursor := crDefault;
    Free;
  end;
  MyPreView(cDirTemp, cRandomFileName);
end;
