      TextRC[iRow, 6] := 'Календарні дні (основне місце роботи)';
      TextRC[iRow, 7] := 'Заробітна плата (сумісництво)';
      TextRC[iRow, 8] := 'Календарні дні (сумісництво)';
      SetSelection(iRow, 1, iRow, nMaxCol);
      SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
      SetSelection(iRow, 2, iRow, 4);
      SetAlignment(F1HAlignCenterAcrossCells, true, F1VAlignCenter, 0);
      SetSelection(iRow, 1, iRow, nMaxCol);
      SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
    end;

    SetSelection(iRow, 1, iRow, nMaxCol);
    nStartRow := iRow + 1;

    // Из z_EOtkl при расчёте по окладу приходит qryRSrOkl, а при расчёте
    // по 6-ти месяцам - qry_RBln. Тут они называются одинаково qry_RBln,
    // хотя у них разные структуры. Сие надо помнить при доработках

    if qryRBln.RecordCount > 0 then begin
      with qryRBln do begin
        nSvNR := FieldByName('NR').AsInteger;
        DisableControls;
        First;
        nPp := 0;
        nSmZpOsn     := 0;
        nCntDays     := 0;
        nSmZpSovm    := 0;
        nCntDaysSovm := 0;
        nSrDnOsn     := 0;
        nSrDnSovm    := 0;
        nSrDnCmn     := 0;

        while not Eof do begin
          Inc(iRow);
          Inc(nPp);

          if (cCase = '12m') or (cCase = '6m') {по 12-ти или 6-ти месяцам} then begin
            NumberRC[iRow, 1] := nPp;
            DecodeDate(FieldByName('ZaMesGod').AsDateTime, nY, nM, nD);
            TextRC[iRow, 2] := UkrMes(nM) + ' ' + IntToStr(nY) + ' г.';
            SetSelection(iRow, 2, iRow, 4);
            SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
            NumberRC[iRow, 5] := FieldByName('SmZarabotka').AsFloat;
            SetSelection(iRow, 5, iRow, 5);
            FormatFixed2;
            NumberRC[iRow, 6] := FieldByName('CntDays').AsFloat;
            SetSelection(iRow, 6, iRow, 6);
            FormatFixed;
            NumberRC[iRow, 7] := FieldByName('Sm_Svm').AsFloat;
            SetSelection(iRow, 7, iRow, 7);
            FormatFixed2;
            NumberRC[iRow, 8] := FieldByName('CntDays_Svm').AsFloat;
            SetSelection(iRow, 8, iRow, 8);
            FormatFixed;

            nSmZpOsn := nSmZpOsn + FieldByName('SmZarabotka').AsFloat;
            nCntDays := nCntDays + FieldByName('CntDays').AsFloat;
            nSmZpSovm := nSmZpSovm + FieldByName('Sm_Svm').AsFloat;
            nCntDaysSovm := nCntDaysSovm + FieldByName('CntDays_Svm').AsFloat;

          end else begin{по окладу}
            NumberRC[iRow, 1] := nPp;
            TextRC[iRow, 2] := FieldByName('VidN').AsString;
            TextRC[iRow, 3] := FieldByName('NmPokaz').AsString;
            TextRC[iRow, 4] := FieldByName('ShVidN').AsString;
            TextRC[iRow, 5] := FieldByName('SP').AsString;
            SetSelection(iRow, 5, iRow, 5);
            SetAlignment(F1HAlignCenter, false, F1VAlignCenter, 0);
            NumberRC[iRow, 6] := FieldByName('SumProc').AsFloat;
            SetSelection(iRow, 6, iRow, 7);
            SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
            NumberRC[iRow, 8] := FieldByName('SmVZachet').AsFloat;
            SetSelection(iRow, 6, iRow, 8);
            FormatFixed2;

            nSmZpOsn := nSmZpOsn + FieldByName('SmVZachet').AsFloat;
          end;

          Next;
        end; {while qryRBln}

        Locate('NR', nSvNR, []);
        EnableControls;
      end; {with qry_RBln}

      if nCntDays <> 0 then
        nSrDnOsn  := TNumUtils.RoundToKopeck(nSmZpOsn / nCntDays)
      else
        nSrDnOsn := 0;

      if nCntDaysSovm <> 0 then
        nSrDnSovm := TNumUtils.RoundToKopeck(nSmZpSovm / nCntDaysSovm)
      else
        nSrDnSovm := 0;

      nSrDnCmn  := nSrDnOsn + nSrDnSovm;

      SetSelection(nStartRow, 1, iRow, nMaxCol);
      SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
      Inc(iRow);
      TextRC[iRow, 4] := 'Итого:';
      NumberRC[iRow, 5] := nSmZpOsn;
      SetSelection(iRow, 5, iRow, 5);
      FormatFixed2;
      NumberRC[iRow, 6] := nCntDays;
      SetSelection(iRow, 6, iRow, 6);
      FormatFixed;
      NumberRC[iRow, 7] := nSmZpSovm;
      SetSelection(iRow, 7, iRow, 7);
      FormatFixed2;
      NumberRC[iRow, 8] := nCntDaysSovm;
      SetSelection(iRow, 8, iRow, 8);
      FormatFixed;

    end else if qryVBln.FieldByName('ListCont').AsString = '1' then begin
      // это годится для обоих алгоритмов
      cMsg := 'В залiк прийнята сума середнего,';
      Inc(iRow);
      TextRC[iRow, 1] := cMsg;
      SetSelection(iRow, 1, iRow, nMaxCol);
      SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
      SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
      cMsg := 'розрахована для листка № ' +
                qryVBln.FieldByName('PredNR').AsString + ' от ' +
                qryVBln.FieldByName('PredDt').AsString;
      Inc(iRow);
      TextRC[iRow, 1] := cMsg;
      SetSelection(iRow, 1, iRow, nMaxCol);
      SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
      SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
    end;

    Inc(iRow);
    TextRC[iRow, 4] := 'СереднДн. зароб. основний:';
    NumberRC[iRow, 8] := nSrDnOsn;
    SetSelection(iRow, 8, iRow, 8);
    FormatFixed2;
    SetSelection(iRow-1, 1, iRow, nMaxCol);
    SetBorder(1,-1,-1,-1,-1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
    Inc(iRow);
    TextRC[iRow, 4] := 'СереднДн. зароб. сумiсницький:';
    NumberRC[iRow, 8] := nSrDnSovm;
    SetSelection(iRow, 8, iRow, 8);
    FormatFixed2;
    SetSelection(iRow-1, 1, iRow, nMaxCol);
    SetBorder(1,-1,-1,-1,-1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
    Inc(iRow);
    TextRC[iRow, 4] := 'СереднДн. зароб. загальн:';
    NumberRC[iRow, 8] := nSrDnCmn;
    SetSelection(iRow, 8, iRow, 8);
    FormatFixed2;
    SetSelection(iRow-1, 1, iRow, nMaxCol);
    SetBorder(1,-1,-1,-1,-1,0,clBlack,clBlack,clBlack,clBlack,clBlack);

    bSovmSumExists := false;
    with tblRBln do begin
      First;
      while not Eof do begin
        if tblRbln.FieldByName('SmmSovm').AsFloat <> 0 then begin
          bSovmSumExists := true;
          break;
        end;
        Next;
      end;
    end;

    if bSovmSumExists then begin
      Inc(nMaxCol);
      ColWidth[8] := Round( 9 * nMyConst);
    end;

    Inc(iRow, 2);
    if cVidBln = '2602' then
      cMsg := 'Нарахування декретних'
    else
      cMsg := 'Нарахування лiкарняних';
    TextRC[iRow, 1] := cMsg;
    SetSelection(iRow, 1, iRow, nMaxCol);
    FontBold := true;
    SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
    Inc(iRow);
    TextRC[iRow, 1] := '№ з/п';
    TextRC[iRow, 2] := 'Вид';
    TextRC[iRow, 3] := 'Шифр виду';
    TextRC[iRow, 4] := 'Дата початку:';
    TextRC[iRow, 5] := 'Дата закiнчення:';

    if (cCase = '12m') or (cVidBln = '2602') then
      TextRC[iRow, 7] := 'Календ. днiв'
    else
      TextRC[iRow, 7] := 'Роб. днiв';

    if cVidBln = '2602' then begin
      TextRC[iRow, 8] := 'Сума декрет. осн.зароб';
      if bSovmSumExists then
        TextRC[iRow, 9] := 'Сума декрет. сумiсн.зароб';
    end else begin
      TextRC[iRow, 8] := 'Сума лiкарн.осн.зароб';
      if bSovmSumExists then
        TextRC[iRow, 9] := 'Сума лiкарн.сумiсн.зароб';
    end;

    SetSelection(iRow, 1, iRow, nMaxCol);
    SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
    SetSelection(iRow, 5, iRow, 6);
    SetAlignment(F1HAlignCenterAcrossCells, true, F1VAlignCenter, 0);
    SetSelection(iRow, 1, iRow, nMaxCol);
    SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);

    with tblRBln do begin
      First;
      nPp := 0;
      nCntDays := 0;
      nSmBlnTt := 0;
      nSmBlnSovmTt := 0;
      while not Eof do begin
        Inc(iRow);
        Inc(nPp);
        NumberRC[iRow, 1] := nPp;
        TextRC[iRow, 2] := FieldByName('VidN').AsString;
        TextRC[iRow, 3] := FieldByName('ShVidN').AsString;
        TextRC[iRow, 4] := FieldByName('DtBeg').AsString;
        SetSelection(iRow, 4, iRow, 4);
        SetAlignment(F1HAlignCenter, false, F1VAlignCenter, 0);
        TextRC[iRow, 5] := FieldByName('DtEnd').AsString;
        SetSelection(iRow, 5, iRow, 6);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
        NumberRC[iRow, 7] := FieldByName('CntDays').AsFloat;
        SetSelection(iRow, 7, iRow, 7);
        FormatFixed;
        NumberRC[iRow, 8] := FieldByName('Smm').AsFloat;
        SetSelection(iRow, 8, iRow, 8);
        FormatFixed2;
        if bSovmSumExists then begin
          NumberRC[iRow, 9] := FieldByName('SmmSovm').AsFloat;
          SetSelection(iRow, 9, iRow, 9);
          FormatFixed2;
          nSmBlnSovmTt := nSmBlnSovmTt + FieldByName('SmmSovm').AsFloat;
        end;
        nCntDays := nCntDays + FieldByName('CntDays').AsFloat;
        nSmBlnTt := nSmBlnTt + FieldByName('Smm').AsFloat;
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
        Next;
      end;
    end;

    if nPp > 1 then begin
      Inc(iRow);
      TextRC[iRow, 4] := 'Всього:';
      NumberRC[iRow, 7] := nCntDays;
      SetSelection(iRow, 7, iRow, 7);
      FormatFixed;
      NumberRC[iRow, 8] := nSmBlnTt;
      SetSelection(iRow, 8, iRow, 8);
      FormatFixed2;
      if bSovmSumExists then begin
        NumberRC[iRow, 9] := nSmBlnSovmTt;
        SetSelection(iRow, 9, iRow, 9);
        FormatFixed2;
      end;
      SetSelection(iRow-1, 1, iRow, nMaxCol);
      SetBorder(1,-1,-1,-1,-1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
    end;

    Inc(iRow, 3);
    TextRC[iRow, 4] := 'Керiвник';
    TextRC[iRow, 5] := '______________ Сергій НЕСТЕРЕНКО';
    Inc(iRow, 2);
    SetSelection(iRow-1, 2, iRow, 2);
    mCellFormat := CreateNewCellFormat;
    mCellFormat.AlignHorizontal := F1HAlignCenter;
    mCellFormat.AlignVertical := F1VAlignCenter;
    mCellFormat.MergeCells := true;
    mCellFormat.WordWrap   := false;
    SetCellFormat(mCellFormat);
    TextRC[iRow-1, 2] := 'МП';
    SetSelection(iRow-1, 2, iRow, 2);
    FontName := 'MS Sans Serif';
    SetBorder(4, 0, 0, 0, 0, 0, clBlack,clBlack,clBlack,clBlack,clBlack);
    TextRC[iRow, 4] := 'Заст.головн.бухг.';
    TextRC[iRow, 5] := '______________ Оксана БОРМОТІНА'; // Ольга ЧАРАЄВА
    Inc(iRow, 2);
    TextRC[iRow, 4] := 'Бухгалтер';
    cMsg := '______________ ' + Form_Dm.KdUsr2FioUsr(nAppKdUsr);
    TextRC[iRow, 5] := cMsg;
    cRandomFileName := RandomFileName;
    Screen.Cursor   := crDefault;

    if bAppDocsToExcel then begin
      cRandomFileName := cRandomFileName + '.xls';
      WriteEx(cDirTemp + cRandomFileName, F1FileExcel97); end
    else begin
      cRandomFileName := cRandomFileName + '.vts';
      WriteEx(cDirTemp + cRandomFileName, F1FileFormulaOne6);
    end;
  end;

  FormZpCmnPrt.Free;
  Screen.Cursor := crDefault;
  MyPreView(cDirTemp, cRandomFileName);
end; {F6_PrtBln12m}

//------- !!! ПЕРЕЕХАЛА В RptSickLastMnth !!! ----------------------------------
{
