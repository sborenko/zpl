procedure F6_PrtAvnsAllObj(dDtProc : TDateTime; dtsAvans : TDataSet;
                                             nNrFirstVed, nBigVedNr : integer);
var iRow, nStartRow, nMyConst, nPp : integer;
    cMsg, cShObj, cNmObj : string;
    nSmAvns, nSmVed, nSmVedTt : double;
    nCntVed, nPrtObj, nSvTabN, nKopeek, nVedNR : integer;
    nY, nM, nD : word;
    bAutoNumb : boolean;
    qryNumb : TQuery;
begin
  Screen.Cursor := crHourGlass;
  FormZpCmnPrt := TFormZpCmnPrt.Create(Application);
  with FormZpCmnPrt, F6B do begin
    qryNumb := TQuery.Create(FormZpCmnPrt);
    if nNrFirstVed > 0 then begin
      bAutoNumb := true;
      nVedNR  := nNrFirstVed; end
    else begin
      bAutoNumb := false;
      nVedNR := 0;
    end;
    DecodeDate(dDtProc, nY, nM, nd);
    nMyConst := RowHeight[1];
    ShowGridLines    := false;
    ShowColHeading   := true;
    ShowRowHeading   := true;
    ShowZeroValues   := false;
    ShowTabs         := 0;
    PrintNoColor     := true;
    PrintGridLines   := false;
    PrintFooter      := '';
    PrintHeader      := '';
    PrintLandscape   := false;
    DefaultFontCharSet := F1RussianCharSet;
    DefaultFontSize := 10;
    ColWidth[1] := Round(4 * nMyConst);   // № п/п
    ColWidth[2] := Round(8 * nMyConst);   // ТабН
    ColWidth[3] := Round(30 * nMyConst);  // ФамИО
    ColWidth[4] := Round(11 * nMyConst);  // Сумма
    ColWidth[5] := Round(12 * nMyConst);  // Подпись
    iRow := 1;
    with dtsAvans do begin
      nSvTabN := FieldByName('TabN').AsInteger;
      First;
      nCntVed := 0;
      nSmVedTt := 0;
      while not Eof do begin
        if nCntVed > 0 then begin
          Inc(iRow);
          AddRowPageBreak(iRow);
          Inc(iRow);
        end;
        Inc(nCntVed);
        nSmVed := 0;
        nPrtObj := FieldByName('KdObj').AsInteger;
        cShObj := DmMain.KdObj2ShObj(nPrtObj, cNmObj);
        TextRC[iRow, 5] := cNmObj;
        if bAutoNumb then
          GetNewVedNR(dDtProc, nPrtObj, nVedNR, nBigVedNr, qryNumb);
        SetSelection(iRow, 5, iRow, 5);
        FontUnderLine := true;
        SetAlignment(F1HAlignRight, false, F1VAlignCenter, 0);
        Inc(iRow);
        cMsg := 'Ведомость аванса №';
        if nVedNR > 0 then begin
          cMsg := cMsg + ' ' + IntToStr(nVedNR);
          Inc(nVedNR); end
        else
          cMsg := cMsg + ' ____';
        TextRC[iRow, 1] := cMsg;
        Inc(iRow);
        cMsg := MesRus(nM) + ' ' + IntToStr(nY) + ' г.';
        TextRC[iRow, 1] := 'за ' + cMsg;
        SetSelection(iRow-1, 1, iRow, 5);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
        FontBold := true;
        Inc(iRow);
        TextRC[iRow, 1] := '№ п/п';
        TextRC[iRow, 2] := 'Таб. номер';
        TextRC[iRow, 3] := 'Фамилия И.О.';
        TextRC[iRow, 4] := 'Сумма';
        TextRC[iRow, 5] := 'Роспись о получении';
        RowHeight[iRow] := Round(2.2 * nMyConst);
        SetSelection(iRow, 1, iRow, 5);
        SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
        nStartRow := iRow;
        nPp := 0;
        while (FieldByName('KdObj').AsInteger = nPrtObj) and not Eof do begin
          if (FieldByName('Summa').AsFloat = 0) then begin
            Next;
            Continue;
          end;
          nSmAvns := RoundTo(FieldByName('Summa').AsFloat, -2);
