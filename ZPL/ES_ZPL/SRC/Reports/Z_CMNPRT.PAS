    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
begin
  Screen.Cursor := crHourGlass;
  FormZpCmnPrt := TFormZpCmnPrt.Create(Application);
  with FormZpCmnPrt, F6B do begin
    with cdsTmp do begin
      if Active then Close;
      FieldDefs.Clear;
      IndexDefs.Clear;
      IndexName := '';
      FieldDefs.Add('NR', ftAutoInc);
      FieldDefs.Add('VidN', ftString, 4);
      FieldDefs.Add('Cnt', ftSmallInt);
      FieldDefs.Add('DaysSobstv', ftSmallInt);
      FieldDefs.Add('SmSobstv', ftFloat);
      FieldDefs.Add('DaysSocStr', ftSmallInt);
      FieldDefs.Add('SmSocStr', ftFloat);
      CreateDataSet;
      AddIndex('OnVidN', 'VidN', []);
      Open;
      IndexName := 'OnVidN';
    end;
    nMyConst := RowHeight[1];
    PgSetup := CreateNewPageSetup;
    SetPageParams(PgSetup);
    SetPageSetup(PgSetup);
    ShowGridLines    := false;
    ShowColHeading   := true;
    ShowRowHeading   := true;
    ShowZeroValues   := false;
    ShowTabs         := 0;
    PrintNoColor     := true;
    PrintGridLines   := false;
    PrintFooter      := '';
    PrintHeader      := '';
    PrintLandscape   := false;
    DefaultFontCharSet := F1RussianCharSet;
    DefaultFontSize := 10;
    nMaxCol := 10;
    iRow := 1;
    iCol := 1;
    cMsg := 'Національний університет "Одеська політехніка"';
    TextRC[iRow, 1] := cMsg;
    SetSelection(iRow, 1, iRow, nMaxCol);
    FontSize := 11;
    FontBold := true;
    SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
    Inc(iRow, 2);
    TextRC[iRow, 1] := 'Реестр больничных листов';
    SetSelection(iRow, 1, iRow, nMaxCol);
    FontBold := true;
    SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
    Inc(iRow);
    DecodeDate(dDtPrc, nY, nM, nD);
    cMsg := 'за ' + MesRus(nM) + ' ' + IntToStr(nY) + ' г.';
    TextRC[iRow, 1] := cMsg;
    SetSelection(iRow, 1, iRow, nMaxCol);
    FontBold := true;
    SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
    ColWidth[1]  := Round( 4 * nMyConst);  // nPp
    ColWidth[2]  := Round( 9 * nMyConst);  // TabN & NrList
    ColWidth[3]  := Round(21 * nMyConst);  // FamIO
    ColWidth[4]  := Round(10 * nMyConst);  // DtBeg & DtEnd
    ColWidth[5]  := Round( 8 * nMyConst);  // CntDays
    ColWidth[6]  := Round( 8 * nMyConst);  // SmSrDn & ProcOpl
    ColWidth[7]  := Round(10 * nMyConst);  // НачислВсего
    ColWidth[8]  := Round(10 * nMyConst);  // в т.ч. из СобствСр-в
    ColWidth[9]  := Round(10 * nMyConst);  // в т.ч. из СоцСтраха
    ColWidth[10] := Round( 5 * nMyConst);  // ВидНачисления
    nPage := 0;
    ShapReeBln(F6B, iRow, iCol);
    nMaxPgLines := 47;
    with qryVBln do begin // сортирована по DtProc, TabN. стоит на 1-й записи с
      nPp := 0;           // заданным dDtPrc
      nCntDayTtSobstv := 0;
      nCntDayTtSocStrah := 0;
      nSmTtSobstv := 0;
      nSmTtSocStrah := 0;
      nSmPgSobstv := 0;
      nSmPgSocStrah := 0;
      nCntPgLines := 0;
      while (FieldByName('DtProc').AsDateTime = dDtPrc) and not Eof do begin
        if nCntPgLines >= nMaxPgLines then begin
          Inc(iRow);
          TextRC[iRow, 3] := 'Итого по листу';
          SetSelection(iRow, 3, iRow, 6);
          SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
          NumberRC[iRow, 7] := nSmPgSobstv + nSmPgSocStrah;
          NumberRC[iRow, 8] := nSmPgSobstv;
          NumberRC[iRow, 9] := nSmPgSocStrah;
          SetSelection(iRow, 7, iRow, 9);
          FormatFixed2;
          SetSelection(iRow, 1, iRow, nMaxCol);
          SetBorder(1,1,1,1,0,0,clBlack,clBlack,clBlack,clBlack,clBlack);
          Inc(iRow);
          AddRowPageBreak(iRow);
          nCntPgLines := 0;
          nSmPgSobstv := 0;
          nSmPgSocStrah := 0;
          ShapReeBln(F6B, iRow, iCol);
        end;
        nCntDaySobstv := 0;
        nCntDaySocStrah := 0;
        nSmSobstv := 0;
        nSmSocStrah := 0;
        Inc(nPp);
        Inc(iRow);
        NumberRC[iRow, 1] := nPp;
        NumberRC[iRow, 2] := FieldByName('TabN').AsInteger;
        SetSelection(iRow, 2, iRow, 2);
        FontBold := true;
        TextRC[iRow+1, 2] := FieldByName('NrList').AsString;
        TextRC[iRow, 3] := FieldByName('FamIO').AsString;
        TextRC[iRow, 4] := FieldByName('DtBeg').AsString;
        TextRC[iRow+1, 4] := FieldByName('DtEnd').AsString;
        NumberRC[iRow, 5] := FieldByName('CntDays').AsInteger;
        SetSelection(iRow, 5, iRow, 5);
        FormatFixed;
        NumberRC[iRow, 6] := FieldByName('ProcOpl').AsFloat;
        SetSelection(iRow, 6, iRow, 6);
        FontSize := 8;
        FontItalic := true;
        NumberRC[iRow+1, 6] := FieldByName('SmSrDn').AsFloat;
        SetSelection(iRow, 6, iRow+1, 6);
        FormatFixed2;
        NumberRC[iRow, 7] := FieldByName('SmBln').AsFloat;
        SetSelection(iRow, 7, iRow, 7);
        FormatFixed2;
        TextRC[iRow, 10] := FieldByName('VidN').AsString;
        SetSelection(iRow, 1, iRow+1, nMaxCol);
        SetBorder(1,1,1,1,0,0,clBlack,clBlack,clBlack,clBlack,clBlack);
        qryOtkl.First;
        while not qryOtkl.Eof do begin
          nCntDay := Round(RoundTo(qryOtkl.FieldByName('Chas').AsFloat / 8, -2));
          cVidN := qryOtkl.FieldByName('VidN').AsString;
          if not cdsTmp.Locate('VidN', cVidN, []) then begin
            cdsTmp.Append;
            cdsTmp.FieldByName('VidN').AsString := cVidN; end
          else
            cdsTmp.Edit;

          // SB 23.3.2026 По аналогии, наверное, и 2606
          if (cVidN = '2603') or (cVidN = '2606') then begin
            nCntDayTtSobstv := nCntDayTtSobstv + nCntDay;
            nSmTtSobstv := nSmTtSobstv + qryOtkl.FieldByName('Summa').AsFloat;
            nCntDaySobstv := nCntDaySobstv + nCntDay;
            nSmPgSobstv := nSmPgSobstv + qryOtkl.FieldByName('Summa').AsFloat;
            nSmSobstv := nSmSobstv + qryOtkl.FieldByName('Summa').AsFloat;
            cdsTmp.FieldByName('Cnt').AsInteger :=
                           cdsTmp.FieldByName('Cnt').AsInteger + 1;
            cdsTmp.FieldByName('DaysSobstv').AsInteger :=
                           cdsTmp.FieldByName('DaysSobstv').AsInteger + nCntDay;

            cdsTmp.FieldByName('SmSobstv').AsFloat :=
                           cdsTmp.FieldByName('SmSobstv').AsFloat +
                                     qryOtkl.FieldByName('Summa').AsFloat; end
          else begin
            nCntDayTtSocStrah := nCntDayTtSocStrah + nCntDay;
            nSmTtSocStrah := nSmTtSocStrah + qryOtkl.FieldByName('Summa').AsFloat;
            nCntDaySocStrah := nCntDaySocStrah + nCntDay;
            nSmPgSocStrah := nSmPgSocStrah + qryOtkl.FieldByName('Summa').AsFloat;
            nSmSocStrah := nSmSocStrah + qryOtkl.FieldByName('Summa').AsFloat;
            cdsTmp.FieldByName('Cnt').AsInteger :=
                           cdsTmp.FieldByName('Cnt').AsInteger + 1;
            cdsTmp.FieldByName('DaysSocStr').AsInteger :=
                           cdsTmp.FieldByName('DaysSocStr').AsInteger + nCntDay;
            cdsTmp.FieldByName('SmSocStr').AsFloat :=
                           cdsTmp.FieldByName('SmSocStr').AsFloat +
                                     qryOtkl.FieldByName('Summa').AsFloat;
          end;
          cdsTmp.Post;
          qryOtkl.Next;
        end;
        NumberRC[iRow, 8] := nSmSobstv;
        NumberRC[iRow, 9] := nSmSocStrah;
        SetSelection(iRow, 8, iRow, 9);
        FormatFixed2;
        cMsg := '(' + IntToStr(nCntDaySobstv) +
                '+' + IntToStr(nCntDaySocStrah) + ')';
        TextRC[iRow+1, 5] := cMsg;
        Inc(iRow); // т.к. заняли 2 строки
        Inc(nCntPgLines, 2);
        Next;
        if (Eof or (FieldByName('DtProc').AsDateTime <> dDtPrc)) and
                                                          (nPage > 1) and
                         ((nSmPgSobstv <> 0) or (nSmPgSocStrah <> 0)) then begin
          Inc(iRow);
          TextRC[iRow, 3] := 'Итого по листу';
          SetSelection(iRow, 3, iRow, 6);
          SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignBottom, 0);
          NumberRC[iRow, 7] := nSmPgSobstv + nSmPgSocStrah;
          NumberRC[iRow, 8] := nSmPgSobstv;
          NumberRC[iRow, 9] := nSmPgSocStrah;
          SetSelection(iRow, 7, iRow, 9);
          FormatFixed2;
          SetSelection(iRow, 1, iRow, nMaxCol);
          SetBorder(1,1,1,1,0,0,clBlack,clBlack,clBlack,clBlack,clBlack);
        end;
      end;
      if nPp > 0 then begin
        Inc(iRow, 2);
        TextRC[iRow, 1] := 'Всего листов, шт ' + IntToStr(nPp);
        SetSelection(iRow, 1, iRow, 4);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignBottom, 0);
        NumberRC[iRow, 5] := nCntDayTtSobstv + nCntDayTtSocStrah;
        SetSelection(iRow, 5, iRow, 5);
        FormatFixed;
        NumberRC[iRow, 7] := nSmTtSobstv + nSmTtSocStrah;
        NumberRC[iRow, 8] := nSmTtSobstv;
        NumberRC[iRow, 9] := nSmTtSocStrah;
        SetSelection(iRow, 7, iRow, 9);
        FormatFixed2;
        cMsg := '(' + IntToStr(nCntDayTtSobstv) +
                '+' + IntToStr(nCntDayTtSocStrah) + ')';
        TextRC[iRow+1, 5] := cMsg;
        if cdsTmp.RecordCount > 0 then begin
          Inc(iRow);
          TextRC[iRow, 1] := 'Составляющие по видам начисления:';
          cdsTmp.First;
          while not cdsTmp.Eof do begin
            Inc(iRow);
            TextRC[iRow, 3] := cdsTmp.FieldByName('VidN').AsString + ' - ' +
                 DmMain.VidN2ShVidN(cdsTmp.FieldByName('VidN').AsString, cMsg);
            SetSelection(iRow, 3, iRow, 3);
            SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);
            TextRC[iRow, 5] := '(' +
                          IntToStr(cdsTmp.FieldByName('DaysSobstv').AsInteger) +
                               '+' +
                          IntToStr(cdsTmp.FieldByName('DaysSocStr').AsInteger) +
                               ')';
            NumberRC[iRow, 7] := cdsTmp.FieldByName('SmSobstv').AsFloat +
                                  cdsTmp.FieldByName('SmSocStr').AsFloat;
            NumberRC[iRow, 8] := cdsTmp.FieldByName('SmSobstv').AsFloat;
            NumberRC[iRow, 9] := cdsTmp.FieldByName('SmSocStr').AsFloat;
            SetSelection(iRow, 7, iRow, 9);
            FormatFixed2;
            cdsTmp.Next;
          end;
        end;
      end;
    end;
    with cdsTmp do begin
      SaveToFile(cDirTemp + 'InfByVid.cds');
      Close;
      FieldDefs.Clear;
      IndexDefs.Clear;
    end;
    cRandomFileName := RandomFileName;
    Screen.Cursor   := crDefault;
    if bAppDocsToExcel then begin
      cRandomFileName := cRandomFileName + '.xls';
      WriteEx(cDirTemp + cRandomFileName, F1FileExcel97); end
    else begin
      cRandomFileName := cRandomFileName + '.vts';
      WriteEx(cDirTemp + cRandomFileName, F1FileFormulaOne6);
    end;
  end;
  FormZpCmnPrt.Free;
  Screen.Cursor := crDefault;
  MyPreView(cDirTemp, cRandomFileName);
end;

