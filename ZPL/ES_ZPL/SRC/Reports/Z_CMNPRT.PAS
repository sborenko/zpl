      end;
      Screen.Cursor := crDefault;
    end; {with cdsAlm}

    Free;
  end; {with FormZpCmnPrt, F6B}

  Screen.Cursor := crDefault;

  if bIsKss then
    MyPreView(cDirTemp, cKssFileNm);

  if bIsPosta then
    MyPreView(cDirTemp, cPostaFileNm);

  if bIsKss and bIsPosta and bAppDocsToExcel then
    ShowMessage('Ведомости выводятся в два документа.' + #13#10 +
                'Исользуйте пункт "Окно" главного меню MsExcel' +
                #13#10 + 'для переключения между документами');
