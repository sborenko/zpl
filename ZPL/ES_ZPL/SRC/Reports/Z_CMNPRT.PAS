var iRow, iCol, nMyConst, nPp, nMaxCol, nPage : integer;
    nCntPgLines, nMaxPgLines : SmallInt;
    cMsg : string;
    nY, nM, nD : word;
    nCntDay, nCntDayTtSobstv, nCntDayTtSocStrah,
                     nCntDaySobstv, nCntDaySocStrah : integer;
    nSmTtSobstv, nSmTtSocStrah, nSmSobstv, nSmSocStrah,
                                nSmPgSobstv, nSmPgSocStrah  : double;
    PgSetup : F1PageSetup;
    cVidN : string4;
    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    procedure ShapReeBln(F6B : TF6Book; var iRow, iCol : integer);
    begin
      with F6B do begin
        Inc(nPage);
        Inc(iRow);
        TextRC[iRow, nMaxCol] := 'Стр. ' + IntToStr(nPage);
        SetSelection(iRow, nMaxCol, iRow, nMaxCol);
        SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
        Inc(iRow);
        iCol := 1;
        SetSelection(iRow, iCol, iRow+1, iCol);
        mCellFormat := CreateNewCellFormat;
        mCellFormat.AlignHorizontal := F1HAlignCenter;
        mCellFormat.AlignVertical := F1VAlignCenter;
        mCellFormat.MergeCells := true;
        mCellFormat.WordWrap   := true;
        SetCellFormat(mCellFormat);
        TextRC[iRow, iCol] := '№ п/п';
        Inc(iCol);
        TextRC[iRow, iCol] := 'Таб. номер';
        SetSelection(iRow, iCol, iRow, iCol);
