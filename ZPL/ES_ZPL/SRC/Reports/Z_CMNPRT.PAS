    ColWidth[4] := Round(12 * nMyConst);  // ID
    ColWidth[5] := Round(11 * nMyConst);  // DtBeg
    ColWidth[6] := Round(17 * nMyConst);  // LS
    ColWidth[7] := Round(15 * nMyConst);  // Pens
    iRow := 1;
    iCol := 1;
