    nSmTtsFss    := 0;
    with qryBln do begin
      DisableControls;
      First;
      nPp := 0;
      while not Eof do begin
        nTabN    := FieldByName('TabN').AsInteger;
        cFamIO   := FieldByName('Fam').AsString;
        cIma     := FieldByName('Ima').AsString;
        cOtch    := FieldByName('Otch').AsString;
        cID      := FieldByName('ID').AsString;
        nZO      := FieldByName('Sovm').AsInteger;
        Case nZO of
          0: nZO := 1;
          1: nZO := 2;
          3: nZO := 4;
        end;
        cNrList  := FieldByName('NrList').AsString;
        if not FieldByName('ListCont').IsNull then
          nFoN     := FieldByName('ListCont').AsInteger + 1
        else  nFoN := 0;

        if not FieldByName('Prichina').IsNull then
          nPrBln   := FieldByName('Prichina').AsInteger
        else
          nPrBln   := 0;
        bDigital := FieldByName('Digital').AsString = 'Y';

        dDtBeg   := FieldByName('DtBeg').AsDateTime;
        dDtEnd   := FieldByName('DtEnd').AsDateTime;
        nStgCmn  := FieldByName('StgCmn').AsInteger;
        nStg12   := FieldByName('Stg12').AsInteger;
        nSmmFnd  := 0;
        nSmmTts  := 0;
        nSmmChern:= 0;
        nDayFnd  := 0;
        nDayTts  := 0;
        nDayChern:= 0;
        If FieldByName('DtZ').AsString <> '' then begin

          cVidN := FieldByName('VidN').AsString;
          if cVidN = '2602' then
            cCase := 'dkr'
          else
            cCase := 'bln';
          cCase   := 'blk';
          DmMain.GetCntWrkDaysBln(qryBln.FieldByName('DtBeg').AsDateTime,
                                       qryBln.FieldByName('DtEnd').AsDateTime,
                                             nCntWorkDays, nCntWorkChas, cCase);
          nCntDay     := Round(nCntWorkDays);
          nSmmTts     := nSmmTts + FieldByName('Summa').AsFloat;
          nSmTtsBln   := nSmTtsBln + FieldByName('Summa').AsFloat;
          nDayTts     := nDayTts + nCntDay;

          // не 5 дней за счёт предприятия
          // SB 23.3.2026 По аналогии, наверное, и 2606
          if (cVidN <> '2603') and (cVidN <> '2606') then begin
            nSmmFnd   := nSmmFnd + FieldByName('Summa').AsFloat;
            nSmTtsFss := nSmTtsFss + FieldByName('Summa').AsFloat;
            nDayFnd   := nDayFnd + nCntDay;
          end;

          if (nPrBln = 3) and not bDigital {чернобыльские} then begin
            nSmmChern := nSmmChern + FieldByName('Summa').AsFloat;
            nDayChern := nDayChern + nCntDay;
          end;
          nSpecNR := FieldByName('Spec_NR').AsInteger;
          if qryTmp.Active then
             qryTmp.Close;
          qryTmp.SQL.Clear;
          qryTmp.DataBaseName := CESMAIN;

          qryTmp.SQL.Add(
            'select * ' +
            'from ViOtkl ' +
            'where Spec_NR = :nSpec_NR ' +
              // SB 23.3.2026 По аналогии, наверное, и 2606
              'and (VidN = "2603" or VidN = "2606")'
          );
          qryTmp.ParamByName('nSpec_NR').AsInteger := nSpecNR;
          qryTmp.Open;

          while not qryTmp.eof do begin
            nSmmFnd   := nSmmFnd   - qryTmp.FieldByName('Summa').AsFloat;
            nSmTtsFss := nSmTtsFss - qryTmp.FieldByName('Summa').AsFloat;
            nDayFnd   := nDayFnd   - nCntDay;
            qryTmp.Next;
          end;

          dDtEnd      := FieldByName('DtEnd').AsDateTime;
        end;
        Next;
        If nSmmFnd >= 0.01 then begin
          Inc(iRow);
          Inc(nPp);
          NumberRC[iRow, 1] := nPp;
          TextRC[iRow, 2] := cFamIO;
          TextRC[iRow, 3] := cIma;
          TextRC[iRow, 4] := cOtch;
          TextRC[iRow, 5] := cID;
          TextRC[iRow, 6] := Copy(cNrList,1,3);
          TextRC[iRow, 7] := Copy(cNrList,4,Length(cNrList)-3);
          SetSelection(iRow, 2, iRow, 4);
          SetAlignment(F1HAlignLeft, false, F1VAlignBottom, 0);
          SetSelection(iRow, 6, iRow, 6);
          SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);
          if nSmmFnd <> 0 then
            NumberRC[iRow, 9]  := nSmmFnd;
          SetSelection(iRow, 1, iRow, nMaxCol);
          SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack); end;
      end;
      Inc(iRow);
      TextRC[iRow, 1] := 'Р а з о м';
      SetSelection(iRow, 1, iRow, 9);
      SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignBottom, 0);
      NumberRC[iRow,9] := nSmTtsFss;
      SetSelection(iRow, 8, iRow, 9);
      FormatFixed2;

      SetSelection(iRow, 1, iRow, nMaxCol);
      FontBold := true;
      SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
      Inc(iRow);
      EnableControls;
    end;
    Inc(iRow, 4);

    TextRC[iRow, 2] := 'Керівник установи ';
    TextRC[iRow, 3] := '_________________ ';
    TextRC[iRow, 4] := '______________________________ ';
    Inc(iRow,1);
    TextRC[iRow, 3] := '           (підпис)';
    TextRC[iRow, 4] := '      (Прізвище, імя, по батькові)';
    Inc(iRow,3);
    TextRC[iRow, 2] := 'Головний бухгалтер ';
    TextRC[iRow, 3] := '_________________ ';
    TextRC[iRow, 4] := '______________________________ ';
    Inc(iRow,1);
    TextRC[iRow, 3] := '           (підпис)';
    TextRC[iRow, 4] := '      (Прізвище, імя, по батькові)';
    Inc(iRow,3);
    TextRC[iRow, 2] := 'МП (за наявності) ';
    TextRC[iRow, 3] := '_________________ ';
    Inc(iRow,1);
    TextRC[iRow, 3] := '    Дата складання';


    SetSelection(iRow, 6, iRow, 6);
    SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);


    cRandomFileName := RandomFileName;
    if bAppDocsToExcel then begin
      cRandomFileName := cRandomFileName + '.xls';
      WriteEx(cDirTemp + cRandomFileName, F1FileExcel97); end
    else begin
      cRandomFileName := cRandomFileName + '.vts';
      WriteEx(cDirTemp + cRandomFileName, F1FileFormulaOne6);
    end;
    Screen.Cursor := crDefault;
    Free;
  end;
  MyPreView(cDirTemp, cRandomFileName);
