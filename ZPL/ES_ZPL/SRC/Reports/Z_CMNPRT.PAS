        if (FieldByName('VidN').AsString <> '6000') and
                   (FieldByName('VidN').AsString <> '8000') and
                   (FieldByName('VidN').AsString <> '9999') then begin
          Inc(nPp);
          NumberRC[iRow, 1] := nPp;

