    Inc(iRow);
    TextRC[iRow, 1] := 'Банк ' + IntToStr(nKdBnk) + ' ' + cNmBnk;
    SetSelection(iRow, 1, iRow, 1);
    FontBold := true;
    FontUnderline := true;
    SetSelection(iRow-1, 1, iRow, nMaxCol);
    SetAlignment(F1HAlignCenterAcrossCells, true, F1VAlignBottom, 0);
    nCntPgLn := 0;
    nCntPg := 0;
    ShapSps(F6B, iRow, iCol);
    with dtsSps do begin
      nSvTabN := FieldByName('TabN').AsInteger;
      DisableControls;
      First;
      nPp := 0;
      while not Eof do begin
        Inc(nPp);
        Inc(iRow);
        Inc(nCntPgLn);
        if nCntPgLn > nMaxCntPgLn then begin
          Inc(iRow);
          AddRowPageBreak(iRow);
          nCntPgLn := 0;
          ShapSps(F6B, iRow, iCol);
          Inc(iRow);
        end;
        NumberRC[iRow, 1] := nPp;
        NumberRC[iRow, 2] := FieldByName('TabN').AsInteger;
        TextRC[iRow, 3]   := FieldByName('FamIO').AsString;
        TextRC[iRow, 4]   := Trim(FieldByName('ID').AsString);
        TextRC[iRow, 5]   := FieldByName('DtBeg').AsString;
        TextRC[iRow, 6]   := FieldByName('LicSch').AsString;
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
        Next;
