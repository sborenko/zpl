    ColWidth[4] := Round( 6 * nMyConst);  // KdObj
    ColWidth[5] := Round( 6 * nMyConst);  // VidN
    ColWidth[6] := Round(12 * nMyConst);  // ShVidN
    ColWidth[7] := Round( 8 * nMyConst);  // DtBeg
    ColWidth[8] := Round( 9 * nMyConst);  // NrPrBeg
