      SetSelection(iRow, 1, iRow, nMaxCol);
      FontSize := 10;
      FontBold := true;
      SetAlignment(F1HAlignCenterAcrossCells, true, F1VAlignCenter, 0);
      ShapArh(F6B, nY, nM, iRow, iCol);
      while not Eof do begin
        dDtProc := FieldByName('DtProc').AsDateTime;
        Inc(iRow);
        Inc(nCntPgLines);
        DecodeDate(dDtProc, nY, nM, nd);
        TextRC[iRow, 1] := UkrMes(nM) + ' ' + IntToStr(nY) + ' г.';
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetAlignment(F1HAlignCenterAcrossCells, true, F1VAlignCenter, 0);
        FontBold := true;
        nSmMesNach := 0;
        nSmMesUdrg := 0;
        while (FieldByName('DtProc').AsDateTime = dDtProc) and not Eof do begin
          if nCntPgLines >= nMaxPgLines then begin
            Inc(iRow);
            AddRowPageBreak(iRow);
            nCntPgLines := 0;
            ShapArh(F6B, nY, nM, iRow, iCol);
          end;
          Inc(iRow);
          Inc(nCntPgLines);
          cVidN := FieldByName('VidN').AsString;
          cZaMG := Copy(FieldByName('ZaMesGod').AsString, 4, 7);
          TextRC[iRow, 1] := cZaMG;
          TextRC[iRow, 2] := cVidN;
          TextRC[iRow, 3] := FieldByName('ShVidN').AsString;
          TextRC[iRow, 4] := FieldByName('NmVidN').AsString;
          NumberRC[iRow, 5] := FieldByName('Chasu').AsFloat;
          if cVidN < '6000' then begin
            NumberRC[iRow, 6] := FieldByName('Summa').AsFloat;
            nSmMesNach := nSmMesNach + FieldByName('Summa').AsFloat;
            nSmTotNach := nSmTotNach + FieldByName('Summa').AsFloat; end
          else begin
            NumberRC[iRow, 7] := FieldByName('Summa').AsFloat;
            nSmMesUdrg := nSmMesUdrg + FieldByName('Summa').AsFloat;
            nSmTotUdrg := nSmTotUdrg + FieldByName('Summa').AsFloat;
          end;
          SetSelection(iRow, 6, iRow, 7);
          FormatFixed2;
          SetSelection(iRow, 1, iRow, nMaxCol);
          SetBorder(1, 1, 1, 1, 1, 0, clBlack,
                                  clBlack, clBlack, clBlack, clBlack);
          Next;
        end;
        Inc(iRow);
        Inc(nCntPgLines);
        TextRC[iRow, 4] := 'Всього:';
        SetSelection(iRow, 4, iRow, 4);
        SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
        NumberRC[iRow, 6] := nSmMesNach;
        NumberRC[iRow, 7] := nSmMesUdrg;
        SetSelection(iRow, 6, iRow, 7);
        FormatFixed2;
        Inc(iRow);
        Inc(nCntPgLines);
        TextRC[iRow, 4] := 'До виплати:';
        SetSelection(iRow, 4, iRow, 4);
        SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
        SetSelection(iRow, 6, iRow, 7);
        mCellFormat := CreateNewCellFormat;
        mCellFormat.AlignHorizontal := F1HAlignCenter;
        mCellFormat.AlignVertical := F1VAlignCenter;
        mCellFormat.MergeCells := true;
        mCellFormat.WordWrap   := false;
        mCellFormat.FontBold   := false;
        SetCellFormat(mCellFormat);
        NumberRC[iRow, 6] := nSmMesNach + nSmMesUdrg;
        FormatFixed2;
        SetSelection(iRow-1, 1, iRow, nMaxCol);
        SetBorder(1, 1, 1, 1, 1, 0, clBlack,
                                  clBlack, clBlack, clBlack, clBlack);
        if nCntPgLines >= nMaxPgLines-3 then begin
          Inc(iRow);                    // Чтобы наименование нового
          AddRowPageBreak(iRow);        // месяца не оставалось одиноким
          nCntPgLines := 0;
          ShapArh(F6B, nY, nM, iRow, iCol);
        end;
      end;
      if CaseNich = 1 then
        cMsg := '(Без нарахувань по НДЧ)'
      else if CaseNich = 2 then
        cMsg := '(Только по нарахуванням НДЧ)';
      if (CaseNich = 1) or (CaseNich = 2) then begin
        Inc(iRow);
        TextRC[iRow, 1] := cMsg;
        SetSelection(iRow, 1, iRow, 1);
        FontSize := 8;
      end;
      Inc(iRow, 2);
      TextRC[iRow, nMaxCol] := 'Бухгалтер ____________ ' +
                                               Form_Dm.KdUsr2FioUsr(nAppKdUsr);
      SetSelection(iRow, nMaxCol, iRow, nMaxCol);
      SetAlignment(F1HAlignRight, false, F1VAlignCenter, 0);
      Inc(iRow);
      First;
      EnableControls;
    end;
    Screen.Cursor := crHourGlass;
    cRandomFileName := RandomFileName;
    if bAppDocsToExcel then begin
      cRandomFileName := cRandomFileName + '.xls';
      WriteEx(cDirTemp + cRandomFileName, F1FileExcel97); end
    else begin
      cRandomFileName := cRandomFileName + '.vts';
      WriteEx(cDirTemp + cRandomFileName, F1FileFormulaOne6);
    end;
    Screen.Cursor := crDefault;
    Free;
  end;
  MyPreView(cDirTemp, cRandomFileName);
end;

