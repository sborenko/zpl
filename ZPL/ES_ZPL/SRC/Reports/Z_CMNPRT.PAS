      First;
      DisableControls;
      while not Eof do begin
        nTabN := FieldByName('TabN').AsInteger;
        Inc(nCntTabNInVed);
        while (FieldByName('TabN').AsInteger = nTabN) and not Eof do begin
          Next;
        end;
      end;
      nPp := 0;
      nSmTt := 0;
      nSmPg := 0;
      nSmBudg := 0;
      nSmBlnBudg := 0;
      nSmSpec := 0;
      nSmBlnSpec := 0;
      nKopeek := 0;
      nCntRestTabN := nCntTabNInVed;
      First;
      while not Eof do begin
        nTabN := FieldByName('TabN').AsInteger;
        nSmZp := 0;
        cFIO := MyFamIO(FieldByName('Fam').AsString,
                             FieldByName('Ima').AsString,
                                  FieldByName('Otch').AsString);
