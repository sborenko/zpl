      SetSelection(iRow, 5, iRow, 5);
      FormatFixed;
      NumberRC[iRow, 6] := nSmZpKoef;
      SetSelection(iRow, 6, iRow, 6);
      FormatFixed2;
      Inc(iRow);
      TextRC[iRow, 2] := 'Среднедневной заработок:';
      NumberRC[iRow, 6] := qryVOtp.FieldByName('SmSrDn').AsFloat;
