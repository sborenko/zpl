    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    procedure ShapochkaAmo(F6B : TF6Book; nY, nM : word;
                                                   var iRow, iCol : integer);
    var cMsg : string;
    begin
      with F6B do begin
        Inc(iRow);
        iCol := 1;
        cMsg := 'Мемориальный ордер';  // тут пристраивать название из спр-ка
