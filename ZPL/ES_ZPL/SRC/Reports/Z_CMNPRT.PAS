procedure F6PrtSpsLgt(dDtBeg : TDateTime; cdsLgt : TDataSet);
var iRow, nMaxCol, nMyConst : integer;
    PgSetup : F1PageSetup;
    cMsg : string;
    nPp : integer;
    nY, nM, nD : word;
    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    procedure Shapka(F6B : TF6Book; var iRow : integer);
    begin
      with F6B do begin
        Inc(iRow);
        TextRC[iRow, 1] := '№ п/п';
        TextRC[iRow, 2] := 'Процент льготы';
        TextRC[iRow, 3] := 'Таб. Номер';
        TextRC[iRow, 4] := 'Фамилия Имя Отчество';
        TextRC[iRow, 5] := 'Озна ка пільги';
        TextRC[iRow, 6] := 'К-во льгот';
        TextRC[iRow, 7] := 'Примечание';
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
        SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
      end;
    end;
begin
  Screen.Cursor := crHourGlass;
  FormZpCmnPrt := TFormZpCmnPrt.Create(Application);
  with FormZpCmnPrt, F6B do begin
    PgSetup := CreateNewPageSetup;
    SetPageParams(PgSetup);
    SetPageSetup(PgSetup);
    ShowGridLines    := false;
    ShowColHeading   := true;
    ShowRowHeading   := true;
    ShowZeroValues   := false;
    ShowTabs         := 0;
    PrintNoColor     := true;
    PrintGridLines   := false;
    PrintFooter      := '';
    PrintHeader      := '';
    PrintLandscape   := false;
    DefaultFontCharSet := F1RussianCharSet;
    DefaultFontSize := 9;
    nMyConst := RowHeight[1];
    nMaxCol := 7;
    ColWidth[1] := Round( 4 * nMyConst);
    ColWidth[2] := Round( 9 * nMyConst);
    ColWidth[3] := Round( 8 * nMyConst);
    ColWidth[4] := Round(50 * nMyConst);
    ColWidth[5] := Round( 6 * nMyConst);
    ColWidth[6] := Round( 6 * nMyConst);
    ColWidth[7] := Round(25 * nMyConst);
    DecodeDate(dDtBeg, nY, nM, nD);
    iRow := 1;
    cMsg := 'Список сотрудников, имеющих льготы в ' +
                                MesPredlogn(nM) + ' ' + IntToStr(nY) + ' г.';
    TextRC[iRow, 1] := cMsg;
    SetSelection(iRow, 1, iRow, nMaxCol);
    SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
    //Inc(iRow);
    Shapka(F6B, iRow);
    with cdsLgt do begin
      DisableControls;
      First;
      nPp := 0;
      while not Eof do begin
        Inc(iRow);
        Inc(nPp);
        NumberRC[iRow, 1] := nPp;
        NumberRC[iRow, 2] := FieldByName('PrcLgt').AsInteger;
        NumberRC[iRow, 3] := FieldByName('TabN').AsInteger;
        cMsg := FieldByName('Fam').AsString + ' ' + FieldByName('Ima').AsString +
                      ' ' + FieldByName('Otch').AsString;;
        TextRC[iRow, 4]   := cMsg;
        NumberRC[iRow, 5] := FieldByName('Ozn_Pilg').AsInteger;
        NumberRC[iRow, 6] := FieldByName('Cnt').AsInteger;
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
        Next;
      end;
      EnableControls;
    end;
    Inc(iRow, 2);
    cMsg := 'Бухгалтер  __________  ' + Form_Dm.KdUsr2FioUsr(nAppKdUsr);
    TextRC[iRow, nMaxCol] := cMsg;
    SetSelection(iRow, nMaxCol, iRow, nMaxCol);
    SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
    cRandomFileName := RandomFileName;
    if bAppDocsToExcel then begin
      cRandomFileName := cRandomFileName + '.xls';
      WriteEx(cDirTemp + cRandomFileName, F1FileExcel97); end
    else begin
      cRandomFileName := cRandomFileName + '.vts';
      WriteEx(cDirTemp + cRandomFileName, F1FileFormulaOne6);
    end;
    Screen.Cursor := crDefault;
    Free;
  end;
  MyPreView(cDirTemp, cRandomFileName);
end;
