procedure F6PrtInvPns(dtsP, dtsNU : TDataSet; cMes : ShortString);
var iRow, nPp, nMaxCol, nMyConst : integer;
    cMsg : string;
    PgSetup : F1PageSetup;
    nCntTt, nCntInP : integer;
    nSmTt, nSmInP, nSmInPFz : double;
begin
  Screen.Cursor := crHourGlass;
  FormZpCmnPrt := TFormZpCmnPrt.Create(Application);
  with FormZpCmnPrt, F6B do begin
    PgSetup := CreateNewPageSetup;
    SetPageParams(PgSetup);
    SetPageSetup(PgSetup);
    nMyConst := RowHeight[1];
    ShowGridLines    := false;
    ShowColHeading   := true;
    ShowRowHeading   := true;
    ShowZeroValues   := false;
    ShowTabs         := 0;
    PrintNoColor     := true;
    PrintGridLines   := false;
    PrintFooter      := '';
    PrintHeader      := '';
    PrintLandscape   := false;
    DefaultFontCharSet := F1RussianCharSet;
    DefaultFontSize := 10;
    nMaxCol := 7;
    ColWidth[1] := Round( 4 * nMyConst);  // nPp
    ColWidth[2] := Round(10 * nMyConst);  // TabNr
    ColWidth[3] := Round(25 * nMyConst);  // FamIO
    ColWidth[4] := Round(30 * nMyConst);  // Dolgnost
    ColWidth[5] := Round(12 * nMyConst);  // Oklad
    ColWidth[6] := Round( 8 * nMyConst);  // Inv
    ColWidth[7] := Round( 4 * nMyConst);  // Pens
    iRow := 1;
    cMsg := 'Инвалиды (' + cMes + ')';
    TextRC[iRow,  1] := cMsg;
    SetSelection(iRow, 1, iRow, nMaxCol);
    SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
    Inc(iRow);
    TextRC[iRow, 1] := 'Н-р п/п';
    TextRC[iRow, 2] := 'Табельн. номер';
    TextRC[iRow, 3] := 'Фамилия И.О.';
    TextRC[iRow, 4] := 'Должность';
    TextRC[iRow, 5] := 'Оклад';
    TextRC[iRow, 6] := 'Группа инв.';
    TextRC[iRow, 7] := 'Пенс';
    SetSelection(iRow, 1, iRow, nMaxCol);
    SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
    SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
    with dtsP do begin
      First;
      nPp := 0;
      nCntTt   := 0;  // всего инвалидов
      nCntInP  := 0;  // всего инвалидов неПенсионеров
      nSmTt    := 0;  // ФОТ всех инвалидов
      nSmInP   := 0;  // ФОТ всех инвалидов неПенсионеров
      nSmInPFz := 0;  // ФОТ всех инвалидов неПенсионеров для ФЗ (с 7)
      while not Eof do begin
        Inc(nPp);
        Inc(iRow);
        NumberRC[iRow, 1] := nPp;
        NumberRC[iRow, 2] := FieldByName('TabN').AsInteger;
        TextRC[iRow, 3]   := FieldByName('FamIO').AsString;
        TextRC[iRow, 4]   := Trim(FieldByName('Dolgnost').AsString);
        NumberRC[iRow, 5] := FieldByName('OklTrf').AsFloat;
        SetSelection(iRow, 5, iRow, 5);
        FormatFixed2;
        NumberRC[iRow, 6] := FieldByName('Inv').AsInteger;
        if FieldByName('PrPens').AsInteger >= 1 then
          TextRC[iRow, 7] := 'X';
        SetSelection(iRow, 6, iRow, 7);
        SetAlignment(F1HAlignCenter, true, F1VAlignBottom, 0);
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
        Inc(nCntTt);
        if dtsP.FieldByName('PrPens').IsNull or
                               (dtsP.FieldByName('PrPens').AsInteger <= 0) then
          nCntInP := nCntInP + 1;
        dtsNU.First;
        while not dtsNu.Eof do begin
          nSmTt := nSmTt + dtsNu.FieldByName('Summa').AsFloat;
          if dtsP.FieldByName('PrPens').IsNull or
                        (dtsP.FieldByName('PrPens').AsInteger <= 0) then begin
            nSmInP := nSmInP + dtsNu.FieldByName('Summa').AsFloat;
            if not dtsNu.FieldByName('SBZR').IsNull and
                   (dtsNu.FieldByName('SBZR').AsInteger = 1) then
              nSmInPFz := nSmInPFz + dtsNu.FieldByName('Summa').AsFloat;
          end;
          dtsNu.Next;
        end;
        Next;
      end;
      First;
    end;
    Inc(iRow, 2);
    TextRC[iRow, 3] := 'Показатель';
    TextRC[iRow, 4] := 'Численность';
    TextRC[iRow, 5] := 'ФОТ для ФЗ';
    SetSelection(iRow, 3, iRow, 5);
    SetAlignment(F1HAlignCenter, false, F1VAlignCenter, 0);
    Inc(iRow);
    TextRC[iRow, 3] := 'Инвалидов всего:';
    SetSelection(iRow, 3, iRow, 3);
    SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);
    NumberRC[iRow, 4] := nCntTt;
    NumberRC[iRow, 5] := nSmTt;
    SetSelection(iRow, 5, iRow, 5);
    FormatFixed2;
    Inc(iRow);
    TextRC[iRow, 3] := '- в т.ч. не достигших пенсионного возраста:';
    SetSelection(iRow, 3, iRow, 3);
    FontSize := 8;
    SetAlignment(F1HAlignRight, true, F1VAlignBottom, 0);
    NumberRC[iRow, 4] := nCntInP;
    NumberRC[iRow, 5] := nSmInPFz;
    SetSelection(iRow, 5, iRow, 5);
    FormatFixed2;
    SetSelection(iRow-2, 3, iRow, 5);
    SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
    Inc(iRow, 2);
    cMsg := 'Бухгалтер  __________  ' + Form_Dm.KdUsr2FioUsr(nAppKdUsr);
    TextRC[iRow, nMaxCol] := cMsg;
    SetSelection(iRow, nMaxCol, iRow, nMaxCol);
    SetAlignment(F1HAlignRight, false, F1VAlignBottom, 0);
    cRandomFileName := RandomFileName;
    if bAppDocsToExcel then begin
      cRandomFileName := cRandomFileName + '.xls';
      WriteEx(cDirTemp + cRandomFileName, F1FileExcel97); end
    else begin
      cRandomFileName := cRandomFileName + '.vts';
      WriteEx(cDirTemp + cRandomFileName, F1FileFormulaOne6);
    end;
    Screen.Cursor := crDefault;
    Free;
  end;
  MyPreView(cDirTemp, cRandomFileName);
end;
