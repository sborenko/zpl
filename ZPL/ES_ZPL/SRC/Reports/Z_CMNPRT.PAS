            if FieldByName('PRR').IsNull or
                              (FieldByName('PRR').AsInteger = 0) then
              nSmBudg := nSmBudg - FieldByName('Summa').AsFloat
            else
              nSmBlnBudg := nSmBlnBudg - FieldByName('Summa').AsFloat; end
          else begin
            if FieldByName('PRR').IsNull or
                              (FieldByName('PRR').AsInteger = 0) then
              nSmSpec := nSmSpec - FieldByName('Summa').AsFloat
            else
              nSmBlnSpec := nSmBlnSpec - FieldByName('Summa').AsFloat;
          end;
          //nSmPg := nSmPg - FieldByName('Summa').AsFloat;
          nSmTt := nSmTt - FieldByName('Summa').AsFloat;
          Next;
        end;
        if (nCntPgLines >= nMaxPgLines-1) or ((nCntRestTabN <= 2) and
                                  (nCntPgLines >= (nMaxPgLines-10))) then begin
          if (nCntRestTabN <= 2) then
            nCntRestTabN := 100;
          Inc(iRow);
          RowHeight[iRow] := Round(nMyConst * 1.4);
          TextRC[iRow, 1] := 'Усього по листу:';
          SetSelection(iRow, 1, iRow, 5);
          SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignBottom, 0);
          NumberRC[iRow, 6] := nSmPg;
          nSmPg := 0;
          SetSelection(iRow, 6, iRow, 6);
          FormatFixed2;
          TextRC[iRow, 7] := '-';
          SetSelection(iRow, 7, iRow, 7);
          SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);
          SetSelection(iRow, 1, iRow, nMaxCol);
          SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
          Inc(iRow);
          AddRowPageBreak(iRow);
          nCntPgLines := 0;
          ShapVedKss(F6B, iRow, iCol);
        end;
        Inc(iRow);
        RowHeight[iRow] := Round(nMyConst * 1.4);
        Inc(nCntPgLines);
        Inc(nPp);
        Inc(nCntRestTabN, -1);
        iCol := 1;
        NumberRC[iRow, iCol] := nPp;
        Inc(iCol);
        NumberRC[iRow, iCol] := nTabN;
        Inc(iCol);
        TextRC[iRow, iCol] := ' ' + cFIO;
        Inc(iCol, 3);
        NumberRC[iRow, iCol] := nSmZp;
        nSmPg := nSmPg + nSmZp; // - FieldByName('Summa').AsFloat; /////////
        SetSelection(iRow, iCol, iRow, iCol);
        FormatFixed2;
        SetSelection(iRow, 1, iRow, 2);
        SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
        SetSelection(iRow, 6, iRow, nMaxCol);
        SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetAlignment(F1HAlignGeneral, false, F1VAlignCenter, 0);
        SetBorder(1,-1,-1,-1,-1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
      end;
      if (nSmPg <> 0) and (nPage > 1) then begin
        Inc(iRow);
        RowHeight[iRow] := Round(nMyConst * 1.4);
        TextRC[iRow, 1] := 'Усього по листу:';
        SetSelection(iRow, 1, iRow, 5);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignBottom, 0);
        NumberRC[iRow, 6] := nSmPg;
        SetSelection(iRow, 6, iRow, 6);
        FormatFixed2;
        TextRC[iRow, 7] := '-';
        SetSelection(iRow, 7, iRow, 7);
        SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
      end;
      if nPp <> 0 then begin
        Inc(iRow);
        RowHeight[iRow] := Round(nMyConst * 1.4);
        TextRC[iRow, 1] := 'Всього по вiдомостi:';
        SetSelection(iRow, 1, iRow, 5);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignBottom, 0);
        NumberRC[iRow, 6] := nSmTt;
        SetSelection(iRow, 6, iRow, 6);
        FormatFixed2;
        TextRC[iRow, 7] := '-';
        SetSelection(iRow, 7, iRow, 7);
        SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);
        SetSelection(iRow, 1, iRow, nMaxCol);
        FontBold := true;
        SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
        nSmTtGrn := Int(nSmTt);
        nSmTtKop := (nSmTt - nSmTtGrn) * 100;
        cMsg := '( ' + FloatToStrF(nSmTtGrn, ffCurrency, 18, 0) + ' грн. ';
        if nSmTtKop < 10 then
          cMsg := cMsg + '0';
        cMsg := cMsg + FloatToStrF(nSmTtKop, ffFixed, 2, 0) + ' коп.' + ' )';
        // Теперь известна сумма по ведомости - впечатываю её вверх
        TextRC[nRowSmTT, 1] := cMsg;
        cMsg := UkrSumPropis(nSmTt, 'w', nKopeek);
        cMsg := AnsiUpperCase(Copy(cMsg,1,1)) +
                                  Copy(cMsg, 2, Length(cMsg)) + ' грн., ';
        if nKopeek = 0 then
          cMsg := cMsg + '00 коп.'
        else if nKopeek < 10 then
          cMsg := cMsg + '0' + IntToStr(nKopeek) + ' коп.'
        else
          cMsg := cMsg + IntToStr(nKopeek) + ' коп.';
        // И вверх впечатываю сумму прописью
        TextRC[nRowSmPropis, 2] := cMsg;
        Inc(iRow);
        if (nSmBudg <> 0) then begin
          Inc(iRow);
          TextRC[iRow, 3] := 'КЕКВ 2111/1:';
          SetSelection(iRow, 3, iRow, 3);
          SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);
          NumberRC[iRow, 4] := nSmBudg;
          SetSelection(iRow, 4, iRow, 4);
          FormatFixed2;
          SetSelection(iRow, 3, iRow, 4);
          SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
        end;
        // больничные кроме 1-х пяти дней 1120/1
        if (nSmBlnBudg <> 0) then begin
          Inc(iRow);
          TextRC[iRow, 3] := 'КЕКВ 2120/1:';
          SetSelection(iRow, 3, iRow, 3);
          SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);
          NumberRC[iRow, 4] := nSmBlnBudg;
          SetSelection(iRow, 4, iRow, 4);
          FormatFixed2;
          SetSelection(iRow, 3, iRow, 4);
          SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
        end;
        if (nSmSpec <> 0) then begin
          Inc(iRow);
          TextRC[iRow, 3] := 'КЕКВ 2111/6:';
          SetSelection(iRow, 3, iRow, 3);
          SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);
          NumberRC[iRow, 4] := nSmSpec;
          SetSelection(iRow, 4, iRow, 4);
          FormatFixed2;
          SetSelection(iRow, 3, iRow, 4);
          SetBorder(1, 1, 1, 1, 1, 0, clBlack,
                                  clBlack, clBlack, clBlack, clBlack);
        end;
        // больничные кроме 1-х пяти дней 1120/6
        if (nSmBlnSpec <> 0) then begin
          Inc(iRow);
          TextRC[iRow, 3] := 'КЕКВ 2120/6:';
          SetSelection(iRow, 3, iRow, 3);
          SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);
          NumberRC[iRow, 4] := nSmBlnSpec;
          SetSelection(iRow, 4, iRow, 4);
          FormatFixed2;
          SetSelection(iRow, 3, iRow, 4);
          SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
        end;
        // Теперь известно к-во аркушів - впечатываю их
        TextRC[nRowCntPg, 8] := 'Кількість аркушів:  ' + IntToStr(nPage);
        Inc(iRow, 2);
        TextRC[iRow, nMaxCol] := 'Відомість склав  ____________  ____________';
        SetSelection(iRow, nMaxCol, iRow, nMaxCol);
        SetAlignment(F1HAlignRight, false, F1VAlignCenter, 0);
        Inc(iRow);
        TextRC[iRow, 7] := '(підпис, прізвище, ініціали)';
        SetSelection(iRow, 7, iRow, nMaxCol);
        FontSize := 8;
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignTop, 0);
        Inc(iRow, 2);
        TextRC[iRow, nMaxCol] := 'Відомість перевірив  ____________  ____________';
        SetSelection(iRow, nMaxCol, iRow, nMaxCol);
        SetAlignment(F1HAlignRight, false, F1VAlignCenter, 0);
        Inc(iRow);
        TextRC[iRow, 7] := '(підпис, прізвище, ініціали)';
        SetSelection(iRow, 7, iRow, nMaxCol);
        FontSize := 8;
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignTop, 0);
        Inc(iRow);
        AddRowPageBreak(iRow);
      end;
      Locate('TabN', nSvTabN, []);
      EnableControls;
    end;
    Screen.Cursor := crHourGlass;
    cRandomFileName := RandomFileName;
    if bAppDocsToExcel then begin
      cRandomFileName := cRandomFileName + '.xls';
      WriteEx(cDirTemp + cRandomFileName, F1FileExcel97); end
    else begin
      cRandomFileName := cRandomFileName + '.vts';
      WriteEx(cDirTemp + cRandomFileName, F1FileFormulaOne6);
    end;
    Screen.Cursor := crDefault;
    Free;
  end;
  MyPreView(cDirTemp, cRandomFileName);
end;
