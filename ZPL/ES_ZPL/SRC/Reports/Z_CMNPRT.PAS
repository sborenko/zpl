procedure F6PrtOtklNu(nTabN : integer; cFamIO : ShortString;
                                dDtPrc : TDateTime; dtsOtkl, dtsNU : TDataSet);
var nPp, iRow, nMyConst, nMaxCol : integer;
    cMsg, cVidN : ShortString;
    PgSetup : F1PageSetup;
    nSvOtklNR, nSvNuNR : integer;
    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    procedure Shapka(F6B : TF6Book; var iRow : integer);
    begin
      with F6B do begin
        Inc(iRow);
        TextRC[iRow, 1] := DateToStr(Date);
        SetSelection(iRow, nMaxCol, iRow, nMaxCol);
        SetAlignment(F1HAlignRight, true, F1VAlignCenter, 0);
        Inc(iRow);
        TextRC[iRow, 1] := '№ п/п';
        TextRC[iRow, 2] := 'Dt Prc';
        TextRC[iRow, 3] := 'Za MG';
        TextRC[iRow, 4] := 'VidN';
        TextRC[iRow, 5] := 'ShVida';
        TextRC[iRow, 6] := 'Dt Beg';
        TextRC[iRow, 7] := 'Dt End';
        TextRC[iRow, 8] := 'Summa';
        TextRC[iRow, 9] := 'SchBU';
        TextRC[iRow,10] := 'Kd Obj';
        TextRC[iRow,11] := 'Kd Kat';
        TextRC[iRow,12] := 'MyNotes';
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
        SetBorder(1, 1, 1, 1, 1, 0, clBlack,clBlack,clBlack,clBlack,clBlack);
      end;
    end;
begin
  Screen.Cursor := crHourGlass;
  FormZpCmnPrt := TFormZpCmnPrt.Create(Application);
  with FormZpCmnPrt, F6B do begin
    PgSetup := CreateNewPageSetup;
    SetPageParams(PgSetup);
    SetPageSetup(PgSetup);
    ShowGridLines    := false;
    ShowColHeading   := true;
    ShowRowHeading   := true;
    ShowZeroValues   := false;
    ShowTabs         := 0;
    PrintNoColor     := true;
    PrintGridLines   := false;
    PrintFooter      := '';
    PrintHeader      := '';
    PrintLandscape   := false;
    DefaultFontSize  := 9;
    DefaultFontCharSet := F1RussianCharSet;
    nMaxCol      := 12;
    nMyConst     := RowHeight[1];
    ColWidth[1]  := Round( 4 * nMyConst);  // № п/п
    ColWidth[2]  := Round( 7 * nMyConst);  // DtProc
    ColWidth[3]  := Round( 7 * nMyConst);  // ZaMG
    ColWidth[4]  := Round( 6 * nMyConst);  // VidN
    ColWidth[5]  := Round(15 * nMyConst);  // ShVidN
    ColWidth[6]  := Round( 7 * nMyConst);  // Dt_Beg
    ColWidth[7]  := Round( 7 * nMyConst);  // Dt_End
    ColWidth[8]  := Round(12 * nMyConst);  // Summa
    ColWidth[9]  := Round( 9 * nMyConst);  // SchBU
    ColWidth[10] := Round( 5 * nMyConst);  // KdObj
    ColWidth[11] := Round( 4 * nMyConst);  // KdKatP
    ColWidth[12] := Round(20 * nMyConst);  // MyNotes

    iRow := 2;
    cMsg := 'Отклонения и начисления / удержания по ТабНр ' +
            IntToStr(nTabN) + ' (' + cFamIO + ')';
    TextRC[iRow, 1] := cMsg;
    SetSelection(iRow, 1, iRow, nMaxCol);
    FontSize := 11;
    //FontBold := true;
    FontUnderLine := true;
    SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
    Inc(iRow);
    cMsg := 'в месяце ' + Copy(DateToStr(dDtPrc), 4, 7);
    TextRC[iRow, 1] := cMsg;
    SetSelection(iRow, 1, iRow, nMaxCol);
    FontSize := 11;
    FontBold := true;
    FontUnderLine := true;
    SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
    Inc(iRow);
    with dtsOtkl do begin
      if RecordCount = 0 then begin
        Inc(iRow);
        cMsg := 'Отклонений не было';
        TextRC[iRow, 1] := cMsg;
        SetSelection(iRow, 1, iRow, nMaxCol);
        FontUnderline := true;
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignBottom, 0); end
      else begin
        Inc(iRow);
        cMsg := 'Отклонения';
        TextRC[iRow, 1] := cMsg;
        SetSelection(iRow, 1, iRow, nMaxCol);
        FontUnderline := true;
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignBottom, 0);
        Shapka(F6B, iRow);
        nSvOtklNR := FieldByName('NR').AsInteger;
        DisableControls;
        First;
        nPp := 0;
        while not Eof do begin
          Inc(iRow);
          Inc(nPp);
          NumberRC[iRow, 1] := nPp;
          cMsg := FieldByName('DtProc').AsString;
          cMsg := Copy(cMsg, 4, 3) + Copy(cMsg, 9, 2);
          TextRC[iRow, 2]   := cMsg;
          cMsg := FieldByName('ZaMesGod').AsString;
          cMsg := Copy(cMsg, 4, 3) + Copy(cMsg, 9, 2);
          TextRC[iRow, 3] := cMsg;
          cVidN := FieldByName('VidN').AsString;
          TextRC[iRow, 4] := cVidN;
          SetSelection(iRow, 2, iRow, 4);
          SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);
          TextRC[iRow, 5] := FieldByName('ShVidN').AsString;
          if not FieldByName('Dt_Beg').IsNull then begin
            cMsg := FieldByName('Dt_Beg').AsString;
            cMsg := Copy(cMsg, 4, 3) + Copy(cMsg, 9, 2);
            TextRC[iRow, 6] := cMsg;
          end;
          if not FieldByName('Dt_End').IsNull then begin
            cMsg := FieldByName('Dt_End').AsString;
            cMsg := Copy(cMsg, 4, 3) + Copy(cMsg, 9, 2);
            TextRC[iRow, 7] := cMsg;
          end;
          SetSelection(iRow, 6, iRow, 7);
          SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);
          NumberRC[iRow, 8] := FieldByName('Summa').AsFloat;
          SetSelection(iRow, 8, iRow, 8);
          FormatFixed2;
          TextRC[iRow, 9] := FieldByName('SchBU').AsString;
          NumberRC[iRow, 10] := FieldByName('KdObj').AsInteger;
          NumberRC[iRow, 11] := FieldByName('KdKatP').AsInteger;
          TextRC[iRow, 12] := FieldByName('MyNotes').AsString;
