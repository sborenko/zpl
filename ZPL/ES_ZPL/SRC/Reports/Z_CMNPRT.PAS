    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    procedure ShapkaMo(F6B : TF6Book; nY, nM : word; var iRow, iCol : integer);
    var cMsg : ShortString;
    begin
      with F6B do begin
        Inc(iRow);
        iCol := 1;
        TextRC[iRow, iCol] := 'Національний унiверситет "Одеська полiтехнiка"';
        SetSelection(iRow, iCol, iRow, nMaxCol);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
        FontSize := 10;
        FontBold := true;
        Inc(iRow);
        TextRC[iRow, iCol] := 'ЄДРПОУ 43861328';
        SetSelection(iRow, iCol, iRow, nMaxCol);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
        Inc(iRow);
        Inc(iRow);
        iCol := 1;
        cMsg := 'Меморіальний ордер';  // тут пристраивать название из спр-ка
        if MapInfo.MemOrdNm <> '' then
          cMsg := cMsg + ' № ' + MapInfo.MemOrdNm;
        TextRC[iRow, iCol] := cMsg;    // названий МО (сделать его)
        RowHeight[iRow] := Round(1.2 * nMyConst);
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
        FontSize := 10;
        FontBold := true;
        Inc(iRow);
        if (Pos('801/1-1', cSchBU) > 0) or (Pos('801/1-2', cSchBU) > 0) or
                                               (Pos('823/1', cSchBU) > 0) then
          bIsNICH := true;
        cMsg := 'СубРах. ' + MapInfo.Accnt + ' ' + MapInfo.AccNm;
        TextRC[iRow, iCol] := cMsg;
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
        Inc(iRow);
        cMsg := 'за ' + UkrMes(nM) + ' ' + IntToStr(nY) + ' року';
        TextRC[iRow, iCol] := cMsg;
        RowHeight[iRow] := Round(1.2 * nMyConst);
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
        FontSize := 10;
        FontBold := true;
        Inc(iRow);
        iCol := 1;
        TextRC[iRow, iCol] := '№ з/п';
        ColWidth[iCol] := Round(4 * nMyConst);
        Inc(iCol);
        TextRC[iRow, iCol] := 'Вид';
        ColWidth[iCol] := Round(5 * nMyConst);
        Inc(iCol);
        ColWidth[iCol] := Round(35 * nMyConst);
        ColWidth[iCol+1] := Round(10 * nMyConst);
        SetSelection(iRow, iCol, iRow, iCol+1);
        mCellFormat := CreateNewCellFormat;
        mCellFormat.MergeCells := true;
        mCellFormat.WordWrap   := false;
        SetCellFormat(mCellFormat);
        TextRC[iRow, iCol] := 'Найменування';
        Inc(iCol, 2);
        TextRC[iRow, iCol] := 'Дебет рахунку';
        ColWidth[iCol] := Round(8 * nMyConst);
        Inc(iCol);
        TextRC[iRow, iCol] := 'КЕКВ';
        ColWidth[iCol] := Round(7 * nMyConst);
        Inc(iCol);
        TextRC[iRow, iCol] := 'Кредит рахунку';
        ColWidth[iCol] := Round(8 * nMyConst);
        Inc(iCol);
        TextRC[iRow, iCol] := 'Сума';
        ColWidth[iCol] := Round(15 * nMyConst);
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetAlignment(F1HAlignCenter, true, F1VAlignCenter, 0);
        RowHeight[iRow] := Round(2 * nMyConst);
        SetSelection(iRow, 1, iRow, nMaxCol);;
        SetBorder(1, 1, 1, 1, 1, 0, clBlack,clBlack,clBlack,clBlack,clBlack);
      end;
    end;
    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
begin
  Screen.Cursor := crHourGlass;
  DmAccMap := TDmAccMap.Create(nil);

  FormZpCmnPrt := TFormZpCmnPrt.Create(Application);
  with FormZpCmnPrt, F6B do begin
    PgSetup := CreateNewPageSetup;
    SetPageParams(PgSetup);
    SetPageSetup(PgSetup);
    DecodeDate(dDtProc, nY, nM, nD);
    ShowGridLines  := false;
    ShowColHeading := true;
    ShowRowHeading := true;
    ShowZeroValues := false;
    ShowTabs       := 0;
    PrintNoColor   := true;
    PrintGridLines := false;
    PrintFooter    := '';
    PrintHeader    := '';
    PrintLandscape := false;
    DefaultFontCharSet := F1RussianCharSet;
    DefaultFontSize := 10;
    bIsNICH := false;
    DmMain.GetPdnInfo(dDtProc, nPrcPdn, nPrcPdn2, nDummy, nDummy, nDummy,
                                   nDummy, nDummy, nDummy, nDummy, nDummy,
                                                              nDummy, nDummy);
    bIsUdVes := false; // Не расчитывались удельные веса в cdsKekv
    nMaxCol := 8;
    nMyConst := RowHeight[1];
    iRow := 1;
    iCol := 1;
    TextRC[iRow, nMaxCol] := cPrtCaption;
    RowHeight[iRow] := Round(1.2 * nMyConst);
    SetSelection(iRow, nMaxCol, iRow, nMaxCol);
    FontUnderLine := true;
    SetAlignment(F1HAlignRight, false, F1VAlignCenter, 0);
    with cdsSpZ do begin
      DisableControls;
      First;
      nStartRow := iRow + 1;
      nPp := 0;
      cSchZp := '6511';    // '661';
      nNumberSchBU := 0;
      while not Eof do begin
        if (FieldByName('VNU').AsInteger >= 4)
            or (FieldByName('VNU').AsInteger = 2)
            or (FieldByName('Smm').AsFloat = 0) then begin
          Next;
          Continue;
        end;
        cSchBU := FieldByName('SchBU').AsString;
        cNmSchBU := Form_Dm.SchBU2NmSbu(cSchBU);

        MapInfo := 
            DMAccMap.MapAccounts(cSchBU, cNmSchBU, BaseAcc);

        if cdsKekv.Active then cdsKekv.Close;
        cdsKekv.FieldDefs.Clear;
        cdsKekv.IndexDefs.Clear;
        cdsKekv.FieldDefs.Add('KEKV', ftString, 4);
        cdsKekv.FieldDefs.Add('SmN', ftFloat);
        cdsKekv.FieldDefs.Add('SmPdN', ftFloat);
        cdsKekv.FieldDefs.Add('SmPfSotr', ftFloat);
        cdsKekv.FieldDefs.Add('UdVes', ftFloat);
        cdsKekv.FieldDefs.Add('SmForPF', ftFloat);
        cdsKekv.FieldDefs.Add('SmToPfPrp', ftFloat);
        cdsKekv.IndexDefs.Add('OnKekv', 'KEKV', []);
        cdsKekv.CreateDataSet;
        cdsKekv.IndexName := 'OnKekv';
        cdsKekv.Open;
        Inc(nNumberSchBU);
        if nNumberSchBU > 1 then begin
          Inc(iRow);
          AddRowPageBreak(iRow);
        end;
        ShapkaMo(F6B, nY, nM, iRow, iCol);
        bIsKrtTitle := false;
        bIsDbtTitle := false;
        nSmDolgTM := 0;
        nSmDolgPM := 0;
        nSmVnu_1 := 0;   // для группы больничных видов
        nSmVnu00 := 0;   // для вида 1210 СрДляМобилиз
        nSmVnu01 := 0;   //            виды начилений
        nSmVnu02 := 0;   //            виды удержаний
        nSmVnu03 := 0;   //            прочие (удалил все)
        nSmVnu04 := 0;   //            выплаты и долги (коп., ПМ, ТМ)
        nEsvPrpDoMinZp := 0;
        while (FieldByName('SchBU').AsString = cSchBU) and not Eof do begin
          if (FieldByName('SchBU').AsString = cSchBU) and (
              (FieldByName('VNU').AsInteger >= 4)
              or (FieldByName('VNU').AsInteger = 2) and bIsDbtTitle
              or (FieldByName('Smm').AsFloat = 0)) then begin
            Next;
            Continue;
          end;
          nVNU := FieldByName('VNU').AsInteger;
          if (nVNU = 2) and not bIsUdVes then begin
            RaschetUdVesa;
            if bFlagDbg then
              cdsKekv.SaveToFile(cDirTemp + 'Mo52Kekv.cds');
            bIsUdVes := true;
          end;
          if (nVNU = -1) or (nVNU = 0) or (nVNU = 1) and
                                                  not bIsKrtTitle then begin
            cMsg := 'Кредит рахунку ' + cSchZp + ' в дебет рахунку:';
            Inc(iRow);
            TextRC[iRow, 1] := cMsg;
            SetSelection(iRow, 1, iRow, nMaxCol);
            SetBorder(1,0,0,0,0,0,clBlack,clBlack,clBlack,clBlack,clBlack);
            SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
            FontBold := true;
            FontUnderLine := true;
            bIsKrtTitle := true; end
          else if (nVNU = 2) and not bIsDbtTitle then begin
            if (nSmVnu_1 <> 0) or (nSmVnu00 <> 0) or (nSmVnu01 <> 0) then begin
              Inc(IRow);
              SetSelection(iRow, 1, iRow, nMaxCol-1);
              mCellFormat := CreateNewCellFormat;
              mCellFormat.AlignHorizontal := F1HAlignCenter;
              mCellFormat.AlignVertical := F1VAlignBottom;
              mCellFormat.MergeCells := true;
              mCellFormat.WordWrap   := false;
              mCellFormat.FontBold   := true;
              SetCellFormat(mCellFormat);
              TextRC[iRow, 1] := 'Всього по видах нарахування:';
              NumberRC[iRow, 8] := nSmVnu_1 + nSmVnu00 + nSmVnu01;
              SetSelection(iRow, 8, iRow, 8);
              FontBold := true;
              FormatFixed2;
              SetSelection(iRow, 1, iRow, nMaxCol);
              SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);
              {
              Inc(iRow);
              SetSelection(iRow, 1, iRow, nMaxCol);
              SetBorder(1,0,0,0,0,0,clBlack,clBlack,clBlack,clBlack,clBlack);
              }
            end;
            {
            cMsg := 'Дебет счёта ' + cSchZp + ' в кредит счетов:';
            Inc(iRow);
            TextRC[iRow, 1] := cMsg;
            SetSelection(iRow, 1, iRow, nMaxCol);
            SetBorder(1,0,0,0,0,0,clBlack,clBlack,clBlack,clBlack,clBlack);
            SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
            FontBold := true;
            FontUnderLine := true;
            }
            bIsDbtTitle := true;
            Next;
            Continue;
          end;
          while (FieldByName('SchBU').AsString = cSchBU) and
                   (FieldByName('VNU').AsInteger = nVNU) and not Eof do begin
            if (FieldByName('VNU').AsInteger > 4)
                or (FieldByName('VNU').AsInteger = 2)
                or (FieldByName('Smm').AsFloat = 0) then begin
              Next;
              Continue;
            end;
            cKrSch := FieldByName('KrSch').AsString;
            nSmKrSch := 0;
            nCntLineInSch := 0;
            while (FieldByName('KrSch').AsString = cKrSch) and not Eof do begin
              if (FieldByName('VNU').AsInteger > 4)
                  or (FieldByName('VNU').AsInteger = 2)
                  or (FieldByName('Smm').AsFloat = 0) then begin
                Next;
                Continue;
              end;
              Inc(nCntLineInSch);
              cVidN := FieldByName('VidN').AsString;
              cNmVidN := FieldByName('NmVidN').AsString;
              cKEKV := FieldByName('Vid_KEKV').AsString;
              nSmVidN := 0;
              cSp_PF := FieldByName('SP_PF').AsString;
              while (FieldByName('VidN').AsString = cVidN) and not Eof do begin
                if (FieldByName('VNU').AsInteger > 4)
                    or (FieldByName('VNU').AsInteger = 2)
                    or (FieldByName('Smm').AsFloat = 0) then begin
                  Next;
                  Continue;
                end;
                nSmVidN := nSmVidN + FieldByName('Smm').AsFloat;
                if (cVidN = '2723') or (cVidN = '6623') then
                  // возврат и удержание копеек - просто пропускаем
                else if cVidN = '2724' then
                  nSmDolgTM := nSmDolgTM + FieldByName('Smm').AsFloat
                else if cVidN = '6624' then
                  nSmDolgPM := nSmDolgPM - -FieldByName('Smm').AsFloat // ?????
                                         // будет плюсовым, хотя удерж.
                else if cVidN < '6000' then
                  nSmKrSch := nSmKrSch + FieldByName('Smm').AsFloat
                else if cVidN < '8600' then
                  nSmKrSch := nSmKrSch - FieldByName('Smm').AsFloat;
                Next;
              end;
              if (nVNU = 1) and (cKrSch = cSchBU) and
                                (cVidN <> '2723') and (cVidN <> '2724') and
                                                          (cVidN < '8000') then
                AddInfInCdsKekv(cKekv, nSmVidN);
              if (nVNU <= 1) and (cVidN < '6000') and (cSp_PF = '1') then
                AddPFInCdsKekv(cKekv, nSmVidN);
              if (cVidN <> '2723') and (cVidN <> '2724') and
                    (cVidN <> '6623') and (cVidN <> '6624') and
                        ((cVidN < '5000') or (cVidN >= '6000')) and
                                               (cVidN < '8600') then begin
                Form_Dm.GetEsvPrc(dDtProc, nPrcCmn, nPrcPps, nPrcBln,
                                                             nPrcDkr, nPrcDgv);
                Inc(nPp);
                Inc(iRow);
                NumberRC[iRow, 1] := nPp;
                TextRC[iRow, 2] := cVidN;
                SetSelection(iRow, 2, iRow, 2);
                SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);
                SetSelection(iRow, 3, iRow, 4);
                mCellFormat := CreateNewCellFormat;
                mCellFormat.MergeCells := true;
                mCellFormat.WordWrap   := false;
                mCellFormat.FontSize := 8;
                SetCellFormat(mCellFormat);
                cMsg := cNmVidN;
                if cVidN = '6201' then begin
                  if cdsPrp.Locate('SchBU;VidN',
                                    VarArrayOf([cSchBU,cVidN]), []) then begin
                    nSmFor := cdsPrp.FieldByName('SmFor').AsFloat;
                    nSmSvPrg := cdsPrp.FieldByName('SmSvPrg').AsFloat;
                    //nSmTo := cdsPrp.FieldByName('SmTo').AsFloat;
                    cMsg := cMsg + ' ' + FloatToStr(nPrcCmn) + '% (' +
                                        FloatToStrF(nSmFor, ffFixed, 18, 2);
                    if nSmSvPrg <> 0 then begin
                      cMsg := cMsg + ' - ' +
                                       FloatToStrF(nSmSvPrg, ffFixed, 18, 2);
                      cMsg := cMsg + ' = ' +
                                FloatToStrF(nSmFor-nSmSvPrg, ffFixed, 18, 2);
                    end;
                    cMsg := cMsg + ')';
                  end; end
                else if cVidN = '6206' then begin
                  if cdsPrp.Locate('SchBU;VidN',
                                    VarArrayOf([cSchBU,cVidN]), []) then begin
                    nSmFor := cdsPrp.FieldByName('SmFor').AsFloat;
                    nSmSvPrg := cdsPrp.FieldByName('SmSvPrg').AsFloat;
                    //nSmTo := cdsPrp.FieldByName('SmTo').AsFloat;
                    cMsg := cMsg + ' ' + FloatToStr(nPrcPps) + '% (' +
                                         FloatToStrF(nSmFor, ffFixed, 18, 2);
                    if nSmSvPrg <> 0 then begin
                      cMsg := cMsg + ' - ' +
                                       FloatToStrF(nSmSvPrg, ffFixed, 18, 2);
                      cMsg := cMsg + ' = ' +
                                FloatToStrF(nSmFor-nSmSvPrg, ffFixed, 18, 2);
                    end;
                    cMsg := cMsg + ')';
                  end; end
                else if cVidN = '6211' then begin
                  if cdsPrp.Locate('SchBU;VidN',
                                    VarArrayOf([cSchBU,cVidN]), []) then begin
                    nSmFor := cdsPrp.FieldByName('SmFor').AsFloat;
                    nSmSvPrg := cdsPrp.FieldByName('SmSvPrg').AsFloat;
                    //nSmTo := cdsPrp.FieldByName('SmTo').AsFloat;
                    cMsg := cMsg + ' ' + FloatToStr(nPrcBln) + '% (' +
                                         FloatToStrF(nSmFor, ffFixed, 18, 2);
                    if nSmSvPrg <> 0 then begin
                      cMsg := cMsg + ' - ' +
                                       FloatToStrF(nSmSvPrg, ffFixed, 18, 2);
                      cMsg := cMsg + ' = ' +
                                FloatToStrF(nSmFor-nSmSvPrg, ffFixed, 18, 2);
                    end;
                    cMsg := cMsg + ')';
                  end; end
                else if cVidN = '6216' then begin
                  if cdsPrp.Locate('SchBU;VidN',
                                    VarArrayOf([cSchBU,cVidN]), []) then begin
                    nSmFor := cdsPrp.FieldByName('SmFor').AsFloat;
                    nSmSvPrg := cdsPrp.FieldByName('SmSvPrg').AsFloat;
                    //nSmTo := cdsPrp.FieldByName('SmTo').AsFloat;
                    cMsg := cMsg + ' ' + FloatToStr(nPrcDgv) + '% (' +
                                        FloatToStrF(nSmFor, ffFixed, 18, 2);
                    if nSmSvPrg <> 0 then begin
                      cMsg := cMsg + ' - ' +
                                       FloatToStrF(nSmSvPrg, ffFixed, 18, 2);
                      cMsg := cMsg + ' = ' +
                                FloatToStrF(nSmFor-nSmSvPrg, ffFixed, 18, 2);
                    end;
                    cMsg := cMsg + ')';
                  end;
                end;
                TextRC[iRow, 3] := cMsg;
                SetSelection(iRow, 3, iRow, 3);
                FontSize := 8;
                if nVNU < 2 then
                  TextRC[iRow, 5] := 
                    DMAccMap.MapAccounts(cKrSch, '', AccrualAcc).Accnt
                else
                  TextRC[iRow, 5] := cSchZp;
                SetColWidthAuto(iRow, 5, iRow, 5, false);
                //if (nVNU <= 1) or ((nVNU > 1) and (cdsKekv.RecordCount < 2)) or
                //     (Pos(cVidN, '6021,6303,6304,6501,6601,6602,' +
                //                 '6707,7509,7511,8611,8612') > 0) then
                  TextRC[iRow, 6] := cKEKV; // иначе будет разблюдовка по КЕКВ
                if nVNU < 2 then //начисления (больн, детск. = 0; остальн. = 1)
                  TextRC[iRow, 7] := cSchZp
                else             // виды удержаний и выплаты
                  TextRC[iRow, 7] := cKrSch;
                SetSelection(iRow, 5, iRow, 7);
                SetAlignment(F1HAlignCenter, false, F1VAlignBottom, 0);
                SetColWidthAuto(iRow, 5, iRow, 5, false);
