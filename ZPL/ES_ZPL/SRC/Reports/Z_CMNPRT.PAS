    SetPageSetup(PgSetup);
    nMyConst := RowHeight[1];
    nMaxCol := 8;
    ShowGridLines    := false;
    ShowColHeading   := true;
    ShowRowHeading   := true;
    ShowZeroValues   := false;
    ShowTabs         := 0;
    PrintNoColor     := true;
    PrintGridLines   := false;
    PrintFooter      := '';
    PrintHeader      := '';
    PrintLandscape   := false;
    DefaultFontCharSet := F1RussianCharSet;
    DefaultFontSize := 9;
    ColWidth[1] := Round(5.5 * nMyConst); // № п/п
    ColWidth[2] := Round( 9 * nMyConst);  // ТабНр
    ColWidth[3] := Round(12 * nMyConst);  // ЄДРПОУ
    ColWidth[4] := Round(30 * nMyConst);  // ФамИО
    ColWidth[5] := Round( 5 * nMyConst);  // Разделительная колонка
    ColWidth[6] := Round(13 * nMyConst);  // Сумма
    ColWidth[7] := Round(13 * nMyConst);  // Роспись
    ColWidth[8] := Round(13 * nMyConst);  // Примітки
    iRow := 0;
    iCol := 1;
    nMaxPgLines := 18;
    with cdsPrt do begin
      nSvTabN := FieldByName('TabN').AsInteger;
      DisableControls;
      First;
      nVedNR := nKssVedNR;
      nCntObj := 0;
      nVedNR := nKssVedNR;
      while not Eof do begin
        nKdObj := FieldByName('KdObj_Sps').AsInteger;
        nSvNR := FieldByName('NR').AsInteger;
        nCntTabNInObj := 0;
        while (FieldByName('KdObj_Sps').AsInteger = nKdObj) and not Eof do begin
          nTabN := fieldByName('TabN').AsInteger;
          Inc(nCntTabNInObj);
          while (FieldByName('TabN').AsInteger = nTabN) and
              (FieldByName('KdObj_Sps').AsInteger = nKdObj) and not Eof do begin
            Next;
          end;
        end;
        Locate('NR', nSvNR, []);
        nCntRestTabN := nCntTabNInObj;
        Inc(nCntObj);
        if (nCntObj > 1) and (nVedNr > 0) then
          Inc(nVedNR);
        nPage := 0;
        cShObj := DmMain.KdObj2ShObj(nKdObj, cNmObj);
        cNmObj := IntToStr(nKdObj) + '  ' + cNmObj;
        ShapVedKss01(F6B, iRow, iCol);
