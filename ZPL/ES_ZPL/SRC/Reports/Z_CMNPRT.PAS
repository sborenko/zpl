            TextRC[iRow, 3] := TextRC[iRow, 3] + '(сумісн)';

          TextRC[iRow, 16] := VidN;
          TextRC[iRow, 17] := FieldByName('ShVidN').AsString;
          if (FieldByName('NSovm').AsString = 'Y')
            and (FieldByName('VSovm').AsString <> '1')
          then
            TextRC[iRow, 17] := TextRC[iRow, 17] + '(сумісн)';
        end else begin
          TextRC[iRow, 1] := FieldByName('ShVidN').AsString;
          SetSelection(iRow, 1, iRow, 3);
          SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignBottom, 0);
          TextRC[iRow, 16] := FieldByName('ShVidN').AsString;
          SetSelection(iRow, 16, iRow, 17);
          SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignBottom, 0);
        end;

        iCol := 3;
        for i := 1 to 6 do begin
          Inc(iCol);
          PrintSection('Sm', I);
          Inc(iCol);
          if VidN <> '9999' then PrintSection('SmZa', I);
        end;

        SetSelection(iRow, 4, iRow, nMaxCol01);
        FormatFixed2;

        iCol := 17;
        for i := 7 to 12 do begin
          Inc(iCol);
          PrintSection('Sm', I);
          Inc(iCol);
          if VidN <> '9999' then PrintSection('SmZa', I);
        end;

        SetSelection(iRow, 18, iRow, nMaxCol);
        FormatFixed2;
        SetSelection(iRow, 1, iRow, nMaxCol);
        SetBorder(1,1,1,1,1,0,clBlack,clBlack,clBlack,clBlack,clBlack);

        if (VidN = '6000') or (VidN = '8000') or (VidN = '9999') then begin
          FontBold := true;
          SetColWidthAuto(iRow, 4, iRow, nMaxCol01, false);
          SetColWidthAuto(iRow, 18, iRow, nMaxCol, false);
        end;
        
        Next;
      end;
      Inc(iRow);
      TextRC[iRow, 1] := 'Прим.: В кожному мiсяцi можуть бути нарах. як за ' +
        'минулi мiсяцi (лiкарнянi, виправлення та iн.), так ' +
        'i за наступнi (вiдпустки, декрети та iн.).';
      SetSelection(iRow, 1, iRow, 1);
      FontSize := 8;
      Inc(iRow);
      TextRC[iRow, 3] := 'Тому нарах. та утримання друкуються в два ' +
        'стовбцi: 1. Мiсяць, в якому виконувалися виплати, та 2. ' +
        'Мiсяць, за який робилися нарахування.';
      SetSelection(iRow, 3, iRow, 3);
      FontSize := 8;
      if CaseNich = 1 then
        cMsg := '(Без начислений по НИЧ)'
      else if CaseNich = 2 then
        cMsg := '(Только по начислениям НИЧ)';
      if (CaseNich = 1) or (CaseNich = 2) then begin
        Inc(iRow);
        TextRC[iRow, 1] := cMsg;
        SetSelection(iRow, 1, iRow, 1);
        FontSize := 8;
        Inc(iRow);
      end;
      TextRC[iRow, nMaxCol] := 'Бухгалтер ____________  ' +
                                               Form_Dm.KdUsr2FioUsr(nAppKdUsr);
      SetSelection(iRow, nMaxCol, iRow, nMaxCol);
      SetAlignment(F1HAlignRight, false, F1VAlignCenter, 0);
      Inc(iRow);
      First;
      EnableControls;
    end;
    Screen.Cursor := crHourGlass;
    cRandomFileName := RandomFileName;
    if bAppDocsToExcel then begin
      cRandomFileName := cRandomFileName + '.xls';
      WriteEx(cDirTemp + cRandomFileName, F1FileExcel97); end
    else begin
      cRandomFileName := cRandomFileName + '.vts';
      WriteEx(cDirTemp + cRandomFileName, F1FileFormulaOne6);
    end;
    Screen.Cursor := crDefault;
    Free;
  end;
  MyPreView(cDirTemp, cRandomFileName);
end;

