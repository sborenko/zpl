      cMsg := cMsg + 'Календ. дней: '
    else if cCase = '12m' then
      cMsg := cMsg + 'Календ. дней: '
    else
      cMsg := cMsg + 'Рабочих дней: ';
    cMsg := cMsg + qryVBln.FieldByName('CntDays').AsString +
                   ',  с ' + qryVBln.FieldByName('DtBeg').AsString + ' по ' +
                            qryVBln.FieldByName('DtEnd').AsString + ' (вкл.)';
    Inc(iRow);
    TextRC[iRow, 1] := cMsg;
    SetSelection(iRow, 1, iRow, nMaxCol);
    FontBold := true;
    SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
    if qryVBln.FieldByName('ListCont').AsString = '1' then begin
      Inc(iRow);
      cMsg := '(Продолжение листка № ' + qryVBln.FieldByName('PredNR').AsString +
              ' от ' + qryVBln.FieldByName('PredDt').AsString + ')';
      TextRC[iRow, 1] := cMsg;
      SetSelection(iRow, 1, iRow, nMaxCol);
      SetAlignment(F1HAlignCenterAcrossCells, false, F1VAlignCenter, 0);
    end;
    cMsg := 'Процент оплаты: ' + qryVBln.FieldByName('ProcOpl').AsString + ' %';
