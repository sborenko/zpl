        Next;
      end;
      myFooter(F6B, nSmNar, nSmDox, nSmTaxN, nSmTaxP, nSmWSbNar, nSmWSbTax,
                     iRow, nPp, nCntFizLic, nCntPg,
                      dtsRkvzt.FieldByName('Dir_ID').AsString,
                       dtsRkvzt.FieldByName('Dir_FIO').AsString,
                        dtsRkvzt.FieldByName('Dir_Phone').AsString,
                         dtsRkvzt.FieldByName('Buh_ID').AsString,
                          dtsRkvzt.FieldByName('Buh_FIO').AsString,
                           dtsRkvzt.FieldByName('Buh_Phone').AsString,
                            nCntPrac, nCntSuvm, bPrtDtPod);
    end;
    cRandomFileName := cDfDirResults + 'Porc_' + IntToStr(nPorcia);
    if bAppDocsToExcel then
      WriteEx(cRandomFileName + '.xls', F1FileExcel97)
    else
      WriteEx(cRandomFileName + '.vts', F1FileFormulaOne6);
    Screen.Cursor   := crDefault;
    FormZpCmnPrt.Free;
    if bAppDocsToExcel then
      ShellExecute(Application.Handle, nil,
                    PChar(cRandomFileName + '.xls'),
                                   nil, nil, SW_SHOWNOACTIVATE)
    else
      ShowF6File(cRandomFileName + '.vts');   {df_F6B}
  end;
end;

