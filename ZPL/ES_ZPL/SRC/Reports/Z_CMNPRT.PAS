//------------------------------------------------------------------------------
procedure TFormZpCmnPrt.GetNewVedNR(dDtProc : TDateTime; nKdObj : integer;
                            var nVedNR, nBigVedNr : integer; qryNumb : TQuery);
var nFoundNR : integer; cBigVedNr : string;
begin
  cBigVedNr := 'avns_' + IntToStr(nBigVedNr);
  with qryNumb do begin
    if Active then Close;
    SQL.Clear;
    DataBaseName := CESMAIN;
    SQL.Add('Select * from Z_VedNR where (DtProc = :dDtProc) and ' +
            ' (KdObj = :nKdObj) and (TypeVed = :cBigVedNR)');
    ParamByName('dDtProc').AsDateTime := dDtProc;
    ParamByName('nKdObj').AsInteger   := nKdObj;
    ParamByName('cBigVedNr').AsString := cBigVedNr;
    Open;
    if RecordCount > 0 {может быть только одна или ни одной} then begin
      // уже печаталась, зарегистрировалась - изменить в Z_VedNR и вернуть новый
      nFoundNR := FieldByName('NR').AsInteger;
      SQL.Clear;
      SQL.Add('Update Z_VedNR set VedNR = :nVedNR, TypeVed = :cTypeVed ' +
              ' where NR = :nFoundNR');
      ParamByName('nVedNR').AsInteger   := nVedNR;
      ParamByName('cTypeVed').AsString  := cBigVedNR;
      ParamByName('nFoundNR').AsInteger := nFoundNR;
      ExecSQL; end
    else begin
      SQL.Clear;
      SQL.Add('Insert into Z_VedNR (DtProc, KdSps, KdObj, TypeVed, VedNR, ' +
              ' VedDate, Notes) values (:dDtProc, :nKdSps, :nKdObj, ' +
              ' :cTypeVed, :nVedNR, :dVedDate, :cNotes)');
      ParamByName('dDtProc').AsDateTime  := dDtProc;
      ParamByName('nKdSps').AsInteger    := gl_nKdSps;
      ParamByName('nKdObj').AsInteger    := nKdObj;
      ParamByName('cTypeVed').AsString   := cBigVedNR;
      ParamByName('nVedNR').AsInteger    := nVedNR;
      ParamByName('dVedDate').AsDateTime := Date;
      ParamByName('cNotes').AsString     := '';
      ExecSQL;
    end;
    Close;
    SQL.Clear;
    DataBaseName := '';
  end;
end;
