  object qryInclRS: TQuery
    CachedUpdates = True
    DatabaseName = 'DbMain'
    SQL.Strings = (
      
        'select s.SchBU, r.* from kd_RSCH r left Outer Join Kd_Sbu s on s' +
        '.KdSch = r.KdSbu'
      'where r.KdWho = 6 and not r.ShPPdr is null')
