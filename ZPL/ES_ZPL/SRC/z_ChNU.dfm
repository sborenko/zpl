  object qryNu: TQuery
    OnCalcFields = qryNuCalcFields
    DatabaseName = 'DbMain'
    SQL.Strings = (
      
        'Select u.Fam, u.Ima, u.Otch, s.TabN, s.DtProc, s.KdObj, KdSps, s' +
        '.NCH, '
      
        '       s.KdKatP, s.Notes, Sum(o.Summa) as SmPlus, Sum(o2.Summa) ' +
        'as SmMinus'
      'from z_sps s'
      '     Left outer join z_UPI u on u.TabN = s.TabN'
      '     Left outer join z_Otkl o on'
      '        o.TabN = s.TabN and o.DtProc = s.DtProc and o.Summa >= 0'
      '     Left outer join z_Otkl o2 on'
      
        '        o2.TabN = s.TabN and o2.DtProc = s.DtProc and o2.Summa <' +
        ' 0'
      ' where s.DtProc = '#39'09/01/2008'#39' and not'
      
        '                 Exists (Select Tabn from z_NU where z_NU.TabN =' +
        ' s.TabN and'
      '                                 z_NU.DtProc = s.DtProc)'
      
        'group by u.Fam, u.Ima, u.Otch, s.TabN, s.DtProc, s.KdObj, KdSps,' +
        ' s.NCH, '
      '       s.KdKatP, s.Notes'
      ''
      '')
    Left = 72
    Top = 104
    object qryNuFAM: TStringField
      DisplayLabel = #1060#1072#1084#1080#1083#1080#1103
      FieldName = 'FAM'
      Visible = False
    end
