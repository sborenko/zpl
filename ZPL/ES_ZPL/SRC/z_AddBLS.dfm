  object qryPkt: TQuery
    DatabaseName = 'DbMain'
    SQL.Strings = (
      
        'Select usr.NmUsr, bls.NrPkt, bls.KdUsr, bls.KdBnk, bls.DtBeg, co' +
        'unt(bls.NR) as Cnt '
      'from z_BankiLS bls'
      'Left Outer Join usrs usr on usr.KdUsr = bls.KdUsr '
      'where not bls.NrPkt is NULL'
      'group by usr.NmUsr,bls.NrPkt, bls.KdUsr, bls.KdBnk, bls.DtBeg')
