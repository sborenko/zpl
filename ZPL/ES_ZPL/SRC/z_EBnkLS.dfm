  object qryLS: TQuery
    DatabaseName = 'DbMain'
    SQL.Strings = (
      'select u.ID, u.Fam, u.Ima, u.Otch, bs.* '
      'from z_BankiLS bs Left outer join z_Upi u on u.TabN = bs.TabN'
      'order by u.ID, u.TabN'
      '')
    Left = 416
  end
