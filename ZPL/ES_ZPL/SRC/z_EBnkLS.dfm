  object qryPkt: TQuery
    DatabaseName = 'DbMain'
    SQL.Strings = (
      'Select distinct LS.NrPkt, LS.KdUsr, usrs.Notes as NmUsr, '
      '                     LS.KdBnk, bnk.ShBnk, LS.DtBeg '
      'from z_BankiLS LS '
      '     Left Outer Join usrs on usrs.KdUsr = LS.KdUsr'
      '     Left Outer Join Z_Banki bnk on Bnk.KdBnk = LS.KdBnk'
      ' where not NrPkt is NULL')
    Left = 52
    Top = 176
    object qryPktNRPKT: TIntegerField
      DisplayLabel = #8470' '#1087#1082#1090
      FieldName = 'NRPKT'
    end
    object qryPktKDUSR: TSmallintField
      FieldName = 'KDUSR'
    end
