  object qryTmp: TQuery
    Active = True
    DatabaseName = 'DbMain'
    SQL.Strings = (
      
        'Select distinct s.DtProc, s.tabN, s.KdObj as s_KdObj, u.Fam, u.I' +
        'ma, u.Otch, '
      
        '                                                        s.OldKdO' +
        'bj, s1.KdObj'
      ' from z_sps s '
      '  Left outer Join z_Sps s1 on s1.TabN = s.TabN and '
      
        '                                         s1.DtProc = s.DtProc an' +
        'd s1.KdObj = s1.OldKdObj'
      '  Left outer Join z_Upi u on u.TabN = s.TabN'
      'where s.dtProc = '#39'01/01/2008'#39' and s1.KdObj is Null'
      'order by s.KdObj, s.TabN')
    Left = 72
    Top = 216
    object qryTmpDTPROC: TDateTimeField
      FieldName = 'DTPROC'
    end
    object qryTmpS_KDOBJ: TSmallintField
      DisplayLabel = #1055#1076#1088
      FieldName = 'S_KDOBJ'
    end
    object qryTmpTABN: TIntegerField
      DisplayLabel = #1058#1072#1073#1053#1088
      FieldName = 'TABN'
    end
    object qryTmpFAM: TStringField
