  object qrySvd: TQuery
    DatabaseName = 'DbMain'
    SQL.Strings = (
      'Select p.KdKatP, k.ShKatP, k.NmKatP, Count(p.TabN) as CNT, '
      '                   Sum(Cast(p.Summa as Numeric(18,2))) as Summa'
      'from Z_GetNuByKatP('#39'04/01/2009'#39') p'
      '     Left Outer Join z_KatPers k on k.KdKatP = p.KdKatP'
      'group by p.KdKatP, k.ShKatP, k.NmKatP')
    Left = 16
    Top = 160
  end
