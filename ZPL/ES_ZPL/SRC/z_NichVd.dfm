  object qryTmp: TQuery
    DatabaseName = 'DbMain'
    SQL.Strings = (
      'Select PSCH, SchBU, KdSpZ, NmSch, TabN, VidN, ZaMesGod, ShVidN, '
      ' Sum(Summa) as Summa from viNu_Main '
      ' where dtProc = '#39'12/01/2007'#39' and VidN < "7500" and'
      ' (PSCH = "823/1" or PSCH = "801/1-1" or '
      '  PSCH = "801/1-2" or SchBU = "811/72") '
      
        ' group by PSCH, SchBU, KdSpZ, NmSch, TabN, VidN, ZaMesGod, ShVid' +
        'N')
    Left = 48
    Top = 144
  end
