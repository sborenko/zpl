  for i := 0 to ParamCount do begin
    if LowerCase(ParamStr(i)) = 'dbg' then
      bFlagDbg := true;
  end;

  if not CheckUsrPsw('zpl', nAppKdUsr, nAppKdKatUsr, gc_AppNmUsr) {a_Ch2Psw} then
    exit;

  AppSetts := TAppSetts.Create;
  AppSetts.UserId := nAppKdUsr;

  FormSplash := TFormSplash.Create(Application);

  FormSplash.Show;
  FormSplash.Update;

  Application.Title := 'Временно приостановленные';
  Application.HelpFile := '\ZpHelp\ZpHelp.hlp';

  Application.Initialize;
  Application.CreateForm(TForm_Dm, Form_Dm);
  Application.CreateForm(TFormZpMain, FormZpMain);
  Application.CreateForm(TDmAudit, DmAudit);
  Application.CreateForm(TDMAccMap, DMAccMap);
  Application.CreateForm(TDMSpan, DMSpan);
  Application.CreateForm(TDMUsrSetts, DMUsrSetts);
  Application.CreateForm(TDMUsrStats, DMUsrStats);
  Application.CreateForm(TFrmSpov, FrmSpov);
  Application.CreateForm(TDmD41DF, DmD41DF);
  Application.CreateForm(TStpAppx4DM, StpAppx4DM);
  Application.CreateForm(TFrmEdNadb, FrmEdNadb);
  with FormSplash do begin
    Hide;
    Free;
  end;

  // Обновить статистику входов в программу
  DMUsrStats.Login := DMUsrStats.Login + 1;

  Application.Run;

  AppSetts.Free;
end.
